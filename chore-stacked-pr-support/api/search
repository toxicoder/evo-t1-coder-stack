uting","devcontainer","bazel","ci","docker"],"url":"/contribute/devcontainer#the-block-configuresh-writes","content":"The block configure.sh writes"},"1157":{"id":"/contribute/devcontainer-11","page_id":"/contribute/devcontainer","type":"heading","tags":["contributing","devcontainer","bazel","ci","docker"],"url":"/contribute/devcontainer#dropping-the-caches","content":"Dropping the caches"},"1158":{"id":"/contribute/devcontainer-12","page_id":"/contribute/devcontainer","type":"heading","tags":["contributing","devcontainer","bazel","ci","docker"],"url":"/contribute/devcontainer#the-warm-up","content":"The warm-up"},"1159":{"id":"/contribute/devcontainer-13","page_id":"/contribute/devcontainer","type":"heading","tags":["contributing","devcontainer","bazel","ci","docker"],"url":"/contribute/devcontainer#keeping-it-maintained","content":"Keeping it maintained"},"1160":{"id":"/contribute/devcontainer-14","page_id":"/contribute/devcontainer","type":"heading","tags":["contributing","devcontainer","bazel","ci","docker"],"url":"/contribute/devcontainer#seeding-the-contributor-home","content":"Seeding the contributor home"},"1161":{"id":"/contribute/devcontainer-15","page_id":"/contribute/devcontainer","type":"heading","tags":["contributing","devcontainer","bazel","ci","docker"],"url":"/contribute/devcontainer#how-the-container-seeds-it","content":"How the container seeds it"},"1162":{"id":"/contribute/devcontainer-16","page_id":"/contribute/devcontainer","type":"heading","tags":["contributing","devcontainer","bazel","ci","docker"],"url":"/contribute/devcontainer#the-flags-it-takes","content":"The flags it takes"},"1163":{"id":"/contribute/devcontainer-17","page_id":"/contribute/devcontainer","type":"heading","tags":["contributing","devcontainer","bazel","ci","docker"],"url":"/contribute/devcontainer#the-two-research-lanes","content":"The two research lanes"},"1164":{"id":"/contribute/devcontainer-18","page_id":"/contribute/devcontainer","type":"heading","tags":["contributing","devcontainer","bazel","ci","docker"],"url":"/contribute/devcontainer#repairing-a-missing-context7-block","content":"Repairing a missing context7 block"},"1165":{"id":"/contribute/devcontainer-19","page_id":"/contribute/devcontainer","type":"heading","tags":["contributing","devcontainer","bazel","ci","docker"],"url":"/contribute/devcontainer#the-files-it-writes","content":"The files it writes"},"1166":{"id":"/contribute/devcontainer-20","page_id":"/contribute/devcontainer","type":"heading","tags":["contributing","devcontainer","bazel","ci","docker"],"url":"/contribute/devcontainer#the-notesmd-back-copy","content":"The notes.md back-copy"},"1167":{"id":"/contribute/devcontainer-21","page_id":"/contribute/devcontainer","type":"heading","tags":["contributing","devcontainer","bazel","ci","docker"],"url":"/contribute/devcontainer#stack-owned-and-user-owned-files","content":"Stack-owned and user-owned files"},"1168":{"id":"/contribute/devcontainer-22","page_id":"/contribute/devcontainer","type":"heading","tags":["contributing","devcontainer","bazel","ci","docker"],"url":"/contribute/devcontainer#github-auth-in-the-container","content":"GitHub auth in the container"},"1169":{"id":"/contribute/devcontainer-23","page_id":"/contribute/devcontainer","type":"heading","tags":["contributing","devcontainer","bazel","ci","docker"],"url":"/contribute/devcontainer#running-the-gate-here","content":"Running the gate here"},"1170":{"id":"/contribute/devcontainer-24","page_id":"/contribute/devcontainer","type":"heading","tags":["contributing","devcontainer","bazel","ci","docker"],"url":"/contribute/devcontainer#from-the-host-with-test-in-image","content":"From the host, with test-in-image"},"1171":{"id":"/contribute/devcontainer-25","page_id":"/contribute/devcontainer","type":"heading","tags":["contributing","devcontainer","bazel","ci","docker"],"url":"/contribute/devcontainer#typed-inside-the-container","content":"Typed inside the container"},"1172":{"id":"/contribute/devcontainer-26"