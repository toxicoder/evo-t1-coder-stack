":"heading","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"url":"/observability#which-page-answers-which-question","content":"Which page answers which question"},"3513":{"id":"/observability-23","page_id":"/observability","type":"heading","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"url":"/observability#how-the-sparks-pages-reach-one-machine","content":"How the Sparks pages reach one machine"},"3514":{"id":"/observability-24","page_id":"/observability","type":"heading","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"url":"/observability#a-dashboard-is-a-committed-file","content":"A dashboard is a committed file"},"3515":{"id":"/observability-25","page_id":"/observability","type":"heading","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"url":"/observability#the-gate","content":"The gate"},"3516":{"id":"/observability-26","page_id":"/observability","type":"heading","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"url":"/observability#the-metric-allow-list","content":"The metric allow-list"},"3517":{"id":"/observability-27","page_id":"/observability","type":"heading","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"url":"/observability#the-coarser-gate","content":"The coarser gate"},"3518":{"id":"/observability-28","page_id":"/observability","type":"heading","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"url":"/observability#retention-and-disk","content":"Retention and disk"},"3519":{"id":"/observability-29","page_id":"/observability","type":"heading","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"url":"/observability#what-each-component-keeps","content":"What each component keeps"},"3520":{"id":"/observability-30","page_id":"/observability","type":"heading","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"url":"/observability#changing-a-cap","content":"Changing a cap"},"3521":{"id":"/observability-31","page_id":"/observability","type":"heading","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"url":"/observability#reaching-the-uis","content":"Reaching the UIs"},"3522":{"id":"/observability-32","page_id":"/observability","type":"heading","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"url":"/observability#the-one-public-name","content":"The one public name"},"3523":{"id":"/observability-33","page_id":"/observability","type":"heading","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"url":"/observability#operator-checks","content":"Operator checks"},"3524":{"id":"/observability-34","page_id":"/observability","type":"heading","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"url":"/observability#the-one-command-that-asks-all-of-these","content":"The one command that asks all of these"},"3525":{"id":"/observability-35","page_id":"/observability","type":"heading","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"url":"/observability#what-that-check-does-not-cover","content":"What that check does not cover"},"3526":{"id":"/observability-36","page_id":"/observability","type":"heading","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"url":"/observability#the-probes-in-order","content":"The probes, in order"},"3527":{"id":"/observability-37","page_id":"/observability","type":"heading","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"url":"/observability#is-the-bundle-selected-at-all","content":"Is the bundle selected at all"},"3528":{"id":"/observability-38","page_id":"/observability","type":"heading","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"url":"/observability#did-grafana-come-up-and-can-it-read-its-own-database","content":"Did Grafana come up and can it read its own database"},"3529":{"id":"/observability-39","page_id":"/observability","type":"heading","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"url":"/observability#are-the-scrapes-up","content":"Are the scrapes up"},"3530":{"id":"/observability-40","page_id":"/observability","type":"heading","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"url":"/observability#is-the-write-to-mimir-landing","content":"Is the write to Mimir landing"},"3531":{"id":"/observability-41","page_id":"/observability","type":"heading","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"url":"/observability#are-the-three-unpublished-backends-alive","content":"Are the three unpublished backends alive"},"3532":{"id":"/observability-42","page_id":"/observability","type":"heading","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"url":"/observability#is-the-whole-thing-still-well-formed-on-both-flag-paths","content":"Is the whole thing still well-formed on both flag paths"},"3533":{"id":"/observability-43","page_id":"/observability","type":"heading","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"url":"/observability#the-shipped-payload-checks","content":"The shipped payload checks"},"3534":{"id":"/observability-44","page_id":"/observability","type":"heading","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"url":"/observability#what-is-deliberately-not-here","content":"What is deliberately not here"},"3535":{"id":"/observability-45","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#observability-bundle","content":"**What's on this page**"},"3536":{"id":"/observability-46","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#observability-bundle","content":"What each of the ten services does, and why this stack ships it at all"},"3537":{"id":"/observability-47","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#observability-bundle","content":"The path a metric, a log line and a span take before Grafana renders them"},"3538":{"id":"/observability-48","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#observability-bundle","content":"The one flag that decides whether the bundle exists, and how to turn it off"},"3539":{"id":"/observability-49","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#observability-bundle","content":"Where each component's config lives in the checkout, and what it costs to change"},"3540":{"id":"/observability-50","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#observability-bundle","content":"Which of the thirteen provisioned dashboards answers which question, and how a panel actually gets changed"},"3541":{"id":"/observability-51","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#observability-bundle","content":"Retention caps, the named volumes the data lands on, and how to reach each UI"},"3542":{"id":"/observability-52","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#observability-bundle","content":"What is not here - no pager destination until you set one, no object storage, no trace client"},"3543":{"id":"/observability-53","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#observability-bundle","content":"**What this enables**"},"3544":{"id":"/observability-54","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#observability-bundle","content":"Reading the box's history from Grafana instead of from `docker compose logs`"},"3545":{"id":"/observability-55","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#observability-bundle","content":"Telling a scrape fault from a write fault from a read fault in three commands"},"3546":{"id":"/observability-56","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#observability-bundle","content":"Deciding what to add next without guessing what is already wired"},"3547":{"id":"/observability-57","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#observability-bundle","content":"Ten services sit behind one Compose profile. Six of them store and read - `prometheus`,\n`mimir`, `loki`, `tempo`, `grafana` and `alloy` - and four watch the box and speak up -\n`node_exporter`, `cadvisor`, `blackbox_exporter` and `alertmanager`. They answer one\nquestion the rest of the stack cannot - what this box was doing ten minutes ago - and they\nare the only part of the stack that keeps data after a container is gone. Everything else on this page is about the seams between them,\nbecause that is where a monitoring stack silently stops working: a service can be\n`running`, a dashboard can be green, and a panel can still be empty."},"3548":{"id":"/observability-58","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-ten-services","content":"| Service      | Image                     | Job on this box                                                                                                |\n| ------------ | ------------------------- | -------------------------------------------------------------------------------------------------------------- |\n| `prometheus` | `prom/prometheus:v3.16.0` | Scrape. Holds the last `PROMETHEUS_RETENTION_TIME` of series on its own TSDB and copies every sample to Mimir. |","table":"table-0"},"3549":{"id":"/observability-59","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-ten-services","content":"| Service | Image                 | Job on this box                                                                                      |\n| ------- | --------------------- | ---------------------------------------------------------------------------------------------------- |\n| `mimir` | `grafana/mimir:3.2.5` | Long-term metric store. Prometheus `remote_write`s into it; Grafana queries the long view out of it. |","table":"table-0"},"3550":{"id":"/observability-60","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-ten-services","content":"| Service | Image                 | Job on this box                                                                  |\n| ------- | --------------------- | -------------------------------------------------------------------------------- |\n| `loki`  | `grafana/loki:3.7.10` | Log store. Takes the lines Alloy ships and answers LogQL from Grafana's Explore. |","table":"table-0"},"3551":{"id":"/observability-61","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-ten-services","content":"| Service | Image                 | Job on this box                                                              |\n| ------- | --------------------- | ---------------------------------------------------------------------------- |\n| `tempo` | `grafana/tempo:3.1.1` | Trace store. Listens for OTLP on `4317` and answers trace queries on `3200`. |","table":"table-0"},"3552":{"id":"/observability-62","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-ten-services","content":"| Service   | Image                    | Job on this box                                                                                                            |\n| --------- | ------------------------ | -------------------------------------------------------------------------------------------------------------------------- |\n| `grafana` | `grafana/grafana:13.3.1` | The only read path and the only published UI. Metrics, logs and traces all render here, from four provisioned datasources. |","table":"table-0"},"3553":{"id":"/observability-63","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-ten-services","content":"| Service | Image                   | Job on this box                                                                |\n| ------- | ----------------------- | ------------------------------------------------------------------------------ |\n| `alloy` | `grafana/alloy:v1.22.0` | The collector. Tails the host's Docker json-file logs and pushes them to Loki. |","table":"table-0"},"3554":{"id":"/observability-64","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-ten-services","content":"| Service         | Image                                      | Job on this box                                                                                                                                                                    |\n| --------------- | ------------------------------------------ | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `node_exporter` | `quay.io/prometheus/node-exporter:v1.12.1` | The stack host as a machine. Reads `/proc` and `/sys` read-only under `--path.rootfs=/host` with `pid: host`, and adds `--collector.processes` so the process series exist at all. |","table":"table-0"},"3555":{"id":"/observability-65","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-ten-services","content":"| Service    | Image                             | Job on this box                                                                                                        |\n| ---------- | --------------------------------- | ---------------------------------------------------------------------------------------------------------------------- |\n| `cadvisor` | `ghcr.io/google/cadvisor:v0.61.0` | Per-container metrics. The bundle's one privileged container, `--docker_only` with `image,name` whitelisted as labels. |","table":"table-0"},"3556":{"id":"/observability-66","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-ten-services","content":"| Service             | Image                            | Job on this box                                                                                                                              |\n| ------------------- | -------------------------------- | -------------------------------------------------------------------------------------------------------------------------------------------- |\n| `blackbox_exporter` | `prom/blackbox-exporter:v0.29.1` | The prober for anything with no `/metrics` to scrape: Prometheus hands it each URL as `__param_target`, so one container probes every Spark. |","table":"table-0"},"3557":{"id":"/observability-67","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-ten-services","content":"| Service        | Image                       | Job on this box                                                                                  |\n| -------------- | --------------------------- | ------------------------------------------------------------------------------------------------ |\n| `alertmanager` | `prom/alertmanager:v0.35.0` | Delivery. Groups, inhibits and silences what the rule files fire, and holds the repeat interval. |","table":"table-0"},"3558":{"id":"/observability-68","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-ten-services","content":"The split is upstream's own:"},"3559":{"id":"/observability-69","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-ten-services","content":"Prometheus is a fast local scratch store"},"3560":{"id":"/observability-70","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-ten-services","content":"Mimir is the same PromQL over longer retention"},"3561":{"id":"/observability-71","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-ten-services","content":"Alloy is the single agent that touches the host filesystem"},"3562":{"id":"/observability-72","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-ten-services","content":"This box needs all three because a container that dies takes its own log file out of\n`docker compose logs` reach only if you are too late - but a workspace that was slow at\n03:00 is unrecoverable without retention."},"3563":{"id":"/observability-73","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#four-places-a-panel-goes-empty","content":"Four things are worth naming precisely, because each is a place a panel goes empty while\nevery container stays up:"},"3564":{"id":"/observability-74","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#four-places-a-panel-goes-empty","content":"**Prometheus is the only scraper.** Its scrape config targets the apps that publish\n`/metrics` - `coder:2112` and `litellm:4000` - plus:"},"3565":{"id":"/observability-75","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#four-places-a-panel-goes-empty","content":"the six components that publish their own (`prometheus:9090`, `mimir:8080`,\n`loki:3100`, `tempo:3200`, `grafana:3000`, `alloy:12345`)"},"3566":{"id":"/observability-76","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#four-places-a-panel-goes-empty","content":"the stack host through `node_exporter:9101` and `cadvisor:8080`"},"3567":{"id":"/observability-77","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#four-places-a-panel-goes-empty","content":"Alertmanager itself at `alertmanager:9093`"},"3568":{"id":"/observability-78","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#four-places-a-panel-goes-empty","content":"the Spark jobs that reach `blackbox_exporter:9115` as their prober"},"3569":{"id":"/observability-79","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#four-places-a-panel-goes-empty","content":"Fifteen jobs in all. The LiteLLM\nscrape carries a bearer token, so the metrics stay behind `LITELLM_MASTER_KEY` the way\nevery other LiteLLM endpoint is."},"3570":{"id":"/observability-80","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#four-places-a-panel-goes-empty","content":"Measured on the pinned v3.16.0: `$VAR` and `${VAR}`\nunder `global.external_labels` come back filled in at `/api/v1/status/config`, where\n`$(VAR)` stays literal, and a scrape target address and `authorization.credentials`\nexpand nothing at all - `$(VAR)`, `${VAR}` and `$VAR` in the latter each reached a\nlistener that logs its request headers verbatim - so the key cannot travel that way,\nand it arrives as a file instead."},"3571":{"id":"/observability-81","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#four-places-a-panel-goes-empty","content":"Compose renders `configs.litellm_metrics_token` into\n`/etc/prometheus-secrets/litellm_token` in the container (`docker-compose.yml:839-841`,\n`:1452`), and the `litellm` job presents that file through\n`authorization.credentials_file` (`observability/prometheus/prometheus.yml:126-129`)."},"3572":{"id":"/observability-82","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#four-places-a-panel-goes-empty","content":"The config's `content:` interpolates the very same\n`${LITELLM_MASTER_KEY:-change-me-litellm}` the proxy boots with\n(`docker-compose.yml:1459`), so with no dotenv both ends land on the shipped\nplaceholder and the scrape works, and the fault an operator actually meets is the two\nends disagreeing: rotate the key without recreating `prometheus` and the file still\nholds the old one."},"3573":{"id":"/observability-83","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#four-places-a-panel-goes-empty","content":"**The apps with no `/metrics` are observed by logs alone, on purpose.** These publish\nno Prometheus endpoint, so scraping them would leave a target answering 404 forever\nand a tally no one trusts:"},"3574":{"id":"/observability-84","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#four-places-a-panel-goes-empty","content":"`ollama`"},"3575":{"id":"/observability-85","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#four-places-a-panel-goes-empty","content":"`searxng`"},"3576":{"id":"/observability-86","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#four-places-a-panel-goes-empty","content":"`kasm`"},"3577":{"id":"/observability-87","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#four-places-a-panel-goes-empty","content":"`homepage`"},"3578":{"id":"/observability-88","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#four-places-a-panel-goes-empty","content":"the two nginx hops"},"3579":{"id":"/observability-89","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#four-places-a-panel-goes-empty","content":"`hermes`"},"3580":{"id":"/observability-90","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#four-places-a-panel-goes-empty","content":"the three Infisical containers (`infisical`, `infisical-db`, `infisical-redis`)"},"3581":{"id":"/observability-91","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#four-places-a-panel-goes-empty","content":"Ollama is the one operators ask about: upstream has had the request for a `/metrics`\nendpoint open since 2024 (ollama/ollama#3144), and the IPEX-LLM image runs a stock\n`ollama serve`, so there is nothing to scrape."},"3582":{"id":"/observability-92","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#four-places-a-panel-goes-empty","content":"Its traffic is measured anyway, because every request reaches it through LiteLLM,\nwhich does publish. What every one of those containers does contribute is its log\nstream, which is where a SearXNG rate limit or a Kasm start failure lands."},"3583":{"id":"/observability-93","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#four-places-a-panel-goes-empty","content":"**Mimir is written to, not scraped from.** Prometheus `remote_write`s to\n`http://mimir:8080/api/v1/push`. A query against the `prometheus` datasource answers\nfrom the local TSDB; the `mimir` datasource answers through\n`http://mimir:8080/prometheus`. Those two disagreeing is the diagnostic, not a bug."},"3584":{"id":"/observability-94","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#four-places-a-panel-goes-empty","content":"**Alloy, not Loki, reads the disk.** Loki has no Docker credential and no host mount.\nThe only container that sees the host's container log directory is Alloy, and it sees\nit read-only. That directory is `${STACK_DOCKER_LOG_DIR:-/var/lib/docker/containers}`,\nmounted at the same path inside the collector, so a host whose daemon keeps its logs\nsomewhere else (rootless Docker does) needs that key set or the collector tails\nnothing."},"3585":{"id":"/observability-95","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#four-places-a-panel-goes-empty","content":"**Traces arrive over OTLP only, and one client already speaks it.** Anything that wants\ntraces in this stack sends OTLP gRPC to `tempo:4317`. Grafana is the one shipped\ncaller: `GF_TRACING_ENABLED` points its own exporter at `tempo:4317`, so the trace\nviewer has the product's own spans before any workspace emits one."},"3586":{"id":"/observability-96","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#four-places-a-panel-goes-empty","content":"Tempo's metrics_generator then computes span-metrics and service-graph series and\n`remote_write`s them back into Prometheus, which is why Prometheus carries\n`--web.enable-remote-write-receiver`: without that flag the write is refused with a 404\nand the traces dashboard has nothing to plot."},"3587":{"id":"/observability-97","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-four-fixed-datasource-uids","content":"Grafana's four datasources carry fixed UIDs - `prometheus` (the default), `mimir`,\n`loki`, `tempo` - and every shipped dashboard references those UIDs, so renaming one in\nthe UI breaks the dashboards that were provisioned against it."},"3588":{"id":"/observability-98","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#who-evaluates-and-who-delivers","content":"Rules are evaluated by Prometheus and delivered by Alertmanager: the `alerting:` block at\n`observability/prometheus/prometheus.yml:52` names `alertmanager:9093`, so grouping,\ninhibition, silences and the repeat interval all belong to that one service."},"3589":{"id":"/observability-99","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#who-evaluates-and-who-delivers","content":"| Rule file                                        | Recording-rule prefix                                      | Alerts               | Critical                                                                                                        |\n| ------------------------------------------------ | ---------------------------------------------------------- | -------------------- | --------------------------------------------------------------------------------------------------------------- |\n| `observability/prometheus/rules/stack.rules.yml` | `host:` (one `container:` for the cAdvisor throttle ratio) | 9, all `tier=\"host\"` | `HostCpuPegged`, `HostMemoryNearExhaustion`, `HostFilesystemNearFull`, `HostNodeExporterGap`, `HostCadvisorGap` |","table":"table-1"},"3590":{"id":"/observability-100","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#who-evaluates-and-who-delivers","content":"| Rule file                                        | Recording-rule prefix | Alerts                                                    | Critical                                                                                   |\n| ------------------------------------------------ | --------------------- | --------------------------------------------------------- | ------------------------------------------------------------------------------------------ |\n| `observability/prometheus/rules/spark.rules.yml` | `spark:`              | 7, all `tier=\"spark\"` and each stamped `spark=<hostname>` | `SparkDown`, `SparkGpuRowRemapFailure`, `SparkGpuEccUncorrectable`, `SparkGpuSeriesSilent` |","table":"table-1"},"3591":{"id":"/observability-101","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#who-evaluates-and-who-delivers","content":"| Rule file                                            | Recording-rule prefix | Alerts                     | Critical                                                                                                                                                      |\n| ---------------------------------------------------- | --------------------- | -------------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `observability/prometheus/rules/inference.rules.yml` | `litellm:`            | 10, all `tier=\"inference\"` | `LiteLLMModelErrorRatioSustained`, `LiteLLMDeploymentUnhealthy`, `LiteLLMDeploymentCoolingDownRepeatedly`, `LiteLLMBackendSeriesGone`, `LiteLLMMetricsAbsent` |","table":"table-1"},"3592":{"id":"/observability-102","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#four-things-to-know-before-editing-the-wiring","content":"Four things about that wiring are worth knowing before you edit it:"},"3593":{"id":"/observability-103","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#four-things-to-know-before-editing-the-wiring","content":"**The gap alerts select on the job name.** `HostNodeExporterGap` and `HostCadvisorGap`\nfire when `job=\"node_exporter\"` or `job=\"cadvisor\"` carries no series, which is why the\njob name is the Compose service name (`observability/prometheus/prometheus.yml:142` and\n`:151`). Renaming either service without renaming its job makes two alerts permanently\nquiet, and no test will tell you."},"3594":{"id":"/observability-104","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#four-things-to-know-before-editing-the-wiring","content":"**The Spark tier is quiet until the boxes are enrolled.** Those two jobs read their\ntargets from `observability/spark-targets/sparks.json` through `file_sd_configs`, a file\nthe stack host generates and `.gitignore:76` keeps out of git. No file means no target\ngroups, which reads as zero Sparks rather than as a broken probe. The boxes' own\nnode_exporter and DCGM exporter are installed on the boxes by `scripts/spark-monitor.sh`,\nnot by this Compose file."},"3595":{"id":"/observability-105","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#four-things-to-know-before-editing-the-wiring","content":"**Grafana lists the rules because the datasource says to.** The Prometheus datasource is\nregistered `alerting: true` (`observability/grafana/provisioning/datasources/stack.yaml:26`);\nwithout that flag the rules answer only on Prometheus' own `/alerts` page and never\nappear under Alerting -> Rules. Delivery still belongs to Alertmanager."},"3596":{"id":"/observability-106","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#four-things-to-know-before-editing-the-wiring","content":"**An alert a person builds in Grafana goes to the same Alertmanager.** The provisioned\ncontact point is `type: alertmanager` at `http://alertmanager:9093`\n(`observability/grafana/provisioning/alerting/stack.yaml:28`), not a webhook, so it\nspeaks `/api/v2/alerts` and Alertmanager's grouping, inhibition and silences apply to\nGrafana-originated alerts exactly as they do to Prometheus'. One place holds the\nsilences, whichever engine fired."},"3597":{"id":"/observability-107","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-webhook-destination-is-empty-as-shipped","content":"Nothing leaves the box until the operator says who to tell."},"3598":{"id":"/observability-108","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-webhook-destination-is-empty-as-shipped","content":"Alertmanager's own config parser cannot expand an environment variable inside a webhook\nURL, so `observability/alertmanager/alertmanager.yml` carries no URL at all: all four\nwebhook receivers read `url_file: /alertmanager/webhook_url`."},"3599":{"id":"/observability-109","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-webhook-destination-is-empty-as-shipped","content":"That file is written at container start by the image's entrypoint,\n`observability/alertmanager/boot-webhook-url.sh`, from the `ALERTMANAGER_WEBHOOK_URL` key\n(`.env.example:635`, empty as shipped), and the script then `exec`s the binary."},"3600":{"id":"/observability-110","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-webhook-destination-is-empty-as-shipped","content":"An empty key is a working configuration: the container starts, the rules fire, the\nreceivers are no-ops, and the entrypoint regenerates the file every start so a removed\nkey cannot survive as a stale destination on disk."},"3601":{"id":"/observability-111","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-webhook-destination-is-empty-as-shipped","content":"The Alertmanager UI is loopback-bound for the same reason it has no auth - it can silence\nalerts - so read it from a shell on the stack host, or use Grafana's Alerting pages,\nwhich need no extra port."},"3602":{"id":"/observability-112","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-flag","content":"One key decides whether the bundle exists: `OBSERVABILITY_ENABLED`, default `true`, in\n`.env.example` and `.env.sample` beside it."},"3603":{"id":"/observability-113","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-flag","content":"All ten services carry `profiles: [\"observability\"]`, and `compose_observability_args()`\nin `scripts/lib/common.sh` is the single place that reads the key - it prints\n`--profile observability` when the value is truthy and nothing for `false`, `0`, `no` or\n`off`."},"3604":{"id":"/observability-114","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-flag","content":"Every stack runner goes through it:"},"3605":{"id":"/observability-115","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-flag","content":"`dev-stack.sh` and `prod-stack.sh` in their `compose_prefix()` and `run_compose()`"},"3606":{"id":"/observability-116","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-flag","content":"`update-stack.sh` in `stack_compose()`"},"3607":{"id":"/observability-117","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#turning-the-bundle-off","content":"To turn the bundle off, set the key in the env file that belongs to that project -\n`.env` for the stable stack, `dev-stack.env` for the dev one - and bring the stack up:"},"3608":{"id":"/observability-118","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#turning-the-bundle-off","content":"A profile decides which services a command *selects*; it does not delete what is already\nrunning. The ten containers stay up until you stop them, so after flipping the key off\neither take the project down (`bazelisk run //scripts:prod-stack -- down`) or delete the\nten by name through compose."},"3609":{"id":"/observability-119","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#turning-the-bundle-off","content":"Their named volumes survive either way, and `reset` is the one that destroys them."},"3610":{"id":"/observability-120","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#both-flag-paths-are-gated","content":"Both flag paths are gated: `bazelisk run //scripts:validate` runs\n`docker compose config -q` twice, once plain and once with `--profile observability`, so\na compose file that only parses with the bundle on (or only with it off) fails the build\nrather than the deploy."},"3611":{"id":"/observability-121","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-payload-directory","content":"The bundle's payloads are one directory of their own, bind-mounted read-only, so\n`git diff` is the record of every monitoring change and nothing is edited in the running\ncontainer:"},"3612":{"id":"/observability-122","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-payload-directory","content":"| Path                                      | Read by                                                                                                                                   |\n| ----------------------------------------- | ----------------------------------------------------------------------------------------------------------------------------------------- |\n| `observability/prometheus/prometheus.yml` | Prometheus: the fourteen scrape jobs, the `alerting:` block that names Alertmanager, the three `rule_files:` and the Mimir `remote_write` |","table":"table-2"},"3613":{"id":"/observability-123","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-payload-directory","content":"| Path                          | Read by |\n| ----------------------------- | ------- |\n| `observability/loki/loki.yml` | Loki    |","table":"table-2"},"3614":{"id":"/observability-124","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-payload-directory","content":"| Path                            | Read by |\n| ------------------------------- | ------- |\n| `observability/tempo/tempo.yml` | Tempo   |","table":"table-2"},"3615":{"id":"/observability-125","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-payload-directory","content":"| Path                            | Read by                                                                   |\n| ------------------------------- | ------------------------------------------------------------------------- |\n| `observability/mimir/mimir.yml` | Mimir, including `multitenancy_enabled: false` - see the query path below |","table":"table-2"},"3616":{"id":"/observability-126","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-payload-directory","content":"| Path                                                        | Read by                                   |\n| ----------------------------------------------------------- | ----------------------------------------- |\n| `observability/grafana/provisioning/datasources/stack.yaml` | The four datasources and their fixed UIDs |","table":"table-2"},"3617":{"id":"/observability-127","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-payload-directory","content":"| Path                                                       | Read by                                                                                                   |\n| ---------------------------------------------------------- | --------------------------------------------------------------------------------------------------------- |\n| `observability/grafana/provisioning/dashboards/stack.yaml` | The provider that loads the JSON below: folder `EVO-T1`, `allowUiUpdates: false`, `disableDeletion: true` |","table":"table-2"},"3618":{"id":"/observability-128","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-payload-directory","content":"| Path                                | Read by                                                                                                                                                                                                            |\n| ----------------------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `observability/grafana/dashboards/` | The thirteen provisioned dashboard JSONs - the section below names each one and what it answers - mounted again at `/var/lib/grafana/dashboards` (`docker-compose.yml:1049`), which is the path the provider reads |","table":"table-2"},"3619":{"id":"/observability-129","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-payload-directory","content":"| Path                                                  | Read by                                                                                                                                                                                                                                     |\n| ----------------------------------------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `observability/grafana/unified-storage/overrides.yml` | Grafana's unified-storage quota overrides, mounted read-only at `/etc/grafana/stack-overrides.yml` and named there by `GF_UNIFIED_STORAGE_OVERRIDES_PATH` (`docker-compose.yml:1035`, `:1055`) - the note below says what its presence buys |","table":"table-2"},"3620":{"id":"/observability-130","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-payload-directory","content":"| Path                               | Read by                                                     |\n| ---------------------------------- | ----------------------------------------------------------- |\n| `observability/alloy/config.alloy` | The log pipeline: which files to tail, what to ship to Loki |","table":"table-2"},"3621":{"id":"/observability-131","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-payload-directory","content":"| Path                              | Read by                                                                                                                                                                                                             |\n| --------------------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `observability/prometheus/rules/` | Prometheus, through that `rule_files:` block: `stack.rules.yml`, `spark.rules.yml`, `inference.rules.yml`. They arrive with the directory this file is mounted from, so there is no second place to register a rule |","table":"table-2"},"3622":{"id":"/observability-132","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-payload-directory","content":"| Path                                          | Read by                                                                                                                  |\n| --------------------------------------------- | ------------------------------------------------------------------------------------------------------------------------ |\n| `observability/alertmanager/alertmanager.yml` | Alertmanager: the `tier` routes, three inhibit rules, and five receivers (four webhook, one blackhole for the heartbeat) |","table":"table-2"},"3623":{"id":"/observability-133","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-payload-directory","content":"| Path                                             | Read by                                                                                                                  |\n| ------------------------------------------------ | ------------------------------------------------------------------------------------------------------------------------ |\n| `observability/alertmanager/boot-webhook-url.sh` | The container's `entrypoint:`: writes `/alertmanager/webhook_url` from `ALERTMANAGER_WEBHOOK_URL`, then execs the binary |","table":"table-2"},"3624":{"id":"/observability-134","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-payload-directory","content":"| Path                                  | Read by                                                                                                      |\n| ------------------------------------- | ------------------------------------------------------------------------------------------------------------ |\n| `observability/blackbox/blackbox.yml` | blackbox_exporter: the two HTTP probe modules the Spark jobs pass by name, `spark_health` and `spark_models` |","table":"table-2"},"3625":{"id":"/observability-135","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-payload-directory","content":"| Path                                                     | Read by                                                                      |\n| -------------------------------------------------------- | ---------------------------------------------------------------------------- |\n| `observability/grafana/provisioning/alerting/stack.yaml` | The `stack-alertmanager` contact point and Grafana's default alerting policy |","table":"table-2"},"3626":{"id":"/observability-136","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#what-the-read-only-mounts-mean","content":"Two consequences of the `:ro` mounts, both the same rule the other payload directories\nfollow:"},"3627":{"id":"/observability-137","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#what-the-read-only-mounts-mean","content":"A bind follows the *path*, so an edit made in the checkout is already inside the\nrunning container, and the only question left is when the process reads it again"},"3628":{"id":"/observability-138","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#what-the-read-only-mounts-mean","content":"These are directory binds, so measured against the pinned image an in-place rewrite\nof a mounted file and a rename of a new one over it both reached the container with no\nrestart and no recreate, which is why the dashboards section below can promise a minute\nrather than a redeploy"},"3629":{"id":"/observability-139","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#what-the-read-only-mounts-mean","content":"The one credential that behaves differently is the LiteLLM bearer token, and the reason\nis that it is not a bind - Compose writes a `configs` entry when it creates the\ncontainer, so rotating `LITELLM_MASTER_KEY` takes `up -d --force-recreate prometheus`,\nwhere a plain `up -d` leaves the old bytes in place, and so does a `restart`."},"3630":{"id":"/observability-140","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#what-the-read-only-mounts-mean","content":"And treat the provisioned dashboards and datasources as read-only in the UI:\n`allowUiUpdates: false` and `disableDeletion: true` stop a save from overwriting the\nJSON, so anything you build by hand lands in Grafana's own database in `grafana-data`\ninstead - it works, and it drifts from git invisibly."},"3631":{"id":"/observability-141","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-two-grafana-environment-settings","content":"The `grafana` service carries two settings that live in its `environment:` block\n(`docker-compose.yml:1034-1035`) rather than in any file above, each one there to quiet a\nGrafana 13.3.1 defect this box pays for as log noise."},"3632":{"id":"/observability-142","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-search-manifest-watcher-filter","content":"`GF_LOG_FILTERS: search-manifest-watcher:error` drops that one logger to `error` and\nleaves every other logger at its default."},"3633":{"id":"/observability-143","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-search-manifest-watcher-filter","content":"The watcher warns twice each poll, and the polls in the log this branch was cut from were\n41 to 59 s apart - `source listed zero manifests`, then\n`zero manifests, keeping previous set` - whenever no app publishes a search manifest,\nwhich is every OSS install with nothing provisioned into the app platform; upstream calls\nthat a logging defect (grafana/grafana#137058) and confirms search keeps working, because\nretrying an empty source is intended and only the level is wrong."},"3634":{"id":"/observability-144","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-search-manifest-watcher-filter","content":"The filter is a workaround for that defect, not a preference: it comes out when the pin\nmoves to a release carrying the fix, and the pin today is `grafana/grafana:13.3.1`\n(`docker-compose.yml:976`)."},"3635":{"id":"/observability-145","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-unified-storage-overrides-file","content":"`GF_UNIFIED_STORAGE_OVERRIDES_PATH: /etc/grafana/stack-overrides.yml`\npoints the unified-storage resource server at the file the table names: without it the\nquota lookup the browse view fires on every dashboard page answers 501, since that\nserver's quota service is nil with nothing pointed at it (grafana/grafana#136271), and the\nbox prints one error line per page load while the browser console fills with 501s; with it\nthe same call answers 200."},"3636":{"id":"/observability-146","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-unified-storage-overrides-file","content":"Both halves were measured on `grafana/grafana:13.3.1` as two containers differing only in\nthat variable: the one without the file answered 501 for both\n`dashboard.grafana.app/dashboards` and `folder.grafana.app/folders` and the one with it\nanswered 200 for both, with `/api/health` 200 either way."},"3637":{"id":"/observability-147","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-unified-storage-overrides-file","content":"On the filter side, over one 300-second window the unfiltered container wrote 16\n`search-manifest-watcher` lines, all `level=warn`, and the filtered one wrote none from\nthat logger - the only line in it that still names it is Grafana's own `level=info` record\nthat the setting came from the environment."},"3638":{"id":"/observability-148","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-unified-storage-overrides-file","content":"The overrides file itself says `overrides: {}`, which is Grafana's own defaults - it is\nthe file's presence that clears the 501, not any limit set in it."},"3639":{"id":"/observability-149","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-unified-storage-overrides-file","content":"What the quota call then reports is that default, `{\"usage\":0,\"limit\":1000}` for\ndashboards and for folders on 13.3.1; four plausible cap shapes left the number where it\nwas, and a scalar or an unparseable document under `overrides:` stops the container at\nboot, so the file's header asks for a limit to be proven on the pinned image before it is\nwritten down."},"3640":{"id":"/observability-150","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-litellm-board-is-the-credential-dependent-one","content":"The thirteen dashboards are provisioned, so they appear on a fresh Grafana in the\n`EVO-T1` folder with no clicking - the section below names each one and the question it\nanswers."},"3641":{"id":"/observability-151","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-litellm-board-is-the-credential-dependent-one","content":"The LiteLLM board is the one that depends on a credential: its metrics sit behind\n`LITELLM_MASTER_KEY` like every other LiteLLM route, and the bearer Prometheus presents is\nthe file Compose rendered from that key, so anything that puts the two ends out of step -\na key rotated in the env file with `prometheus` never recreated, a token file that is\nmissing or wrong - leaves every panel on that board reading empty while the others stay\nfull."},"3642":{"id":"/observability-152","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-dashboards","content":"Thirteen JSON files in `observability/grafana/dashboards/` are the only dashboards this\nstack ships. `observability/grafana/provisioning/dashboards/stack.yaml:11` loads them all\ninto one `EVO-T1` folder (`:14`) with `disableDeletion: true` (`:16`),\n`updateIntervalSeconds: 60` (`:17`) and `allowUiUpdates: false` (`:18`)."},"3643":{"id":"/observability-153","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-dashboards","content":"Read those three values before you try to fix a panel. Then find your question in the\ntables below: every page name and every panel name quoted here is copied out of the JSON,\nso you can search the UI for it. Panel counts include the panels a collapsed row holds."},"3644":{"id":"/observability-154","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#which-page-answers-which-question","content":"The stack host - the box the bundle itself runs on:"},"3645":{"id":"/observability-155","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#which-page-answers-which-question","content":"| Question                                                                                                                                                                                                                                     | Page                    | UID                    | Panels |\n| -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | ----------------------- | ---------------------- | ------ |\n| What is the box doing as a machine: per-core CPU, load, the PSI pressure stats, memory and swap, IOPS and throughput per device, `Space and inode headroom per mount`, dropped packets, conntrack, file descriptors, `Top containers by CPU` | Stack host task manager | `evo-host-taskmanager` | 36     |","table":"table-3"},"3646":{"id":"/observability-156","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#which-page-answers-which-question","content":"| Question                                                                                                                                                                                     | Page       | UID              | Panels |\n| -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | ---------- | ---------------- | ------ |\n| Which container is at fault: `CPU usage against CFS throttling`, `Memory working set against its limit`, `OOM kills`, `Uptime since last start`, `Reported containers and how stale each is` | Containers | `evo-containers` | 12     |","table":"table-3"},"3647":{"id":"/observability-157","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#which-page-answers-which-question","content":"The DGX Sparks - the off-stack boxes Prometheus probes through blackbox:"},"3648":{"id":"/observability-158","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#which-page-answers-which-question","content":"| Question                                                                                                                                            | Page                | UID                   | Panels |\n| --------------------------------------------------------------------------------------------------------------------------------------------------- | ------------------- | --------------------- | ------ |\n| Which box needs looking at: one repeated stat strip per enrolled box, then `Every Spark, one row per box` and `Serving request rate, by deployment` | DGX Sparks overview | `evo-sparks-overview` | 11     |","table":"table-4"},"3649":{"id":"/observability-159","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#which-page-answers-which-question","content":"| Question                                                                                                                                                                                                                                                                        | Page          | UID              | Panels |\n| ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | ------------- | ---------------- | ------ |\n| Everything about the one box you have picked: the host rows, the GPU rows (`GPU utilisation`, `Framebuffer used and free`, `GPU and memory temperature against the slowdown point`, `ECC row remaps in the last hour`), the blackbox probe rows, and that box's own deployments | One DGX Spark | `evo-spark-host` | 41     |","table":"table-4"},"3650":{"id":"/observability-160","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#which-page-answers-which-question","content":"| Question                                                                                                                                                                                                               | Page            | UID                | Panels |\n| ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | --------------- | ------------------ | ------ |\n| The fleet as one number: `Total GPU utilisation`, `Total GPU power draw`, `Hottest GPU core`, `Fullest framebuffer`, `Uncorrectable ECC rows, last hour`, the per-box comparison tables, and the fleet admission queue | DGX Spark fleet | `evo-sparks-fleet` | 15     |","table":"table-4"},"3651":{"id":"/observability-161","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#which-page-answers-which-question","content":"The inference backends - the software that serves the models, not the machines it runs\non, which are two rows above:"},"3652":{"id":"/observability-162","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#which-page-answers-which-question","content":"| Question                                                                                                                                                                                                                     | Page   | UID                    | Panels |\n| ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | ------ | ---------------------- | ------ |\n| What callers see, per model: `Request rate by model`, `Error ratio by model, 4xx vs 5xx`, the three latency panels, `Time to first token by model (p50/p95/p99)`, `Cache hit ratio`, `Served models, one row per deployment` | Models | `evo-inference-models` | 24     |","table":"table-5"},"3653":{"id":"/observability-163","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#which-page-answers-which-question","content":"| Question                                                                                                                                                                                                                                                                                           | Page               | UID                      | Panels |\n| -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | ------------------ | ------------------------ | ------ |\n| What the router is doing, per deployment: `Deployment inventory and state`, `Backends off the healthy state`, `Cooldown transitions per deployment`, `Admission rejections by reason`, `Balance per deployment`, `Aliases served per deployment`, `Upstream p95 against total p95, per deployment` | Inference backends | `evo-inference-backends` | 24     |","table":"table-5"},"3654":{"id":"/observability-164","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#which-page-answers-which-question","content":"The bundle itself:"},"3655":{"id":"/observability-165","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#which-page-answers-which-question","content":"| Question                                                                                                                                                               | Page         | UID        | Panels |\n| ---------------------------------------------------------------------------------------------------------------------------------------------------------------------- | ------------ | ---------- | ------ |\n| Start here: the `EVO-T1 dashboards` list and one link panel per board, then a stat per bundle service beside `Targets up`, `Targets configured` and `Scrape freshness` | EVO-T1 stack | `evo-home` | 33     |","table":"table-6"},"3656":{"id":"/observability-166","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#which-page-answers-which-question","content":"| Question                                                                                                                                                                                                                                                          | Page           | UID                  | Panels |\n| ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | -------------- | -------------------- | ------ |\n| Is the monitoring still working: `Scrape targets up`, `Prometheus TSDB on disk`, `Remote write to Mimir`, and one reporting-stat per exporter and per bundle process, each reading `0` while that process answers its scrape and `1` when it has no series at all | Stack overview | `evo-stack-overview` | 28     |","table":"table-6"},"3657":{"id":"/observability-167","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#which-page-answers-which-question","content":"| Question                                                                                                                                                                      | Page   | UID          | Panels |\n| ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | ------ | ------------ | ------ |\n| What is firing and did it get out: `Firing alerts`, the three severity counts, `Firing series by alert`, `Alertmanager intake`, `Notifications dropped`, `Slowest rule group` | Alerts | `evo-alerts` | 16     |","table":"table-6"},"3658":{"id":"/observability-168","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#which-page-answers-which-question","content":"| Question                                                                   | Page           | UID              | Panels |\n| -------------------------------------------------------------------------- | -------------- | ---------------- | ------ |\n| What did a container say: `Log volume`, `stdout and stderr`, `Errors only` | Container logs | `evo-stack-logs` | 3      |","table":"table-6"},"3659":{"id":"/observability-169","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#which-page-answers-which-question","content":"| Question                                                                                                  | Page                   | UID                | Panels |\n| --------------------------------------------------------------------------------------------------------- | ---------------------- | ------------------ | ------ |\n| Where did a request spend its time: `Span rate by service`, `Span latency, p95 by service`, `Span errors` | Traces and service map | `evo-stack-traces` | 4      |","table":"table-6"},"3660":{"id":"/observability-170","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#which-page-answers-which-question","content":"| Question                                                                                                                                                                          | Page | UID           | Panels |\n| --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | ---- | ------------- | ------ |\n| What did the proxy cost and do: `Spend in the selected range`, `Spend per model, selected range`, `Requests by status code`, `Deployment state`, `Cooldown events per deployment` |      | `evo-litellm` | 17     |","table":"table-6"},"3661":{"id":"/observability-171","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#which-page-answers-which-question","content":"Four of those carry a `How to read this page` text panel - `evo-alerts`,\n`evo-inference-models`, `evo-litellm` and `evo-stack-traces` - and it is worth reading\nbefore you chase a flat line on one of them."},"3662":{"id":"/observability-172","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#how-the-sparks-pages-reach-one-machine","content":"`evo-sparks-overview` and `evo-spark-host` each declare a `host` templating variable, both\nof them a `query` variable whose query is `label_values(spark:box_up, hostname)`, so the\ndropdown lists the boxes Prometheus actually sees and nothing else. On `evo-spark-host` the\nvariable is labelled `Spark` and every panel on the page filters to whatever it holds."},"3663":{"id":"/observability-173","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#how-the-sparks-pages-reach-one-machine","content":"The overview does not ask you to choose first. Seven stat panels each carry `repeat` on\nthat same variable with `repeatDirection: h`, so the strip renders one column per enrolled\nbox:"},"3664":{"id":"/observability-174","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#how-the-sparks-pages-reach-one-machine","content":"`Spark $host`"},"3665":{"id":"/observability-175","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#how-the-sparks-pages-reach-one-machine","content":"`GPU util`"},"3666":{"id":"/observability-176","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#how-the-sparks-pages-reach-one-machine","content":"`Framebuffer fill`"},"3667":{"id":"/observability-177","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#how-the-sparks-pages-reach-one-machine","content":"`Temp headroom`"},"3668":{"id":"/observability-178","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#how-the-sparks-pages-reach-one-machine","content":"`Power`"},"3669":{"id":"/observability-179","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#how-the-sparks-pages-reach-one-machine","content":"`CPU`"},"3670":{"id":"/observability-180","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#how-the-sparks-pages-reach-one-machine","content":"`Memory`"},"3671":{"id":"/observability-181","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#how-the-sparks-pages-reach-one-machine","content":"The link panel `Open this Spark` repeats alongside them and points at\n`/d/evo-spark-host/one-dgx-spark?var-host=${var:queryparam}`: the tile under the box you\nare reading opens that box's page with `host` already set. That is the path from a red tile\non the overview to the GPU rows for that machine, and it is the only link between the two\nboards."},"3672":{"id":"/observability-182","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#how-the-sparks-pages-reach-one-machine","content":"`evo-sparks-fleet` declares no variable at all, because it aggregates across every box by\ndesign."},"3673":{"id":"/observability-183","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#a-dashboard-is-a-committed-file","content":"The provider owns the `EVO-T1` folder, so nothing you do in the browser to a shipped panel\nsurvives: `allowUiUpdates: false` refuses the save, `disableDeletion: true` refuses the\ndelete, and the 60-second poll quietly undoes whatever the UI let you stage."},"3674":{"id":"/observability-184","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#a-dashboard-is-a-committed-file","content":"A board you build from scratch is not thrown away - it lands in Grafana's own database on\n`grafana-data` - but it is invisible to git and to the gate below, which is the same drift\nthe `:ro` mounts above exist to prevent."},"3675":{"id":"/observability-185","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#a-dashboard-is-a-committed-file","content":"So the way to change a panel is to edit its JSON and let the interval apply it. The folder\nis bind-mounted read-only onto the path the provider scans (`docker-compose.yml:1049`), so\nan edit to a file that is already there is visible to the running container and shows up\nwithin a minute - no restart, and no recreate. A new file needs no registration either, for\nthe same reason."},"3676":{"id":"/observability-186","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#a-dashboard-is-a-committed-file","content":"Recreate only when the mount line or the provisioning tree itself changed\n(`docker-compose.yml:1047-1048`), and then with the `up -d` rule from the section above:"},"3677":{"id":"/observability-187","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-gate","content":"The folder is source, so it is tested as source:"},"3678":{"id":"/observability-188","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-gate","content":"`tests/bats/observability-dashboards.bats` asserts seventeen properties over every file in\nit:"},"3679":{"id":"/observability-189","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-gate","content":"the folder is non-empty and each file parses with the repo's own parser"},"3680":{"id":"/observability-190","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-gate","content":"each is pure ASCII, LF-only, one trailing newline"},"3681":{"id":"/observability-191","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-gate","content":"the pinned top-level keys and house values are present"},"3682":{"id":"/observability-192","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-gate","content":"UIDs and titles are unique across the folder"},"3683":{"id":"/observability-193","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-gate","content":"panel ids are unique integers"},"3684":{"id":"/observability-194","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-gate","content":"every panel carries a full `gridPos` and no two visible panels overlap"},"3685":{"id":"/observability-195","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-gate","content":"every panel stays inside the house key set"},"3686":{"id":"/observability-196","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-gate","content":"every target opens with `refId` and carries its own datasource"},"3687":{"id":"/observability-197","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-gate","content":"every datasource is one of the four provisioned UIDs"},"3688":{"id":"/observability-198","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-gate","content":"every querying panel carries a `description`"},"3689":{"id":"/observability-199","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-gate","content":"every stat states its own empty reading rather than leaving it to Grafana"},"3690":{"id":"/observability-200","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-gate","content":"every referenced variable is declared"},"3691":{"id":"/observability-201","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-gate","content":"every templating variable is well formed"},"3692":{"id":"/observability-202","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-gate","content":"every link names a dashboard that exists in the folder"},"3693":{"id":"/observability-203","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-gate","content":"every UID besides `evo-home` is named by a link panel or a `links:` entry there"},"3694":{"id":"/observability-204","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-gate","content":"no file carries an import block, a host name, or a dead metric shape"},"3695":{"id":"/observability-205","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-metric-allow-list","content":"The one to read before you write an `expr`: every metric name in every `expr` has to sit on\na pinned allow-list, and that list is assembled at test time from the recording rules this\nrepo ships under `observability/prometheus/rules/` as well as the pinned names\n(`tests/bats/observability-dashboards.bats:688`)."},"3696":{"id":"/observability-206","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-metric-allow-list","content":"A new recording rule therefore needs no test edit, and a metric nothing here records fails\nthe build instead of rendering an empty tile."},"3697":{"id":"/observability-207","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-coarser-gate","content":"`bazelisk run //scripts:validate` covers the coarser layer: it parses every dashboard JSON\nthrough `scripts/lib/parse_json.py` (`scripts/validate.sh:104`), the gate that already\ncovers the three rule files."},"3698":{"id":"/observability-208","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-coarser-gate","content":"Nothing in this section has been rendered in a live Grafana from this checkout: the pages\nare proven by that structure and by metric names a source in this repo backs, not by\npixels."},"3699":{"id":"/observability-209","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#what-each-component-keeps","content":"Everything lands on named volumes under Docker's volume root on the host disk. Nothing\nhere reaches an object store, so the caps are what protect that disk:"},"3700":{"id":"/observability-210","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#what-each-component-keeps","content":"| Component  | Cap (env key, default)                                                                       | Volume -> container path           |\n| ---------- | -------------------------------------------------------------------------------------------- | ---------------------------------- |\n| Prometheus | `PROMETHEUS_RETENTION_TIME` (15d), `PROMETHEUS_RETENTION_SIZE` (10GB) - whichever hits first | `prometheus-data` -> `/prometheus` |","table":"table-7"},"3701":{"id":"/observability-211","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#what-each-component-keeps","content":"| Component | Cap (env key, default)                    | Volume -> container path      |\n| --------- | ----------------------------------------- | ----------------------------- |\n| Mimir     | `MIMIR_RETENTION_PERIOD` (2160h, 90 days) | `mimir-data` -> `/data/mimir` |","table":"table-7"},"3702":{"id":"/observability-212","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#what-each-component-keeps","content":"| Component | Cap (env key, default)                 | Volume -> container path |\n| --------- | -------------------------------------- | ------------------------ |\n| Loki      | `LOKI_RETENTION_PERIOD` (168h, 7 days) | `loki-data` -> `/loki`   |","table":"table-7"},"3703":{"id":"/observability-213","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#what-each-component-keeps","content":"| Component | Cap (env key, default)                                                                  | Volume -> container path     |\n| --------- | --------------------------------------------------------------------------------------- | ---------------------------- |\n| Tempo     | `TEMPO_BLOCK_RETENTION_TIME` (168h), applied by the backend-scheduler's compaction work | `tempo-data` -> `/var/tempo` |","table":"table-7"},"3704":{"id":"/observability-214","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#what-each-component-keeps","content":"| Component | Cap (env key, default)       | Volume -> container path             |\n| --------- | ---------------------------- | ------------------------------------ |\n| Grafana   | n/a (dashboards, not series) | `grafana-data` -> `/var/lib/grafana` |","table":"table-7"},"3705":{"id":"/observability-215","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#what-each-component-keeps","content":"| Component | Cap (env key, default)                                      | Volume -> container path              |\n| --------- | ----------------------------------------------------------- | ------------------------------------- |\n| Alloy     | none shipped; it keeps its own state under `--storage.path` | `alloy-data` -> `/var/lib/alloy/data` |","table":"table-7"},"3706":{"id":"/observability-216","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#what-each-component-keeps","content":"| Component    | Cap (env key, default)                                     | Volume -> container path               |\n| ------------ | ---------------------------------------------------------- | -------------------------------------- |\n| Alertmanager | none; it keeps silences and notification state, not series | `alertmanager-data` -> `/alertmanager` |","table":"table-7"},"3707":{"id":"/observability-217","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#what-each-component-keeps","content":"The four exporters keep nothing between runs: what they hold is a scrape interval deep, so\nrecreating one costs no history and needs no volume of its own."},"3708":{"id":"/observability-218","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#changing-a-cap","content":"Change a cap in the env file and recreate. The Prometheus size cap is the one that\nactually bounds the box: it is the only figure that does not depend on how fast the\nseries arrive."},"3709":{"id":"/observability-219","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#changing-a-cap","content":"Tempo's cap is the odd one, because Tempo 3.x moved it out of the config file - it reaches\nthe container as `-backend-scheduler.provider.work.compaction.block-retention`\non the command line in docker-compose.yml, so editing tempo.yml for it changes nothing."},"3710":{"id":"/observability-220","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#changing-a-cap","content":"`bazelisk run //scripts:storage-clean` is the interactive janitor for the persistent\nlayer if a volume outgrows what you meant it to hold."},"3711":{"id":"/observability-221","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#reaching-the-uis","content":"| What    | Where                                                                                                  | Notes                                                                                                                                                          |\n| ------- | ------------------------------------------------------------------------------------------------------ | -------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| Grafana | `http://<lan>:3005` (`GRAFANA_PORT`), and `grafana-<suffix>.<base>` when `STACK_PUBLIC_HOSTS` names it | The only published name in the bundle. Login is `GRAFANA_ADMIN_USER` / `GRAFANA_ADMIN_PASSWORD` from `.env`; anonymous access and analytics reporting are off. |","table":"table-8"},"3712":{"id":"/observability-222","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#reaching-the-uis","content":"| What       | Where                                       | Notes                                                                        |\n| ---------- | ------------------------------------------- | ---------------------------------------------------------------------------- |\n| Prometheus | `http://127.0.0.1:9090` (`PROMETHEUS_PORT`) | `:2112` metrics port. Reading a graph there needs a shell on the stack host. |","table":"table-8"},"3713":{"id":"/observability-223","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#reaching-the-uis","content":"| What  | Where                                                   | Notes                                          |\n| ----- | ------------------------------------------------------- | ---------------------------------------------- |\n| Mimir | nothing published - `mimir:8080` on the compose network | Reach it through Grafana's `mimir` datasource. |","table":"table-8"},"3714":{"id":"/observability-224","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#reaching-the-uis","content":"| What | Where                           | Notes                             |\n| ---- | ------------------------------- | --------------------------------- |\n| Loki | nothing published - `loki:3100` | Reach it through Grafana Explore. |","table":"table-8"},"3715":{"id":"/observability-225","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#reaching-the-uis","content":"| What  | Where                                                     | Notes                             |\n| ----- | --------------------------------------------------------- | --------------------------------- |\n| Tempo | nothing published - `tempo:3200` query, `tempo:4317` OTLP | Reach it through Grafana Explore. |","table":"table-8"},"3716":{"id":"/observability-226","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#reaching-the-uis","content":"| What  | Where                             | Notes                                                                              |\n| ----- | --------------------------------- | ---------------------------------------------------------------------------------- |\n| Alloy | nothing published - `alloy:12345` | The component graph UI stays inside the network; read the container's log instead. |","table":"table-8"},"3717":{"id":"/observability-227","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#reaching-the-uis","content":"| What         | Where                                             | Notes                                                                                                                                                                                                                                                |\n| ------------ | ------------------------------------------------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| Alertmanager | `http://127.0.0.1:9093` (`OBS_ALERTMANAGER_PORT`) | Loopback on purpose. Its UI silences alerts and the service ships no auth, so an Alertmanager reachable by the whole LAN is not something to hand a network. Read silences here from a shell on the stack host, or through Grafana's Alerting pages. |","table":"table-8"},"3718":{"id":"/observability-228","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#reaching-the-uis","content":"| What                | Where                                                                                                                                                                               | Notes                                                                                                                                                                                                                                              |\n| ------------------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| The three exporters | `node_exporter` on `127.0.0.1:9101` (`OBS_NODE_EXPORTER_PORT`), `cadvisor` on `127.0.0.1:9290` (`OBS_CADVISOR_PORT`), `blackbox_exporter` on `127.0.0.1:9115` (`OBS_BLACKBOX_PORT`) | Prometheus reaches all three by service name on the compose network; the loopback mapping exists so you can read a metric off the box itself. None reaches the LAN, which matters most for blackbox: it is a general-purpose outbound HTTP prober. |","table":"table-8"},"3719":{"id":"/observability-229","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-one-public-name","content":"Public mode follows the same path as the other names: `STACK_GRAFANA_NAME` (default label\n`grafana`) is composed by `scripts/lib/domain.sh` with the rest, `bootstrap` writes\n`STACK_GRAFANA_URL`, and the router sends that Host to `grafana:3000`."},"3720":{"id":"/observability-230","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-one-public-name","content":"Only Grafana gets a name - the other nine have no reason to answer the LAN, let alone the\nWAN, and Alertmanager least of all."},"3721":{"id":"/observability-231","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-one-public-name","content":"Full detail on the naming parts and the Traefik side is in\npublic-access.md."},"3722":{"id":"/observability-232","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-one-command-that-asks-all-of-these","content":"Start with the one command that asks all of these at once, then drop to the individual\nprobes when it names a section:"},"3723":{"id":"/observability-233","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-one-command-that-asks-all-of-these","content":"It walks the bundle outward from the dotenv - the operator keys, the host's log\ndirectory, the profile render, each container's state, each endpoint, whether data is\nactually moving - and prints the stack's usual `summary: N ok, W warnings, F failed`."},"3724":{"id":"/observability-234","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-one-command-that-asks-all-of-these","content":"It is the check that catches the two failures a `running` state hides: an Alloy pointed at\nan empty log root, and a Prometheus that scraped everything for a day and never wrote a\nsample to Mimir."},"3725":{"id":"/observability-235","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-one-command-that-asks-all-of-these","content":"`--no-docker` skips the four unpublished backends when you are not on a shell that can\naddress the daemon."},"3726":{"id":"/observability-236","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#what-that-check-does-not-cover","content":"Its service list is still the original six (`OBS_SERVICES`, `scripts/observability-check.sh:165`).\nThe four exporters and Alertmanager declare no `healthcheck` and publish no readiness path\nof their own, so their state comes from the `status` rows and the container logs below,\nnot from this check."},"3727":{"id":"/observability-237","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-probes-in-order","content":"Then, from the checkout on the stack host, in this order. Each one splits one symptom from\nthe next."},"3728":{"id":"/observability-238","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#is-the-bundle-selected-at-all","content":"Ten rows when `OBSERVABILITY_ENABLED` is on, none when it is off."},"3729":{"id":"/observability-239","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#is-the-bundle-selected-at-all","content":"Expect `running`, not `healthy`, on the eight that declare no `healthcheck`: `mimir`,\n`loki`, `tempo` and `alloy` (those four images are distroless, so they carry no shell and\nno `wget`/`curl` for a healthcheck to run), plus `node_exporter`, `cadvisor`,\n`blackbox_exporter` and `alertmanager`. Only `prometheus` and `grafana` declare one."},"3730":{"id":"/observability-240","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#is-the-bundle-selected-at-all","content":"A missing row means the profile was not selected - see the\ntroubleshooting entry on which env file the dev project actually reads."},"3731":{"id":"/observability-241","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#are-the-scrapes-up","content":"Every target should read `\"health\":\"up\"`. A target missing entirely is the scrape config;\na target present and `down` is the app not serving `/metrics`, or - for `litellm` alone -\nthe bearer file not holding the key the proxy answers with."},"3732":{"id":"/observability-242","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#are-the-scrapes-up","content":"That failure describes itself twice over: a file that is not there leaves one red target\nwhose `lastError` names `/etc/prometheus-secrets/litellm_token` while Prometheus loads the\nrest of the config normally, and a file holding the wrong key brings LiteLLM's 401 body\n`No connected db.`, which at v1.102.1 is the wrong-token branch rather than a database\ncomplaint - its auth path compares the bearer against `LITELLM_MASTER_KEY` and returns\nPROXY_ADMIN before it looks for a DB."},"3733":{"id":"/observability-243","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#are-the-scrapes-up","content":"Either way the fix is the file and a recreate of `prometheus` so Compose renders it again;\nthe metrics stay authenticated."},"3734":{"id":"/observability-244","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#are-the-scrapes-up","content":"What that 401 offers instead is turning the endpoint's auth off\n(`litellm_settings.require_auth_for_metrics_endpoint`), and this stack refuses it: `:4000`\nis published to the LAN, and these metrics name model aliases and traffic volumes."},"3735":{"id":"/observability-245","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#is-the-write-to-mimir-landing","content":"A refused or failing `remote_write` shows up in the Prometheus log."},"3736":{"id":"/observability-246","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#is-the-write-to-mimir-landing","content":"The clean version of the same question is asked in the UI: the `prometheus` datasource has\nthe series and the `mimir` one does not, which is a write fault, not a query fault."},"3737":{"id":"/observability-247","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#are-the-three-unpublished-backends-alive","content":"Their health endpoints are `http://loki:3100/ready`, `http://tempo:3200/ready` and\n`http://mimir:8080/ready`, all compose-DNS only."},"3738":{"id":"/observability-248","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#are-the-three-unpublished-backends-alive","content":"Those exact URLs are the `siteMonitor` of the **Observability** group's cards on the\ndashboard, so the card badge is the probe - and because those four containers have no\nhealthcheck, it is the only automatic one."},"3739":{"id":"/observability-249","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#are-the-three-unpublished-backends-alive","content":"For the logs behind a red badge, use the container log rather than an exec, since a\ndistroless image has no shell to exec into:"},"3740":{"id":"/observability-250","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#is-the-whole-thing-still-well-formed-on-both-flag-paths","content":"That gate is what makes the monitoring payloads ordinary source: it parses the three rule\nfiles, `alertmanager.yml`, `blackbox.yml` and the Grafana alerting policy, and parses every\ndashboard JSON through `scripts/lib/parse_json.py` (`scripts/validate.sh:104`)."},"3741":{"id":"/observability-251","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#is-the-whole-thing-still-well-formed-on-both-flag-paths","content":"A panel that is not well-formed JSON, a dashboard whose `title` is blank, and the generated\nSpark file-SD document are gate failures now rather than an empty tile someone notices in\nthe browser."},"3742":{"id":"/observability-252","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#the-shipped-payload-checks","content":"And the shipped payload checks, which cover the dashboard group and its card URLs:"},"3743":{"id":"/observability-253","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#what-is-deliberately-not-here","content":"**No destination is configured, so nothing pages anyone as shipped.** The rules, the\nroutes and the receivers all exist; only the URL is missing. `ALERTMANAGER_WEBHOOK_URL`\nis empty in `.env.example`, so on a box nobody edited every alert is visible - on\nPrometheus' own alerts page and under Grafana's Alerting pages - and is delivered\nnowhere."},"3744":{"id":"/observability-254","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#what-is-deliberately-not-here","content":"Who gets woken is an operator decision, made in the env file."},"3745":{"id":"/observability-255","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#what-is-deliberately-not-here","content":"**No healthcheck or dashboard card for the four new services.** None of\n`node_exporter`, `cadvisor`, `blackbox_exporter` or `alertmanager` declares a\n`healthcheck`, and the dashboard's **Observability** group still carries five cards\n(dashboard.md), so their liveness is the `status` row plus the container\nlog."},"3746":{"id":"/observability-256","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#what-is-deliberately-not-here","content":"**No object storage.** Loki, Mimir and Tempo keep blocks on named volumes on this\nbox's disk. The follow-up is a bucket and the storage config in each of those three\nfiles; nothing about the read path changes when it lands."},"3747":{"id":"/observability-257","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#what-is-deliberately-not-here","content":"**No trace client.** Tempo has an OTLP door and a datasource, and no caller. Pointing\nthe first service at `tempo:4317` is a change in that service, not in this bundle."},"3748":{"id":"/observability-258","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#what-is-deliberately-not-here","content":"When a symptom shows up as an empty panel, start at\ntroubleshooting.md, Observability section: the failures an operator\nactually hits are all on one side of a seam:"},"3749":{"id":"/observability-259","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#what-is-deliberately-not-here","content":"the scrape"},"3750":{"id":"/observability-260","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#what-is-deliberately-not-here","content":"the write"},"3751":{"id":"/observability-261","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#what-is-deliberately-not-here","content":"the tenant path"},"3752":{"id":"/observability-262","page_id":"/observability","tags":["observability","prometheus","grafana","loki","tempo","mimir","operate"],"type":"text","url":"/observability#what-is-deliberately-not-here","content":"the log root Alloy was given"},"3753":{"id":"/operate","page_id":"/operate","type":"page","content":"Operate the box","breadcrumbs":["Docs","Operate the box"],"tags":["operate","dashboard","maintain","overview"],"url":"/operate"},"3754":{"id":"/operate-0","page_id":"/operate","tags":["operate","dashboard","maintain","overview"],"type":"text","url":"/operate","content":"Day-to-day operation — the dashboard and desktops, what to refresh after a git pull, the public shape, and the sy