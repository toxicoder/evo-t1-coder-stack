},"215":{"id":"/coder-templates-96","page_id":"/coder-templates","type":"heading","tags":["coder","templates","workspaces","terraform"],"url":"/coder-templates#the---additional-repos-escape-hatch","content":"The `--additional-repos` escape hatch"},"216":{"id":"/coder-templates-97","page_id":"/coder-templates","type":"heading","tags":["coder","templates","workspaces","terraform"],"url":"/coder-templates#github-credentials-for-a-workspace","content":"GitHub credentials for a workspace"},"217":{"id":"/coder-templates-98","page_id":"/coder-templates","type":"heading","tags":["coder","templates","workspaces","terraform"],"url":"/coder-templates#where-the-token-comes-from","content":"Where the token comes from"},"218":{"id":"/coder-templates-99","page_id":"/coder-templates","type":"heading","tags":["coder","templates","workspaces","terraform"],"url":"/coder-templates#the-credential-ladder-in-gits-consult-order","content":"The credential ladder, in git's consult order"},"219":{"id":"/coder-templates-100","page_id":"/coder-templates","type":"heading","tags":["coder","templates","workspaces","terraform"],"url":"/coder-templates#the-five-slots-in-order","content":"The five slots, in order"},"220":{"id":"/coder-templates-101","page_id":"/coder-templates","type":"heading","tags":["coder","templates","workspaces","terraform"],"url":"/coder-templates#the-four-commands","content":"The four commands"},"221":{"id":"/coder-templates-102","page_id":"/coder-templates","type":"heading","tags":["coder","templates","workspaces","terraform"],"url":"/coder-templates#reading-the-chain-and-repairing-it","content":"Reading the chain, and repairing it"},"222":{"id":"/coder-templates-103","page_id":"/coder-templates","type":"heading","tags":["coder","templates","workspaces","terraform"],"url":"/coder-templates#installing-a-pasted-pat-and-the-full-usage","content":"Installing a pasted PAT, and the full usage"},"223":{"id":"/coder-templates-104","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#coder-workspace-templates","content":"**What's on this page**"},"224":{"id":"/coder-templates-105","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#coder-workspace-templates","content":"What the two templates make, and when the `devcontainer` toggle matters"},"225":{"id":"/coder-templates-106","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#coder-workspace-templates","content":"How `push-template.sh` ships the source, and the same push by hand"},"226":{"id":"/coder-templates-107","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#coder-workspace-templates","content":"Every create-form field and template variable, with its default"},"227":{"id":"/coder-templates-108","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#coder-workspace-templates","content":"Autostop, TTLs, Docker-in-Docker, and the DinD sidecar failure modes"},"228":{"id":"/coder-templates-109","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#coder-workspace-templates","content":"Terminal and editor defaults inside the container, and workspace GitHub credentials"},"229":{"id":"/coder-templates-110","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#coder-workspace-templates","content":"The Infisical boot fetch: its two gates, its eight agent-env keys, and `~/.infisical/agent.env`"},"230":{"id":"/coder-templates-111","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#coder-workspace-templates","content":"**What this enables**"},"231":{"id":"/coder-templates-112","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#coder-workspace-templates","content":"Choosing between the plain container and the devcontainer before you click create"},"232":{"id":"/coder-templates-113","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#coder-workspace-templates","content":"Reading a failed push or a stuck workspace against what the template actually does"},"233":{"id":"/coder-templates-114","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#coder-workspace-templates","content":"Changing a template variable without guessing which file owns it"},"234":{"id":"/coder-templates-115","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#coder-workspace-templates","content":"Deep reference for `templates/workspace/` and `templates/devcontainer/`: what they build,\nhow they get pushed, what each template variable means, and how the create form and the\nin-editor terminal and editor behave."},"235":{"id":"/coder-templates-116","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#coder-workspace-templates","content":"Related: project-conventions.md (shell and payload conventions),\nSECURITY.md, and\ndocs/grok-build-and-agents.md\n(the long prose on the tmux profiles and the Grok Build session)."},"236":{"id":"/coder-templates-117","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-the-two-templates-make","content":"Two templates live under `templates/`, and a push covers both."},"237":{"id":"/coder-templates-118","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-the-two-templates-make","content":"`workspace` (`templates/workspace/`) is the plain dev container."},"238":{"id":"/coder-templates-119","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-the-two-templates-make","content":"`devcontainer` (`templates/devcontainer/`) is the DinD-backed one."},"239":{"id":"/coder-templates-120","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-the-two-templates-make","content":"`workspace` goes first, `devcontainer` last: a dependent template pushes last so a\npartial failure leaves the base template usable."},"240":{"id":"/coder-templates-121","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-the-two-templates-make","content":"`devcontainer` reuses `workspace`'s variables. `repo_url` exists in both; `dind` does\nnot exist in `devcontainer`."},"241":{"id":"/coder-templates-122","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-the-two-templates-make","content":"Each template dir keeps its own independent copy of the `.tftpl` payloads\n(`startup.sh.tftpl`, `settings.json.tftpl`, `grok-config.toml.tftpl`). Change one twin,\nchange the other."},"242":{"id":"/coder-templates-123","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-templatescommon-payloads","content":"`templates/common/` exists once instead of twice, and both templates consume it.\n`template_push_one` stages every file in this list beside the staged `main.tf`; a\nmissing one fails the push before the CLI runs."},"243":{"id":"/coder-templates-124","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#boot-identity-rulebook-icon-notes-and-terminal","content":"`GROK_BUILD_AGENTS.md` is the orchestration-protocol seed text that becomes every\nworkspace's `~/.grok/AGENTS.md` (read with `file()`, chomped). It rides\n`coder_script.agents_seed` rather than the startup script, for the reason that section\ngives: it is the largest payload the twins inline."},"244":{"id":"/coder-templates-125","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#boot-identity-rulebook-icon-notes-and-terminal","content":"`vscode-alt.svg` is the editor icon (read with `filebase64()`). It stays small\nenough that the resulting `data:image/svg+xml;base64,...` URL fits Coder\nv2.36's `workspace_apps.icon` column (`varchar(256)`)."},"245":{"id":"/coder-templates-126","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#boot-identity-rulebook-icon-notes-and-terminal","content":"`notes-setup.sh` is the library behind each clone's private `notes.md`. The\nstartup script inlines it with `file()` the same way, writes it into\n`~/.grok/`, sources it, and calls `notes_materialize` per clone."},"246":{"id":"/coder-templates-127","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#boot-identity-rulebook-icon-notes-and-terminal","content":"That call also seeds the ignore entries that keep the file uncommitted; see \"What is\nshared\" in `docs/grok-build-and-agents.md` for what it writes into git config."},"247":{"id":"/coder-templates-128","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#boot-identity-rulebook-icon-notes-and-terminal","content":"Once every clone has been through it the same script calls `run_notes_watch`, which\nreaches `notes_sync_start` on the home owner's uid and leaves the container with one\nbackground watcher (`NOTES_SYNC_INTERVAL` seconds, 30 by default; one instance per\ncontainer behind a `flock` on `$HOME/.notes-sync.lock`) copying each clone's notes back\nto the owner's notes volume between boots."},"248":{"id":"/coder-templates-129","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#boot-identity-rulebook-icon-notes-and-terminal","content":"The workspace twin watches `$HOME/workspace`; the devcontainer twin passes its\n`$dc_dir`, because those clones sit on the `/srv/coder-devcontainers` bind."},"249":{"id":"/coder-templates-130","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#boot-identity-rulebook-icon-notes-and-terminal","content":"`tmux.conf` is the fidelity config the startup script writes. `grok-build-terminal.sh`\nand `vscode-terminal-tmux.sh` are the two terminal launchers, and they ride\n`coder_script \"terminal_launchers\"` with the shared body\n`templates/common/terminal-launchers.sh.tftpl` rather than the startup argument, which\nis the one execve that runs out of room: nothing at boot runs either script, the\ncode-server terminal profile is their only consumer. Helpers use `$folder` (not\n`$${folder}`) because `file()` contents are not re-interpolated."},"250":{"id":"/coder-templates-131","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-skill-command-seeds-and-the-body-that-writes-them","content":"`grok-build-delegation.SKILL.md` and `coder-agents.md` are the Coder Agents\nskill and instruction seeds (chomped `file()`)."},"251":{"id":"/coder-templates-132","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-skill-command-seeds-and-the-body-that-writes-them","content":"`ez-learn.SKILL.md`, `ez-skillify.SKILL.md` and `ez-create-skill.SKILL.md` are the\nstack's three skill commands:"},"252":{"id":"/coder-templates-133","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-skill-command-seeds-and-the-body-that-writes-them","content":"`/ez-learn` writes memory files, reproducing the upstream memory family `/flush`,\n`/dream`, `/remember` and `/memory`;"},"253":{"id":"/coder-templates-134","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-skill-command-seeds-and-the-body-that-writes-them","content":"`/ez-skillify` captures the session that just worked into a skill;"},"254":{"id":"/coder-templates-135","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-skill-command-seeds-and-the-body-that-writes-them","content":"`/ez-create-skill` scaffolds one from what the operator describes."},"255":{"id":"/coder-templates-136","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-skill-command-seeds-and-the-body-that-writes-them","content":"Skill authoring is those last two - `/ez-learn` stores facts, not procedures. They ride\n`coder_script.stack_skills` rather than the startup argument (see\n\"The one-argument ceiling\"), which writes each absent skill into\n`~/.coder/skills/<name>/SKILL.md` and twin-copies it to\n`~/.agents/skills/<name>/SKILL.md`, each only while absent."},"256":{"id":"/coder-templates-137","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-skill-command-seeds-and-the-body-that-writes-them","content":"Upstream there is no `/learn` and no `/skillify` to shadow: no published source names\neither one."},"257":{"id":"/coder-templates-138","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-skill-command-seeds-and-the-body-that-writes-them","content":"`/create-skill` is real, but only as a *bundled* platform skill whose catalog is\nfetched per identity/team behind an x.ai sign-in this stack does not have;"},"258":{"id":"/coder-templates-139","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-skill-command-seeds-and-the-body-that-writes-them","content":"the memory family `/ez-learn` copies is no skill at all but the CLI's own `/flush`,\n`/dream` and `/memory` registry entries plus the pager's `/remember`, with the\nregistry three gated on a memory store, which is off by default and never configured\nhere."},"259":{"id":"/coder-templates-140","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-skill-command-seeds-and-the-body-that-writes-them","content":"So these payloads are what make the three commands exist, and the `ez-` prefix is what\nkeeps them clear of those upstream names."},"260":{"id":"/coder-templates-141","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-skill-command-seeds-and-the-body-that-writes-them","content":"`stack-skills.sh.tftpl` is the `coder_script \"stack_skills\"` body that seeds that trio,\nrendered with `templatefile()` from the three `chomp(file())` entries `main.tf` passes it.\nIt is absent-only and silent on a healthy workspace, because its log is what an operator\nreads when a skill is missing."},"261":{"id":"/coder-templates-142","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-rulebook-body-and-the-repository-conversion-family","content":"`agents-seed.sh.tftpl` is the `coder_script \"agents_seed\"` body that writes\n`~/.grok/AGENTS.md` from `GROK_BUILD_AGENTS.md`. Marker-aware rather than absent-only: a\ncopy still carrying the stack marker is rewritten on every start, and one whose marker\nlines a person deleted stays theirs. `scripts/lib/config_seed.sh` names the same file and\ntarget for the host-side reseed."},"262":{"id":"/coder-templates-143","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-rulebook-body-and-the-repository-conversion-family","content":"`ez-bazel-first.SKILL.md`, `ez-strong-types.SKILL.md` and `ez-trunk-based-repo.SKILL.md`\nare the stack's three repository-conversion commands, and they stand in for nothing\nupstream:"},"263":{"id":"/coder-templates-144","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-rulebook-body-and-the-repository-conversion-family","content":"`/ez-bazel-first` puts every tracked file behind a target and budgets the `glob()`s"},"264":{"id":"/coder-templates-145","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-rulebook-body-and-the-repository-conversion-family","content":"`/ez-strong-types` pins a strict checker profile per language and ratchets the\nbroad-type census"},"265":{"id":"/coder-templates-146","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-rulebook-body-and-the-repository-conversion-family","content":"`/ez-trunk-based-repo` turns environment branches into environments and unfinished\nwork into flags."},"266":{"id":"/coder-templates-147","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-rulebook-body-and-the-repository-conversion-family","content":"The family's fourth member, `ez-micro-plan.SKILL.md`, converts nothing: it is the\n  parent's dispatch protocol, the one that cuts a change into micro tasks a fleet of\n  subagents can each finish alone."},"267":{"id":"/coder-templates-148","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-rulebook-body-and-the-repository-conversion-family","content":"It writes the dispatch plan to `.grok/plans/<slug>/plan.md` (Goal, Dispatch, Lanes,\n  Tasks, Ledger, Not doing) with `ctx/` briefs and `results/` reports beside it, in the\n  same shape the rulebook at `~/.grok/AGENTS.md` tells the parent to expect, and the plan\n  tree is git-ignored by `templates/common/notes-setup.sh` beside the two scratch note\n  names."},"268":{"id":"/coder-templates-149","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-rulebook-body-and-the-repository-conversion-family","content":"Unlike the authoring trio these are not single files: three of the four shell out to a\n  python helper, so `ez-bazel-first` carries `ez-bazel-first.owned_files_check.py` and\n  `ez-bazel-first.glob_budget.py`, `ez-strong-types` carries\n  `ez-strong-types.type_baseline.py`, and `ez-micro-plan` carries\n  `ez-micro-plan.plan_check.py`, each written to a `scripts/` subdirectory of the same\n  skill directory."},"269":{"id":"/coder-templates-150","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-rulebook-body-and-the-repository-conversion-family","content":"The bodies name the `~/.agents` spelling of those helpers, which is why the twin copy is\n  not optional."},"270":{"id":"/coder-templates-151","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-rulebook-body-and-the-repository-conversion-family","content":"`stack-repo-skills.sh.tftpl` is the `coder_script \"stack_repo_skills\"` body that seeds\nthat family, from eight `chomp(file())` entries: one `SKILL.md` per command plus the four\npython helpers. It is a second body rather than eight\nmore heredocs in the first one for the reason this whole file keeps repeating: each\n`coder_script.script` is its own `execve` argument with its own ceiling, and a family\nthat ships helpers grows faster than one that ships a `SKILL.md` each."},"271":{"id":"/coder-templates-152","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-advisor-commands-and-their-body","content":"`documenter.SKILL.md`, `performance-optimizer.SKILL.md`, `debugger.SKILL.md` and\n`migrator.SKILL.md` are the stack's four advisor commands (`/documenter`,\n`/performance-optimizer`, `/debugger`, `/migrator`), `ez-code-index.SKILL.md` is the fifth\nand ships its helper `ez-code-index.code_index.py` in a `scripts/` subdir of the same skill\ndirectory, and `documenter.AGENT.md` is the one role definition the `/documenter` skill\ndispatches. What each does and which lane each phase rides is\ngrok-build-and-agents.md."},"272":{"id":"/coder-templates-153","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-advisor-commands-and-their-body","content":"`stack-advisors.sh.tftpl` is the `coder_script \"stack_advisors\"` body that seeds those seven\npayloads: each skill into `~/.coder/skills/<name>/` and its `cp` twin into\n`~/.agents/skills/<name>/`, with `documenter.md` written under `~/.grok/agents/` beside the\nskill that needs it so a start has the command and its role or has neither. Absent-only and\nsilent on a healthy workspace, the way the two skill bodies above are."},"273":{"id":"/coder-templates-154","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#hooks-the-mcp-cache-proxy-token-refresh-and-the-vault-fetch","content":"`hooks.evo-t1-hooks.json` is the hook manifest Grok Build reads at\n`~/.grok/hooks/evo-t1-hooks.json`, and five more files land under `hooks/bin/` beside it:\nthe four handlers it names (`hooks.secret-guard.sh`, `hooks.dangerous-command-guard.sh`,\n`hooks.post-edit-format.sh`, `hooks.selective-test-runner.sh`) plus the\n`hooks.deny-patterns.txt` the command guard reads one ERE per line. The manifest has to stay\nparseable JSON, so its stack marker is the `\"__evoT1Stack\": true` key rather than a comment\nline."},"274":{"id":"/coder-templates-155","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#hooks-the-mcp-cache-proxy-token-refresh-and-the-vault-fetch","content":"`stack-hooks.sh.tftpl` is the `coder_script \"stack_hooks\"` body that seeds that family, from\nsix `chomp(file())` entries, on its own body for the usual ceiling reason."},"275":{"id":"/coder-templates-156","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#hooks-the-mcp-cache-proxy-token-refresh-and-the-vault-fetch","content":"Unlike the three skill bodies above it is **marker-aware** rather than absent-only: a\ncopy still carrying the marker is rewritten on every start, because a guard that drifted\nfrom the seed silently changes what a session may run and what it may write."},"276":{"id":"/coder-templates-157","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#hooks-the-mcp-cache-proxy-token-refresh-and-the-vault-fetch","content":"The four `.sh` files are written executable, with the payload's `#!` line kept on row 1,\nbecause the runner starts a relative command out of the manifest directly; the manifest\nand the deny list are data and carry no executable bit."},"277":{"id":"/coder-templates-158","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#hooks-the-mcp-cache-proxy-token-refresh-and-the-vault-fetch","content":"What the four guards decide, and how an operator extends the deny list, is\ngrok-build-and-agents.md."},"278":{"id":"/coder-templates-159","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#hooks-the-mcp-cache-proxy-token-refresh-and-the-vault-fetch","content":"`mcp-cache-proxy.json` is the context7 MCP cache-proxy blob the startup script\nwrites, into `~/.grok/mcp-cache-proxy/config.json` and only while that file is absent\n(that path is per workspace, so each workspace warms its own SQLite cache). It\nnames no secret: the empty `CONTEXT7_API_KEY` value is what tells `mcp-cache-proxy` to\ninherit `process.env`."},"279":{"id":"/coder-templates-160","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#hooks-the-mcp-cache-proxy-token-refresh-and-the-vault-fetch","content":"`gh-token-refresh.sh.tftpl` is the shared GitHub-token refresh `coder_script`,\nrendered with `templatefile()` so `${github_auth_id}` and\n`${coder_github_app_install_url}` interpolate."},"280":{"id":"/coder-templates-161","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#hooks-the-mcp-cache-proxy-token-refresh-and-the-vault-fetch","content":"`infisical-secrets.sh.tftpl` is the `coder_script \"infisical_secrets\"` body that fetches\nthat workspace's own copy of the stack's credentials from the self-hosted vault on start\n(`templates/workspace/main.tf:771-786`)."},"281":{"id":"/coder-templates-162","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#hooks-the-mcp-cache-proxy-token-refresh-and-the-vault-fetch","content":"Its map is a single key, **`boot_log_lib`** (`templates/workspace/main.tf:783-785`): it\ndeclares no Terraform variable of its own, so the rendered text is identical for every\nworkspace and carries no secret, because Coder stores a rendered `coder_script.script`\nas text on the server, and the one value it does take is the same library text\neverywhere. Everything else it needs arrives as an agent-env variable."},"282":{"id":"/coder-templates-163","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#hooks-the-mcp-cache-proxy-token-refresh-and-the-vault-fetch","content":"The vault itself - its three services, the operator CLI, the managed key inventory and\nrotation - is operate/secrets.md; what the templates have to keep\ntrue about it is The Infisical boot fetch."},"283":{"id":"/coder-templates-164","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-the-staged-copy-does-to-the-template-dir","content":"Editing the common copy changes both templates; the staged copy overwrites any\nsame-named file the template dir still carries."},"284":{"id":"/coder-templates-165","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#presets","content":"Presets collapse the create form to one click."},"285":{"id":"/coder-templates-166","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#presets","content":"`workspace`: **AI workspace** (golden image, the selected default), **Minimal shell**\n(bare `ubuntu:24.04`, for when the golden image is mid-rebuild), **AI workspace + DinD**\n(golden image plus a privileged Docker daemon)."},"286":{"id":"/coder-templates-167","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#presets","content":"`devcontainer`: **Devcontainer default** (the template default) and **Plain clone**."},"287":{"id":"/coder-templates-168","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#presets","content":"Preset keys are parameter *names*; `display_name` is UI-only and would be ignored."},"288":{"id":"/coder-templates-169","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#how-push-template-works","content":"`bazelisk run //scripts:push-template` runs `scripts/push-template.sh`."},"289":{"id":"/coder-templates-170","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#how-push-template-works","content":"It resolves the repo root from `BUILD_WORKSPACE_DIRECTORY` (the real checkout\n`bazelisk run` names) ahead of the runfiles copy, so `.env` and the template\nfiles are regular files rather than execroot symlinks."},"290":{"id":"/coder-templates-171","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#how-push-template-works","content":"It resolves the running stack on the Docker **daemon** by container label, never\nthrough a cwd-resolved compose project."},"291":{"id":"/coder-templates-172","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#how-push-template-works","content":"Per template it checks `main.tf` exists (otherwise \"run this from the repo root\") and\nnotes a missing `.terraform.lock.hcl`."},"292":{"id":"/coder-templates-173","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#how-push-template-works","content":"It rejects a `coder_workspace_preset` description over Coder's 128-**byte** ceiling."},"293":{"id":"/coder-templates-174","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#how-push-template-works","content":"It rejects a `vscode-alt.svg` whose inlined data URL would exceed Coder's\n256-character `workspace_apps.icon` column."},"294":{"id":"/coder-templates-175","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#how-push-template-works","content":"It streams the source as a tar on stdin, with symlinks dereferenced into regular\nfiles. Coder's provisioner unpacks that archive into an empty workdir and does\nnot follow host paths, so a stored runfiles symlink plans as \"No configuration\nfiles\"."},"295":{"id":"/coder-templates-176","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#how-push-template-works","content":"It confirms an **active** version."},"296":{"id":"/coder-templates-177","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#how-push-template-works","content":"It re-sends the template's own description."},"297":{"id":"/coder-templates-178","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#how-push-template-works","content":"It re-pins **Autostop** to *Disabled*."},"298":{"id":"/coder-templates-179","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-it-does-and-does-not-do","content":"No `.terraform.lock.hcl` is committed under `templates/`. Each `main.tf` pins\n`coder/coder` `~> 2.18` and `kreuzwerker/docker` `~> 4.6` in `required_providers`; Coder\npushes with a warning when no lockfile sits beside them. `coder_devcontainer` needs a\nserver `>= 2.21`, which this stack runs (v2.36.6)."},"299":{"id":"/coder-templates-180","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-it-does-and-does-not-do","content":"`terraform init` on the server still talks to `registry.terraform.io` (and\n`registry.coder.com` for `devcontainer`'s `devcontainers_cli` module), even\nwhen a previous provider version is cached. The `coder` compose service\nforwards those lookups to `1.1.1.1` / `8.8.8.8` so a host whose only\nnameserver is Tailscale MagicDNS does not SERVFAIL the push. Recreate\n`coder` after pulling that compose change (`prod-stack up`) before pushing."},"300":{"id":"/coder-templates-181","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-it-does-and-does-not-do","content":"`templates push` carries no description (`push` has no `--description` flag), so\n`templates edit --description` is the write. That text is the routing hint the Coder\nAgents chat reads when it picks a template to provision."},"301":{"id":"/coder-templates-182","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-it-does-and-does-not-do","content":"Both the preset descriptions and the two routing hints fit the same 128-byte ceiling.\n`coder_parameter` descriptions are **not** capped (some run past 450 characters) and are\nnot checked."},"302":{"id":"/coder-templates-183","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-it-does-and-does-not-do","content":"A failed description edit and a failed autostop pin only add a note; neither blocks the\ntemplate."},"303":{"id":"/coder-templates-184","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-it-does-and-does-not-do","content":"A template whose push or verification failed is counted in the\n`N of M template(s) did not reach an active version` line and makes the run exit\nnon-zero, while every other template still gets its push attempt."},"304":{"id":"/coder-templates-185","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-one-argument-ceiling","content":"The agent runs `coder_agent.startup_script`, and every `coder_script.script`, as\n`bash -c <body>`. The whole body therefore travels as **one** argument to `execve(2)`,\nand Linux caps a single argument at `MAX_ARG_STRLEN`, 32 pages = 131072 bytes. Measured\non this host: an argument of 131071 bytes execs and one of 131072 fails with `E2BIG`.\nPast the wall:"},"305":{"id":"/coder-templates-186","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-one-argument-ceiling","content":"the agent logs `fork/exec /bin/bash: argument list too long` with `exit_code=255` a few\nmilliseconds in"},"306":{"id":"/coder-templates-187","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-one-argument-ceiling","content":"the home directory never seeds"},"307":{"id":"/coder-templates-188","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-one-argument-ceiling","content":"the workspace banner reads \"A startup script has failed\""},"308":{"id":"/coder-templates-189","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-one-argument-ceiling","content":"Coder puts no limit there and the plan reports no error, so the wall only announces\nitself on a live recreate."},"309":{"id":"/coder-templates-190","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#which-bytes-make-up-the-argument","content":"The size that matters is not `startup.sh.tftpl`. `main.tf` composes the body from that\ntemplate plus every `templates/common/` payload it inlines, so any edit to the rulebook,\nthe skills, the tmux config, the notes seeder, or the Grok config moves the number."},"310":{"id":"/coder-templates-191","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#which-bytes-make-up-the-argument","content":"That is how six commits crept from 104 KB to 130 KB and one documentation commit crossed\nthe wall at 135 KB."},"311":{"id":"/coder-templates-192","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#which-bytes-make-up-the-argument","content":"Two things follow from the mechanism:"},"312":{"id":"/coder-templates-193","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#which-bytes-make-up-the-argument","content":"**Each body is its own `execve`, so each gets its own ceiling.** Splitting a body into\ntwo `coder_script` resources relocates the wall; it does not raise it. On this server\n(v2.36) the start scripts fan out concurrently in an errgroup and `ready` is set only\nafter all of them return, so splitting does not reduce a peak either.\n`coder_script_order` needs Coder `>= v2.39`."},"313":{"id":"/coder-templates-194","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#which-bytes-make-up-the-argument","content":"This is the escape the stack now uses: the three skill payloads ride\n  `coder_script.stack_skills` rather than the startup argument, because the devcontainer\n  twin had 491 bytes of headroom left and three more inlined payloads could not fit there."},"314":{"id":"/coder-templates-195","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#which-bytes-make-up-the-argument","content":"The same move later made room for the rulebook: `GROK_BUILD_AGENTS.md` is the largest\n  payload the twins inline, and it left the startup argument for\n  `coder_script.agents_seed` when that twin stood 196 bytes from the budget and one more\n  instruction section could not land."},"315":{"id":"/coder-templates-196","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#which-bytes-make-up-the-argument","content":"`grok-build-delegation.SKILL.md` still rides the startup argument - it predates the\n  split, it fits, and its own tests pin it there."},"316":{"id":"/coder-templates-197","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#which-bytes-make-up-the-argument","content":"**A `#!` line does not help.** The body still becomes\n`execve(env, [env, bash, -c, body])`; the interpreter line is content inside the\nargument."},"317":{"id":"/coder-templates-198","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#how-the-push-enforces-the-bound","content":"`startup_size_guard` in `scripts/push-template.sh` enforces this before the CLI runs,\nbeside the icon and preset-description guards. It sums each body's composed bytes and\nrefuses the push past `STARTUP_SIZE_BOUND` (122880, which leaves 8 KiB, about two\ndocumentation-sized commits, under the kernel's own limit). Its reader is\n`scripts/lib/startup_size.awk`; `//tests:bats_startup_script_size_test` re-derives the\nsame totals with an independent parser and pins the two together, so a guard that starts\nmeasuring something else goes red in review."},"318":{"id":"/coder-templates-199","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#how-the-push-enforces-the-bound","content":"The guard also says the number while it is still a warning: a body within\n`STARTUP_SIZE_WARN` (4096) of the bound prints its composed total and the bytes left,\nbecause the distance to the budget is what a reviewer needs and a hard failure only\never reports the crossing."},"319":{"id":"/coder-templates-200","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#measured-sizes-of-the-composed-bodies","content":"Measured on 2026-11-06 with the byte algorithm in `tests/bats/startup-script-size.bats`:"},"320":{"id":"/coder-templates-201","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#measured-sizes-of-the-composed-bodies","content":"the widest body is now the devcontainer startup script at 115967 bytes, 6913 clear of\nthe bound, with the workspace twin at 113767 and 9113 clear."},"321":{"id":"/coder-templates-202","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#measured-sizes-of-the-composed-bodies","content":"Before the trio moved out that same devcontainer body measured 122389 with only 491\nclear, and `ez-learn.SKILL.md` plus its heredoc accounted for roughly 7 KB of it."},"322":{"id":"/coder-templates-203","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#measured-sizes-of-the-composed-bodies","content":"The three payloads now travel in their own body, `coder_script.stack_skills`, which\ncomposes to 36847 bytes."},"323":{"id":"/coder-templates-204","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#measured-sizes-of-the-composed-bodies","content":"Measured again on 2026-11-09 after the repository-conversion family landed:\n`coder_script.stack_repo_skills`, carrying three `SKILL.md` payloads and three python\nhelpers, composes to 60336 bytes, 62544 clear of the bound, and neither startup twin\nmoved."},"324":{"id":"/coder-templates-205","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#measured-sizes-of-the-composed-bodies","content":"Measured again on 2026-11-14 after the family's fourth member landed: that same body now\ncarries four `SKILL.md` payloads and four python helpers and composes to 91203 bytes,\n31677 clear of the bound, and neither startup twin moved - which is the point of giving\na payload family its own `coder_script` instead of feeding it to `startup_script`."},"325":{"id":"/coder-templates-206","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#measured-sizes-of-the-composed-bodies","content":"Measured again on 2026-11-16 with the same reader\n(`awk -f scripts/lib/startup_size.awk templates/workspace/main.tf`, bytes summed per body)\nafter the advisor and guard families landed: `coder_script.stack_advisors`, carrying four\nadvisor `SKILL.md` payloads, the `documenter` role, the code-index skill and its helper,\ncomposes to 71032 bytes, and `coder_script.stack_hooks`, carrying the manifest, four\nguards and the deny list, to 39399 - 51848 and 83481 clear of the bound respectively,\nwith neither startup twin touched."},"326":{"id":"/coder-templates-207","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#escape-hatches-when-a-body-outgrows-the-bound","content":"When a body really does need to grow past the budget, the options are:"},"327":{"id":"/coder-templates-208","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#escape-hatches-when-a-body-outgrows-the-bound","content":"**Move the prose out.** Rationale belongs in this file, not in `startup.sh.tftpl`.\nComments in the template are bytes in everybody's argument; here they cost nothing."},"328":{"id":"/coder-templates-209","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#escape-hatches-when-a-body-outgrows-the-bound","content":"**Stage the payload as a file, not an argument.** The obvious resource does not\nexist: the OSS provider's `ResourcesMap` (`provider/provider.go`) registers\n`coder_agent`, `coder_agent_instance`, `coder_ai_task`, `coder_app`,\n`coder_metadata`, `coder_script`, `coder_env`, `coder_devcontainer` and\n`coder_external_agent`, and nothing else. `coder_file` was requested in\n`coder/coder#3055` and closed `not_planned` on 2022-09-23; a maintainer was still\nasking for it in 2025. Do not plan around it."},"329":{"id":"/coder-templates-210","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#escape-hatches-when-a-body-outgrows-the-bound","content":"**`coder_env` is the only provably-earlier file write.** The agent's\n`writeSecretFiles` (`agent.go`) runs before any start script, `MkdirAll 0700` then\n`WriteFile 0600`. It takes a string value, so it can carry a payload, and it writes\ninto the agent's secret directory rather than anywhere you name."},"330":{"id":"/coder-templates-211","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#escape-hatches-when-a-body-outgrows-the-bound","content":"**`CODER_SCRIPT_DATA_DIR` is the per-script scratch the agent already hands you.**\n`agent/agentscripts/agentscripts.go` appends `CODER_SCRIPT_DATA_DIR` and\n`CODER_SCRIPT_BIN_DIR` to every script's environment, which is a writable place to\nassemble something across scripts."},"331":{"id":"/coder-templates-212","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#escape-hatches-when-a-body-outgrows-the-bound","content":"What is deliberately not done: bind-mounting `templates/` into the workspace so the\nscript can `cat` a payload off the host, and fetching one over HTTP at boot. The first\ncouples boot to a host path that a template push rewrites, and the second puts a\nnetwork dependency on the path that creates the home directory."},"332":{"id":"/coder-templates-213","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#argument-handling","content":"No arguments pushes every template in `TEMPLATES_DEFAULT` order."},"333":{"id":"/coder-templates-214","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#argument-handling","content":"Arguments are template *names*, and they select which names to push. A name that is not\none of the known names is an error that lists the known names, so a typo cannot quietly\ndo nothing."},"334":{"id":"/coder-templates-215","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#argument-handling","content":"A repeated name is one push, not two, and the push order stays `TEMPLATES_DEFAULT`\norder whatever the argument order is. Naming `devcontainer` first cannot orphan it."},"335":{"id":"/coder-templates-216","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#argument-handling","content":"It is also the manual path after you register an account, and the retry path for one\ntemplate."},"336":{"id":"/coder-templates-217","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#where-it-runs-and-why","content":"Everything Coder-facing runs **inside the coder container**, against\n`http://127.0.0.1:3000`."},"337":{"id":"/coder-templates-218","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#where-it-runs-and-why","content":"That is the server's own plain listener (`CODER_HTTP_ADDRESS` binds `0.0.0.0:3000`\ninside the container), reached without crossing the reverse proxy, Authelia, or the WAN."},"338":{"id":"/coder-templates-219","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#where-it-runs-and-why","content":"`coder login` on the host must reach the API *before* it has a credential, and in\npublic mode the only URL it will use is `CODER_ACCESS_URL`, which Authelia gates."},"339":{"id":"/coder-templates-220","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#where-it-runs-and-why","content":"Its first unauthenticated call (the first-user check) gets the HTML sign-in page back,\nand the CLI reports that as `unexpected non-JSON response \"text/html; charset=utf-8\"`."},"340":{"id":"/coder-templates-221","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#where-it-runs-and-why","content":"Loopback inside the container cannot be gated, so the push cannot fail that way."},"341":{"id":"/coder-templates-222","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#where-it-runs-and-why","content":"It runs the image's own `coder` binary, so client and server are the same build."},"342":{"id":"/coder-templates-223","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#where-it-runs-and-why","content":"No host `coder` CLI and no `coder login` are involved, and a stale host-side session\ncannot aim the push at some other deployment."},"343":{"id":"/coder-templates-224","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#credentials","content":"The script mints a short-lived token by inserting a row into the stack's own Postgres."},"344":{"id":"/coder-templates-225","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#credentials","content":"Same trust model as `coder reset-password`, which also bypasses the API and talks to\nthe database directly."},"345":{"id":"/coder-templates-226","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#credentials","content":"The token is scoped to minutes (`CODER_PUSH_TOKEN_MINUTES`, default 10), deleted on the\nway out including on a failed or interrupted run, never printed, and minted **once** for\nthe whole run however many templates it covers."},"346":{"id":"/coder-templates-227","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#credentials","content":"Its scope has to be `coder:all` with `allow_list` `{*:*}`: a narrowed token fails the\nCLI's opening organization lookups, so least privilege is not available on v2.36."},"347":{"id":"/coder-templates-228","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#credentials","content":"Template source travels as a tar on stdin (`coder templates push --directory -`), so\nnothing is copied into the container or its volumes."},"348":{"id":"/coder-templates-229","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#credentials","content":"A push is also the only thing that *registers* a template: Coder stores the source as a\nFilestore row, not as files it scans on disk."},"349":{"id":"/coder-templates-230","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#credentials","content":"The tar is built from a throwaway staging copy, not from the template dir itself."},"350":{"id":"/coder-templates-231","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#credentials","content":"`.terraform/` is excluded (pushing it would put the plan's provider binaries into the\nversion's Filestore row)"},"351":{"id":"/coder-templates-232","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#credentials","content":"symlinks are dumped as their targets (`tar -h`)"},"352":{"id":"/coder-templates-233","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#credentials","content":"the `templates/common/` payloads are copied in beside `main.tf`"},"353":{"id":"/coder-templates-234","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#credentials","content":"A staged copy that still holds a symlink is refused before the CLI runs."},"354":{"id":"/coder-templates-235","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#credentials","content":"Then, per template, it confirms an **active** template version. A push can exit 0 and\nstill leave the template inactive if its Terraform run failed, which shows up as the\ntemplate missing from the create dropdown."},"355":{"id":"/coder-templates-236","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#env-keys-it-reads","content":"Nothing else about GitHub travels in a `--var`."},"356":{"id":"/coder-templates-237","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#env-keys-it-reads","content":"| Read from `.env` | Passed as      | Condition                           |\n| ---------------- | -------------- | ----------------------------------- |\n| `DEV_IMAGE`      | `--var image=` | always; default `evo-t1-dev:latest` |","table":"table-0"},"357":{"id":"/coder-templates-238","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#env-keys-it-reads","content":"| Read from `.env`     | Passed as            | Condition                                                     |\n| -------------------- | -------------------- | ------------------------------------------------------------- |\n| `LITELLM_MASTER_KEY` | `--var litellm_key=` | only when the key is real, never the `change-me*` placeholder |","table":"table-0"},"358":{"id":"/coder-templates-239","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#env-keys-it-reads","content":"| Read from `.env`  | Passed as                | Condition                           |\n| ----------------- | ------------------------ | ----------------------------------- |\n| `CODER_AGENT_URL` | `--var coder_agent_url=` | only when the key is present at all |","table":"table-0"},"359":{"id":"/coder-templates-240","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#env-keys-it-reads","content":"| Read from `.env`    | Passed as                  | Condition                                                                                        |\n| ------------------- | -------------------------- | ------------------------------------------------------------------------------------------------ |\n| `GROK_PROFILE_MODE` | `--var grok_profile_mode=` | when non-empty; the retired `GROK_PROFILE_SHARE` maps (`true` to `shared`, `false` to `private`) |","table":"table-0"},"360":{"id":"/coder-templates-241","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#env-keys-it-reads","content":"| Read from `.env` | Passed as         | Condition                       |\n| ---------------- | ----------------- | ------------------------------- |\n| `REPO_URL`       | `--var repo_url=` | only when present and non-empty |","table":"table-0"},"361":{"id":"/coder-templates-242","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#env-keys-it-reads","content":"| Read from `.env` | Passed as                | Condition                                                                                                                               |\n| ---------------- | ------------------------ | --------------------------------------------------------------------------------------------------------------------------------------- |\n| `GITHUB_MCP`     | `--var github_mcp=false` | only when the value is `false` (the github MCP server is on by default; any other value pushes nothing and the template default stands) |","table":"table-0"},"362":{"id":"/coder-templates-243","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#env-keys-it-reads","content":"| Read from `.env` | Passed as                  | Condition                                                                                                                                        |\n| ---------------- | -------------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `CONTEXT7_MCP`   | `--var context7_mcp=false` | only when the value is `false` (the cached context7 MCP server is on by default; any other value pushes nothing and the template default stands) |","table":"table-0"},"363":{"id":"/coder-templates-244","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#env-keys-it-reads","content":"| Read from `.env`   | Passed as                    | Condition                                      |\n| ------------------ | ---------------------------- | ---------------------------------------------- |\n| `CONTEXT7_API_KEY` | `--var context7_api_key=...` | only when non-empty; the value is never logged |","table":"table-0"},"364":{"id":"/coder-templates-245","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#env-keys-it-reads","content":"| Read from `.env` | Passed as                | Condition                      |\n| ---------------- | ------------------------ | ------------------------------ |\n| `SEARCH_MCP`     | `--var search_mcp=false` | only when the value is `false` |","table":"table-0"},"365":{"id":"/coder-templates-246","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#env-keys-it-reads","content":"| Read from `.env`    | Passed as                                              | Condition                                                 |\n| ------------------- | ------------------------------------------------------ | --------------------------------------------------------- |\n| `STACK_SEARCH_PORT` | `--var searxng_url=http://host.docker.internal:<port>` | always; a blank or non-numeric value falls back to `8181` |","table":"table-0"},"366":{"id":"/coder-templates-247","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#env-keys-it-reads","content":"| Read from `.env`    | Passed as                      | Condition                                                                                                                                  |\n| ------------------- | ------------------------------ | ------------------------------------------------------------------------------------------------------------------------------------------ |\n| `INFISICAL_ENABLED` | `--var infisical_enabled=true` | only when truthy (`on`/`1`/`true`/`yes`); absent, blank or any other value passes nothing and each template's own `default = false` stands |","table":"table-0"},"367":{"id":"/coder-templates-248","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#env-keys-it-reads","content":"| Read from `.env`          | Passed as                            | Condition                                                                                     |\n| ------------------------- | ------------------------------------ | --------------------------------------------------------------------------------------------- |\n| `INFISICAL_PULL_ON_START` | `--var infisical_pull_on_start=true` | only when truthy **and** `INFISICAL_ENABLED` is truthy, because it is read inside that branch |","table":"table-0"},"368":{"id":"/coder-templates-249","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#env-keys-it-reads","content":"| Read from `.env` | Passed as                                                | Condition                                                                                                                                                                                                     |\n| ---------------- | -------------------------------------------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `INFISICAL_PORT` | `--var infisical_url=http://host.docker.internal:<port>` | read inside the `INFISICAL_ENABLED` branch, so a vault-off push passes no URL at all; the value is composed rather than forwarded, and an unset, blank or non-numeric port falls back to the published `8182` |","table":"table-0"},"369":{"id":"/coder-templates-250","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#env-keys-it-reads","content":"| Read from `.env`       | Passed as                        | Condition                      |\n| ---------------------- | -------------------------------- | ------------------------------ |\n| `INFISICAL_PROJECT_ID` | `--var infisical_project_id=...` | same reader and same condition |","table":"table-0"},"370":{"id":"/coder-templates-251","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#env-keys-it-reads","content":"| Read from `.env`                | Passed as                                 | Condition                      |\n| ------------------------------- | ----------------------------------------- | ------------------------------ |\n| `INFISICAL_MACHINE_IDENTITY_ID` | `--var infisical_machine_identity_id=...` | same reader and same condition |","table":"table-0"},"371":{"id":"/coder-templates-252","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#env-keys-it-reads","content":"| Read from `.env`                     | Passed as                       | Condition                                                                              |\n| ------------------------------------ | ------------------------------- | -------------------------------------------------------------------------------------- |\n| `INFISICAL_UNIVERSAL_AUTH_CLIENT_ID` | `--var infisical_client_id=...` | same reader and same condition; the two names differ on purpose (see the bullet below) |","table":"table-0"},"372":{"id":"/coder-templates-253","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#env-keys-it-reads","content":"| Read from `.env`                         | Passed as                           | Condition                                                                                                                                                          |\n| ---------------------------------------- | ----------------------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET` | `--var infisical_client_secret=...` | same; handled exactly as `context7_api_key` is, so the value reaches the CLI as an argument and appears in no log line, including the line that says it was passed |","table":"table-0"},"373":{"id":"/coder-templates-254","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#env-keys-it-reads","content":"| Read from `.env`        | Passed as                         | Condition                      |\n| ----------------------- | --------------------------------- | ------------------------------ |\n| `INFISICAL_ENVIRONMENT` | `--var infisical_environment=...` | same reader and same condition |","table":"table-0"},"374":{"id":"/coder-templates-255","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-three-mcp-switches-and-the-search-port","content":"`GITHUB_MCP`, `CONTEXT7_MCP` and `SEARCH_MCP` share one polarity: all three MCP blocks\nship from the template default (`true`), so the only value worth setting is `false`,\nand `true`/unset/empty pushes nothing at all."},"375":{"id":"/coder-templates-256","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-three-mcp-switches-and-the-search-port","content":"The two research lanes split by question type: a library, framework, CLI or setup\nquestion goes to `context7` (resolve the library id first, then query docs on that\nid), anything else on the web goes to the `searxng` `search` tool, and a URL already\nin hand goes to `searxng`'s `fetch_content`. Grok's native `web_search` is parked\nhere, and native `web_fetch` is unavailable because that tool needs an egress proxy\nendpoint this stack does not run, so `SEARCH_MCP=false` leaves a session with library\ndocs and no way to reach the web."},"376":{"id":"/coder-templates-257","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-three-mcp-switches-and-the-search-port","content":"A dev stack that moved the search port needs its own template push: `searxng_url`\nis derived from `STACK_SEARCH_PORT` as read from `.env`, so a push made while\n`dev-stack.env` carries `18181` still names `8181` unless the key is set in `.env`\ntoo. A workspace dials the host gateway, where the compose network does not help,\nso the port in the rendered `SEARXNG_URL` has to be the one actually published."},"377":{"id":"/coder-templates-258","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-clone-and-the-agent-url","content":"`repo_url` prefills the Git repository field on both create forms. The Terraform\ndefault is still no clone (`workspace`) or the coder/coder demo (`devcontainer`).\n`.env.sample` sets `REPO_URL` to this stack's GitHub URL, so a normal push prefills\n`https://github.com/toxicoder/evo-t1-coder-stack.git` and **VS Code Web** opens\n`~/workspace/evo-t1-coder-stack`. A blank `REPO_URL=` line stays unpassed."},"378":{"id":"/coder-templates-259","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-clone-and-the-agent-url","content":"There is no GitHub-token template variable, so no push ever carries a personal access\ntoken. See GitHub credentials for a workspace."},"379":{"id":"/coder-templates-260","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-clone-and-the-agent-url","content":"`coder_agent_url` exists so agents keep dialing the local plain listener when\n`CODER_ACCESS_URL` is a public name."},"380":{"id":"/coder-templates-261","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-vault-keys-and-their-two-gates","content":"The five values the boot reads the vault with are forwarded **whether or not the flag is\non** (`scripts/push-template.sh:696-730`), so adopting the vault later is a re-push of one\nword rather than a re-config of five, and a stack that never adopted Infisical pushes none\nof them."},"381":{"id":"/coder-templates-262","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-vault-keys-and-their-two-gates","content":"None of the five is echoed either: a project id and a machine identity id both end up\ntranscribed into whoever's CI log this output lands in, so the log line names only the\nkey a value came from (`scripts/push-template.sh:696-700`)."},"382":{"id":"/coder-templates-263","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-vault-keys-and-their-two-gates","content":"The sixth value, the instance URL, is the one a workspace cannot do without and the one\nthis script composes rather than forwards, inside the flag gate\n(`scripts/push-template.sh:652-661`): `.env`'s `INFISICAL_URL` is the address the *host*\ndials, and a container handed that spelling reaches its own loopback, where nothing\nlistens."},"383":{"id":"/coder-templates-264","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-vault-keys-and-their-two-gates","content":"Both gates are read with this script's own `env_get`, not with `infisical_enabled` from\n`scripts/lib/infisical.sh`: no push variable there reads the process environment, so a\nstray exported `INFISICAL_ENABLED` cannot change what gets pushed\n(`scripts/push-template.sh:632-635`)."},"384":{"id":"/coder-templates-265","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-vault-keys-and-their-two-gates","content":"The name shift on the Universal Auth pair is deliberate: the templates name the variables\nafter what the values *are* (`infisical_client_id`, `infisical_client_secret`), `.env`\nnames its keys after how the Infisical CLI reads them\n(`INFISICAL_UNIVERSAL_AUTH_CLIENT_ID`, `..._SECRET`), and `bazelisk run //scripts:infisical\n-- check` is the reader that keeps the `.env` spelling honest\n(`scripts/push-template.sh:686-689`, `:709-714`, `:725-730`)."},"385":{"id":"/coder-templates-266","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-vault-keys-and-their-two-gates","content":"The vault itself is not this page's subject: the three compose services, the operator CLI,\nthe managed key inventory, the outage bounds and rotation are\noperate/secrets.md. What the templates do with what these keys\nforward is The Infisical boot fetch."},"386":{"id":"/coder-templates-267","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#knobs-and-skips","content":"`CODER_CONTAINER_SERVICE` (default `coder`), `CODER_DB_SERVICE` (default `db`),\n`CODER_CONTAINER_API_URL` (default `http://127.0.0.1:3000`), `CODER_PUSH_USER`,\n`CODER_PUSH_TOKEN_MINUTES`, `DOCKER_BIN`, `PROBE_TIMEOUT` (20s) and `VERIFY_TIMEOUT`\n(60s) are the overrides."},"387":{"id":"/coder-templates-268","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#knobs-and-skips","content":"A missing `docker`, `timeout`, `tar` or `openssl`, a stack that is not running, or no\nactive Coder account is a *skip*: a one-line reason and exit 0. `bootstrap.sh` calls\nthis script, and a fresh clone has none of those prerequisites yet."},"388":{"id":"/coder-templates-269","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#knobs-and-skips","content":"`SKIP_TEMPLATE_PUSH=1 bazelisk run //scripts:bootstrap` skips the step."},"389":{"id":"/coder-templates-270","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#knobs-and-skips","content":"A `DEV_IMAGE` that is not in the local image store is a note, not a stop: build it\nfirst with `bazelisk run //scripts:build-dev-image`."},"390":{"id":"/coder-templates-271","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-same-push-by-hand","content":"The supported push is `bazelisk run //scripts:push-template`: no arguments pushes every\ntemplate, a template name retries just that one, and the image tag comes from `DEV_IMAGE`\nin `.env`. The raw equivalent below is what that script does internally — it streams the\nsame tar and makes the same CLI call the script makes for each template, execing into the\ndaemon's `coder` container by name."},"391":{"id":"/coder-templates-272","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#why-the-raw-form-differs-from-the-script","content":"That form addresses the stack through `docker compose` instead, so it names the\nproject with `-p`. From the checkout root the folder name would have said the same thing."},"392":{"id":"/coder-templates-273","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#why-the-raw-form-differs-from-the-script","content":"The service appears twice by necessity: the first `coder` selects the compose service, the\nsecond is the CLI binary inside it."},"393":{"id":"/coder-templates-274","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-token-then-the-tar","content":"Set a token first. `CODER_SESSION_TOKEN` is any token from the Coder **Tokens** page or\nfrom `coder tokens create`."},"394":{"id":"/coder-templates-275","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-token-then-the-tar","content":"Then push `workspace` (the repo is not mounted into the container, so the directory has to\ntravel as a tar):"},"395":{"id":"/coder-templates-276","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-token-then-the-tar","content":"Use this shape for reference, or for pushing a tag `.env` does not carry."},"396":{"id":"/coder-templates-277","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-token-then-the-tar","content":"`coder templates` is the canonical name; `template` is its alias."},"397":{"id":"/coder-templates-278","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-token-then-the-tar","content":"The docker provider resolves `evo-t1-dev:latest` from the local image store and never\nattempts a registry pull, which is what keeps workspace creation working with no\ninternet."},"398":{"id":"/coder-templates-279","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#pinning-autostop-by-hand","content":"Autostop is metadata, not Terraform. Re-pin it with `templates edit` after a push made\nfrom the checkout root, or on the dev stack swap `-p evo-t1-coder-stack` for\n`-p evo-t1-dev --env-file dev-stack.env`."},"399":{"id":"/coder-templates-280","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#pinning-autostop-by-hand","content":"Point the CLI at the in-container plain listener, with a token by name:"},"400":{"id":"/coder-templates-281","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#pinning-autostop-by-hand","content":"Then re-pin both values:"},"401":{"id":"/coder-templates-282","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#pinning-autostop-by-hand","content":"Check it in the Coder UI afterwards: **Default autostop** must read *Disabled* (0 h)."},"402":{"id":"/coder-templates-283","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#create-form-fields","content":"What a create form shows, in `workspace` order."},"403":{"id":"/coder-templates-284","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-image-the-daemon-and-the-repositories","content":"**Workspace image** (`workspace_image`, dropdown, immutable). `--var image=` seeds its\ndefault and is also injected as its own option, so a custom tag still reaches the\ncontainer while the form stays honest about what it is building."},"404":{"id":"/coder-templates-285","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-image-the-daemon-and-the-repositories","content":"**Docker-in-docker** (`dind`, Yes/No radio, immutable)."},"405":{"id":"/coder-templates-286","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-image-the-daemon-and-the-repositories","content":"**Git repository** (`repo_url`, input, mutable). The Terraform default is empty\n(`workspace`) or the coder/coder demo (`devcontainer`); after a push that forwards\n`.env` `REPO_URL` (this stack's own repo in the sample) the form prefills that URL.\nAnything you type is cloned into the workspace on the next start."},"406":{"id":"/coder-templates-287","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-image-the-daemon-and-the-repositories","content":"**Git repositories (additional)** (`additional_repos`, textarea, mutable, default\nempty)."},"407":{"id":"/coder-templates-288","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-image-the-daemon-and-the-repositories","content":"**Grok profile** (`grok_profile_mode`, dropdown, immutable, default `shared`):"},"408":{"id":"/coder-templates-289","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-image-the-daemon-and-the-repositories","content":"`shared` puts that workspace's notes, memory and sessions on one per-owner volume\neach"},"409":{"id":"/coder-templates-290","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-image-the-daemon-and-the-repositories","content":"`private` mounts no per-owner volume, so all three live on that workspace's own\nhome volume and die with it"},"410":{"id":"/coder-templates-291","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-image-the-daemon-and-the-repositories","content":"`config.toml` is that workspace's own file in both modes, and switching needs a\nrebuild."},"411":{"id":"/coder-templates-292","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-image-the-daemon-and-the-repositories","content":"**Grok default model** (`grok_default_model`, dropdown, immutable, default `agent`)."},"412":{"id":"/coder-templates-293","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-image-the-daemon-and-the-repositories","content":"**Grok config extras** (`grok_config_extra`, textarea, mutable, default empty).\nWhatever you type is appended verbatim, under a comment header, to that workspace's\nrendered `~/.grok/config.toml`. That file is this workspace's own in either profile\nmode, so the extras reach it alone."},"413":{"id":"/coder-templates-294","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-image-the-daemon-and-the-repositories","content":"**Grok theme** (`grok_theme`, free-form, mutable, default `grokbuild`). Rendered as\n`[ui] theme` in that workspace's `~/.grok/config.toml`; the literal `auto` renders the\nCLI's `groknight`/`grokday` pair instead of a fixed theme. Each workspace keeps its own."},"414":{"id":"/coder-templates-295","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-theme-and-the-approval-mode","content":"**Editor colour theme** (`vscode_color_theme`, free-form, mutable, default\n`Default Dark Modern`). Written as `workbench.colorTheme` in that workspace's\ncode-server User settings, where it wins over the shared editor-settings overlay."},"415":{"id":"/coder-templates-296","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-theme-and-the-approval-mode","content":"**Grok approval mode** (`grok_permission_mode`, dropdown, mutable, default\n`always-approve`). How much that workspace's Grok sessions stop and ask before they\nact, rendered as `[ui] permission_mode` in that workspace's `~/.grok/config.toml`.\nThe dropdown offers exactly four values:"},"416":{"id":"/coder-templates-297","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-theme-and-the-approval-mode","content":"`default` (the CLI's own policy, which does prompt)"},"417":{"id":"/coder-templates-298","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-theme-and-the-approval-mode","content":"`ask` (a tool call waits for a person)"},"418":{"id":"/coder-templates-299","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-theme-and-the-approval-mode","content":"`auto` (prompts less than `ask`)"},"419":{"id":"/coder-templates-300","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-theme-and-the-approval-mode","content":"`always-approve` (nothing prompts; the product name for `bypassPermissions`)."},"420":{"id":"/coder-templates-301","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-theme-and-the-approval-mode","content":"What it\n    relaxes is prompting only - the `[permission]` deny list the render ships still\n    refuses the dotenv reads, the `Bash(rm -rf *)` form and the commit guards in every\n    mode."},"421":{"id":"/coder-templates-302","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-theme-and-the-approval-mode","content":"`order = 10`, so it sorts after the editor theme rather than beside the two\n    themes."},"422":{"id":"/coder-templates-303","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-theme-and-the-approval-mode","content":"Each workspace keeps its own and a change applies on the next start."},"423":{"id":"/coder-templates-304","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-theme-and-the-approval-mode","content":"Those\n    four are what the `[ui] permission_mode` key documents, not the whole vocabulary the\n    CLI speaks: its own `--permission-mode` flag spells more, so a mode outside this\n    dropdown belongs in the `[ui]` block of `~/.grok/config.toml` by hand, and the next\n    start replaces it with what this field says - and says so on the boot log, naming the\n    value it dropped."},"424":{"id":"/coder-templates-305","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-devcontainer-forms-two-questions","content":"`devcontainer` asks two questions instead: **Git repository** and **Build repo's dev\ncontainer** (`use_devcontainer`, Yes/No, immutable), plus the same Grok and theme fields."},"425":{"id":"/coder-templates-306","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#template-variables","content":"Template variables are pushed defaults; the create form can still override them per\nworkspace."},"426":{"id":"/coder-templates-307","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#template-variables","content":"The four `grok_*_lane` knobs below are `--var` only, and each moves one role, so a single\nrole can be put back on the parent's pinned lane without moving the others - the rollback\nan operator needs when a workspace is older than the LiteLLM config that registers its\nalias (`templates/workspace/coder.tf:19-22`)."},"427":{"id":"/coder-templates-308","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#every-variable-its-default-and-its-notes","content":"| Variable | Default             | Notes                                                                                                                       |\n| -------- | ------------------- | --------------------------------------------------------------------------------------------------------------------------- |\n| `image`  | `evo-t1-dev:latest` | Seeds the **Workspace image** dropdown default. In `devcontainer` it decides nothing about the toolchain inside the editor. |","table":"table-1"},"428":{"id":"/coder-templates-309","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#every-variable-its-default-and-its-notes","content":"| Variable      | Default                               | Notes                                    |\n| ------------- | ------------------------------------- | ---------------------------------------- |\n| `litellm_url` | `http://host.docker.internal:4000/v1` | Reached through the Docker host gateway. |","table":"table-1"},"429":{"id":"/coder-templates-310","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#every-variable-its-default-and-its-notes","content":"| Variable      | Default           | Notes                                        |\n| ------------- | ----------------- | -------------------------------------------- |\n| `litellm_key` | `\"\"`, `sensitive` | Handed to the workspace as `LITELLM_API_KEY` |","table":"table-1"},"430":{"id":"/coder-templates-311","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#every-variable-its-default-and-its-notes","content":"| Variable             | Default | Notes                                                                                                                                                                                |\n| -------------------- | ------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `grok_default_model` | `agent` | `agent` is the tool-capable Spark lane (thinking `xhigh` by default, picker `low` / `medium` / `xhigh`); `agent-low` / `agent-medium` / `agent-xhigh` bake the level into the alias. |","table":"table-1"},"431":{"id":"/coder-templates-312","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#every-variable-its-default-and-its-notes","content":"| Variable              | Default       | Notes                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |\n| --------------------- | ------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `grok_subagents_lane` | `agent-swarm` | The Grok catalog key the **writers** run on, rendered into `[subagents.models]` for `general-purpose` (the type a spawn gets when it names none, so every writer in a fan-out) and for the seeded `implementer` and `tester` definitions. It used to carry all three built-in types, which made the swarm lane a lie: the writers inherited the parent's pinned model and queued behind one box anyway. Each other role has a knob of its own now, so this one no longer moves the whole fleet by itself. A `--var` knob only, and the default ships the writers on the unpinned fleet lane, where the least-busy picker places a fan-out across all three boxes; `--var grok_subagents_lane=agent` is the rollback that puts them back on the same pinned lane as the parent session. It chooses placement only; the fan-out width below comes from `grok_subagent_max_concurrent`, and no lane knob moves it. |","table":"table-1"},"432":{"id":"/coder-templates-313","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#every-variable-its-default-and-its-notes","content":"| Variable            | Default         | Notes                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |\n| ------------------- | --------------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `grok_explore_lane` | `agent-explore` | The Grok catalog key the read-only mappers run on: `[subagents.models]` for the built-in `explore` type and for the seeded `explorer` definition. `agent-explore` is the second Spark group with no LiteLLM session pin, thinking baked to `low`, so a wave of one-shot mappers is placed across all three boxes instead of queueing behind one box's streams - and the pin was never protecting anything here, because a mapper gets one turn and never re-reads its own prompt, which is what a warm prefix would have paid for. `--var grok_explore_lane=agent-low` keeps `low` with the pin back on; `=agent` sends mapping work at the parent's full depth. A validation block keeps the value one bare catalog key (`templates/workspace/coder.tf:28-31`). |","table":"table-1"},"433":{"id":"/coder-templates-314","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#every-variable-its-default-and-its-notes","content":"| Variable         | Default | Notes                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |\n| ---------------- | ------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `grok_plan_lane` | `agent` | The Grok catalog key the planner runs on: `[subagents.models]` for the built-in `plan` type and for the seeded `architect` definition. The one role lane that ships **pinned**, deliberately - a planner is a single conversation that re-reads what it just read and whose answer steers every wave after it, so stickiness and depth both pay where spreading would only re-prefill the same history. `--var grok_plan_lane=agent-medium` trades depth for turnaround on a busy fleet; `agent-xhigh` is the other way. Same bare-key validation (`templates/workspace/coder.tf:38-41`). |","table":"table-1"},"434":{"id":"/coder-templates-315","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#every-variable-its-default-and-its-notes","content":"| Variable           | Default        | Notes                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            |\n| ------------------ | -------------- | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `grok_review_lane` | `agent-review` | The Grok catalog key the skeptics run on: `[subagents.models]` for `reviewer` and `security-auditor`, the two seeded definitions the mandatory independent-review phase of a multi-file change runs as. `agent-review` bakes thinking to `xhigh` and lifts the session pin the way `agent-swarm` does, so a wave of reviewers spreads over the fleet and each one thinks as hard as the parent session it reports to. It is also the single seam for the cost of that phase: `--var grok_review_lane=agent-medium`, with the alias in `litellm/config.yaml` moved with it, makes every review cheaper without touching the writers, the mappers or the planner. Same bare-key validation (`templates/workspace/coder.tf:48-51`). |","table":"table-1"},"435":{"id":"/coder-templates-316","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#every-variable-its-default-and-its-notes","content":"| Variable           | Default | Notes                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |\n| ------------------ | ------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `grok_swarm_width` | `15`    | The fleet's own ceiling, and the width a workspace gets only when it sets `grok_subagent_max_concurrent = null` on purpose; the width itself is the other variable's own shipped 15, so the cap is 15 on every lane, pinned or unpinned. That 15 is fleet arithmetic, not taste: 3 Spark boxes x `PARALLEL` 5 full-length streams (`scripts/spark-configure.sh`) is everything the fleet can hold at once. It is a plain default rather than a lane-conditional number because `agent-swarm` is always selectable - the `[model.\"agent-swarm\"]` block ships ungated in `grok-config.toml.tftpl`, so a session whose default lane is pinned can still name it on any subagent - and a config sized at one box's `PARALLEL` would cap a swarm the operator had only to ask for. Same 1..32 validation, and above the fleet's 15 streams a number deepens LiteLLM's queue rather than buying capacity (`templates/workspace/coder.tf:54-62`). It also travels into the rendered profile on its own, as the `# fleet-width: 15` line directly above `max_concurrent` inside `[subagents]` (`templates/workspace/grok-config.toml.tftpl:427`, fed by `grok_subagent_fleet_width = var.grok_swarm_width` at `templates/workspace/main.tf:558`), so a profile that a `--var` narrowed still shows the count the fleet was sized at. Shrinking a shared fleet is two knobs now: dropping this one moves that ceiling line alone, so set `grok_subagent_max_concurrent` with it, or 15 streams over a fleet sized at 10 are refused by the box with `NoRoom`. |","table":"table-1"},"436":{"id":"/coder-templates-317","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#every-variable-its-default-and-its-notes","content":"| Variable                       | Default | Notes                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               |\n| ------------------------------ | ------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `grok_subagent_max_concurrent` | `15`    | `[subagents] max_concurrent`: how many subagents one session may have in flight. The variable ships its own 15 outright - the fleet ceiling, 3 Spark boxes x `PARALLEL` 5 (`scripts/spark-configure.sh`) - so the width is this variable's own number and tracks no other knob, and the cap is 15 on every lane. `null` is the opt-in that hands the width to `grok_swarm_width` above: `main.tf` renders it as exactly `grok_subagent_max_concurrent = var.grok_subagent_max_concurrent != null ? var.grok_subagent_max_concurrent : var.grok_swarm_width` (`templates/workspace/main.tf:553`), with no lane test anywhere in that expression, so that `:` arm answers only a caller that passes null on purpose. An explicit `--var` still overrides the shipped 15, and a validation keeps any explicit value between 1 and 32 (`templates/workspace/coder.tf:64-72`); past the fleet's 15 streams a number deepens LiteLLM's queue rather than buying capacity. An explicit value persists in two places - on the template, from a raw `coder templates push --var`, and on the workspace, from `coder start --parameter` / `coder update --parameter` or the Variables tab (`--var` is a `coder templates push` flag alone; on Coder v2.36.6 `coder start --help` has no `--var`) - so a workspace's own value outlives every template version, while a value carried as a template version's default is replaced by the next push - `//scripts:push-template` sends no fan-out width of its own, so a re-push takes that parameter back to the `coder.tf` default, which is the literal 15 rather than a sentinel that resolves through another variable. Which of the two holds the number is not visible from inside the container: both live in the Coder database, on the host, and neither answers the agent token. The check that reads the pair asks to be run again after the restart, because the number moving is the only proof either remedy had an effect. The render keeps the pair legible from in there - `# fleet-width: 15` sits directly above `max_concurrent` in `[subagents]`, and `bazelisk run //scripts:subagent-check` compares them and prints what it found - and stage 6 of `templates/workspace/startup.sh.tftpl` prints the same mismatch on the startup log as it re-renders the file (Marker ownership of the seeded files). This is also the knob a pinned lane narrows: `agent` only ever reaches the one box its session key resolves to, whose `PARALLEL` (5 by default, `scripts/spark-configure.sh`) is the useful width, so setting it near 4 there keeps the session inside that box's streams instead of queueing behind them - an operator's choice, never the shipped default. Overflow is held, not failed (`limit_behavior = \"queue\"`), so overshoot costs a subagent latency rather than its life, and `sampling_limit` is left unset because it defaults to `max_concurrent`. |","table":"table-1"},"437":{"id":"/coder-templates-318","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#every-variable-its-default-and-its-notes","content":"| Variable                  | Default | Notes                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      |\n| ------------------------- | ------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `grok_subagent_max_depth` | `2`     | `[subagents] max_depth`: how deep the subagent tree may go. `1` keeps nesting off - only the top-level session spawns - and that is the rollback. `2` is the shipped default: a child may spawn read-only mappers of its own, so a skeptic scopes out its own evidence and the parent skips a round trip. `3` is the operator's experiment ceiling. Nesting is bounded by the role definitions: only `reviewer`, `security-auditor` and `tester` name `spawn_subagent` in `tools`, so a depth-2 wave is read-only work and a mapper has no spawner to recurse with. Every in-flight child holds one of the fleet's 15 streams (3 Spark boxes x `PARALLEL` 5, `scripts/spark-configure.sh`), so a parent sums `1 + spawns` over its in-flight tasks and keeps that total at or below the fleet's stream count - the `fleet:` figure a micro-plan states, which is a separate figure from the session's `slots`. An over-admitted stream is refused by the box. `--var grok_subagent_max_depth=N` sets it for one workspace; same bounded-knob shape as the width above, and the same rendering pass (`templates/workspace/coder.tf:74-82`). |","table":"table-1"},"438":{"id":"/coder-templates-319","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#every-variable-its-default-and-its-notes","content":"| Variable        | Default | Notes                                                         |\n| --------------- | ------- | ------------------------------------------------------------- |\n| `docker_socket` | `\"\"`    | Optional Docker socket URI; empty means the provider default. |","table":"table-1"},"439":{"id":"/coder-templates-320","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#every-variable-its-default-and-its-notes","content":"| Variable          | Default                            | Notes                                                                                                                                                                                            |\n| ----------------- | ---------------------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `coder_agent_url` | `http://host.docker.internal:3002` | The URL the agent dials. Kept on the local plain listener so a public `CODER_ACCESS_URL` does not hairpin agent traffic through the reverse proxy. Empty keeps the provider-rendered access URL. |","table":"table-1"},"440":{"id":"/coder-templates-321","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#every-variable-its-default-and-its-notes","content":"| Variable | Default | Notes                                                                                           |\n| -------- | ------- | ----------------------------------------------------------------------------------------------- |\n| `dind`   | `false` | Turns on the per-workspace privileged daemon described below. Does not exist in `devcontainer`. |","table":"table-1"},"441":{"id":"/coder-templates-322","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#every-variable-its-default-and-its-notes","content":"| Variable   | Default                                                                                                                                                 | Notes                                                                                                                                                                                                                                                                                                      |\n| ---------- | ------------------------------------------------------------------------------------------------------------------------------------------------------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `repo_url` | `\"\"` in `workspace`, `https://github.com/coder/coder` in `devcontainer` (Terraform); `.env.sample` `REPO_URL` overrides both to this stack's GitHub URL | Prefills the **Git repository** field. Both templates clone that URL on the first start; a later start leaves a folder that already holds a `.git` alone. `REPO_URL` in `.env` overrides the default. The sample value is this stack's own repo so **VS Code Web** opens `~/workspace/evo-t1-coder-stack`. |","table":"table-1"},"442":{"id":"/coder-templates-323","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#every-variable-its-default-and-its-notes","content":"| Variable           | Default | Notes                                                                                                                                 |\n| ------------------ | ------- | ------------------------------------------------------------------------------------------------------------------------------------- |\n| `additional_repos` | `\"\"`    | The **Git repositories (additional)** textarea under the repository field. Extra URLs cloned into their own folder beside `repo_url`. |","table":"table-1"},"443":{"id":"/coder-templates-324","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#every-variable-its-default-and-its-notes","content":"| Variable            | Default  | Notes                                                                                                                                                                                                                                                                                                                                                                                                                                                             |\n| ------------------- | -------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `grok_profile_mode` | `shared` | `shared` mounts the owner's three Grok state volumes (`grok-notes-<owner-id>`, `grok-memory-<owner-id>`, `grok-sessions-<owner-id>`) at `~/.grok/notes`, `~/.grok/memory` and `~/.grok/sessions`, inside that workspace's own home volume; `private` mounts none of them and the workspace starts with an empty `~/.grok`. Also the default behind the per-workspace **Grok profile** dropdown; switching a live workspace between the two modes needs a rebuild. |","table":"table-1"},"444":{"id":"/coder-templates-325","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#every-variable-its-default-and-its-notes","content":"| Variable     | Default | Notes                                                                                                                                                                                                                                              |\n| ------------ | ------- | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `github_mcp` | `true`  | Wires the `github` MCP HTTP server into Grok's rendered `config.toml`. Its `Authorization` header names `$GH_TOKEN` and nothing else, so no token value is ever part of a template variable. Set `GITHUB_MCP=false` and re-push to drop the block. |","table":"table-1"},"445":{"id":"/coder-templates-326","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#every-variable-its-default-and-its-notes","content":"| Variable       | Default | Notes                                                                                                                                                                                  |\n| -------------- | ------- | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `context7_mcp` | `true`  | Wires the cached `context7` MCP stdio server into Grok's rendered `config.toml`. The key is optional, so it ships without one. Set `CONTEXT7_MCP=false` and re-push to drop the block. |","table":"table-1"},"446":{"id":"/coder-templates-327","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#every-variable-its-default-and-its-notes","content":"| Variable           | Default           | Notes                                                                                |\n| ------------------ | ----------------- | ------------------------------------------------------------------------------------ |\n| `context7_api_key` | `\"\"`, `sensitive` | Handed to the workspace as `CONTEXT7_API_KEY`. The rendered file names the variable. |","table":"table-1"},"447":{"id":"/coder-templates-328","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#every-variable-its-default-and-its-notes","content":"| Variable            | Default | Notes                                                                                                                                              |\n| ------------------- | ------- | -------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `grok_config_extra` | `\"\"`    | The **Grok config extras** textarea: free-form TOML appended verbatim, under a comment header, to that workspace's rendered `~/.grok/config.toml`. |","table":"table-1"},"448":{"id":"/coder-templates-329","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#every-variable-its-default-and-its-notes","content":"| Variable            | Default | Notes                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              |\n| ------------------- | ------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `infisical_enabled` | `false` | The vault's switch, and the first of two gates. Off means the workspace cannot tell Infisical exists: no `INFISICAL_*` key in the agent env, no `coder_script.infisical_secrets` at all (`templates/workspace/main.tf:720-721`), no boot log line. Forwarded only as `--var infisical_enabled=true` for a truthy `.env` `INFISICAL_ENABLED` (`scripts/push-template.sh:636-638`), which is the deliberate inverse of `OBSERVABILITY_ENABLED` - that bundle ships on, so here an absent key is off (`scripts/push-template.sh:623-630`). All eight `infisical_*` variables exist in both twins (`templates/workspace/coder.tf:207-274`, `templates/devcontainer/coder.tf:194-261`). |","table":"table-1"},"449":{"id":"/coder-templates-330","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#every-variable-its-default-and-its-notes","content":"| Variable        | Default | Notes                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        |\n| --------------- | ------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `infisical_url` | `\"\"`    | Handed to the boot fetch as `INFISICAL_DOMAIN`: the base URL of the self-hosted instance, e.g. `http://host.docker.internal:8182`. The CLI dials Infisical Cloud when handed no domain, so an empty value disables the fetch rather than guessing one, and a self-hosted vault nobody names is a wrong-server bug (`templates/workspace/coder.tf:215-219`). `//scripts:push-template` composes the value as `http://host.docker.internal:<INFISICAL_PORT>` rather than forwarding `.env`'s `INFISICAL_URL`, because that key is the address the stack host dials and a workspace has to reach the host gateway instead (`scripts/push-template.sh:652-661`). |","table":"table-1"},"450":{"id":"/coder-templates-331","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#every-variable-its-default-and-its-notes","content":"| Variable               | Default | Notes                                                                                                                                                                                                            |\n| ---------------------- | ------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `infisical_project_id` | `\"\"`    | → `INFISICAL_PROJECT_ID`. The project the export reads. Not a credential, but no read works without it, so an empty value disables the fetch the way an empty URL does (`templates/workspace/coder.tf:221-227`). |","table":"table-1"},"451":{"id":"/coder-templates-332","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#every-variable-its-default-and-its-notes","content":"| Variable                        | Default | Notes                                                                                                                                                                                                                                                                                                               |\n| ------------------------------- | ------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `infisical_machine_identity_id` | `\"\"`    | → `INFISICAL_MACHINE_IDENTITY_ID`. The machine identity the boot authenticates as - the id, never the token. It has no slot in any CLI argv, since the client id/secret are the credential, so it gates the fetch and records which identity the stack means (`templates/common/infisical-secrets.sh.tftpl:10-13`). |","table":"table-1"},"452":{"id":"/coder-templates-333","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#every-variable-its-default-and-its-notes","content":"| Variable              | Default | Notes                                                                                                                                                                                                                                                                                                    |\n| --------------------- | ------- | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `infisical_client_id` | `\"\"`    | → `INFISICAL_UNIVERSAL_AUTH_CLIENT_ID`. The Universal Auth client id; **not** sensitive, because it identifies the identity but cannot authenticate alone. `.env` spells this key the way the Infisical CLI reads it, which is the one name pair here that differs (`scripts/push-template.sh:709-714`). |","table":"table-1"},"453":{"id":"/coder-templates-334","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#every-variable-its-default-and-its-notes","content":"| Variable                  | Default           | Notes                                                                                                                                                                                                                                                                                                                                                                                       |\n| ------------------------- | ----------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `infisical_client_secret` | `\"\"`, `sensitive` | → `INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET`, and only when non-empty: it keeps its own conditional so an empty secret omits the key rather than handing the boot script a credential it would try to authenticate with (`templates/workspace/main.tf:654-657`). Never printed, and never interpolated into the body, which only names the variable (`templates/workspace/coder.tf:244-252`). |","table":"table-1"},"454":{"id":"/coder-templates-335","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#every-variable-its-default-and-its-notes","content":"| Variable                | Default | Notes                                                                                                                                                                                                                             |\n| ----------------------- | ------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `infisical_environment` | `prod`  | → `INFISICAL_ENVIRONMENT`. Which Infisical environment the export reads; the CLI takes `--env` on every read, so a fork that keeps another environment slug has no default that fits it (`templates/workspace/coder.tf:254-261`). |","table":"table-1"},"455":{"id":"/coder-templates-336","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#every-variable-its-default-and-its-notes","content":"| Variable                  | Default | Notes                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |\n| ------------------------- | ------- | --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `infisical_pull_on_start` | `false` | The second gate, under `infisical_enabled`, and it decides only whether a start *waits* on the vault. Forwarded only when both `.env` keys are truthy (`scripts/push-template.sh:636`, `:668-671`). Off leaves the script present but idle: one log line naming the gate and exit 0 (`templates/common/infisical-secrets.sh.tftpl:27-30`). Handed over as the string `\"true\"`/`\"false\"`, because a `coder_agent` env value has to be a string and the body compares it against a literal (`templates/workspace/main.tf:649-652`). |","table":"table-1"},"456":{"id":"/coder-templates-337","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#notes-on-the-two-dropdowns-that-take-a-custom-value","content":"The `grok_default_model` aliases are `agent`, `agent-low`, `agent-medium`,\n`agent-xhigh`, `agent-xhigh-fast`, `agent-swarm`, `agent-swarm-fast`, `coder`,\n`coder-fast` and `chat`, plus a **Custom** entry when the variable names another one."},"457":{"id":"/coder-templates-338","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#notes-on-the-two-dropdowns-that-take-a-custom-value","content":"The two `-fast` entries are the Spark lane each is named after, unchanged, with one call\nmoved: the proxy re-serves that session's conversation summary from the Arc group\n`compaction-fast`, which is the whole difference, because the CLI has no compaction-model\nkey of its own."},"458":{"id":"/coder-templates-339","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#notes-on-the-two-dropdowns-that-take-a-custom-value","content":"The provider requires a parameter default to be one of its options, which is why a\ncustom `--var` value is injected as its own option instead of being dropped."},"459":{"id":"/coder-templates-340","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#notes-on-the-two-dropdowns-that-take-a-custom-value","content":"A `github_mcp` of `true` with no GitHub account connected gives that workspace a server\nthat fails its handshake once per session, because `$GH_TOKEN` is empty."},"460":{"id":"/coder-templates-341","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#notes-on-the-two-dropdowns-that-take-a-custom-value","content":"A `context7_mcp` of `true` with an empty `context7_api_key` is *not* the same shape:\nthe key is optional, the block renders either way, and the server handshakes and\nanswers without one - no `Authorization` header goes out, so the lane runs at the\npublic rate limit and private libraries are the only thing out of reach."},"461":{"id":"/coder-templates-342","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#notes-on-the-two-dropdowns-that-take-a-custom-value","content":"That keyless block is the pushed default and what a fresh deploy gets, since nothing in git\ncarries a key, and `bazelisk run //scripts:mcp-check` only warns about it."},"462":{"id":"/coder-templates-343","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#notes-on-the-two-dropdowns-that-take-a-custom-value","content":"Park a lane deliberately with `GITHUB_MCP=false` / `CONTEXT7_MCP=false` in `.env` (relayed\nby `push-template.sh`) or `--var github_mcp=false` / `--var context7_mcp=false` on\nthe push; a block missing from a render that got neither of those is a defect, not a\npark."},"463":{"id":"/coder-templates-344","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#notes-on-the-two-dropdowns-that-take-a-custom-value","content":"Fill the context7 key with `CONTEXT7_API_KEY` in `.env` plus a re-push when a\nsession needs private libraries or a higher rate limit."},"464":{"id":"/coder-templates-345","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#autostop-and-ttls","content":"Autostart, autostop and TTLs are template *metadata*, so they stay out of the Terraform\n(where they would fight the UI) and travel on the CLI after pushing."},"465":{"id":"/coder-templates-346","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#autostop-and-ttls","content":"**Autostop is disabled by default.**"},"466":{"id":"/coder-templates-347","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#autostop-and-ttls","content":"Coder reads the template's **Default autostop** (its default TTL) when it seeds a\nworkspace. That field also decides whether the create form's **Enable Autostop**\narrives ticked, and it ships at 24 h - which is how a workspace would otherwise start\nwith a shutdown deadline nobody chose."},"467":{"id":"/coder-templates-348","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#autostop-and-ttls","content":"A 0 default TTL leaves the checkbox unchecked and leaves `coder create` with nothing to\ninherit, so a workspace runs until its owner stops it."},"468":{"id":"/coder-templates-349","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#autostop-and-ttls","content":"`--activity-bump` goes to `0` with it: a bump only extends a deadline, and with no\ndeadline there is nothing to extend."},"469":{"id":"/coder-templates-350","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#autostop-and-ttls","content":"`push-template.sh` re-sends both after every push, and `new-workspace.sh` names no\n`--stop-after`, so a script-made workspace gets no autostop deadline either."},"470":{"id":"/coder-templates-351","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#autostop-and-ttls","content":"A workspace owner can still tick the box for one workspace: `allow_user_autostop`\nstays on, because CE cannot turn it off -- `--allow-user-autostop=false` is marked\n\"can only be disabled in enterprise\"."},"471":{"id":"/coder-templates-352","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#autostop-and-ttls","content":"Keep the other licensed flags out of the CE stack too."},"472":{"id":"/coder-templates-353","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#autostop-and-ttls","content":"`--failure-ttl` (Failure cleanup), `--dormancy-threshold` and\n`--dormancy-auto-deletion` are all marked \"This licensed feature's default is 0h\n(off)\" in `templates edit --help` on v2.36.6, and `--allow-user-autostart` works\nthe same way."},"473":{"id":"/coder-templates-354","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#autostop-and-ttls","content":"Older notes also list `--inactivityTTL` among the rejected names; v2.36.6 has no\nflag of that name, and `--default-ttl` and `--activity-bump` are the closest."},"474":{"id":"/coder-templates-355","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#autostop-and-ttls","content":"Check it in the Coder UI: the template editor's **Default autostop** reads *Disabled*\n(0 h), and a workspace's **Schedule** tab shows **Enable Autostop** unchecked."},"475":{"id":"/coder-templates-356","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#docker-in-docker","content":"Opt-in in `workspace` (the **Docker-in-docker** Yes/No question, preset *AI workspace +\nDinD*, template variable `dind`). With the toggle off, `docker` in that workspace fails\nthe normal way rather than against a daemon that does not exist."},"476":{"id":"/coder-templates-357","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-the-toggle-creates","content":"With it on, per workspace:"},"477":{"id":"/coder-templates-358","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-the-toggle-creates","content":"One privileged `docker:29.8.1-dind` sidecar on a bridge network private to that\nworkspace (`coder-<wsid>-dind`, network alias `dind`)."},"478":{"id":"/coder-templates-359","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-the-toggle-creates","content":"The workspace container attaches to **both** `bridge` and that private network; once a\n`networks_advanced` block appears the provider stops letting `network_mode` do the\nattaching, so `bridge` has to be listed explicitly."},"479":{"id":"/coder-templates-360","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-the-toggle-creates","content":"`DOCKER_HOST=tcp://dind:2375` is injected into the agent environment - absent when the\ntoggle is off."},"480":{"id":"/coder-templates-361","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-the-toggle-creates","content":"`docker build`, `docker run` and `docker compose` then work inside the workspace. The\n*AI workspace + DinD* preset is the usual way to get this shape, since the client\nbinaries ship only in the golden image."},"481":{"id":"/coder-templates-362","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#details-that-matter","content":"The toggle is `mutable = false`: turning it on or off means a workspace **rebuild**,\nbecause a network, a volume and a second container appear or vanish. The preset makes\nthat one click."},"482":{"id":"/coder-templates-363","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#details-that-matter","content":"Only the literal string `\"true\"` enables it; anything else reads as off."},"483":{"id":"/coder-templates-364","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#details-that-matter","content":"The daemon's `/var/lib/docker` lives on its own volume (`coder-<wsid>-dind-lib`), so a\nstop/start does not re-pull every image the builds used. It is not gated on\n`start_count`, so it survives a stop and is reused by the next start."},"484":{"id":"/coder-templates-365","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#details-that-matter","content":"`DOCKER_TLS_CERTDIR=` is deliberately **empty**, so the daemon serves plain\n`tcp://0.0.0.0:2375` with no TLS and no auth. (`DOCKER_TLS_CERTSIZE=0` does not do\nthis: the daemon would listen on 2376 with TLS and the client fails against 2375.)"},"485":{"id":"/coder-templates-366","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#details-that-matter","content":"Nothing is published to the host, and 2375 is reachable only from that workspace's own\nnetwork - which is also why the network is not `internal`."},"486":{"id":"/coder-templates-367","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#details-that-matter","content":"An internal network gets no gateway route or NAT, so `host.docker.internal` would\nresolve and never answer, and the agent would strand. See\nSECURITY.md."},"487":{"id":"/coder-templates-368","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#details-that-matter","content":"The daemon image is resolved with `data \"docker_image\"`, which inspects the host store\nand **never pulls**, so `docker:29.8.1-dind` must already be there. `bootstrap.sh`\npre-arms it; to do it manually:"},"488":{"id":"/coder-templates-369","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#details-that-matter","content":"A missing image fails the workspace build at **plan** time, before anything is\ncreated, with `did not find docker image 'docker:29.8.1-dind'` - see\ntroubleshooting.md."},"489":{"id":"/coder-templates-370","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#details-that-matter","content":"`cgroupns_mode = \"private\"` and `shm_size = 1024` (MB to the provider, so 1 GiB) are\nboth load-bearing; the sidecar is torn down with the workspace because it is gated on\n`start_count` as well as on the toggle."},"490":{"id":"/coder-templates-371","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#details-that-matter","content":"`DOCKER_CLI_VERSION` in `images/dev/tool-versions.env` and the `docker:29.8.1-dind` tag\nin `templates/workspace/main.tf` and `templates/devcontainer/main.tf` are the same\nengine line (29.8.1). Bump all three together."},"491":{"id":"/coder-templates-372","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-devcontainer-template","content":"That is the *AI workspace + DinD* shape, always on, plus a repository that brings its own\ntoolchain."},"492":{"id":"/coder-templates-373","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#shape","content":"One workspace container from the golden image: launcher and clone target only. It still\nhas to be the golden image, because that is what ships the Docker client the\ndevcontainer flow talks through. The editor's real environment is whatever the repo\nbuilds, so `image` decides nothing about the toolchain inside it."},"493":{"id":"/coder-templates-374","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#shape","content":"An always-on privileged `docker:29.8.1-dind` sidecar on the per-workspace bridge\nnetwork, with `DOCKER_HOST=tcp://dind:2375` injected **unconditionally** and\n`DOCKER_TLS_CERTDIR=` empty for the reasons above. `internal` stays false for the same\none reason."},"494":{"id":"/coder-templates-375","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#shape","content":"`dind` is not a variable here. A devcontainer workspace without a daemon is nothing,\nand the plain-clone fallback still wants a daemon its `docker` commands can reach."},"495":{"id":"/coder-templates-376","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#shape","content":"One host bind, `/srv/coder-devcontainers/<workspace-id>`, mounted at that **identical**\npath in both containers."},"496":{"id":"/coder-templates-377","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#why-the-shared-bind-path-is-load-bearing","content":"The devcontainer CLI always bind-mounts the workspace folder into the dev container it\ncreates, and a bind source is resolved by the daemon that *runs* that container - here\nthe sidecar, not the workspace's."},"497":{"id":"/coder-templates-378","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#why-the-shared-bind-path-is-load-bearing","content":"So the clone must exist at the same path inside the sidecar too, or it dies with\n`bind source path does not exist`."},"498":{"id":"/coder-templates-379","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#why-the-shared-bind-path-is-load-bearing","content":"Named volumes cannot substitute: a volume is a daemon-local object and does not cross\nto the sidecar's daemon."},"499":{"id":"/coder-templates-380","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#why-the-shared-bind-path-is-load-bearing","content":"Docker creates the missing host directory itself (root-owned) and `startup.sh.tftpl`\nchowns it."},"500":{"id":"/coder-templates-381","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#why-the-shared-bind-path-is-load-bearing","content":"Inside a built dev container the same folder appears under `/workspaces/<repo-name>`,\nthe devcontainer CLI's default mount target and where the dev-container editor opens."},"501":{"id":"/coder-templates-382","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#why-the-shared-bind-path-is-load-bearing","content":"`main.tf` therefore spells the editor's `folder` per hosting environment\n(`local.editor_folder`): `/workspaces/<repo-name>` inside the dev container,\n`/srv/coder-devcontainers/<workspace-id>/<repo-name>` on the plain container, and\n`/home/coder` when no repository was named."},"502":{"id":"/coder-templates-383","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#why-the-shared-bind-path-is-load-bearing","content":"One host-side path for all three would open the editor on a folder that exists nowhere\nthe editor runs, and VS Code answers that with\n`Workspace does not exist. Please select another workspace to open.`"},"503":{"id":"/coder-templates-384","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-two-questions","content":"**Git repository** (`repo_url`) is mutable: switching repository is a re-clone plus a\ndevcontainer build, not a new topology the way `workspace`'s DinD toggle is."},"504":{"id":"/coder-templates-385","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-two-questions","content":"**Build repo's dev container** (`use_devcontainer`, default `true`) is immutable:\nbuilding a dev container or not is a different topology. With Yes the editor lives in\nthe dev container; with No, in the plain container."},"505":{"id":"/coder-templates-386","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-two-questions","content":"A repository that ships no `devcontainer.json` gets no dev container and hence no\neditor with the toggle on. The toggle - or\n`bazelisk run //scripts:new-workspace -- <git-url>`, which reads the repository and\npicks for you - is how that case is meant to be handled."},"506":{"id":"/coder-templates-387","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#clone-and-build","content":"`startup.sh.tftpl` clones the repository onto that bind in **both** toggle modes."},"507":{"id":"/coder-templates-388","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#clone-and-build","content":"With the toggle on, `coder_devcontainer.repo` then builds the repo's own\n`.devcontainer/devcontainer.json` on the sidecar through the Coder agent\n(`@devcontainers/cli` is installed into the parent workspace container by a\n`run_on_start` module, and the golden image does not ship it)."},"508":{"id":"/coder-templates-389","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#clone-and-build","content":"That exposes the dev container as a sub-agent with its own terminal and apps, and the\nin-browser editor attaches to *that* sub-agent, so the editor runs inside the dev\ncontainer where the cloned repo's toolchain lives."},"509":{"id":"/coder-templates-390","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#clone-and-build","content":"With the toggle off - or on a repo that carries no `devcontainer.json`, where the build\nhas nothing to build - the editor attaches to the plain workspace agent instead, opened\non the same clone path."},"510":{"id":"/coder-templates-391","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#clone-and-build","content":"Either way `folder` is the clone, so code-server and its terminal profiles land on the\nrepository, and the **Web Terminal** button `cd`s there too."},"511":{"id":"/coder-templates-392","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#clone-and-build","content":"No `config_path` is set, so the CLI discovers the file the way VS Code does, and a repo\nusing the other legal locations behaves the same."},"512":{"id":"/coder-templates-393","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#clone-and-build","content":"`coder_script.dind_bootstrap` is an ordering guard, not a starter: it waits up to 120s\n(180s cap) for the sidecar to answer `docker version`, because the agent runs its\n`run_on_start` scripts before it creates the dev containers."},"513":{"id":"/coder-templates-394","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-it-reuses-and-the-trust-warning","content":"The mount covers the workspace container only; a dev container built on the sidecar\nkeeps its own home either way."},"514":{"id":"/coder-templates-395","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-it-reuses-and-the-trust-warning","content":"It carries its own copies of `startup.sh.tftpl`, `settings.json.tftpl` and\n`grok-config.toml.tftpl`, so the tmux-default terminal and LiteLLM wiring above apply\nto it too."},"515":{"id":"/coder-templates-396","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-it-reuses-and-the-trust-warning","content":"**Treat the repository as untrusted code.** Everything it builds runs on a privileged\ndaemon on this box, so a Dockerfile in that repo is root-equivalent on the stack host.\nThe create form's own description says so, and only repositories you trust belong in\nthe field."},"516":{"id":"/coder-templates-397","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#from-a-git-url-bazelisk-run-scriptsnew-workspace","content":"`bazelisk run //scripts:new-workspace -- <git-url> [name]` answers the two questions\nabove for you: which template, and whether to build the dev container."},"517":{"id":"/coder-templates-398","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#from-a-git-url-bazelisk-run-scriptsnew-workspace","content":"The `--` ends Bazel's own flags, so a URL that begins with a dash still reaches the\nscript. Every fence below is one complete command."},"518":{"id":"/coder-templates-399","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#from-a-git-url-bazelisk-run-scriptsnew-workspace","content":"Dry run (decision only, creates nothing):"},"519":{"id":"/coder-templates-400","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#from-a-git-url-bazelisk-run-scriptsnew-workspace","content":"Create the workspace it picks:"},"520":{"id":"/coder-templates-401","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#from-a-git-url-bazelisk-run-scriptsnew-workspace","content":"Force the `workspace` template:"},"521":{"id":"/coder-templates-402","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-it-decides","content":"It shallow-clones (`--depth 1 --no-checkout --single-branch`) into a temporary\ndirectory, from the host, and lists the tracked files."},"522":{"id":"/coder-templates-403","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-it-decides","content":"It looks for a dev container in `.devcontainer/`, `.github/devcontainers/`, or a\n`devcontainer.json`/`devcontainer.yml` anywhere in the tree."},"523":{"id":"/coder-templates-404","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-it-decides","content":"A tracked `.devcontainer/contributor-env` outranks every other signal: the probe is a\n**miss** even when the same clone also tracks `.devcontainer/devcontainer.json`."},"524":{"id":"/coder-templates-405","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-it-decides","content":"That is how this repo keeps its own Coder workspaces on `workspace` — the `.devcontainer/` it\nships is the contributor one for a laptop and CI, not a nested toolchain to rebuild\ninside the workspace's own DinD sidecar (see\ncontribute/devcontainer.md)."},"525":{"id":"/coder-templates-406","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-it-decides","content":"Application repositories do not carry the sentinel, so their dev containers stay a hit."},"526":{"id":"/coder-templates-407","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-it-decides","content":"Found means `devcontainer`; not found means `workspace`. A probe that fails **entirely**\nis also a `workspace` answer, with a warning."},"527":{"id":"/coder-templates-408","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-it-decides","content":"The clone is a plain `git clone` from the host, so it consults the host's own git\ncredentials. A private repository therefore needs a grant covering it **on the machine\nyou run this from**."},"528":{"id":"/coder-templates-409","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-it-decides","content":"It then assembles `coder create` with the template's parameters:"},"529":{"id":"/coder-templates-410","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-it-decides","content":"`repo_url=<url>` always"},"530":{"id":"/coder-templates-411","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-it-decides","content":"`use_devcontainer=false` whenever `devcontainer` was chosen but no dev container was\nfound (forced with `--devcontainer` onto a repo that has none, or a probe that could\nnot check the repo - the cases where leaving the toggle at its default would build\nnothing anyway)"},"531":{"id":"/coder-templates-412","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-it-decides","content":"`dind=true` on `--dind`"},"532":{"id":"/coder-templates-413","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-it-decides","content":"`additional_repos=<list>` whenever `--additional-repos` named at least one extra URL"},"533":{"id":"/coder-templates-414","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-it-decides","content":"It names no `--stop-after`, so a script-made workspace gets no autostop deadline."},"534":{"id":"/coder-templates-415","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-it-decides","content":"It either runs the command (`--no-wait`; watch with `coder ls` / `coder logs <name>`)\nor, with no usable `coder` login, prints the same command to run by hand and exits 0."},"535":{"id":"/coder-templates-416","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-it-decides","content":"`--devcontainer` forces the devcontainer template and `--template <name>` overrides the\ntemplate choice outright."},"536":{"id":"/coder-templates-417","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-it-decides","content":"A workspace name can follow the URL. Coder names start with a letter (40 characters\nmax); the derived default is the repository leaf."},"537":{"id":"/coder-templates-418","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-it-decides","content":"It never mints, reads, or stores a token - unlike `push-template.sh`, which mints its\nown because a template push has no other credential path. With `CODER_SESSION_TOKEN`\nset but `CODER_URL` unset it refuses to guess, and an empty token is a *not yet* state\nrather than an error."},"538":{"id":"/coder-templates-419","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#inside-the-workspace-container","content":"Each template creates one Docker container per workspace."},"539":{"id":"/coder-templates-420","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#inside-the-workspace-container","content":"Extra named volumes are chowned to the home owner by `startup.sh.tftpl` - the first four\nat its start, the archive by its own stage - because Docker creates an empty named volume\nas `root:root` 755 and the agent runs as `coder`:"},"540":{"id":"/coder-templates-421","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#inside-the-workspace-container","content":"`vscode-settings-<owner-id>` at `~/.shared/vscode`"},"541":{"id":"/coder-templates-422","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#inside-the-workspace-container","content":"in shared mode the three state volumes `grok-notes-<owner-id>` at `~/.grok/notes`,\n`grok-memory-<owner-id>` at `~/.grok/memory` and `grok-sessions-<owner-id>` at\n`~/.grok/sessions`"},"542":{"id":"/coder-templates-423","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#inside-the-workspace-container","content":"the host-wide `grok-session-archive` at `/var/lib/grok-session-archive`"},"543":{"id":"/coder-templates-424","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#inside-the-workspace-container","content":"The archive volume sits outside `~/.grok` on purpose and is read by nothing in the\nworkspace: see\nthe out-of-band session archive."},"544":{"id":"/coder-templates-425","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#inside-the-workspace-container","content":"Image from `images/dev/Dockerfile` (overridable with the `image` variable) carrying:\nNode 22 + 24, Python 3.12 + 3.11, Go 1.24, Bazelisk/buildifier,\nTerraform/tflint/terragrunt, protoc and its Go plugins, kubectl/helm/kubeconform,\nshfmt/shellcheck/bats/ruff/mypy/prettier, the Coder CLI, and the pinned Grok Build CLI\nat `/usr/local/bin/grok`."},"545":{"id":"/coder-templates-426","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#inside-the-workspace-container","content":"The Docker **client** toolchain only (`docker`, `docker buildx`, `docker compose` as\nCLI plugins under `/usr/local/lib/docker/cli-plugins`). No daemon: the build asserts\n`dockerd`, `containerd`, `runc` and `docker-proxy` are absent."},"546":{"id":"/coder-templates-427","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#inside-the-workspace-container","content":"The five offline MCP servers ship in the image, but the rendered config declares none\nof them by default, so a workspace needs no network to start a session."},"547":{"id":"/coder-templates-428","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#inside-the-workspace-container","content":"A persistent per-workspace home volume (`coder-<wsid>-home`)."},"548":{"id":"/coder-templates-429","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#inside-the-workspace-container","content":"`host.docker.internal` mapped to `host-gateway`, so workspaces reach the Coder server\nand LiteLLM."},"549":{"id":"/coder-templates-430","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#inside-the-workspace-container","content":"`startup_script_behavior = \"blocking\"`, so a workspace only reports *ready* once the\ntoolchain is genuinely staged - no opening an editor mid-install."},"550":{"id":"/coder-templates-431","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#inside-the-workspace-container","content":"`connection_timeout = 300`."},"551":{"id":"/coder-templates-432","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-the-startup-script-does-in-order","content":"Installs `tmux` if it is missing, then seeds `~/.tmux.conf` (only while that file is\nabsent or still carries the `managed-by: evo-t1-coder-stack` marker)."},"552":{"id":"/coder-templates-433","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-the-startup-script-does-in-order","content":"Ensures the **Grok Build CLI** is on PATH. The golden image ships it, so the\n`https://x.ai/cli/install.sh` download runs only where `grok` is missing from PATH -\nthe `ubuntu:24.04` image option, or a home volume that never received the CLI."},"553":{"id":"/coder-templates-434","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-the-startup-script-does-in-order","content":"Puts `~/.grok/bin` on PATH (login shells and that process), and appends the one-line\nreader that sources `~/.infisical/agent.env` under `set -a` into `~/.bashrc` - the reader\nis what makes the vault fetch worth doing at all\n(see The Infisical boot fetch)."},"554":{"id":"/coder-templates-435","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-the-startup-script-does-in-order","content":"The two terminal-profile tmux helpers are written by their own\n`coder_script \"terminal_launchers\"` body, which runs after this one returns (see\nbelow)."},"555":{"id":"/coder-templates-436","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-the-startup-script-does-in-order","content":"Nothing at boot executes either script -- the code-server terminal profile is\nthe only consumer -- so landing them a step later costs an operator nothing, and each\nbody names itself in the start log. The default one gives each visible terminal its\nown pane: it re-joins a folder's session only while nothing is attached to it, and\notherwise opens a numbered sibling."},"556":{"id":"/coder-templates-437","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-the-startup-script-does-in-order","content":"Seeds the Coder Agents context files, then the shared code-server User settings, only\nfor files that are absent."},"557":{"id":"/coder-templates-438","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-the-startup-script-does-in-order","content":"Renders `~/.grok/config.toml` (the three gated MCP servers ship by default; the five\noffline stdio ones are not declared)."},"558":{"id":"/coder-templates-439","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-the-startup-script-does-in-order","content":"**Clones a non-empty Git repository field** into `/home/coder/workspace/<repo-name>`\n(in `devcontainer`, onto the `/srv/coder-devcontainers/<workspace-id>` bind)."},"559":{"id":"/coder-templates-440","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-the-startup-script-does-in-order","content":"The script creates that folder first (`mkdir -p` plus a chown to the workspace user) so\nthe editor's wait loop can see it, then clones into it."},"560":{"id":"/coder-templates-441","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-the-startup-script-does-in-order","content":"This is idempotent, runs as\nthe workspace user so their git credentials are consulted, and refuses to touch an\nexisting non-empty non-git folder there. An empty pre-created target still clones."},"561":{"id":"/coder-templates-442","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-the-startup-script-does-in-order","content":"**Starts the out-of-band session archive mirror** (boot stage 9). It chowns\n`/var/lib/grok-session-archive` to the home owner, folds the container hostname into a\nsafe leaf name under `workspaces/`, then leaves a backgrounded loop that `rsync`s\n`~/.grok/sessions/` into that leaf every 180 seconds, without `--delete`, for the life\nof the container."},"562":{"id":"/coder-templates-443","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-the-startup-script-does-in-order","content":"`flock -n` keeps it to one loop per leaf across repeated starts."},"563":{"id":"/coder-templates-444","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-the-startup-script-does-in-order","content":"Best-effort and invisible to the CLI: nothing in the workspace reads the volume back,\nand the hooks deny list refuses an agent command that names it. See\nthe out-of-band session archive."},"564":{"id":"/coder-templates-445","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-the-startup-script-does-in-order","content":"The repository leaf is derived the same way in `main.tf` and in `startup.sh.tftpl`:\nsplit on `/`, drop empty segments, take the last, drop a trailing `.git`, map every\ncharacter outside `[A-Za-z0-9._-]` to `-`, and fall back to `repo` when that leaves no\nleading alphanumeric."},"565":{"id":"/coder-templates-446","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-the-startup-script-does-in-order","content":"Both derivations must agree, or the editor and the terminal helpers point at a folder that\nwas never cloned."},"566":{"id":"/coder-templates-447","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#why-the-stages-sit-where-they-do","content":"The order above is not incidental; each line is a constraint the script has to keep."},"567":{"id":"/coder-templates-448","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-tmux-seed-and-the-clipboard-route","content":"`~/.tmux.conf` is seeded *before* the two terminal helpers, which their own\n`coder_script` writes after this body returns. `tmux` reads that file once\nat server start and every terminal (plus an SSH client that reattaches) shares that one\nserver, so seeding after the first `tmux new-session -A` could run would leave that\nsession unconfigured for the whole boot."},"568":{"id":"/coder-templates-449","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-tmux-seed-and-the-clipboard-route","content":"`mouse off` is what keeps every click with\n  the terminal client: tmux requests no mouse reporting, so a drag is the client's own\n  highlight, the settings seed's `copyOnSelection` puts it on the machine clipboard,\n  and right-click and middle-click paste it back."},"569":{"id":"/coder-templates-450","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-tmux-seed-and-the-clipboard-route","content":"Measured on the shipped tmux 3.4, an\n  attach with `mouse on` writes `ESC[?1000h`, `ESC[?1002h` and `ESC[?1006h` to the\n  client and an attach with it off writes none of them."},"570":{"id":"/coder-templates-451","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-tmux-seed-and-the-clipboard-route","content":"tmux keeps no clipboard of its\n  own next to that: the copy-mode copies, the prefix paste `]`, the buffer picker `=`\n  and the root-table middle-click paste are unbound, and `Prefix m` is only the switch\n  that hands the wheel to tmux for a long scroll and hands it back."},"571":{"id":"/coder-templates-452","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-tmux-seed-and-the-clipboard-route","content":"`set-clipboard on` and `allow-passthrough on` stay for the one copy route that is\n  not tmux's own - an app inside a pane (vim's `+` register, anything that emits\n  OSC 52) drives the machine clipboard through them, which is what a native terminal\n  hands that app - and a client that blocks OSC 52 (iTerm2 by default) gets nothing at\n  all, because there is no tmux buffer left to fall back to."},"572":{"id":"/coder-templates-453","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-tmux-seed-and-the-clipboard-route","content":"The browser build of VS\n  Code drops that escape as well\n  (microsoft/vscode#318254), so a\n  pane app's OSC 52 copy is silent in the tab and lands over ssh from a real terminal\n  app, while the operator's own copy in the tab is the plain drag."},"573":{"id":"/coder-templates-454","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-clone-the-chown-and-the-best-effort-tail","content":"The clone folder is created before git runs, and before the `coder_script.code_server`\nscript's own `mkdir`: the editor starts in parallel with the startup script, and an\nempty tree is a folder VS Code can open while the clone is still writing."},"574":{"id":"/coder-templates-455","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-clone-the-chown-and-the-best-effort-tail","content":"An empty\ndirectory is also what `git clone` accepts, so pre-creating it does not change what gets\ncloned - the emptiness guard still refuses a folder holding anything."},"575":{"id":"/coder-templates-456","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-clone-the-chown-and-the-best-effort-tail","content":"`notes_materialize` runs *before* the recursive chown of a fresh clone: the notes file\nand the `.git/info/exclude` write are the stack's to make, and the chown afterwards\nsettles their ownership."},"576":{"id":"/coder-templates-457","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-clone-the-chown-and-the-best-effort-tail","content":"The chown of `~/.grok` and `~/.shared` runs a second time at the end of the script,\nbecause the CLI installer and the seeds above may have created files as root when the\nagent ran as root."},"577":{"id":"/coder-templates-458","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-clone-the-chown-and-the-best-effort-tail","content":"`run_notes` and `run_notes_watch` follow the clone's identity rule rather than the\nagent's uid, because that stage writes into the workspace home and runs\n`git config --global`: run as root it would rename a root-owned `~/.gitconfig` over the\nworkspace user's and leave `notes.md` unreadable on an already-cloned folder."},"578":{"id":"/coder-templates-459","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-clone-the-chown-and-the-best-effort-tail","content":"The watcher left at the end is what makes notes survive a recreate that lands *between*\nedits. The boot-time sync runs once, so anything written later lived solely inside that\ncontainer, which is how a whole workspace's notes went missing on a recreate."},"579":{"id":"/coder-templates-460","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-clone-the-chown-and-the-best-effort-tail","content":"Every stage from the Coder Agents seeds onward is best-effort: an offline first boot has\nto leave a working terminal, and a repository that will not clone has to leave a\nworkspace someone can fix, so nothing there may abort the script."},"580":{"id":"/coder-templates-461","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-clone-the-chown-and-the-best-effort-tail","content":"In `devcontainer` a\nmissing or half-cloned folder is not silent either: `coder_devcontainer` fails on its own\nwith a visible error naming the folder it looked in, and the clone stage warns first when\na clone arrives with no devcontainer configuration in it."},"581":{"id":"/coder-templates-462","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-grok-build-cli-probe-the-download-and-the-installer-stub","content":"The install check is `command -v grok`, not `[ -x ~/.grok/bin/grok ]`: the golden image\nbakes the CLI into `/usr/local/bin`, so on a golden-image boot the probe answers yes and\nnothing downloads. The download exists for the **Minimal shell** (`ubuntu:24.04`) preset\nand for a home volume that never received a CLI."},"582":{"id":"/coder-templates-463","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-grok-build-cli-probe-the-download-and-the-installer-stub","content":"It is bounded and retried on purpose: one unbounded attempt burned a whole start on a\nsingle stalled connection to x.ai (`curl: (28) SSL connection timeout`) and still booted\nthe workspace without a CLI."},"583":{"id":"/coder-templates-464","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-grok-build-cli-probe-the-download-and-the-installer-stub","content":"`GROK_FRESH_INSTALL` records that an install *completed* this boot - the second\n`command -v` probe inside the install branch is what sets it, so a failed download leaves\nthe flag at `0`."},"584":{"id":"/coder-templates-465","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-grok-build-cli-probe-the-download-and-the-installer-stub","content":"The installer writes its own `~/.grok/config.toml` (a\n`[cli] installer = ...` stub) that is indistinguishable from a user's config, so the\nconfig stage may treat that stub as stack-owned only on a completed install: a download\nthat failed must never wipe a user-owned config in its place. Without that flag a\nbrand-new workspace would be left with an unconfigured CLI, because the stub carries\nneither stack marker and the file already exists."},"585":{"id":"/coder-templates-466","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#marker-ownership-of-the-seeded-files","content":"Most seeded files are written only while absent, so a hand-edited copy is user-owned and\nthe stage re-runs harmlessly. Three of them are re-written on every start, and ownership is\ndecided by a marker - never by mtime and never by first boot:"},"586":{"id":"/coder-templates-467","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#marker-ownership-of-the-seeded-files","content":"`~/.tmux.conf` and `~/.grok/AGENTS.md` are rewritten while the\n`managed-by: evo-t1-coder-stack` line is present; editing the file away from the marker\nhands it to the user for good, and each prints one warning line when it is marker-free."},"587":{"id":"/coder-templates-468","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-hooks-family-and-why-it-is-stricter","content":"The guard family under `~/.grok/hooks/` follows the same rule for a sharper reason."},"588":{"id":"/coder-templates-469","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-hooks-family-and-why-it-is-stricter","content":"The manifest and the five files under `hooks/bin/` are rewritten on every start while they carry\nthe marker - the `\"__evoT1Stack\": true` key in the JSON, the only spelling that leaves it\nparseable, and the `managed-by: evo-t1-coder-stack` comment in the four scripts and the deny\nlist."},"589":{"id":"/coder-templates-470","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-hooks-family-and-why-it-is-stricter","content":"A hook decides what a session may run and what it may write, so a copy that drifted\nfrom the seed is a silent behaviour change, while a stale `SKILL.md` misleads one run; that\ndifference is why the skills stay absent-only (the advisors' twelve copies and their\n`~/.grok/agents/documenter.md` included) and this family does not. Each write ends by\nappending the marker line if the payload lost its own, so a rewritten file never becomes\nunrecognisable as stack-owned on the next boot."},"590":{"id":"/coder-templates-471","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-config-render-and-its-two-markers","content":"`~/.grok/config.toml` is re-rendered when it is absent, when\n`GROK_FRESH_INSTALL` is set, or while *either* marker is present: the `managed-by`\ncomment or the top-level `__evoT1Stack = true` key."},"591":{"id":"/coder-templates-472","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-config-render-and-its-two-markers","content":"That render is also what puts the fleet's own ceiling inside the file, as\n`# fleet-width: 15` directly above `max_concurrent` in `[subagents]`\n(`templates/workspace/grok-config.toml.tftpl:427`, fed from `var.grok_swarm_width` at\n`templates/workspace/main.tf:558`), while `max_concurrent` carries the width variable's\nown shipped 15 - two variables, so a `--var` that narrows the width never erases the\nnumber the fleet was sized at."},"592":{"id":"/coder-templates-473","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-config-render-and-its-two-markers","content":"Stage 6 reads the pair the moment the render\n  lands: right after `boot_ok \"config.toml re-materialized with the stack markers\"`\n  (`templates/workspace/startup.sh.tftpl:258`) it compares them and, when the width is the\n  narrower of the two, prints one `note:` line naming the gap through `boot_note`\n  (`templates/common/boot-log.lib.sh:51`, the verb that carries no counter), pointing at\n  the rendered width is below fleet-width."},"593":{"id":"/coder-templates-474","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-config-render-and-its-two-markers","content":"`bazelisk run //scripts:subagent-check` is the same comparison for a shell, and the same\n  two numbers answer it: a profile whose marker the operator removed gets neither the line\n  nor the note, because both are products of this render."},"594":{"id":"/coder-templates-475","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-config-render-and-its-two-markers","content":"The key is what makes the rule hold. The CLI's own settings writer (`grok mcp add` and\nfriends) deletes every comment line, so a comment-only marker can vanish with nobody\ntouching the file."},"595":{"id":"/coder-templates-476","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-config-render-and-its-two-markers","content":"The config file usually already exists, because an earlier start of this workspace\nwrote it, so the marker rather than first boot is what decides."},"596":{"id":"/coder-templates-477","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-the-re-render-carries-over","content":"Re-rendering carries over the tables the CLI owns instead of wiping them: `[cli]` holds\n`cli.installer`, which picks the CLI's update path; `[ui]` carries over the keys the\noperator added; and `[marketplace]` is CLI settings the stack never owns."},"597":{"id":"/coder-templates-478","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-the-re-render-carries-over","content":"The `[ui]` carry-over is filtered, not copied: the render owns `theme` and\n  `permission_mode` in that table, so the startup drops those keys - the alternation\n  `(theme|auto_dark_theme|auto_light_theme|ui_theme|permission_mode)` at\n  `templates/workspace/startup.sh.tftpl:238` - from what it carries across."},"598":{"id":"/coder-templates-479","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-the-re-render-carries-over","content":"The strip is what makes the render's answer the only one in the file: an operator's\n  `permission_mode` left beside the render's own line gives one `[ui]` table two identical\n  keys, which is invalid TOML."},"599":{"id":"/coder-templates-480","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-the-re-render-carries-over","content":"So the create form's **Grok approval mode** is\n  the seam for that key, and an approval mode hand-written into the file does not\n  survive a re-render, while every other `[ui]` key the operator set still does."},"600":{"id":"/coder-templates-481","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-the-re-render-carries-over","content":"The drop\n  leaves a trace: when the strip removes a `permission_mode` the body prints one\n  `warning:` line naming the value it dropped\n  (`templates/workspace/startup.sh.tftpl:248`), and `boot_warn` counts it into the\n  closing summary (`templates/common/boot-log.lib.sh:45`), so a workspace that starts,\n  or stops, prompting after a restart leaves a line an operator can read."},"601":{"id":"/coder-templates-482","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-the-re-render-carries-over","content":"The unmanaged case is announced rather than silent, because the render is the only place\na workspace's model catalog and MCP lanes are ever written."},"602":{"id":"/coder-templates-483","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-the-re-render-carries-over","content":"`~/.grok/notes-setup.sh` is the exception to the absent-only rule: it is stack-owned code\nand the copy in this workspace has to be the one this template shipped, so it\nis rewritten every start."},"603":{"id":"/coder-templates-484","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-the-re-render-carries-over","content":"It is written beside its target and `mv`'d in - and `chmod\n0644`'d first, because `mktemp` makes 0600 and `mv` keeps that mode - so the rename is the\nfirst moment the file exists for anyone to source, and a process that starts seconds\nlater never reads a half-written library."},"604":{"id":"/coder-templates-485","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-per-owner-grok-state-volumes","content":"Only three directories under `~/.grok` are shared, and that decides several of the\nrules above."},"605":{"id":"/coder-templates-486","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-per-owner-grok-state-volumes","content":"In `shared` mode (the default `grok_profile_mode`) the container mounts three of the\nowner's Docker volumes read-write, nested inside that workspace's own `/home/coder`\nvolume: `grok-notes-<owner-id>` at `~/.grok/notes`, `grok-memory-<owner-id>` at\n`~/.grok/memory` and `grok-sessions-<owner-id>` at `~/.grok/sessions`."},"606":{"id":"/coder-templates-487","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-per-owner-grok-state-volumes","content":"Those three\ntrees are then the same files every other workspace this owner has reads and writes,\nand they survive a rebuild."},"607":{"id":"/coder-templates-488","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-per-owner-grok-state-volumes","content":"Everything else under `~/.grok` - `config.toml` above all - is a regular file on this\nworkspace's own home volume."},"608":{"id":"/coder-templates-489","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-per-owner-grok-state-volumes","content":"Each start re-renders `config.toml` for this workspace\nalone, so its default model (or, in `devcontainer`, its model alias), its theme and\nits config extras are its own, and a hand edit there lasts until that one workspace\nrestarts."},"609":{"id":"/coder-templates-490","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-per-owner-grok-state-volumes","content":"The whole-profile volume this template used to mount over all of `~/.grok`,\n`grok-profile-<owner-id>`, is still mounted in `shared` mode, but **read-only** and at\n`~/.grok-legacy`, only so the first start after the split can hoist its `notes/`,\n`memory/` and `sessions/` across (`notes_hoist_legacy` in\n`templates/common/notes-setup.sh`)."},"610":{"id":"/coder-templates-491","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-per-owner-grok-state-volumes","content":"Nothing reads it afterwards, and a later `chore:`\nremoves that mount."},"611":{"id":"/coder-templates-492","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-per-owner-grok-state-volumes","content":"`private` mounts no per-owner volume at all: the three state directories then live on\nthis workspace's own home volume too, so they are its own and die with it."},"612":{"id":"/coder-templates-493","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-per-owner-grok-state-volumes","content":"In `devcontainer` the mounts are on the workspace container only. A dev container the repo\nbuilds on the sidecar keeps its own home and its own `~/.grok`, which is why the live\n`notes-setup.sh` there is a regular file reached through the clone bind rather than a\nlink into `~/.grok`, and why a built dev container sees neither the settings volume nor\nthe shared editor overlay."},"613":{"id":"/coder-templates-494","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-per-owner-grok-state-volumes","content":"The Coder Agents seeds under `~/.coder` and `~/.agents` are not on those mounts: they live\non the workspace's own home volume, and that stage neither needs nor disturbs it."},"614":{"id":"/coder-templates-495","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#stale-editor-swap-files","content":"The swap file's own persistence turns a killed editor into a permanent nuisance. Open\n`vim ~/.grok/config.toml`, stop the workspace with the editor still up, and the agent's\nprocess tree dies while the swap file stays on the home volume."},"615":{"id":"/coder-templates-496","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#stale-editor-swap-files","content":"The next `vim` on that name stops with `E325: ATTENTION` and a question about a\nsession whose container has been gone for days, and because \"(E)dit anyway\" leaves the\nswap in place and mints `.swo`, `.swn`, `.swm` beside it, an operator who keeps answering\nthe prompt ends up with four of them and a prompt that never goes away."},"616":{"id":"/coder-templates-497","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#why-the-sweep-lives-in-that-body","content":"The boot clears them, from `grok_sweep_config_swaps` in\n`templates/common/agents-seed.sh.tftpl`."},"617":{"id":"/coder-templates-498","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#why-the-sweep-lives-in-that-body","content":"It runs there rather than in `startup.sh.tftpl`\nbecause the startup argument sits under a byte gate that holds the composed body to 110592\nbytes (12288 of room under the 122880 budget this repo sets for itself, which is itself\n8 KiB under the kernel's measured 131072 one-argument ceiling; see\nThe one-argument ceiling), and the `devcontainer` twin already\ncomposes 110242 of those, leaving 350 bytes for everything else."},"618":{"id":"/coder-templates-499","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#why-the-sweep-lives-in-that-body","content":"It also runs there because\nthat body is already where a stack-owned file under `~/.grok` is refreshed against its\nmarker."},"619":{"id":"/coder-templates-500","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#why-the-sweep-lives-in-that-body","content":"It does not lean on running after\nthe `startup_script`: a `coder_script` runs in no promised order with it\n(`templates/workspace/coder.tf:272`), so the argument is the marker itself."},"620":{"id":"/coder-templates-501","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#why-the-sweep-lives-in-that-body","content":"A\n`config.toml` that still carries the marker is one every start replaces from\n`grok-config.toml.tftpl`, whichever of the two runs first, so what an orphaned swap holds\nis doomed either way."},"621":{"id":"/coder-templates-502","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-makes-the-step-safe","content":"What makes the step safe is that it destroys nothing it cannot prove. Neither of its two\nchecks establishes that a writer is gone. vim writes the swap once about four seconds after\na change and then stays quiet while you read, so a live session idling over the file looks\nlike a crashed one; and each workspace runs in its own PID namespace, so the `/proc` scan\nsees this container's descriptors only, which leaves a sibling workspace holding the same\nfile open on the shared volume invisible from here."},"622":{"id":"/coder-templates-503","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-makes-the-step-safe","content":"So an orphan is moved into\n`~/.grok/stale-swaps/` under a name the sweep gives itself, and stays recoverable with\n`vim -r` for a month. The archived copy is re-dated to the moment it was set down: `mv`\ncarries the swap's own mtime, and a workspace stopped for six weeks leaves a swap older\nthan the retention, which that same boot would otherwise archive and prune in one breath."},"623":{"id":"/coder-templates-504","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-makes-the-step-safe","content":"A wrong call is one `ls` from undone."},"624":{"id":"/coder-templates-505","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-makes-the-step-safe","content":"It only runs when `config.toml` still carries a stack marker, either spelling of it, by\nthe same contract as\nMarker ownership of the seeded files. A config\nthat lost its marker is the operator's file, swap and all."},"625":{"id":"/coder-templates-506","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-makes-the-step-safe","content":"The usual way one loses the\nmarker is `grok mcp add` rewriting the file, and the remedy there is\n`bazelisk run //scripts:seed-dev-env -- --force`."},"626":{"id":"/coder-templates-507","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-makes-the-step-safe","content":"A swap written within the last hour stays. The hour is a courtesy toward a session that\nmay still be open in a sibling container, which is exactly what the archive is for."},"627":{"id":"/coder-templates-508","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-makes-the-step-safe","content":"A swap some process in this container still holds open stays, read straight off\n`/proc/*/fd` and compared by exact path. Comparing it as a glob would let one bracket in\n`$HOME` hide a live holder."},"628":{"id":"/coder-templates-509","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-makes-the-step-safe","content":"Every path that cannot decide leaves the file where it is and says nothing:"},"629":{"id":"/coder-templates-510","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-makes-the-step-safe","content":"a `find` or `basename` that is missing or errors"},"630":{"id":"/coder-templates-511","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-makes-the-step-safe","content":"a `readlink` that cannot answer (the body runs it\nand checks the result instead of just looking for the binary, since an empty answer\nreads exactly as \"no descriptor points here\")"},"631":{"id":"/coder-templates-512","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-makes-the-step-safe","content":"a `/proc` with nothing to scan"},"632":{"id":"/coder-templates-513","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-makes-the-step-safe","content":"an archive directory that cannot be made"},"633":{"id":"/coder-templates-514","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-makes-the-step-safe","content":"an archive name already taken"},"634":{"id":"/coder-templates-515","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-makes-the-step-safe","content":"a `mv` that is refused"},"635":{"id":"/coder-templates-516","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-makes-the-step-safe","content":"The E325 prompt then waits for a person, which is a visible nuisance with no\ndata behind it, while a wrong deletion is quiet and has data behind it."},"636":{"id":"/coder-templates-517","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-makes-the-step-safe","content":"Only vim's own `.sw?` suffix on that one name is a candidate, and a symlink at that name\nis left alone, since archiving a link would move the name and strand the bytes behind it.\nSo `.notes.md.swp` and a `.config.toml.newswp` are never touched. Each move is announced\non the body's log with the archived path in it, because the name carries a suffix nobody\ncan guess."},"637":{"id":"/coder-templates-518","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-makes-the-step-safe","content":"The prune matches the `sweep-`-prefixed names this function gives itself, at one level of\n`~/.grok/stale-swaps/` and no deeper, so a person who reads this page and parks a file in\nthat directory keeps it."},"638":{"id":"/coder-templates-519","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-blind-spot-the-design-accepts","content":"The blind spot the design accepts is a holder this process cannot see in `/proc` at all: a\nsibling container's vim, which the PID namespace hides, or a process whose `/proc/<pid>/fd`\nis unreadable from here. Its buffer and the archived bytes both survive, and the move is\nreversible for a month; what goes missing is the E325 prompt that would have warned the\nnext person to open the file."},"639":{"id":"/coder-templates-520","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-blind-spot-the-design-accepts","content":"That window is narrow, it sits on a file every start\noverwrites anyway, and it is why the sweep stops at one name here."},"640":{"id":"/coder-templates-521","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#do-not-hand-edit-that-file","content":"This is not an invitation to hand-edit the file. `config.toml` is re-rendered from\n`grok-config.toml.tftpl` on every start of this workspace, so an edit a person makes\nthere is overwritten by the next boot and touches no other workspace. The keys\na person actually wants are template variables: `grok_subagent_max_concurrent`,\n`grok_subagent_max_depth` and `grok_subagents_lane` for the fan-out\n(the fan-out seam), and `grok_config_extra`\nfor anything the managed block does not set."},"641":{"id":"/coder-templates-522","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#do-not-hand-edit-that-file","content":"Change the seed or push the variable, then\nrestart; `bazelisk run //scripts:seed-dev-env -- --force` re-materializes the file from\nthis checkout when the intent really is to rewrite it."},"642":{"id":"/coder-templates-523","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-coder-agents-seeds-and-their-agents-tree-twins","content":"The chat agent discovers its context through its *default* paths (verified against the\nv2.36.6 agent binary and its `agentcontextconfig` source): the instruction file\n`AGENTS.md` under `~/.coder`, skills under `~/.coder/skills`, and a working-dir-relative\n`.agents/skills`, which here resolves to `/home/coder/.agents/skills` - the same folder\nthe Grok Build CLI looks in."},"643":{"id":"/coder-templates-524","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-coder-agents-seeds-and-their-agents-tree-twins","content":"Neither `main.tf` sets `CODER_AGENT_EXP_SKILLS_DIRS` or the\n`CODER_AGENT_EXP_INSTRUCTIONS_*` keys: those *replace* the default lists rather than\nappending, and the seeded copies already sit where the unmodified defaults point. Chat\nitself is on by default in 2.36.6 - no experiment name and no entitlement gates it."},"644":{"id":"/coder-templates-525","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-coder-agents-seeds-and-their-agents-tree-twins","content":"Each file also gets a twin in the `~/.agents` tree, because the `execute`-lane delegation\nthis stack teaches starts `grok -p` inside the workspace and that CLI reads the\n`~/.agents` convention. The chat agent would only ever take the `~/.coder` copies - skill\ndedupe is first-match-wins, home scope before working-dir paths - so one agent never\nloads a skill twice; the twins exist for the CLI, not as a second source for chat."},"645":{"id":"/coder-templates-526","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-coder-agents-seeds-and-their-agents-tree-twins","content":"A twin is copied only while absent, and only from the managed `~/.coder` copy, so a\nhand-placed file in `~/.agents` is never overwritten and the dedupe keeps exactly one\nlive source. The CLI-side spelling of the instruction file keeps the `INSTRUCTIONS.md`\nname because that is the name the `~/.agents` convention was seeded under."},"646":{"id":"/coder-templates-527","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-coder-agents-seeds-and-their-agents-tree-twins","content":"In `devcontainer`, working-dir resolution has a second case: with the dev-container\ntoggle off the agent's working dir is `/home/coder`, exactly as in `workspace`; with it\non, the dev container's own working dir is the cloned folder under\n`/srv/coder-devcontainers/...`, and that folder ships no skill tree, so the `~/.coder`\ncopies remain the live source either way."},"647":{"id":"/coder-templates-528","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-coder-agents-seeds-and-their-agents-tree-twins","content":"In a `SKILL.md` the marker sits *after* the `---` frontmatter: the skill parser needs\n`---` on line 1 and silently drops a skill whose first line is anything else. In an\ninjected instruction file the marker is pure provenance, because injected content has its\nHTML comments stripped anyway. The stage is best-effort: a read-only or missing `$HOME`\nchanges nothing observable."},"648":{"id":"/coder-templates-529","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-ez-learn-seed-and-the-bundled-catalog","content":"`/ez-learn` is seeded on the same absent-only contract because nothing here supplies the\ncommand: no published source ships an upstream `/learn` at all, and the built-in memory\nfamily it copies is gated behind a memory store that is off by default, so those names\nstay hidden."},"649":{"id":"/coder-templates-530","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-ez-learn-seed-and-the-bundled-catalog","content":"The bundle is a separate thing, and a real one: the CLI extracts\n  platform skills such as `create-skill` into `~/.grok/bundled/`, read back with\n  `SkillScope::Bundled`, and that catalog is fetched per identity/team behind an x.ai\n  sign-in this stack deliberately does not have - LiteLLM is the only transport - so the\n  directory is never created and none of those skills ever lands."},"650":{"id":"/coder-templates-531","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-ez-learn-seed-and-the-bundled-catalog","content":"Writing the file is what\n  makes each command exist, and it is seeded under the `ez-` name, which exists to stay\n  clear of the upstream ones."},"651":{"id":"/coder-templates-532","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-ez-learn-seed-and-the-bundled-catalog","content":"The same stage deletes a leftover `skills/learn/SKILL.md` from\n  before the rename, but only while it still carries the stack marker; a marker-free one is\n  user-owned and stays. Deleting a seeded copy never keeps your own - the boot writes it\n  back - so only dropping that marker does."},"652":{"id":"/coder-templates-533","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-boot-log-each-body-prints","content":"Every exec'd body narrates itself, so a workspace start reads as a staged run rather than a\nwall of file copies. The verbs are `scripts/lib/common.sh`'s own words - `== section ==`,\n`-> phase`, `ok:`, `warning:`, `note:`, `error:`, and a closing `summary:` - so one\nvocabulary covers the host CLIs and the workspace boot."},"653":{"id":"/coder-templates-534","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#one-library-handed-to-every-body","content":"The verbs live in one payload, `templates/common/boot-log.lib.sh`, and both twins hand it\nto every exec'd body as the `boot_log_lib` key of that body's `templatefile()` map: the\nstartup body plus ten `coder_script`s in `workspace`\n(`templates/workspace/main.tf:509-510`), and eleven in the `devcontainer` twin, which adds\none body, `dind-bootstrap.sh.tftpl`."},"654":{"id":"/coder-templates-535","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#one-library-handed-to-every-body","content":"The two bodies nothing execs, `settings.json.tftpl` and\n`grok-config.toml.tftpl`, take no such key."},"655":{"id":"/coder-templates-536","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#one-library-handed-to-every-body","content":"A body takes the library as one bare line under its `set -u`. Terraform does not\nre-interpolate a map value, so the library's own dollar-brace shell text lands verbatim -\nno here-doc, no temp file, no second copy to drift. That is also why the escape rule below\nis absolute rather than a style preference: Terraform reads an interpolation token wherever\nit sits, a `.tftpl` comment included, so no comment in one of these files may spell one."},"656":{"id":"/coder-templates-537","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-verbs-and-the-shapes-they-print","content":"The shapes, verbatim from `templates/common/boot-log.lib.sh:22-63`:"},"657":{"id":"/coder-templates-538","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#a-writable-directory-under-home","content":"The one precondition a body cannot inherit from another body is a writable directory\nunder `$HOME`. The three per-owner Grok volumes mount *under* `~/.grok`, and the Docker\ndaemon creates a bind mount's target path as `root:root`, so `~/.grok` arrives\nroot-owned on any boot where those mount points are new."},"658":{"id":"/coder-templates-539","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#a-writable-directory-under-home","content":"The startup script chowns it\n  back to the home owner, and nothing orders that before a sibling body: the start\n  scripts fan out in one errgroup, startup script included, which is the same\n  `script_count=10` burst The one-argument ceiling counts."},"659":{"id":"/coder-templates-540","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#a-writable-directory-under-home","content":"So a body that writes under `~/.grok` calls `boot_ensure_dir <dir>`\n  (`templates/common/boot-log.lib.sh:65-140`) rather than a bare `mkdir -p`. It creates\n  the directory and takes back the ownership of each component of it that is not this\n  boot's to write, walking from `$HOME` down, stopping below `$HOME` itself, and never\n  recursing into the mounted volumes that sit beside the target."},"660":{"id":"/coder-templates-541","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#a-writable-directory-under-home","content":"It returns 1 and prints\n  `error:` when the directory stays unwritable, which is what lets a body refuse its own\n  `ok:`."},"661":{"id":"/coder-templates-542","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#a-writable-directory-under-home","content":"`templates/common/terminal-launchers.sh.tftpl` is the case that earned it: a\n  launcher that never landed is a code-server tab that dies with `exit code: 127`, and\n  the body closed at `summary: 2 ok, 0 warnings, 0 failed` while writing nothing. The\n  bodies that seed the two skill homes under `~/.coder` and `~/.agents` still `mkdir -p`\n  directly - neither is a bind-mount parent, so nothing arrives there owned by root."},"662":{"id":"/coder-templates-543","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#a-writable-directory-under-home","content":"Each body opens with its own `== <body>: start ==` and, on every path that got that far, its\nfinal act is `boot_summary`, so the eleven bodies of one agent share a single log and stay\ntellable apart by the name in those two lines (`boot_begin`'s first argument, echoed again in\nthe `summary:`). `note:` is the only verb nothing counts, which is how a gated-off body\nreads: notes, then `summary: 0 ok, 0 warnings, 0 failed`."},"663":{"id":"/coder-templates-544","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-1-mib-log-budget","content":"The bound every body is written against: one agent's whole log stream - `startup_script`\nand every `coder_script` on it together - is 1 MiB. It is a Postgres check,\n`CONSTRAINT max_logs_length CHECK ((logs_length <= 1048576))` on `workspace_agents`\n(dump.sql, v2.36.6),\nand `workspace_agents` is the only table in that schema that carries agent logs at all, so\na script's lines draw on the same budget as the startup script's."},"664":{"id":"/coder-templates-545","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-1-mib-log-budget","content":"The agent's uploader\n  holds the same number as a constant\n  (`codersdk/agentsdk/logs.go`,\n  `maxBytesQueued = 1048576`) and counts it across every log source at once, returning before\n  it appends when the queue is full: the lines you lose are the NEWEST ones, and once the\n  server answers `LogLimitExceeded: true` the uploader drops everything still queued."},"665":{"id":"/coder-templates-546","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-1-mib-log-budget","content":"Hence\n  the about-40-lines-per-body rule, and hence a command with a stream of its own is aimed at\n  a file rather than at the log - the editor launch redirects to `/tmp/code-server.log`\n  (`templates/workspace/code-server.sh.tftpl:67`) while the narration says the same thing in\n  one `boot_phase` line."},"666":{"id":"/coder-templates-547","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-1-mib-log-budget","content":"Nothing on the template side raises that budget, so do not re-add an argument for it.\n`coder_agent` in the provider this stack pins (`~> 2.18`, locked 2.18.0 in\n`templates/workspace/.terraform.lock.hcl`) has no log-size argument: `terraform plan`\nanswers `An argument named \"log_buffer_size\" is not expected here.`"},"667":{"id":"/coder-templates-548","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-1-mib-log-budget","content":"The agent-side constant\nis not read from the environment either - its own comment records the number as \"taken from\ndump.sql `max_logs_length` constraint\". Where to read the log and what a truncated one\nmeans is\ntroubleshooting.md."},"668":{"id":"/coder-templates-549","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-bodies-and-their-braced-escapes","content":"Every script the template renders is a `templatefile()` body: the agent's\n`startup_script` (`startup.sh.tftpl`) and one body per `coder_script` -\n`agents-seed.sh.tftpl`, `code-server.sh.tftpl`, `gh-token-refresh.sh.tftpl`,\n`infisical-secrets.sh.tftpl`, `stack-fleet.sh.tftpl`, `stack-advisors.sh.tftpl`,\n`stack-hooks.sh.tftpl`, the two skill\nfamilies, and `dind-bootstrap.sh.tftpl` in the devcontainer twin."},"669":{"id":"/coder-templates-550","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-bodies-and-their-braced-escapes","content":"Every braced shell expansion in one has to be written `$${name}`; the one-dollar braced\n  form is swallowed as an interpolation, in a comment or a `for` loop as readily as in a\n  command. The unbraced form (`$name`) needs no escape."},"670":{"id":"/coder-templates-551","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-bodies-and-their-braced-escapes","content":"`infisical-secrets.sh.tftpl` is the sparsest body: its map is the single `boot_log_lib`\n  key (`templates/workspace/main.tf:783-785`), so apart from the one line that takes it every\n  braced expansion in it is shell text, none of it interpolates, and the rendered bytes are\n  the same for every workspace."},"671":{"id":"/coder-templates-552","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-may-interpolate","content":"Only the variables `main.tf` passes interpolate. The `workspace` startup script gets\neleven: `boot_log_lib`, `grok_config`, `notes_setup`, `tmux_conf`,\n`grok_build_delegation_skill`, `coder_agents`,\n`mcp_cache_proxy`, `repo_url`, `additional_repos`, `vscode_settings`, `infisical_hook`.\nThe `devcontainer` twin adds `dc_dir` and `build_devcontainer`."},"672":{"id":"/coder-templates-553","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-may-interpolate","content":"The payloads of the other families are not among them:"},"673":{"id":"/coder-templates-554","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-may-interpolate","content":"`ez_learn_skill`, `ez_skillify_skill` and `ez_create_skill_skill` belong to the\n`coder_script.stack_skills` map"},"674":{"id":"/coder-templates-555","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-may-interpolate","content":"`grok_build_agents` to `coder_script.agents_seed`"},"675":{"id":"/coder-templates-556","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-may-interpolate","content":"the fleet's thirteen to `coder_script.stack_fleet`"},"676":{"id":"/coder-templates-557","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-may-interpolate","content":"the advisors' seven (`documenter_skill`, `documenter_agent`,\n`performance_optimizer_skill`, `debugger_skill`, `migrator_skill`,\n`ez_code_index_skill`, `ez_code_index_py`) to `coder_script.stack_advisors`"},"677":{"id":"/coder-templates-558","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-may-interpolate","content":"the guards' six (`evo_t1_hooks_json`, `secret_guard_sh`,\n`dangerous_command_guard_sh`, `post_edit_format_sh`, `selective_test_runner_sh`,\n`deny_patterns_txt`) to `coder_script.stack_hooks`."},"678":{"id":"/coder-templates-559","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-may-interpolate","content":"Each of those `chomp(file())` calls sits inside its own block\nrather than behind a `local.`, because a size reader credits a payload by the\n`chomp(file(\"${path.module}/name\"))` literal it can see in the body's own block, and\nfollows a `local.` exactly one hop (`scripts/lib/startup_size.awk`, invariants)."},"679":{"id":"/coder-templates-560","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-may-interpolate","content":"The list above is checked, not trusted: `//tests:bats_tftpl_interpolation_test` pulls the\nkeys of the `workspace` `startup_script` map out of the checker's own reading of\n`main.tf` and diffs them against the names this page lists."},"680":{"id":"/coder-templates-561","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-may-interpolate","content":"The same suite reads every\n`templatefile()` call in both twins, takes the keys each map declares and the names each\nbody interpolates, and fails on either direction of drift. Run the checker directly to\nsee the offending body and line:\n`python3 scripts/lib/tftpl_interpolation.py templates --strict`."},"681":{"id":"/coder-templates-562","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-may-interpolate","content":"That is why the `.git` suffix is stripped with `sed` rather than the shorter\n`${leaf%.git}`: a braced expansion would add an interpolation `main.tf` does not pass."},"682":{"id":"/coder-templates-563","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#how-values-arrive","content":"The repository URLs arrive as rendered literals and are read through a *quoted* heredoc,\nso no shell quoting has to survive and the value is only ever expanded as data. An empty\nGit repository field means a home-directory workspace, so the whole clone stage is\nskipped rather than attempted with an empty URL."},"683":{"id":"/coder-templates-564","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#how-values-arrive","content":"`~/.grok/config.toml` is emitted from a quoted heredoc for the same reason: a\n`Bearer $${GH_TOKEN}` line the config template emits travels through as literal text\ninstead of being expanded there, and the CLI expands it from the agent environment. The\nsame holds for the `CONTEXT7_API_KEY` reference."},"684":{"id":"/coder-templates-565","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#how-values-arrive","content":"`grok_config` arrives already rendered from `grok-config.toml.tftpl`. Its boolean keys\n`github_mcp`, `search_mcp` and `context7_mcp` only decide whether their\n`[mcp_servers.*]` block appears, and no credential byte is part of that decision;\n`search_url` supplies the URL the searxng block dials, and the workspace affinity key is\na per-workspace routing hint (a workspace UUID, not a secret)."},"685":{"id":"/coder-templates-566","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#cloning-as-the-workspace-user","content":"`clone_owner` is whichever user the workspace really belongs to: the owner of `$HOME`\nwhen the agent runs as root, otherwise whoever is running the script. It decides both the\nchown target and whose git credentials the clone consults."},"686":{"id":"/coder-templates-567","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#cloning-as-the-workspace-user","content":"The parent folder (`/home/coder/workspace`, or the `/srv/coder-devcontainers/<wsid>` bind\nin `devcontainer`) is chowned before git runs, and *non-recursively*: other clones live\nalongside this one and are not ours to take over. The clone folder itself is chowned too,\nor a root agent leaves it root-owned and the clone dies writing `.git` inside it."},"687":{"id":"/coder-templates-568","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#cloning-as-the-workspace-user","content":"git never runs as root, so the credentials it consults - a helper, `~/.git-credentials`,\nssh keys - are the workspace user's."},"688":{"id":"/coder-templates-569","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#cloning-as-the-workspace-user","content":"`HOME` is passed explicitly through `env` because\n`runuser` keeps the invoker's environment; a root agent would otherwise hand git `/root`\nand miss those files entirely. An empty prefix means \"run git directly\", which is correct\nfor a non-root agent and for a root agent with no derivable workspace user."},"689":{"id":"/coder-templates-570","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#cloning-as-the-workspace-user","content":"A folder that already holds a `.git` is left alone: re-fetching is the user's call,\nbecause a pull there could conflict mid-edit or fail on a dirty tree, and either way the\nworkspace would start on code nobody chose."},"690":{"id":"/coder-templates-571","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#cloning-as-the-workspace-user","content":"A failed clone is loud and non-fatal. The workspace still boots, an empty editor folder\nis fixable from a terminal, git removes its own partial clone on failure, and nothing in\nthe script deletes a folder that may hold someone's work."},"691":{"id":"/coder-templates-572","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#mcp-command-reachability-advisory","content":"Every `[mcp_servers.*]` block the render writes names its binary by the absolute path the\ngolden image bakes (`/opt/npm-global/bin/...`), so the config and the image are two\nartifacts that have to agree - and they do not always. A workspace running an image built\nbefore that binary was added boots with a lane that can never start, and the CLI only\nsays so in its own MCP log."},"692":{"id":"/coder-templates-573","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#mcp-command-reachability-advisory","content":"The stage reads the *rendered* file, pulls every `command = \"...\"` value out of it, and\nnames the ones that are not executable files, in the same startup log that wrote the\nconfig. `sed` keeps only a double-quoted value and a TOML path carries no spaces, so an\nempty entry there is an odd line rather than a missing binary."},"693":{"id":"/coder-templates-574","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#mcp-command-reachability-advisory","content":"It is advisory only: one warning line per missing path, never a failed start, so the call\nswallows whatever status the function returns."},"694":{"id":"/coder-templates-575","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#dev-container-preflight","content":"It runs after the clone because it is about what the clone holds, and it also runs on a\nre-start that cloned nothing, because the devcontainer build re-runs then too."},"695":{"id":"/coder-templates-576","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#dev-container-preflight","content":"The six paths it probes are the ones `@devcontainers/cli` looks in: `devcontainer.json`\nand `devcontainer.yml` at the root, under `.devcontainer/`, and under\n`.github/devcontainers/`."},"696":{"id":"/coder-templates-577","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#dev-container-preflight","content":"Nothing here changes what the build does. With the toggle on, a clone carrying no\ndevcontainer configuration fails the build either way, and the editor hangs off the dev\ncontainer, so no dev container also means no editor and no in-container terminal; the\nwarning is only early notice in the same log the clone warnings use."},"697":{"id":"/coder-templates-578","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#dev-container-preflight","content":"With the toggle off the same miss is expected and the editor opens the clone directly."},"698":{"id":"/coder-templates-579","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-infisical-boot-fetch","content":"What the vault is, how to adopt it, and how to rotate a key in it is\noperate/secrets.md. This is only what the two templates do about it."},"699":{"id":"/coder-templates-580","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-two-gates","content":"Two gates, both `default = false`: `infisical_enabled` decides whether the vault is part\nof the workspace at all, `infisical_pull_on_start` only whether a start waits on it\n(`templates/workspace/coder.tf:207-274`)."},"700":{"id":"/coder-templates-581","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-two-gates","content":"Neither is inferred from absence the way\n`OBSERVABILITY_ENABLED` is: that bundle ships on and an explicit `false` drops it, while\nhere an absent key is off, and `push-template.sh` therefore passes no `--var` at all\nrather than passing `false` (`scripts/push-template.sh:623-630`)."},"701":{"id":"/coder-templates-582","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-two-gates","content":"With the first gate off the `coder_script` is not merely idle - its `count` is `0`, so the\ntemplate renders no script, no boot log line, and no `INFISICAL_*` agent-env key, and a\nworkspace whose stack never adopted Infisical cannot tell the difference\n(`templates/workspace/main.tf:708-721`). With the first on and the second off the resource\nexists and does nothing but name its gate (`templates/common/infisical-secrets.sh.tftpl:27-30`)."},"702":{"id":"/coder-templates-583","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-two-gates","content":"Every credential rides the **agent environment** rather than the script body, for the\nreason every credential in `main.tf` rides it: Coder stores a rendered\n`coder_script.script` as text on the server, so a value interpolated into one would sit in\nCoder's database in plain sight, while an agent-env value is rendered per start and never\nwritten to disk (`templates/workspace/main.tf:687-691`)."},"703":{"id":"/coder-templates-584","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-two-gates","content":"The body accordingly declares no\nTerraform variable of its own - its `templatefile()` map is the single `boot_log_lib` key"},"704":{"id":"/coder-templates-585","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-two-gates","content":"and the seven keys the\n  `env = merge({...})` block hands it are its whole interface\n  (`templates/workspace/main.tf:692-706`, `:778-780`)."},"705":{"id":"/coder-templates-586","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-bodys-steps-in-order","content":"The body runs in this order, and every step that cannot proceed prints what it needs and\nexits 0:"},"706":{"id":"/coder-templates-587","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-bodys-steps-in-order","content":"no `infisical` binary in the image (`templates/common/infisical-secrets.sh.tftpl:8` -\nthe golden image bakes the pinned release, so that is an image older than\n`INFISICAL_CLI_VERSION`)"},"707":{"id":"/coder-templates-588","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-bodys-steps-in-order","content":"the six-name not-configured guard (`:14-20`)"},"708":{"id":"/coder-templates-589","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-bodys-steps-in-order","content":"the `INFISICAL_PULL_ON_START` gate (`:27-30`)"},"709":{"id":"/coder-templates-590","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-bodys-steps-in-order","content":"no `HOME` to write into (`:32-36`)"},"710":{"id":"/coder-templates-591","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-bodys-steps-in-order","content":"the Universal Auth login as the machine identity (`:61-65`)"},"711":{"id":"/coder-templates-592","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-bodys-steps-in-order","content":"the dotenv export into a `mktemp` dump (`:45`, `:67`)"},"712":{"id":"/coder-templates-593","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-bodys-steps-in-order","content":"the publish (`:245`)"},"713":{"id":"/coder-templates-594","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-bodys-steps-in-order","content":"Both temp files die in the `EXIT` trap whatever happens between the `mktemp` and the\n`mv` (`:45-52`)."},"714":{"id":"/coder-templates-595","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-bodys-steps-in-order","content":"A CLI error is scrubbed before it is printed. The CLI can echo the bearer token back in an\nerror line, and that line lands in the workspace's script log, so both the token and the\nclient secret are replaced with `<token>` / `<secret>` on their way to stderr\n(`templates/common/infisical-secrets.sh.tftpl:68-77`)."},"715":{"id":"/coder-templates-596","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-a-successful-fetch-writes","content":"`~/.infisical/agent.env` is what a successful fetch produces: mode `0600` inside a `0700`\n`~/.infisical` (`templates/common/infisical-secrets.sh.tftpl:37-40`, `:92`, `:244-246`), written by nobody\nelse, staged as `~/.infisical/.agent.env.XXXXXX` in that same directory and `mv`'d in, so\na reader never sees a half-written file - the same write-then-rename discipline\n`~/.grok/notes-setup.sh` uses above."},"716":{"id":"/coder-templates-597","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#what-a-successful-fetch-writes","content":"Its one reader is `~/.bashrc`, which sources it under\n`set -a` (`templates/workspace/startup.sh.tftpl:76-80`), and that login shell is what every\nterminal, tmux pane and command in the workspace inherits from. The file sits on the\nworkspace's own home volume (`templates/workspace/main.tf:1379-1382`), where every shell\nthat workspace runs can read it."},"717":{"id":"/coder-templates-598","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#re-emitting-the-export","content":"Nothing is copied out of the export line by line: each value is taken apart and re-emitted\nas `export KEY='value'` under quoting with no escape hatch, because the CLI's own dotenv\nwriter leaves an embedded single quote raw, which makes its output either unsources or\nrunnable (`templates/common/infisical-secrets.sh.tftpl:99-107`, `:217`). That is what makes the\n`.bashrc` source above safe, and it is why the reader and the publish step are one pair -\nthe startup comment says to read the publish step before changing either side\n(`templates/workspace/startup.sh.tftpl:71-72`)."},"718":{"id":"/coder-templates-599","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#re-emitting-the-export","content":"Every `INFISICAL_` name is filtered out of that file, and that filter is the load-bearing\nline (`templates/common/infisical-secrets.sh.tftpl:180`): the vault's own address and\nUniversal Auth pair are plausible keys in the very project being exported, and they must\nnot be republished as workspace environment through a file, when the agent environment is\nthe place Coder renders them per start (`:86-87`)."},"719":{"id":"/coder-templates-600","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#re-emitting-the-export","content":"The log line that follows reports a key\n*count*, never a value, and counts what the publish loop actually wrote (`:249-251`)."},"720":{"id":"/coder-templates-601","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#re-emitting-the-export","content":"The `[ -f ... ]` test for that file lives **inside** the appended `.bashrc` line rather\nthan around it, because the startup script and the fetch are two `coder_script`s with no\npromised order (`coder_script_order` needs Coder >= v2.39, see\nThe one-argument ceiling): a first boot whose startup script\nwins the race still ends up with a working hook, and the leading `grep -qs` keeps a later\nstart from appending the block twice (`templates/workspace/startup.sh.tftpl:64-80`)."},"721":{"id":"/coder-templates-602","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#best-effort-and-bounded","content":"The fetch is best-effort and cannot fail a workspace start. `timeout = 120`\n(`templates/workspace/main.tf:730`) bounds the realistic slow case, a vault container\nstill coming up, and every failure path - a refused login, an export that came back empty,\nan `mv` that did not land - prints one line, exits 0, and leaves the boot running on\nwhatever `agent.env` the previous start wrote\n(`templates/common/infisical-secrets.sh.tftpl:62-65`, `:68-77`, `:252-254`)."},"722":{"id":"/coder-templates-603","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#best-effort-and-bounded","content":"operate/secrets.md states the same bound from the other side."},"723":{"id":"/coder-templates-604","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#changing-the-body","content":"To change the body, edit `templates/common/infisical-secrets.sh.tftpl` and re-materialise\nit with `bazelisk run //scripts:push-template`. It is not one of the twins:\n`scripts/lib/template-push.sh:188` stages the common copy beside each `main.tf` and\noverwrites any same-named file a template dir still carries, and what a running workspace\nholds is Coder's Filestore row for its template version, which the next push replaces too.\nNothing here is fixed from inside a workspace."},"724":{"id":"/coder-templates-605","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#editor-terminal-and-the-metadata-tiles","content":"`display_apps` gives: the **VS Code Desktop** helper (a locally installed VS Code /\nCursor / Windsurf plus the `coder.coder-remote` extension), port forwarding, and the\nSSH helper."},"725":{"id":"/coder-templates-606","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#editor-terminal-and-the-metadata-tiles","content":"A separate in-browser **code-server** editor is Coder's VS Code fork (no local VS\nCode), labelled **VS Code Web** with `order = 5` so it sorts before GitHub reauth (7)\nand Install GitHub App (8) and reads apart from the **VS Code Desktop** helper. It is\nthe only app in the bar the agent still proxies."},"726":{"id":"/coder-templates-607","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#editor-terminal-and-the-metadata-tiles","content":"A custom **Web Terminal** command-app at `order = 6` takes the terminal slot. Custom\napps are ordered among themselves; static helper buttons have no `order` or `icon` knob\nin this Coder release and are not reorderable."},"727":{"id":"/coder-templates-608","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#editor-terminal-and-the-metadata-tiles","content":"A **GitHub reauth** external app (`order = 7`, `/icon/github.svg`) opens Coder's\n`/external-auth/<id>` page in a slim window on the user's Coder session: connect, or\n**Reauthenticate** when the account is already linked."},"728":{"id":"/coder-templates-609","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#editor-terminal-and-the-metadata-tiles","content":"It stays on the main agent so\na failed clone (or a `devcontainer` subagent that never starts) still leaves the\nbutton on the workspace page. Device-flow login is not the App install: with the\ninjected App (id `github`) that page prints \"You must install the GitHub App to\nclone private repositories\" as unlinked plaintext, because Coder omits\n`AppInstallURL` on the default provider."},"729":{"id":"/coder-templates-610","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#editor-terminal-and-the-metadata-tiles","content":"An **Install GitHub App** external app (`order = 8`, same icon, opens in a tab)\nis the clickable install path for that default App:\n`https://github.com/apps/coder/installations/new`. It is declared only while\n`github_auth_id` is `github`. After installing, grant the private repos the\nworkspace clones, then restart so `GH_TOKEN` remints."},"730":{"id":"/coder-templates-611","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#editor-terminal-and-the-metadata-tiles","content":"Memory (90 percent) and disk (85 percent, `/home/coder`) usage gauges, six resource\nmetadata tiles sampled every 30s - four `coder stat` calls (`cpu --host`,\n`mem --host`, `disk --path /home/coder`, `cpu --host`) and two awk one-liners for swap\nand load average."},"731":{"id":"/coder-templates-612","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#editor-terminal-and-the-metadata-tiles","content":"Those four are the whole bar."},"732":{"id":"/coder-templates-613","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#editor-terminal-and-the-metadata-tiles","content":"The proxy address reaches the operator as the `litellm`\nitem on the `workspace_info` tile below (`value = var.litellm_url`), a read-out\nrather than a proxied app, so health-checking the proxy is\n`curl http://host.docker.internal:4000/health/liveliness` on the stack host."},"733":{"id":"/coder-templates-614","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#editor-terminal-and-the-metadata-tiles","content":"`coder_metadata.workspace_info` shows the image, the cloned repository (in `workspace`,\nor `none` when the Git repository field is empty), the LiteLLM URL, the default Grok\nmodel, whether DinD is `on (tcp://dind:2375)` or `off`, and - redacted - which key is\nwired in."},"734":{"id":"/coder-templates-615","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#editor-terminal-and-the-metadata-tiles","content":"A misconfigured workspace is therefore visible in the UI without shell\naccess. `devcontainer` adds a `devcontainer folder` tile and always reads\n`on (tcp://dind:2375)` for Docker-in-docker."},"735":{"id":"/coder-templates-616","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-inlined-code-server-fork","content":"Neither template installs code-server through the Registry. Each `main.tf` carries an\ninlined fork (`coder_script.code_server` + `coder_app.code_server`) because that\nupstream module hardcodes `/icon/code.svg` and has no icon input. The script body\nlives in a sibling `code-server.sh.tftpl` and is rendered with `templatefile()`\n(workspace: `{ editor_folder, code_server_version }`; devcontainer: that plus\n`settings_b64`). Do not wrap that `templatefile()` in `chomp()`."},"736":{"id":"/coder-templates-617","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-pinned-release","content":"Both twins pin the editor release in one `code_server_version` local in their own\n`main.tf`, and the script hands that value to the upstream installer as\n`--version`. Without the flag `https://code-server.dev/install.sh` follows\n`latest`, so a release nobody reviewed would reach every new workspace with no\ncommit in this repo - the same reason the Registry module was forked out. The two\nlocals carry the same value and `//tests:bats_coder_apps_test` fails a drift."},"737":{"id":"/coder-templates-618","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-pinned-release","content":"To\nbump: read `https://github.com/coder/code-server/releases`, edit both locals,\n`bazelisk test //tests:bats_coder_apps_test`, `bazelisk run //scripts:push-template`,\nthen restart the workspaces. The pin is a template value and deliberately stays out\nof `images/dev/tool-versions.env`, where every key has to be an `images/dev/Dockerfile`\n`ARG` and this tool ships in no image at all."},"738":{"id":"/coder-templates-619","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-workspace-fork-the-install-guard-and-the-launch","content":"The `workspace` fork installs code-server **only when the pinned release is\nmissing** from `/home/coder/.local/share/code-server`, and starts it with\n`--auth none --port 13337 --app-name \"VS Code Web\" --ignore-last-opened <folder>`,\npassing no settings payload."},"739":{"id":"/coder-templates-620","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-workspace-fork-the-install-guard-and-the-launch","content":"The guard tests\n  `/home/coder/.local/share/code-server/lib/code-server-<version>/bin/code-server`,\n  the directory the installer unpacks, because `bin/code-server` beside it is a\n  symlink to whatever release was installed last: a guard on that symlink would keep\n  a warm volume running its first release after a bump."},"740":{"id":"/coder-templates-621","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-workspace-fork-the-install-guard-and-the-launch","content":"A bump therefore re-downloads\n  on the next start and leaves the previous release under `lib/`; removing that old\n  directory by hand is what reclaims the space."},"741":{"id":"/coder-templates-622","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-workspace-fork-the-install-guard-and-the-launch","content":"Before that launch it `mkdir -p`s the\n  folder and, when the folder is not `/home/coder`, waits up to 60 s for\n  `<folder>/.git` so a first-start\n  clone and the editor no longer race."},"742":{"id":"/coder-templates-623","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-workspace-fork-the-install-guard-and-the-launch","content":"That wait loop increments with\n  `waited=$((waited + 1))` (one dollar) inside the tftpl: `templatefile()` interpolates\n  `${…}` and leaves `$((` alone. `$$((` would expand `$$` to the PID. `coder_agent.dir` stays unset: the agent would\n  chdir there before `startup.sh`, and a missing clone folder would fail the agent."},"743":{"id":"/coder-templates-624","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-workspace-fork-the-install-guard-and-the-launch","content":"The\n  editor's settings are a per-start merge: the boot\n  (`templates/workspace/startup.sh.tftpl`) writes `~/.local/share/code-server/User/settings.json`\n  as a real file from this workspace's render, then layers the per-owner\n  `vscode-settings-<owner-id>` seed (`~/.shared/vscode/settings.json`, where an\n  operator's API keys live) over it, then re-asserts `workbench.colorTheme` from the\n  render last so the seed cannot veto this workspace's own theme."},"744":{"id":"/coder-templates-625","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-devcontainer-fork-and-the-app-url","content":"The `devcontainer` fork has no persistent prefix to reuse - both toggle modes rebuild\nthe container that hosts the editor - so it installs the pinned release fresh under\n`/tmp/code-server` on every start, and bakes the settings seed as base64 into `settings_b64` (empty when the\ntoggle is off, so the shell skips the merge). The DinD wait lives in\n`templates/devcontainer/dind-bootstrap.sh.tftpl`."},"745":{"id":"/coder-templates-626","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-devcontainer-fork-and-the-app-url","content":"Both twins' `coder_app` opens on `http://localhost:13337/?folder=<urlencoded>`. The\n`coder_app` resource in `coder/coder` `~> 2.18` has no `folder` argument, so the\nfolder rides in the URL, in the Web Terminal's `command`, and as a positional\nargument to the code-server binary with `--ignore-last-opened` (path-based apps\ndrop the query string, and without that flag the last restored workspace wins)."},"746":{"id":"/coder-templates-627","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-devcontainer-fork-and-the-app-url","content":"`coder_app` resources are not gated on `start_count`. `coder/preview` warns\n`Unexpanded count argument on block coder_app.*` when they are: that value is\nnot expanded at workspace-create preview. Scripts, metadata and the container\nstay gated."},"747":{"id":"/coder-templates-628","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-devcontainer-fork-and-the-app-url","content":"The `devcontainer` editor cannot set `agent_id` with\n`local.use_dc ? coder_devcontainer.repo[0].subagent_id : coder_agent.main.id`."},"748":{"id":"/coder-templates-629","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-devcontainer-fork-and-the-app-url","content":"`coder_devcontainer.repo` is also gated on `start_count`, so the stop / template-import\nephemeral plan has an empty tuple even with the toggle on (the default), and that\nternary then fails with `Invalid index` / `empty\ntuple`."},"749":{"id":"/coder-templates-630","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-devcontainer-fork-and-the-app-url","content":"`local.code_server_agent_id` is\n`concat(coder_devcontainer.repo[*].subagent_id, [coder_agent.main.id])[0]`: the\nsub-agent when that resource exists, the parent agent on the stopped page."},"750":{"id":"/coder-templates-631","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-devcontainer-fork-and-the-app-url","content":"The start-gated `coder_script.code_server` uses the same local."},"751":{"id":"/coder-templates-632","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-icon-and-its-256-byte-column","content":"The custom icon `templates/common/vscode-alt.svg` travels as a\n`data:image/svg+xml;base64` data URL read from `templates/common/`. Coder serves icons\nonly from its bundled `/icon/*` set or from a full `https`/`data` URL, and that icon is\nnot bundled. `workspace_apps.icon` is `varchar(256)` on Coder v2.36, so the SVG is a\ncompact ribbon whose data URL fits that column; a larger file fails `templates push`\nwith `pq: value too long for type character varying(256)`. `push-template` rejects\nthat locally, before the CLI runs."},"752":{"id":"/coder-templates-633","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#editor-settings-seed","content":"`settings.json.tftpl` is copied once, the first time `~/.shared/vscode/settings.json`\nis missing, onto the per-owner volume `vscode-settings-<owner-id>`, where it stays as\nthe overlay below. Startup chowns that volume (and the three `~/.grok` state volumes)\nto the home owner before the write: an empty Docker named volume is `root:root` 755, and the agent runs\nas `coder`."},"753":{"id":"/coder-templates-634","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#editor-settings-seed","content":"A failed write logs a warning instead of running `jq`/`python`\nagainst a file that was never created."},"754":{"id":"/coder-templates-635","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#editor-settings-seed","content":"code-server's User settings file, `~/.local/share/code-server/User/settings.json`, is\na real file on this workspace's own home volume. Each start writes it in three passes:"},"755":{"id":"/coder-templates-636","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#editor-settings-seed","content":"the per-workspace render (which carries `workbench.colorTheme` from the **Editor\ncolour theme** field)"},"756":{"id":"/coder-templates-637","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#editor-settings-seed","content":"every key from that shared overlay on top so an API key entered once stays"},"757":{"id":"/coder-templates-638","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#editor-settings-seed","content":"the theme re-asserted last so the overlay can never veto this workspace's own theme"},"758":{"id":"/coder-templates-639","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#editor-settings-seed","content":"The write is atomic (`<path>.tmp` then `mv`)."},"759":{"id":"/coder-templates-640","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#editor-settings-seed","content":"A symlink you made yourself at that path is left alone and named on stdout: the stack\ncreates no symlink, and it never replaces one."},"760":{"id":"/coder-templates-641","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#editor-settings-seed","content":"A built dev container sees neither the volume nor that overlay, so it is the one place\nthe seed is baked rather than layered."},"761":{"id":"/coder-templates-642","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#editor-settings-seed","content":"The code-server module is deliberately given no settings map in plain mode: its merge\nruns on every start and would `mv` over the file the boot just layered, dropping the\noverlay's keys. (`devcontainer` passes the seed to the module only in the mode where\nthe merge is wanted, and bakes it as `settings_b64` for the built container.)"},"762":{"id":"/coder-templates-643","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#editor-settings-seed","content":"The seed in git carries no API key. Cline and Roo read their key out of `settings.json`\nand have no `env_key` field, so when `LITELLM_API_KEY` is set the startup script injects\nit into the seed once (`jq`, falling back to `python3`) and nowhere else."},"763":{"id":"/coder-templates-644","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#editor-settings-seed","content":"`subdomain = false` everywhere: there is no `CODER_WILDCARD_ACCESS_URL` on this box, so\nthe editor is proxied on the path-based access URL."},"764":{"id":"/coder-templates-645","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#terminal-and-editor-defaults","content":"Template-side facts only; the long prose lives in\ndocs/grok-build-and-agents.md."},"765":{"id":"/coder-templates-646","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#terminal-and-editor-defaults","content":"`terminal.integrated.defaultProfile.linux` is `\"tmux\"`. The automation profile stays\n`/bin/bash`, so build/tasks commands never wait on tmux. Plain `bash` and **Grok\nBuild** stay available as extra profiles."},"766":{"id":"/coder-templates-647","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-two-launcher-helpers","content":"Two helpers are seeded into `~/.grok/bin` on every start, both `chmod +x`:\n`vscode-terminal-tmux` (the default profile) and `grok-build-terminal`. The two\nprofiles in `settings.json` exec exactly those paths, so the seed body reads both\nfiles back and prints `error:` naming the `exit code: 127` a tab gets when one did not\nland, rather than closing green. The missing-file cause and its remedy are in\ntroubleshooting.md."},"767":{"id":"/coder-templates-648","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-two-launcher-helpers","content":"`vscode-terminal-tmux` keeps `vscode-<folder>-<hash>` as its base session name. It\nre-joins one of that folder's sessions while no client is attached to it, oldest\nfirst (the closed-tab rejoin: an unattached session is reused even while sibling\nterminals are live); it takes the next numbered sibling, `vscode-<folder>-<hash>-2`,\n`-3`, ... only when every session of the folder already has a client."},"768":{"id":"/coder-templates-649","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-two-launcher-helpers","content":"With no\n`tmux` on PATH it falls back to a plain login shell.\nBefore it reads who is attached it detaches any client on those sessions that has\nreported no activity for over 6 hours (`EVO_TMUX_STALE_AFTER`, in seconds): a tab\nwhose browser side went away can leave its client attached and draining nothing,\nand one such client is enough to keep a free session looking busy forever."},"769":{"id":"/coder-templates-650","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-two-launcher-helpers","content":"Because the profile runs inside a session rather than in the tab's own process,\nclosing a tab detaches the client and leaves whatever was running alive."},"770":{"id":"/coder-templates-651","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-two-launcher-helpers","content":"`grok-build-terminal` keeps its own session, `grok-build-<folder>-<hash>`, keyed off\nthe repository root found with `git rev-parse --show-toplevel` (or the terminal's own\n`$PWD` outside a clone) and runs `grok --cwd <that root>` inside it."},"771":{"id":"/coder-templates-652","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-two-launcher-helpers","content":"It is the\nalways-reattach case on purpose: every tab of the clone watches the one agent run.\nThe session is created detached and attached in a second call, so the tab that\nbrings the server up never takes a running agent down with it, and it makes the same\nstale-client sweep its sibling does."},"772":{"id":"/coder-templates-653","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-two-launcher-helpers","content":"With no `tmux` on PATH, and on any create or\nattach it cannot complete, it hands the tab a plain login shell."},"773":{"id":"/coder-templates-654","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-two-launcher-helpers","content":"The seed also pins `terminal.integrated.cwd` and `terminal.integrated.splitCwd` to the\nopened folder, adds a `terminal.integrated.env.linux` block, and carries a\n`commandsToSkipShell` list - all described in the sibling doc."},"774":{"id":"/coder-templates-655","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#cloning-more-than-one-repository","content":"One repository per workspace is the default, and that is what `repo_url` and the\n**Git repository** field mean: one URL, cloned into one folder."},"775":{"id":"/coder-templates-656","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#cloning-more-than-one-repository","content":"That folder is what code-server, the Web Terminal button and the Grok Build session\nopen on. Inside a dev container, code-server sees that same folder under its mount\ntarget, `/workspaces/<repo-name>`."},"776":{"id":"/coder-templates-657","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#cloning-more-than-one-repository","content":"Keep it that way unless a workspace genuinely needs two trees open at once."},"777":{"id":"/coder-templates-658","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the---additional-repos-escape-hatch","content":"`--additional-repos` is the opt-in escape hatch for the service-and-the-library-it-uses\ncase. It takes a comma-separated list (`\"url1,url2\"`), one URL per line works too, and\nthe spaces around each entry are trimmed."},"778":{"id":"/coder-templates-659","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the---additional-repos-escape-hatch","content":"It joins the list into one `additional_repos`\nparameter, so `\"a , b\"` and `\"a\\nb\"` both arrive in the template as `a,b`."},"779":{"id":"/coder-templates-660","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the---additional-repos-escape-hatch","content":"Without the flag the script passes exactly the parameters it used to pass, and the create\nform's **Git repositories (additional)** textarea stays empty."},"780":{"id":"/coder-templates-661","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the---additional-repos-escape-hatch","content":"The extras are cloned **beside** the primary repository, into sibling folders, by the\nsame clone-once rule (a folder that already holds a `.git` is left alone on later\nstarts, never pulled on)."},"781":{"id":"/coder-templates-662","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the---additional-repos-escape-hatch","content":"`workspace` keeps the clone tree under `/home/coder/workspace/<repo-name>`;\n`devcontainer` keeps it under `/srv/coder-devcontainers/<workspace-id>/<repo-name>`."},"782":{"id":"/coder-templates-663","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the---additional-repos-escape-hatch","content":"An extra folder never becomes the folder the tools open on: the editor, the Web\nTerminal button and the tmux helpers all stay on the primary clone."},"783":{"id":"/coder-templates-664","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the---additional-repos-escape-hatch","content":"A private extra repository still has to be GRANTED to the connected GitHub account, or\nits clone is refused, just like the primary one."},"784":{"id":"/coder-templates-665","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the---additional-repos-escape-hatch","content":"`--dry-run` prints the list under `also:` before it creates anything, so the decision\nis readable first."},"785":{"id":"/coder-templates-666","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#github-credentials-for-a-workspace","content":"GitHub credentials arrive by one path only: opt-in, and HTTPS-only. This is the canonical\npage for that path: where the token comes from, the order git consults it in, and the four\ncommands that read or repair it. The troubleshooting entries link here rather than\nrepeating it."},"786":{"id":"/coder-templates-667","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#where-the-token-comes-from","content":"An `ssh://` or `git@` URL reaches nothing here - this stack provisions no SSH keys."},"787":{"id":"/coder-templates-668","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#where-the-token-comes-from","content":"The path is Coder's external-auth broker. With no `coder.env`, Coder CE injects\na GitHub App whose id is `github`, and both templates declare that id by\ndefault."},"788":{"id":"/coder-templates-669","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#where-the-token-comes-from","content":"A custom OAuth app lives in `coder.env` (beside `docker-compose.yml`);\n`push-template.sh` forwards `CODER_EXTERNAL_AUTH_0_ID` so the templates declare\nthe same id. Link that provider to **both** templates."},"789":{"id":"/coder-templates-670","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#where-the-token-comes-from","content":"Fill every `CODER_EXTERNAL_AUTH_0_*` key or omit them all. A defined-but-empty key\ncrash-loops the server, which is why these keys live in `coder.env` and not in `.env`."},"790":{"id":"/coder-templates-671","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#where-the-token-comes-from","content":"Then connect your GitHub account. On a running workspace, click **GitHub reauth** on\nthe agent bar (Coder v2.36's `/external-auth/<id>` page; use **Reauthenticate** if the\npage says you are already authenticated). First-time connect also works from the\nworkspace create/update form and from Settings -> Tokens / external auth."},"791":{"id":"/coder-templates-672","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#where-the-token-comes-from","content":"Device-flow\n  login is not enough for private repos: install Coder's GitHub App with **Install\n  GitHub App** on the same bar (or open\n  github.com/apps/coder/installations/new),\n  grant those repositories, then restart."},"792":{"id":"/coder-templates-673","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#where-the-token-comes-from","content":"An empty\n  github.com/settings/apps page is not a misconfiguration:\n  with `auth_type=client_secret` Coder has no App to install, and Coder's built-in GitHub\n  App only earns a page there once it is installed on the account."},"793":{"id":"/coder-templates-674","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#where-the-token-comes-from","content":"Until something is\n  installed and granted, that page simply has nothing to **Configure**, and the credential\n  the provider mints still authenticates - it just cannot write to a private repository."},"794":{"id":"/coder-templates-675","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#where-the-token-comes-from","content":"Each workspace's agent injects a `GIT_ASKPASS` helper pointing at the `coder` binary it\nstages, alongside the `GH_TOKEN`/`GITHUB_TOKEN` pair in the agent environment. Some\nbuilds of that binary answer every prompt with `unrecognized subcommand`, so the stack\ndepends on the helper below rather than on askpass, and `check` prints a note line when\nthat askpass answers nothing."},"795":{"id":"/coder-templates-676","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#where-the-token-comes-from","content":"Nothing long-lived lives in any file, env or template: the rendered `config.toml`\nnames `GH_TOKEN` and nothing else, and the pair stops at the workspace container's edge\n(a dev container built on the sidecar is not handed either key)."},"796":{"id":"/coder-templates-677","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#where-the-token-comes-from","content":"One connection covers every workspace, and `gh auth status` inside a workspace is how\nyou check it landed. Ask it with the pair cleared - `env -u GH_TOKEN -u GITHUB_TOKEN gh\nauth status` - because gh reports the env pair in preference to the store."},"797":{"id":"/coder-templates-678","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-credential-ladder-in-gits-consult-order","content":"git never reads `GH_TOKEN` itself: it asks its credential helpers in order and sends the\n**first** answer. That order is what decides what github.com sees, and the first slot that\nanswers wins outright - everything under it exists but a real push never reaches it, which\nis the whole difference between a credential that works and a push that works."},"798":{"id":"/coder-templates-679","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-five-slots-in-order","content":"The credential helper configured for `https://github.com`. Both template twins seed\n`~/.gitconfig` at startup, for `github.com` and `gist.github.com` alike:"},"799":{"id":"/coder-templates-680","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-five-slots-in-order","content":"The blank first value is git's reset marker: it drops any helper inherited from a\nlower-precedence config file, and git takes the **last** value it finds for that host."},"800":{"id":"/coder-templates-681","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-five-slots-in-order","content":"The startup seed rewrites both keys every start (idempotent), and `github-auth fix`\ninstalls the same form, leaving a helper that already ignores the pair alone. This\nhelper is the slot that wins, and the clearing is the subject of the paragraph below."},"801":{"id":"/coder-templates-682","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-five-slots-in-order","content":"`GIT_ASKPASS`, when no helper answers. Where the staged binary is alive it mints on\ndemand; where it answers `unrecognized subcommand` git gets no answer at all and falls\nthrough to prompting, which is where `could not read Username` comes from."},"802":{"id":"/coder-templates-683","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-five-slots-in-order","content":"The `GH_TOKEN`/`GITHUB_TOKEN` pair - reached through the helper, because\n`gh auth git-credential` echoes either name whenever one is set."},"803":{"id":"/coder-templates-684","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-five-slots-in-order","content":"A helper that does not\nclear the pair therefore answers with the injected copy and never asks the store: that\nis the shadow, and it is why a hand-edited helper or a hand-rolled askpass script is the\nwrong instrument (see\nthe push-denied entry)."},"804":{"id":"/coder-templates-685","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-five-slots-in-order","content":"The gh auth store (`~/.config/gh`, 0600): the one copy on disk, maintained by\n`gh_token_refresh`. Reachable only past a helper that clears the pair."},"805":{"id":"/coder-templates-686","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-five-slots-in-order","content":"A live `coder external-auth access-token <id>` mint, on demand. Not a helper: it is\nwhat `github-auth fix` calls, and what a workspace shell can call, whenever a token has\nto be certainly fresh."},"806":{"id":"/coder-templates-687","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-five-slots-in-order","content":"**Why the env pair goes stale.** Coder injects `GH_TOKEN`/`GITHUB_TOKEN` into the agent\nenvironment when the workspace starts."},"807":{"id":"/coder-templates-688","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-five-slots-in-order","content":"That is a GitHub App user-to-server token, it\nexpires about an hour later, and the injected copy is never refreshed for the life of the\nworkspace: `gh_token_refresh` re-mints on start and every 20 minutes into the gh auth store\nand the gitconfig helper, never into the environment, and no process can rewrite another\nprocess's environment anyway."},"808":{"id":"/coder-templates-689","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-five-slots-in-order","content":"So for most of a workspace's life the helper echoes a dead\ntoken, github.com answers `remote: Invalid username or token. Password authentication is\nnot supported for Git operations.`, and the healthy store beside it is never asked."},"809":{"id":"/coder-templates-690","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-five-slots-in-order","content":"`gh`\nconsults the same pair before its own store, so inside that workspace `gh` needs\n`env -u GH_TOKEN -u GITHUB_TOKEN gh <args>` for the whole of its life; `git` needs no\nprefix once the helper is the env-proof form above, which is what `fix` installs."},"810":{"id":"/coder-templates-691","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-five-slots-in-order","content":"**Refresh, and reconnect.** `coder external-auth access-token` is the live path when the\nstore goes stale: it re-mints on demand and answers with a live token, or with the\nre-authentication URL and exit 1; with no connected account the refresh script prints its\none note (pointing at **GitHub reauth**, and at **Install GitHub App** when the injected\nApp is in use) and exits 0, and mints nothing."},"811":{"id":"/coder-templates-692","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-five-slots-in-order","content":"After a reconnect, restart the workspace (or\nwait for the next `gh_token_refresh`) so the injected pair and the store match the new\ngrant."},"812":{"id":"/coder-templates-693","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-five-slots-in-order","content":"The refresh script unsets `GH_TOKEN`/`GITHUB_TOKEN` before\n`gh auth login --with-token`, because gh refuses stdin while those names are set."},"813":{"id":"/coder-templates-694","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-five-slots-in-order","content":"**A token that authenticates still has to be granted.** A credential that was never\nGRANTED the repository fails clone and push, and reads prove nothing about write: a private\nrepository hidden from the credential answers 403 or 404 on both lanes, and a public one\nanswers a read probe with 200 for any authenticated caller, so a read-only credential\npasses a read test while every write to that repo is denied."},"814":{"id":"/coder-templates-695","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-five-slots-in-order","content":"`check` therefore asks the\nwrite question directly: one GET of `<repo>.git/info/refs?service=git-receive-pack`, the\nendpoint `git push` itself negotiates through."},"815":{"id":"/coder-templates-696","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#the-four-commands","content":"Every one prints slot names, credential kinds and verdicts, and none of them prints a\ntoken. Repo convention: `bazelisk run //scripts:github-auth -- <subcommand> ...`."},"816":{"id":"/coder-templates-697","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#reading-the-chain-and-repairing-it","content":"`bazelisk run //scripts:github-auth -- check [container] [repo-url] [--source=<slot>]` -\nread-only. Inside a workspace or the contributor devcontainer it runs SELF mode with no\ndocker and prints `self:` lines for this environment's own chain; on the stack host it\nenumerates the labeled workspace containers, or probes a named container alone.\n`--source=chain|env|gh|mint` names one slot (chain is the default), and flags may go\nbefore or after the positionals."},"817":{"id":"/coder-templates-698","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#reading-the-chain-and-repairing-it","content":"The last line is `push would WORK` or\n`push would FAIL`, keyed to the credential git would really send, and check exits\nnon-zero on FAIL."},"818":{"id":"/coder-templates-699","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#reading-the-chain-and-repairing-it","content":"The verdicts are PUSH-READY (200 advertising refs), REFUSED-GRANT\n(403, it authenticates and every write is denied), NOT VISIBLE (404, hidden or absent),\nREJECTED (401, the credential itself is refused, as an expired mint is), or no useful\nanswer (offline)."},"819":{"id":"/coder-templates-700","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#reading-the-chain-and-repairing-it","content":"`bazelisk run //scripts:github-auth -- fix [container] [repo-url]` - THE ONE COMMAND,\nand the answer to every `push would FAIL` line. Inside a workspace it repairs that\nworkspace; on the host a named container repairs that one workspace, and no container is\nrefused there because it names the blast radius. It mints a live token through Coder\nexternal-auth, writes the gh auth store, points git's `github.com` and `gist.github.com`\ncredential helper at that store through a form that clears the env pair first, then\nre-runs the write probe and prints the verdict again, so it proves itself. Idempotent."},"820":{"id":"/coder-templates-701","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#reading-the-chain-and-repairing-it","content":"When nothing can be minted AND the store is empty its line begins `HANDOFF` and names the\nthree clicks the human owes it."},"821":{"id":"/coder-templates-702","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#installing-a-pasted-pat-and-the-full-usage","content":"`bazelisk run //scripts:github-auth -- auth <container> [-]` - STACK HOST ONLY (it\ndrives `docker exec`). Installs a pasted PAT on stdin into that one workspace, then\nre-installs the env-proof helper that `gh auth setup-git` would otherwise overwrite.\nLegitimate only once `check` has already answered REFUSED-GRANT, NOT VISIBLE or REJECTED:\nthe repo rule is that a workspace's credential comes from the External Auth provider, so\nno verdict short of those justifies a pasted token."},"822":{"id":"/coder-templates-703","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#installing-a-pasted-pat-and-the-full-usage","content":"It REPLACES the per-start minted\ncredential, the next `gh_token_refresh` rewrites the store while an account is connected,\nand `gh auth logout` or a rebuild clears it - treat it as a stand-in and rotate or remove\nit in GitHub -> Settings -> Applications when the work ends."},"823":{"id":"/coder-templates-704","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#installing-a-pasted-pat-and-the-full-usage","content":"The PAT arrives on stdin only\n(the `-` form, or the hidden prompt): argv is readable through `ps` and keeps the token in\nshell history."},"824":{"id":"/coder-templates-705","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#installing-a-pasted-pat-and-the-full-usage","content":"`bazelisk run //scripts:github-auth -- -h` - full usage: the verdict kinds, both argument\norders, both modes and the fix contract."},"825":{"id":"/coder-templates-706","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#installing-a-pasted-pat-and-the-full-usage","content":"The lines `check` prints are documented with the failures they explain, in\ntroubleshooting.md:\n`git would send this credential (source: ...)`, `NO GitHub credential ...`,\n`[shadowed: ...]`, `push would WORK` / `push would FAIL`, and the dead-`GIT_ASKPASS` note."},"826":{"id":"/coder-templates-707","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates#installing-a-pasted-pat-and-the-full-usage","content":"`gh` refusing a healthy store is its own entry there, at\n`gh` answers `Bad credentials`,\nand a workspace with no `gh` binary at\n`gh: command not found`."},"827":{"id":"/config-updates","page_id":"/config-updates","type":"page","content":"Keeping a checkout's config current","breadcrumbs":["Docs"],"tags":["env","config","update-configs","maintenance"],"url":"/config-updates"},"828":{"id":"/config-updates-0","page_id":"/config-updates","tags":["env","config","update-configs","maintenance"],"type":"text","url":"/config-updates","content":"What goes stale after a `git pull`, what `update-configs` refreshes, and what it deliberately will not touch."},"829":{"id":"/config-updates-1","page_id":"/config-updates","type":"heading","tags":["env","config","update-configs","maintenance"],"url":"/config-updates#keeping-a-checkouts-config-current","content":"Keeping a checkout's config current"},"830":{"id":"/config-updates-2","page_id":"/config-updates","type":"heading","tags":["env","config","update-configs","maintenance"],"url":"/config-updates#what-goes-stale","content":"What goes stale"},"831":{"id":"/config-updates-3","page_id":"/config-updates","type":"heading","tags":["env","config","update-configs","maintenance"],"url":"/config-updates#the-two-passes","content":"The two passes"},"832":{"id":"/config-updates-4","page_id":"/config-updates","type":"heading","tags":["env","config","update-configs","maintenance"],"url":"/config-updates#the-env-pass","content":"The env pass"},"833":{"id":"/config-updates-5","page_id":"/config-updates","type":"heading","tags":["env","config","update-configs","maintenance"],"url":"/config-updates#the-other-writer-of-the-env-files","content":"The other writer of the env files"},"834":{"id":"/config-updates-6","page_id":"/config-updates","type":"heading","tags":["env","config","update-configs","maintenance"],"url":"/config-updates#the-workspace-pass","content":"The workspace pass"},"835":{"id":"/config-updates-7","page_id":"/config-updates","type":"heading","tags":["env","config","update-configs","maintenance"],"url":"/config-updates#the-reseed-set","content":"The reseed set"},"836":{"id":"/config-updates-8","page_id":"/config-updates","type":"heading","tags":["env","config","update-configs","maintenance"],"url":"/config-updates#the-seeded-skill-commands","content":"The seeded skill commands"},"837":{"id":"/config-updates-9","page_id":"/config-updates","type":"heading","tags":["env","config","update-configs","maintenance"],"url":"/config-updates#taking-a-seeded-copy-over","content":"Taking a seeded copy over"},"838":{"id":"/config-updates-10","page_id":"/config-updates","type":"heading","tags":["env","config","update-configs","maintenance"],"url":"/config-updates#the-all-pass","content":"The all pass"},"839":{"id":"/config-updates-11","page_id":"/config-updates","type":"heading","tags":["env","config","update-configs","maintenance"],"url":"/config-updates#flags","content":"Flags"},"840":{"id":"/config-updates-12","page_id":"/config-updates","type":"heading","tags":["env","config","update-configs","maintenance"],"url":"/config-updates#flag-position","content":"Flag position"},"841":{"id":"/config-updates-13","page_id":"/config-updates","type":"heading","tags":["env","config","update-configs","maintenance"],"url":"/config-updates#a-bare-target-is-a-container","content":"A bare target is a container"},"842":{"id":"/config-updates-14","page_id":"/config-updates","type":"heading","tags":["env","config","update-configs","maintenance"],"url":"/config-updates#prompting-on-a-tty","content":"Prompting on a TTY"},"843":{"id":"/config-updates-15","page_id":"/config-updates","type":"heading","tags":["env","config","update-configs","maintenance"],"url":"/config-updates#where-to-run-it","content":"Where to run it"},"844":{"id":"/config-updates-16","page_id":"/config-updates","type":"heading","tags":["env","config","update-configs","maintenance"],"url":"/config-updates#what-it-will-not-do","content":"What it will not do"},"845":{"id":"/config-updates-17","page_id":"/config-updates","type":"heading","tags":["env","config","update-configs","maintenance"],"url":"/config-updates#the-other-two-seeders","content":"The other two seeders"},"846":{"id":"/config-updates-18","page_id":"/config-updates","type":"heading","tags":["env","config","update-configs","maintenance"],"url":"/config-updates#the-width-the-fleet-ceiling-and-the-depth","content":"The width, the fleet ceiling, and the depth"},"847":{"id":"/config-updates-19","page_id":"/config-updates","type":"heading","tags":["env","config","update-configs","maintenance"],"url":"/config-updates#a-value-the-seeder-cannot-use","content":"A value the seeder cannot use"},"848":{"id":"/config-updates-20","page_id":"/config-updates","type":"heading","tags":["env","config",