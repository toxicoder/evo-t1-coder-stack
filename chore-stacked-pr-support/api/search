,"terminal","operate","safety"],"type":"text","url":"/hermes#hermes-host-assistant","content":"How to reach the dashboard, on the LAN and on the public name"},"2597":{"id":"/hermes-52","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#hermes-host-assistant","content":"Opening the same assistant in your own terminal with `hermes-shell`"},"2598":{"id":"/hermes-53","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#hermes-host-assistant","content":"Sign-in: HTTP basic auth, with Authelia in front of the public name"},"2599":{"id":"/hermes-54","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#hermes-host-assistant","content":"The models it calls through LiteLLM"},"2600":{"id":"/hermes-55","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#hermes-host-assistant","content":"Web research through the stack's own SearXNG, with the third-party fallback off"},"2601":{"id":"/hermes-56","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#hermes-host-assistant","content":"What the container mounts, and what \"be the host\" costs"},"2602":{"id":"/hermes-57","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#hermes-host-assistant","content":"Approval prompts, bootstrap seeding, and the skills directory"},"2603":{"id":"/hermes-58","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#hermes-host-assistant","content":"**What this enables**"},"2604":{"id":"/hermes-59","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#hermes-host-assistant","content":"Running stack operations by conversation with a plan and an approval first"},"2605":{"id":"/hermes-60","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#hermes-host-assistant","content":"Reaching the assistant on the LAN, and on the public name `auto` composes from the parts"},"2606":{"id":"/hermes-61","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#hermes-host-assistant","content":"Asking from a terminal you already have - the right Linux command, a triage, a\nGitHub project deployed into the deploy workspace - with the same skills, memory\nand approval gate behind the answer"},"2607":{"id":"/hermes-62","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#hermes-host-assistant","content":"Hermes is the Nous Research Hermes Agent running as the interactive assistant **on the\nstack host itself**: not inside a workspace, not in a streamed desktop, but with the\ncheckout, the compose project and the docker socket in reach."},"2608":{"id":"/hermes-63","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#hermes-host-assistant","content":"It adds an official Web Dashboard with a Chat tab that carries approval prompts, so the\nassistant can plan a change, show the plan, and wait for you to approve it before it\ntouches anything."},"2609":{"id":"/hermes-64","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#hermes-host-assistant","content":"That is the whole point of the service: stack ops by conversation."},"2610":{"id":"/hermes-65","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#hermes-host-assistant","content":"\"Recreate the dev stack and tell me which container restarts\""},"2611":{"id":"/hermes-66","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#hermes-host-assistant","content":"\"why is the coder agent offline\""},"2612":{"id":"/hermes-67","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#hermes-host-assistant","content":"\"run the gate and fix what it reports\""},"2613":{"id":"/hermes-68","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#hermes-host-assistant","content":"Each one runs with a plan first and an approval card before the mutating command."},"2614":{"id":"/hermes-69","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#hermes-host-assistant","content":"Related:"},"2615":{"id":"/hermes-70","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#hermes-host-assistant","content":"dashboard.md (the card that links here)"},"2616":{"id":"/hermes-71","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#hermes-host-assistant","content":"litellm-routing.md (the aliases Hermes calls)"},"2617":{"id":"/hermes-72","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#hermes-host-assistant","content":"public-access.md (the public name, which `auto` composes)"},"2618":{"id":"/hermes-73","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#hermes-host-assistant","content":"SECURITY.md"},"2619":{"id":"/hermes-74","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#access","content":"Dashboard on host port **9119**, from `HERMES_DASHBOARD_PORT`. The dev sandbox shifts\nit to **19119** the same way it shifts every other published port."},"2620":{"id":"/hermes-75","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#access","content":"**LAN:** `http://<STACK_LAN_HOST>:9119` - plain HTTP, exactly like LiteLLM on `:4000`.\nThere is no self-signed cert for this port and no redirect to HTTPS. This URL stays\nwhen the public name is on. Tailscale reaches it the same way, on that port."},"2621":{"id":"/hermes-76","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-public-name","content":"**Public name, opt-in:** `hermes-<suffix>.<base>`, so\n`https://hermes-gmktecbeast.overeazy.io` under the shipped defaults, when\n`STACK_PUBLIC_HOSTS=auto` composes it or an explicit list names it. Bootstrap\nclassifies `hermes-*` and `hermes.*` and writes `STACK_HERMES_URL`."},"2622":{"id":"/hermes-77","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-public-name","content":"The path is the same as the other public names:"},"2623":{"id":"/hermes-78","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-public-name","content":"Cloudflare (orange cloud, WebSockets on by default)"},"2624":{"id":"/hermes-79","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-public-name","content":"Traefik on the other LAN server (TLS `*.overeazy.io`, Authelia)"},"2625":{"id":"/hermes-80","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-public-name","content":"the `router` on this box `:8080`"},"2626":{"id":"/hermes-81","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-public-name","content":"`http://hermes:9119`, with the original Host preserved"},"2627":{"id":"/hermes-82","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-public-name","content":"Traefik's backend is `:8080`, not `:9119`. See public-access.md."},"2628":{"id":"/hermes-83","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#signing-in","content":"Sign-in is HTTP basic auth from `.env`: `HERMES_DASHBOARD_USER` (default `admin`) and\n`HERMES_DASHBOARD_PASSWORD`. Bootstrap generates the password; it is **not** the\nHomepage password, and `bazelisk run //scripts:dashboard-password` does not rotate it."},"2629":{"id":"/hermes-84","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#signing-in","content":"That basic auth stays on every door. Hermes v0.22.5 refuses to bind `0.0.0.0` with no\nprovider."},"2630":{"id":"/hermes-85","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#signing-in","content":"On the public URL Authelia challenges first and basic auth challenges second; two\nlogins are expected. LAN `:9119`, and LAN `:8080` with this name's Host header, never\nsee Authelia, so basic auth is the credential on those paths."},"2631":{"id":"/hermes-86","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-chat-tab","content":"The **Chat tab** is the primary UX. It embeds the Hermes TUI - a PTY over WebSocket\non `/api/pty` and `/api/ws` - so the terminal agent and the browser are the same\nprocess, and approval prompts render as cards in the chat rather than vanishing into\na detached tty."},"2632":{"id":"/hermes-87","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-chat-tab","content":"Hermes sends a keepalive every 20 seconds. Traefik and Authelia have to pass the\n`Upgrade` hop. A close code **4403** is the Host / Origin / peer guard."},"2633":{"id":"/hermes-88","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-chat-tab","content":"Compose sets `HERMES_DASHBOARD_PUBLIC_URL` from `STACK_HERMES_URL` (the seed file\ndoes not carry `public_url`). The seeded `dashboard.trusted_proxies` is\n`[\"172.16.0.0/12\"]`, which is what makes Hermes honour `X-Forwarded-Proto` from the\nrouter (the Secure cookie and `wss`)."},"2634":{"id":"/hermes-89","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-chat-tab","content":"`HERMES_DASHBOARD_PUBLIC_URL` is environment and applies when the container is\nrecreated."},"2635":{"id":"/hermes-90","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-chat-tab","content":"An existing `hermes-data` volume does not pick up `trusted_proxies` until a reseed or\n`hermes config set` - the volume seed is copy-once. The reseed command is below."},"2636":{"id":"/hermes-91","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-homepage-card","content":"The Homepage card in the **Host** group links to `STACK_HERMES_URL` (the public\norigin when set, otherwise the LAN URL). Its `siteMonitor` is\n`http://hermes:9119/api/status`, which resolves over compose DNS, so the card stays\ncorrect whatever the browser link is. See dashboard.md."},"2637":{"id":"/hermes-92","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#from-the-host-terminal","content":"The Chat tab is the door for someone at a browser. The terminal door is for someone\nalready on the box, and it opens the **same** assistant - same `SOUL.md`, same seeded\n`config.yaml`, same git-tracked skills, same LiteLLM lane, same memory, same manual\napproval gate:"},"2638":{"id":"/hermes-93","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#subcommands-and-options","content":"**Subcommands:** `chat` (the default), `ask TEXT` for one question and exit, `shell`\nfor a shell with the container's mounts and socket, `check` for the readiness report,\n`commands` for the assistant's own help. Every word after the subcommand is handed to\nthe assistant verbatim, so a flag this script has never heard of still works."},"2639":{"id":"/hermes-94","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#subcommands-and-options","content":"**Options** (before the subcommand): `-p/--project-name` (`evo-t1-prod`; the dev\nsandbox is `evo-t1-dev`), `-f/--file`, `-e/--env-file`, `-m/--model <alias>` for one\nsession, `-w/--writable <dir>`, `--one-shot`, `--dry-run`, `-h/--help`."},"2640":{"id":"/hermes-95","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#one-container-not-two","content":"**It enters the running container rather than starting a second one.** Hermes keeps\nits sessions and memory in a SQLite store under `/opt/data`, and two containers on one\ndata directory is the documented way to corrupt it - the WAL sidecars and the lock\nonly mean something inside one container."},"2641":{"id":"/hermes-96","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#one-container-not-two","content":"So while the gateway is up this is `docker compose exec`, and the terminal agent and\nthe dashboard agent are literally the same process on the same store. Only when\nnothing is running does it `docker compose run --rm --no-deps` a lone container.\n`--one-shot` forces the second container anyway and says out loud what it risks."},"2642":{"id":"/hermes-97","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#check-the-approval-gate-and-the-tty","content":"**`check` is the first thing to run when an answer looks impossible.** It reports:"},"2643":{"id":"/hermes-98","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#check-the-approval-gate-and-the-tty","content":"the daemon, the compose CLI, the project, the container state"},"2644":{"id":"/hermes-99","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#check-the-approval-gate-and-the-tty","content":"whether the service resolves, the image"},"2645":{"id":"/hermes-100","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#check-the-approval-gate-and-the-tty","content":"whether the data volume is seeded, whether the model key is set or still a shipped\nplaceholder"},"2646":{"id":"/hermes-101","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#check-the-approval-gate-and-the-tty","content":"whether LiteLLM answers `/health/liveliness`, the work directory"},"2647":{"id":"/hermes-102","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#check-the-approval-gate-and-the-tty","content":"It prints key names and never a value, and it launches nothing."},"2648":{"id":"/hermes-103","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#check-the-approval-gate-and-the-tty","content":"**Approvals are the same gate, inline.** A dangerous command stops in your tty with\n`[o]nce | [s]ession | [a]lways | [d]eny`, deny by default."},"2649":{"id":"/hermes-104","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#check-the-approval-gate-and-the-tty","content":"There is no browser card here and nothing to approve elsewhere; the terminal door does\nnot loosen `approvals.mode: manual`, and `--yolo` / `HERMES_YOLO_MODE` have no place in\nthis stack. See Approvals."},"2650":{"id":"/hermes-105","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#check-the-approval-gate-and-the-tty","content":"**An interactive session needs a real tty** (the TUI draws on a pty compose allocates\nfrom your terminal), so `chat` and `shell` refuse from a pipe or a cron line - that is\nwhat `ask` is for."},"2651":{"id":"/hermes-106","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#what-it-can-see-and-where-it-may-write","content":"**What it can see:** the checkout at `$STACK_HOST_PATH`, the deploy workspace at\n`${STACK_DEPLOY_PATH:-/opt/stack-deploy}`, `/opt/stack-skills`, the data volume, and\nthe docker socket."},"2652":{"id":"/hermes-107","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#what-it-can-see-and-where-it-may-write","content":"**What it cannot:** `/home` is not mounted, so no dotfiles, SSH keys or shell\nhistory - by design. The image carries git and the Docker CLI but not bazelisk, so\ninside the container the same operations go through\n`docker compose -p evo-t1-prod -f \"$STACK_HOST_PATH/docker-compose.yml\"`."},"2653":{"id":"/hermes-108","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#what-it-can-see-and-where-it-may-write","content":"**`--writable` matters more than it looks.** The official image sets\n`HERMES_WRITE_SAFE_ROOT=/opt/data`, so a file-tool write anywhere else is refused\noutright and no approval card even appears."},"2654":{"id":"/hermes-109","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#what-it-can-see-and-where-it-may-write","content":"To have the assistant edit files on the host, name the directory:\n`--writable \"${STACK_DEPLOY_PATH:-/opt/stack-deploy}\"` or the checkout path."},"2655":{"id":"/hermes-110","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#from-a-phone-or-anywhere","content":"The point of the assistant is that the operator leaves the desk and the box keeps\nworking for them. Four doors reach the same agent, the same seeded config, the same\nskills and the same memory store; which one is open is a decision in `.env`, not a\nrebuild."},"2656":{"id":"/hermes-111","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-four-doors","content":"| door      | what it is                                                     | shipped state | open it with                    |\n| --------- | -------------------------------------------------------------- | ------------- | ------------------------------- |\n| Dashboard | browser chat + PTY, basic auth, LAN `:9119` or the public name | on            | `STACK_PUBLIC_HOSTS` for remote |","table":"table-0"},"2657":{"id":"/hermes-112","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-four-doors","content":"| door     | what it is                                                  | shipped state | open it with |\n| -------- | ----------------------------------------------------------- | ------------- | ------------ |\n| Terminal | `hermes-shell` on the host: `ask`, `chat`, `shell`, `check` | always        | nothing      |","table":"table-0"},"2658":{"id":"/hermes-113","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-four-doors","content":"| door       | what it is                                                            | shipped state | open it with                     |\n| ---------- | --------------------------------------------------------------------- | ------------- | -------------------------------- |\n| API server | `POST /v1/chat/completions`, `/v1/runs`, `/api/sessions/*` on `:8642` | **off**       | `HERMES_API_SERVER_ENABLED=true` |","table":"table-0"},"2659":{"id":"/hermes-114","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-four-doors","content":"| door | what it is                        | shipped state | open it with             |\n| ---- | --------------------------------- | ------------- | ------------------------ |\n| Push | ntfy notifications to a phone app | **off**       | keys in `/opt/data/.env` |","table":"table-0"},"2660":{"id":"/hermes-115","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-api-server-door","content":"**The API server** is the headless door: an iOS Shortcut or a Tasker profile can\nPOST a prompt and read the answer with no browser and no dashboard login."},"2661":{"id":"/hermes-116","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-api-server-door","content":"It ships off and the published mapping binds **loopback**, because this server\n\"adds full access to the toolset, including terminal commands\" per upstream, on a\ncontainer that holds the docker socket."},"2662":{"id":"/hermes-117","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-api-server-door","content":"Turning it on is two deliberate edits:"},"2663":{"id":"/hermes-118","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-api-server-door","content":"the flag"},"2664":{"id":"/hermes-119","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-api-server-door","content":"`HERMES_API_BIND` if something off this host should reach it"},"2665":{"id":"/hermes-120","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-api-server-door","content":"`API_SERVER_KEY` is generated by bootstrap with the other secrets and is required\nwhenever the server is on; upstream fails closed rather than serving unauthenticated."},"2666":{"id":"/hermes-121","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-api-server-door","content":"`API_SERVER_MODEL_NAME` (default `hermes`) is what a model-listing frontend shows."},"2667":{"id":"/hermes-122","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-api-server-door","content":"`API_SERVER_CORS_ORIGINS` stays unset: a browser calls the dashboard, not this port,\nand an origin allowlist is only for a client you named on purpose."},"2668":{"id":"/hermes-123","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-push-door","content":"**Push** is what makes a phone viable, because pull means opening a dashboard every\ntime. It rides upstream's ntfy adapter and is configured in the assistant's own\n`/opt/data/.env`, not in compose:"},"2669":{"id":"/hermes-124","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-push-door","content":"Two reasons it lives on the volume:"},"2670":{"id":"/hermes-125","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-push-door","content":"the gateway registers the adapter from the *presence* of `NTFY_TOPIC`, so an empty\n`NTFY_TOPIC=` in compose would hand it a half-configured platform"},"2671":{"id":"/hermes-126","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-push-door","content":"a token in a container's environment is readable by anyone who can `docker inspect` it"},"2672":{"id":"/hermes-127","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-push-door","content":"Leave `NTFY_ALLOWED_USERS` unset and the channel is push-only - your phone gets the\nnotices, and nobody can talk back to the agent through the topic. Set it (to the topic\nname) only for inbound, and only on a topic no one else can guess: upstream's own\nwarning is that every publisher to a topic is treated as the same user."},"2673":{"id":"/hermes-128","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-push-door","content":"`NTFY_SERVER_URL` defaults to `https://ntfy.sh`; a self-hosted ntfy keeps the notices\non your hardware."},"2674":{"id":"/hermes-129","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-questions-you-ask-and-the-verbs-that-answer-them","content":"**What to ask from a phone** is the same list you would run at the desk, and the\n`coding-agents` skill is what teaches the assistant to answer it:"},"2675":{"id":"/hermes-130","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-questions-you-ask-and-the-verbs-that-answer-them","content":"*what are my agents doing* -> `//scripts:coder-sessions -- list` / `show`"},"2676":{"id":"/hermes-131","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-questions-you-ask-and-the-verbs-that-answer-them","content":"*what did it get stuck on* -> `tail <workspace> <session> 40`, then quote the pane"},"2677":{"id":"/hermes-132","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-questions-you-ask-and-the-verbs-that-answer-them","content":"*tell it yes* -> `send <workspace> <session> \"yes\"`"},"2678":{"id":"/hermes-133","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-questions-you-ask-and-the-verbs-that-answer-them","content":"*start one on repo X* -> `launch --dir /home/coder/<repo> <workspace>`"},"2679":{"id":"/hermes-134","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-questions-you-ask-and-the-verbs-that-answer-them","content":"*wake me when it finishes* -> `watch <workspace> <session> 1800`, then `hermes send`\nto the ntfy topic above"},"2680":{"id":"/hermes-135","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-questions-you-ask-and-the-verbs-that-answer-them","content":"*is the box healthy* -> `//scripts:hermes-shell -- check`, and the `host-diagnostics` skill"},"2681":{"id":"/hermes-136","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-questions-you-ask-and-the-verbs-that-answer-them","content":"Session control needs no credential and no open browser: the verbs read the Docker\ndaemon by workspace label. See\ngrok-build-and-agents.md."},"2682":{"id":"/hermes-137","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#audit-and-drift","content":"`hermes-shell -- check` answers \"can I open the assistant\". It cannot answer \"is this\nstill the assistant this repo describes\", and the two come apart on a long-lived box:\nan operator edits the config inside the volume, a recreate reads a stale `.env`, a\nmerge changes the seed and a seed-only-when-absent copy never takes it."},"2683":{"id":"/hermes-138","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#audit-and-drift","content":"`hermes-doctor` answers the second question. It is read-only and prints key names with\nno value."},"2684":{"id":"/hermes-139","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#where-its-facts-come-from","content":"**What it reads:** the config the container actually loads, the environment it was\ncreated with, the mounts it was given, and the two seed files beside the checkout."},"2685":{"id":"/hermes-140","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#where-its-facts-come-from","content":"The created environment is the fact and the `.env` beside the compose file is the\nintention: compose interpolated the former at create time, so a key can be right in\nthe file and stale in the container until the next recreate."},"2686":{"id":"/hermes-141","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#where-its-facts-come-from","content":"Every container-level fact comes from `docker inspect` or `docker compose ps`; nothing\nwrites, restarts, recreates, or execs."},"2687":{"id":"/hermes-142","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-check-names-and-the-exit-codes","content":"**The fourteen checks:**"},"2688":{"id":"/hermes-143","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-check-names-and-the-exit-codes","content":"`approvals` (manual, with cron and unattended both deny)"},"2689":{"id":"/hermes-144","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-check-names-and-the-exit-codes","content":"`terminal-cwd`, `write-root`, `web-lane`, `keyless-egress`, `mcp-servers`,\n`seed-drift`, `mount-identity`, `image-pin`, `model-key`, `dashboard`, `memories`"},"2690":{"id":"/hermes-145","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-check-names-and-the-exit-codes","content":"`anywhere-door` (the API server's enabled/keyed/bound state and whether the push\nchannel can be answered by strangers)"},"2691":{"id":"/hermes-146","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-check-names-and-the-exit-codes","content":"`agent-verbs` (whether the assistant can still reach `scripts/coder-sessions.sh`\nand the socket those verbs read)"},"2692":{"id":"/hermes-147","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-check-names-and-the-exit-codes","content":"The last two are the ones that keep the phone story honest: an open door nobody\nconfigured, and a closed door nobody can find, are the same class of surprise."},"2693":{"id":"/hermes-148","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-check-names-and-the-exit-codes","content":"**It reports, it does not gate.** Exit 0 on a clean bill (warnings allowed), 1 when a\ncheck failed, 2 on a bad invocation, 5 when it cannot find a checkout.\n`hermes-shell -- check` stays the thing that decides whether to launch a session."},"2694":{"id":"/hermes-149","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-findings-it-exists-to-catch","content":"**Three findings it exists to catch**, each one measured on a live box:"},"2695":{"id":"/hermes-150","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-findings-it-exists-to-catch","content":"`terminal.cwd` still carrying the `${STACK_HOST_PATH}` token (Hermes validates that\nvalue with `expanduser()` alone, so the token reads as a missing directory while\n`hermes config get` prints it looking healthy)"},"2696":{"id":"/hermes-151","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-findings-it-exists-to-catch","content":"`STACK_HOST_PATH` naming a directory with no checkout (compose mounts an empty\ndirectory over the repo and every container-level check still reads healthy)"},"2697":{"id":"/hermes-152","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-findings-it-exists-to-catch","content":"a `web` block that stopped pinning `searxng` or flipped a keyless switch back on,\nwhich routes a search to a vendor's free tier while the config still looks local"},"2698":{"id":"/hermes-153","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-findings-it-exists-to-catch","content":"**`--data DIR`** points the two volume checks at a directory instead of asking the\ndaemon where the volume is mounted, so the audit can be run against a copy of one."},"2699":{"id":"/hermes-154","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-findings-it-exists-to-catch","content":"**Run it before a `--force` re-seed and after a merge.** The drift check names the\nfile that differs and prints the `hermes-bootstrap --data <mount> --force` line that\nwould overwrite it, which is the pair an operator wants side by side."},"2700":{"id":"/hermes-155","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#auth","content":"Hermes since the June 2026 hardening refuses a non-loopback bind without a\n`DashboardAuthProvider`. Binding `0.0.0.0` with no provider is a boot error, not a\nwarning."},"2701":{"id":"/hermes-156","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#auth","content":"`HERMES_DASHBOARD_INSECURE` is a deprecated no-op. Setting it changes nothing and buys\nnothing, and it is not how the public name is opened."},"2702":{"id":"/hermes-157","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#auth","content":"Compose supplies the provider: `HERMES_DASHBOARD_BASIC_AUTH_USERNAME`,\n`HERMES_DASHBOARD_BASIC_AUTH_PASSWORD` and `HERMES_DASHBOARD_BASIC_AUTH_SECRET`,\ninterpolated from `.env` with the same non-empty fallbacks `.env.sample`\ncarries (`admin` / `change-me-hermes` / `change-me-hermes-secret`)."},"2703":{"id":"/hermes-158","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#auth","content":"An empty interpolation default is a boot error on `0.0.0.0`: the plugin skips\nregistration and the gateway refuses to bind."},"2704":{"id":"/hermes-159","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#auth","content":"The result fails closed: no credentials, no dashboard. There is no unauthenticated\nread-only mode to fall back to."},"2705":{"id":"/hermes-160","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#models","content":"Hermes talks to the LiteLLM proxy the stack already runs: base URL\n`http://litellm:4000/v1`, model alias **`agent`**. That is the tool-capable Spark lane,\nwhich is what an agent loop needs, and it stays the default."},"2706":{"id":"/hermes-161","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#models","content":"`agent` also thinks hard by default: it bakes `reasoning_effort: xhigh`.\n**`agent-low`**, **`agent-medium`** and **`agent-xhigh`** are the thinking variants of\nit - the same Qwen3.8-Flash-Next on the same three Spark boxes, with real\n`tool_calls` and that level baked into the alias instead."},"2707":{"id":"/hermes-162","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#models","content":"Use one when a run needs a different level; Qwen3.8-Flash-Next takes `low`, `medium`\nand `xhigh` and nothing else."},"2708":{"id":"/hermes-163","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-pinless-aliases","content":"**`agent-swarm`** is one of the nine Spark aliases, and one of four - with\n**`agent-explore`**, **`agent-review`** and **`agent-swarm-fast`** - that the LiteLLM\nsession pin does not cover: same model, same three boxes, same baked `xhigh`, but each\nrequest is placed on the least-busy healthy box."},"2709":{"id":"/hermes-164","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-pinless-aliases","content":"It is the lane for a parallel fan-out, not for one long Hermes session - a single\nthread would give up the pin's prefix-cache locality and could be prefilled on a\ndifferent box each turn. Hermes keeps `agent` as its default."},"2710":{"id":"/hermes-165","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-pinless-aliases","content":"The other three pinless groups serve a Grok Build subagent fleet rather than a chat:"},"2711":{"id":"/hermes-166","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-pinless-aliases","content":"`agent-explore` bakes `low` for a wave of read-only mappers"},"2712":{"id":"/hermes-167","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-pinless-aliases","content":"`agent-review` bakes `xhigh` for the skeptics that check what that fleet wrote"},"2713":{"id":"/hermes-168","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-pinless-aliases","content":"`agent-swarm-fast` is `agent-swarm` again for a wave of writers"},"2714":{"id":"/hermes-169","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-pinless-aliases","content":"The two `-fast` aliases, that one and its pinned twin **`agent-xhigh-fast`**, differ\nfrom their parents in one call only: the proxy, not the client, re-serves that\nsession's conversation summary from the Arc group `compaction-fast`, and every other\nturn still runs on a Spark."},"2715":{"id":"/hermes-170","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-pinless-aliases","content":"See litellm-routing.md."},"2716":{"id":"/hermes-171","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-key-and-the-fallbacks","content":"The key is `LITELLM_MASTER_KEY`, substituted from the environment into the seeded\n`config.yaml`. Do not copy the key into a Hermes file - one secret, one owner."},"2717":{"id":"/hermes-172","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-key-and-the-fallbacks","content":"Fallbacks, in the order worth trying them:"},"2718":{"id":"/hermes-173","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-key-and-the-fallbacks","content":"`chat` - `qwen2.5:7b` on the Arc, and it returns real `tool_calls`. The reliable\ndegrade path when every Spark box is down."},"2719":{"id":"/hermes-174","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-key-and-the-fallbacks","content":"`coder` / `coder-fast` - the Qwen2.5-Coder weights on the Arc. Chat is good, but\nthose weights write the tool call into the message body as plain text, so agent\nturns silently lose their tools. See\nlitellm-routing.md."},"2720":{"id":"/hermes-175","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#how-the-providers-block-declares-aliases","content":"The models come from a `providers:` block in `hermes/config.yaml`. Its `litellm` row\ndeclares the shared catalogue - the aliases that are not one of the Arc's own three\nweights - and each Arc row declares its weight with its `default_model`."},"2721":{"id":"/hermes-176","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#how-the-providers-block-declares-aliases","content":"Between them those declarations are every client-selectable alias in\n`litellm/config.yaml`, and a declaration is what makes an alias routable."},"2722":{"id":"/hermes-177","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#how-the-providers-block-declares-aliases","content":"Hermes matches a typed `/model <alias>` against the ids each row declares and routes\nit to the row that declares it, while a name no row declares is left on the current\nprovider as an unknown hidden model."},"2723":{"id":"/hermes-178","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#how-the-providers-block-declares-aliases","content":"`litellm/config.yaml` owns the set, so an alias is added there and a row follows; the\ngate fails when the two drift apart, or when one alias ends up on two rows."},"2724":{"id":"/hermes-179","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#route-and-model-are-separate-switches","content":"Route and model are two separate switches. A `providers:` row selects the route -\nbase URL, api key, api mode - and the model for a turn is otherwise the value in\nthe `model:` block."},"2725":{"id":"/hermes-180","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#route-and-model-are-separate-switches","content":"Measured on the shipped image, `--provider <row>` moves the route and takes that\nrow's `default_model` with it:"},"2726":{"id":"/hermes-181","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#route-and-model-are-separate-switches","content":"`--provider arc-chat` sends `\"model\":\"chat\"`"},"2727":{"id":"/hermes-182","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#route-and-model-are-separate-switches","content":"`--provider arc-coder` sends `\"model\":\"coder\"`"},"2728":{"id":"/hermes-183","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#route-and-model-are-separate-switches","content":"`--provider arc-coder-fast` sends `\"model\":\"coder-fast\"`"},"2729":{"id":"/hermes-184","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#route-and-model-are-separate-switches","content":"`--provider litellm` sends `\"model\":\"agent\"` - that row's `default_model` is\n`agent`, which is also what the `model:` block holds"},"2730":{"id":"/hermes-185","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#route-and-model-are-separate-switches","content":"`-m/--model <alias>` overrides it: `--model agent-swarm` sends `\"model\":\"agent-swarm\"`,\nand `--provider litellm --model chat` sends `\"model\":\"chat\"`."},"2731":{"id":"/hermes-186","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#route-and-model-are-separate-switches","content":"A run with no flags sends the `model:` block's value (`agent`) whatever rows exist,\nand `hermes config set model.provider <row>` changes the route and leaves that value\nalone - the `default_model` pickup is gated on the CLI flag, not on the config key."},"2732":{"id":"/hermes-187","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-verbs-that-change-the-model","content":"The verbs that do change the model:"},"2733":{"id":"/hermes-188","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-verbs-that-change-the-model","content":"`/model <alias>` inside a session"},"2734":{"id":"/hermes-189","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-verbs-that-change-the-model","content":"`bazelisk run //scripts:hermes-shell -- -m <alias>` from the host, which sets\n`HERMES_MODEL` in the container"},"2735":{"id":"/hermes-190","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-verbs-that-change-the-model","content":"`hermes config set model.default <alias>` to persist it in the live config under\n`/opt/data`"},"2736":{"id":"/hermes-191","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-verbs-that-change-the-model","content":"`model.model` is the legacy spelling of that same value: the loader copies it to\n`default` only while the block carries none, and drops it after that - which is the\nshape a persisted `/model` writes."},"2737":{"id":"/hermes-192","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-verbs-that-change-the-model","content":"So after one in-session switch, `hermes config set model.model <alias>` prints a\nsuccess line and changes nothing, and `hermes config get model.model` answers \"Config\nkey not set\" for the same reason even when a model is set; read it back with\n`hermes config get model.default`."},"2738":{"id":"/hermes-193","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-arc-rows-and-the-picker","content":"The Arc's own weights also ship as named rows beside that catalogue - `arc-chat`,\n`arc-coder` and `arc-coder-fast` - each pointing at the same LiteLLM door."},"2739":{"id":"/hermes-194","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-arc-rows-and-the-picker","content":"The picker does not show them beside it: Hermes folds rows that share an endpoint,\ncredential and wire protocol into one group, so a single `litellm` entry lists\nevery alias those rows declare, and the Arc rows stay reachable as `--provider`\nroutes and as a typed `/model <alias>`."},"2740":{"id":"/hermes-195","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-arc-rows-and-the-picker","content":"Each row's `default_model` is its weight's one declaration, and that declaration is\nwhat makes `/model chat` routable: two rows declaring the same id makes `switch_model`\nrefuse the name outright, so `chat`, `coder` and `coder-fast` are declared only by\ntheir Arc rows."},"2741":{"id":"/hermes-196","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-arc-rows-and-the-picker","content":"These are the route verbs, and `arc-chat` is the row to route through when a session\nwants the Arc's tool-capable model:"},"2742":{"id":"/hermes-197","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-arc-rows-and-the-picker","content":"`hermes --provider arc-chat` does not need the model named beside it - it sends\n`chat` on its own, and `-m <alias>` is there only to send something else through\nthat row. A run that names no flag is untouched by any of this, so the default stays\n`agent` and a healthy Spark box behaves exactly as before."},"2743":{"id":"/hermes-198","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-arc-rows-and-the-picker","content":"The rows go through LiteLLM rather than `http://ollama:11434` because the proxy is\nthe stack's sole model transport, it is where the aliases and the Arc's context\nwindow are defined, and 11434 is deliberately unpublished."},"2744":{"id":"/hermes-199","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#what-the-picker-hides","content":"Two parts of that list are deliberate. `compaction-fast` is served by the proxy and\nkept out of the picker on purpose: it is the Arc summariser the two `-fast` lanes hop\nto for one conversation summary, it carries no tool support, and a session must not\ndrive itself with it."},"2745":{"id":"/hermes-200","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#what-the-picker-hides","content":"`discover_models: false` on the `litellm` row is what keeps it out of the list - left\non, Hermes probes the proxy's `/v1/models` and adopts whatever it advertises."},"2746":{"id":"/hermes-201","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#what-the-picker-hides","content":"Read that as a hide rather than a wall: no row declares the id, and a name no row\ndeclares is *accepted* as an unknown hidden model on the current provider, so a typed\n`/model compaction-fast` still puts a turn on it. Nothing refuses it for you."},"2747":{"id":"/hermes-202","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-seed-reaches-the-volume-once","content":"All of that lives in the seed, and the seed reaches the volume once:\n`scripts/hermes-bootstrap.sh` copies `hermes/config.yaml` into the data volume only\nwhen the file is absent."},"2748":{"id":"/hermes-203","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-seed-reaches-the-volume-once","content":"A box that ran an earlier seed therefore has no `litellm` row at all -\n`--provider litellm` names a row its config does not have, the eleven catalogue\naliases are undeclared there, and with no row carrying `discover_models: false` the\npicker adopts `compaction-fast` off the proxy."},"2749":{"id":"/hermes-204","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-seed-reaches-the-volume-once","content":"Check it with `bazelisk run //scripts:hermes-doctor -- diff`, which names the file\nthat differs and prints the `hermes-bootstrap --data <mount> --force` line that\nre-seeds it; a hand-edited volume copy is worth reading before you overwrite it."},"2750":{"id":"/hermes-205","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-seed-reaches-the-volume-once","content":"Nous Portal is an optional upstream, not a default, and this page does not document it.\nNothing here needs an account."},"2751":{"id":"/hermes-206","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#web-research","content":"The assistant can look things up, and the query leaves through your own SearXNG."},"2752":{"id":"/hermes-207","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#web-research","content":"`web_search` goes to the stack's SearXNG container: the seeded config sets\n`web.search_backend: searxng`, and compose gives the container\n`SEARXNG_URL=${STACK_HERMES_SEARCH_URL:-http://searxng:8181}`."},"2753":{"id":"/hermes-208","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#web-research","content":"The variable's presence is what registers the provider (`plugins/web/searxng` reads\n`SEARXNG_URL` as its key env), and it is the only bundled web provider that\nneeds no API key. The name resolves on the compose network, so this adds no\npublished port."},"2754":{"id":"/hermes-209","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#web-research","content":"**Both keyless switches stay off, and that is the part that keeps the promise.**\n`agent/web_search_registry.py` resolves a backend in five steps, and its last\none is an anonymous free-tier ring - `exa`, `parallel`, `firecrawl`,\n`keenable` - reached with no key at all."},"2755":{"id":"/hermes-210","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#web-research","content":"A seed that named no backend and left `web.keyless_fallback` and `web.keyless_rescue`\nat their shipped `true` would answer a search from a vendor's public endpoint while\nlooking local. With both false, a query either goes to your instance or fails on the\nbox."},"2756":{"id":"/hermes-211","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#web-research","content":"`web_extract` is deliberately unconfigured. SearXNG aggregates engine results\nand does not fetch pages, so the seed leaves `web.backend` and\n`web.extract_backend` empty and page extraction fails with \"no extract provider\nconfigured\"."},"2757":{"id":"/hermes-212","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#web-research","content":"Set `web.extract_backend` yourself when you decide a fetch is worth a third-party\nextractor; nothing reaches one by default."},"2758":{"id":"/hermes-213","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#web-research","content":"Query the lane the same way the agent does:"},"2759":{"id":"/hermes-214","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#web-research","content":"`bazelisk run //scripts:search-check` from a host shell counts results per\nengine, which is how an empty answer stays distinguishable from no answer"},"2760":{"id":"/hermes-215","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#web-research","content":"inside the container,\n`curl -s -H 'Accept: application/json' \"$SEARXNG_URL/search?q=hermes&format=json\"`\nis the exact request the provider makes"},"2761":{"id":"/hermes-216","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#web-research","content":"The instance only answers JSON because `searxng/settings.yml` adds `json` to\n`search.formats`; without it the request is refused with 403 before the query is\nparsed."},"2762":{"id":"/hermes-217","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#web-research","content":"Re-point the lane with `STACK_HERMES_SEARCH_URL` in `.env` (a sibling box, say)\nand recreate."},"2763":{"id":"/hermes-218","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#web-research","content":"An operator who wants a keyed provider sets `web.search_backend` plus that vendor's\nkey env in the container themselves - the seed carries neither, and adding one is a\ndecision with a privacy cost."},"2764":{"id":"/hermes-219","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#mounts-and-be-the-host","content":"| Mount                        | Inside      | Why                              |\n| ---------------------------- | ----------- | -------------------------------- |\n| `hermes-data` (named volume) | `/opt/data` | config, sessions, memory, SQLite |","table":"table-1"},"2765":{"id":"/hermes-220","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#mounts-and-be-the-host","content":"| Mount                   | Inside                           | Why                     |\n| ----------------------- | -------------------------------- | ----------------------- |\n| `${STACK_HOST_PATH:-.}` | `${STACK_HOST_PATH:-/opt/stack}` | identical-path checkout |","table":"table-1"},"2766":{"id":"/hermes-221","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#mounts-and-be-the-host","content":"| Mount                                     | Inside                 | Why                  |\n| ----------------------------------------- | ---------------------- | -------------------- |\n| `${STACK_DEPLOY_PATH:-/opt/stack-deploy}` | the same absolute path | the deploy workspace |","table":"table-1"},"2767":{"id":"/hermes-222","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#mounts-and-be-the-host","content":"| Mount             | Inside                   | Why                |\n| ----------------- | ------------------------ | ------------------ |\n| `./hermes/skills` | `/opt/stack-skills` (ro) | git-tracked skills |","table":"table-1"},"2768":{"id":"/hermes-223","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#mounts-and-be-the-host","content":"| Mount                  | Inside                 | Why                           |\n| ---------------------- | ---------------------- | ----------------------------- |\n| `/var/run/docker.sock` | `/var/run/docker.sock` | compose and container control |","table":"table-1"},"2769":{"id":"/hermes-224","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-data-volume-and-the-checkout","content":"`/opt/data` is a **named volume on purpose**. Hermes keeps a SQLite database there in\nWAL mode, and WAL on a virtiofs bind mount is not safe. Bind-mounting that path is how\nyou corrupt the assistant's own memory."},"2770":{"id":"/hermes-225","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-data-volume-and-the-checkout","content":"`STACK_HOST_PATH` is the checkout's `pwd -P`, or, from a subdirectory or a linked\nworktree, its git top-level. Compose bind-mounts that host path at\nthe same path inside the container, so `docker compose -f $STACK_HOST_PATH/docker-compose.yml`\ntalking through the socket names bind sources the daemon can find."},"2771":{"id":"/hermes-226","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-data-volume-and-the-checkout","content":"Empty (CI `compose config`) falls back to `.:/opt/stack`."},"2772":{"id":"/hermes-227","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-data-volume-and-the-checkout","content":"`bootstrap` refreshes the key only after checking the path holds this\n`docker-compose.yml`: compose mounts whatever the key names, so a stale value leaves\nthe assistant working an empty directory while every container-level check still reads\nhealthy."},"2773":{"id":"/hermes-228","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-working-directory-must-be-a-literal-path","content":"The working directory the agent runs in is `terminal.cwd`, and it has to be a literal\npath. Hermes validates it in `agent/runtime_cwd.py` with `expanduser()` alone:"},"2774":{"id":"/hermes-229","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-working-directory-must-be-a-literal-path","content":"a `${VAR}` left in the file is reported as `does not exist` and the agent works\nsomewhere else"},"2775":{"id":"/hermes-230","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-working-directory-must-be-a-literal-path","content":"`hermes config get terminal.cwd` still prints the token because the config *loader*\ndoes expand `${VAR}`"},"2776":{"id":"/hermes-231","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-working-directory-must-be-a-literal-path","content":"The two paths disagree, and only the runtime one runs commands."},"2777":{"id":"/hermes-232","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-working-directory-must-be-a-literal-path","content":"`hermes-bootstrap` renders the placeholder in the seeded `config.yaml` at seed time\n(`--cwd DIR` overrides what it renders), which is the part that fixes a long-lived box."},"2778":{"id":"/hermes-233","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-working-directory-must-be-a-literal-path","content":"compose also sets `TERMINAL_CWD` from the same key, as the backstop for a config that\nnames no `terminal.cwd`: `apply_terminal_config_to_env` lets an explicit\n`terminal.cwd` in the file own that variable, so the file decides wherever it carries\none."},"2779":{"id":"/hermes-234","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-working-directory-must-be-a-literal-path","content":"Re-seed a volume that predates the render with\n`hermes-bootstrap --data <mount> --force`."},"2780":{"id":"/hermes-235","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-skills-directory","content":"`hermes/skills/` is tracked in git. Add a skill by editing the repo, never by editing\nthe volume; the volume copy is not the record."},"2781":{"id":"/hermes-236","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-deploy-workspace","content":"`STACK_DEPLOY_PATH` (default `/opt/stack-deploy`) is the **deploy workspace**: the one\ndirectory meant for clones, builds, and the compose project of a third-party project\nthe assistant brings up."},"2782":{"id":"/hermes-237","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-deploy-workspace","content":"It is mounted at its own absolute path for the same reason `STACK_HOST_PATH` is - a\nbind source inside a project file the assistant writes has to resolve on the host\ndaemon - and bootstrap fills it in without overwriting a path you set yourself."},"2783":{"id":"/hermes-238","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-deploy-workspace","content":"It is deliberately outside `/home`, so giving the assistant somewhere to work did not\nmean giving it your dotfiles. An existing container gains the mount on recreate, since\n`restart` keeps the old mounts."},"2784":{"id":"/hermes-239","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#what-the-docker-socket-costs","content":"`group_add: ${DOCKER_GID}` plus the socket is the same credential the `coder` service\nalready holds: root-equivalent on the host."},"2785":{"id":"/hermes-240","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#what-the-docker-socket-costs","content":"Nothing new is exposed here that the Coder container does not already have - which is\nprecisely why approvals, below, are the control rather than the mount list. A public\nHermes name has that same standing as public Coder."},"2786":{"id":"/hermes-241","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#what-the-docker-socket-costs","content":"`HERMES_UID` / `HERMES_GID` are set to the host operator, so a file Hermes writes into\n`$STACK_HOST_PATH` is yours to commit and not owned by uid 10000."},"2787":{"id":"/hermes-242","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#what-the-docker-socket-costs","content":"`/home` is **not** mounted in v1. Hermes cannot see your dotfiles, your SSH keys or\nyour shell history, and it should not need to."},"2788":{"id":"/hermes-243","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#approvals","content":"The seeded config sets `approvals.mode: manual`. `cron_mode` and `unattended_mode` are\nboth `deny`, so a scheduled or unattended run cannot approve anything either."},"2789":{"id":"/hermes-244","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#approvals","content":"Leave the mode on `manual`. `off` is `--yolo`: every mutating command executes on the\nhost with no card."},"2790":{"id":"/hermes-245","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#approvals","content":"`terminal.backend: local` keeps the dangerous-command checker active. The `docker`\nbackend skips that checker, because it treats the container as the safety boundary -\nand here the container is mounted onto the host, so that boundary is not real."},"2791":{"id":"/hermes-246","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#approvals","content":"Working agreement with the assistant: it explains the plan in chat, then waits for the\napproval card in the Chat tab before running anything mutating. If a run looks like it\nis acting without one, stop it and re-read the mode."},"2792":{"id":"/hermes-247","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#approvals","content":"From the terminal door the same gate is inline in your tty: a dangerous command stops\nwith `[o]nce | [s]ession | [a]lways | [d]eny` and does not proceed until you answer,\nwith deny the default."},"2793":{"id":"/hermes-248","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#approvals","content":"An approval is scoped to the session you answer in, so a yes given over there does not\ncover a fresh session opened at this door. `--yolo` and `HERMES_YOLO_MODE` bypass the\ngate entirely; they have no place here."},"2794":{"id":"/hermes-249","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#what-the-first-up-seeds","content":"The first `compose up` runs `hermes-init`, which is the in-container equivalent of\n`bazelisk run //scripts:hermes-bootstrap`: it runs\n`scripts/hermes-bootstrap.sh --in-container` and copies `hermes/config.yaml` and\n`hermes/SOUL.md` into `/opt/data` **only when those files are missing**."},"2795":{"id":"/hermes-250","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#what-the-first-up-seeds","content":"Editing the copy in the volume is how an operator ends up with a config no one can\nreproduce."},"2796":{"id":"/hermes-251","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#what-the-first-up-seeds","content":"The seed is a template for one key: `${STACK_HOST_PATH}` in `terminal.cwd` is rendered\nto a literal path on the way into the volume, from `--cwd`, then `STACK_HOST_PATH`,\nthen `/opt/stack` (announced when it falls back)."},"2797":{"id":"/hermes-252","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#what-the-first-up-seeds","content":"`${LITELLM_MASTER_KEY}` stays a token on purpose - Hermes expands it at boot, and a\nbyte of the key in a volume copy is what\nMounts and \"be the host\" argues against."},"2798":{"id":"/hermes-253","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#reseed-the-volume-deliberately","content":"To reseed deliberately:"},"2799":{"id":"/hermes-254","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#reseed-the-volume-deliberately","content":"`<mount>` is the host directory of the Hermes data volume (what compose mounts at\n`/opt/data`). `--force` is how an existing volume picks up the seeded\n`dashboard.trusted_proxies`, and `--cwd /absolute/path/to/checkout` is how a host re-seed\nnames the working directory when the shell running it carries no `STACK_HOST_PATH`."},"2800":{"id":"/hermes-255","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#reseed-the-volume-deliberately","content":"Setting that key with `hermes config set` is the\nin-container alternative. `HERMES_DASHBOARD_PUBLIC_URL` is not in the volume;\nrecreate the container and the env applies."},"2801":{"id":"/hermes-256","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#adding-a-skill","content":"A skill is one directory: `hermes/skills/<name>/SKILL.md`, with\nagentskills.io frontmatter for the name and description.\nCommit it, and the next `up` has it."},"2802":{"id":"/hermes-257","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#adding-a-skill","content":"What ships, and which question each one answers:"},"2803":{"id":"/hermes-258","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#adding-a-skill","content":"`evo-stack-ops` (pull, status, restart, logs for this stack)"},"2804":{"id":"/hermes-259","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#adding-a-skill","content":"`coder-workspace` (workspaces and their GitHub auth)"},"2805":{"id":"/hermes-260","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#adding-a-skill","content":"`coding-agents` (what the coding agents in those workspaces are doing right now,\nand how to answer, start, or stop one — the `//scripts:coder-sessions` verbs)"},"2806":{"id":"/hermes-261","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#adding-a-skill","content":"`model-routing` (which LiteLLM alias, and how to switch it)"},"2807":{"id":"/hermes-262","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#adding-a-skill","content":"`host-linux-ops` (the right Linux command, what each flag does, and the blast\nradius before it runs)"},"2808":{"id":"/hermes-263","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#adding-a-skill","content":"`host-diagnostics` (read-only triage for a slow, hot, full or failing box)"},"2809":{"id":"/hermes-264","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#adding-a-skill","content":"`web-research` (what is worth looking up, how to read an empty answer from the\nlane above, and what that lane refuses to do)"},"2810":{"id":"/hermes-265","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#adding-a-skill","content":"`deploy-from-github` (a named repository to running, with the read-first,\npin-the-ref, isolate, preflight, health-check, keep-a-rollback order)"},"2811":{"id":"/hermes-266","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#adding-a-skill","content":"The last four are what make the terminal door worth opening: they carry the mentoring\nstance - inspect, explain, propose, then act on the yes."},"2812":{"id":"/hermes-267","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#adding-a-skill","content":"A bind-mounted skill needs no recreate when the agent reloads skills from disk; start a\n**new session** - a fresh Chat tab, or a new `hermes-shell` run - and the new skill is\noffered. Recreate only if it still does not show up, since `restart` keeps the old\nmounts."},"2813":{"id":"/hermes-268","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-identity-file","content":"`SOUL.md` is the identity - voice and stance, a short persona. It is not a fork of\nAGENTS.md: the repo's shell conventions stay in that file, where the\nwriters and the linters read them."},"2814":{"id":"/hermes-269","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-public-name-and-its-doors","content":"The public name is opt-in (`hermes-*`, which `auto` composes from the naming parts or\nan explicit list pins). It does not change what the container can do: local terminal,\nhost mounts and the docker socket still mean this agent can affect the real host."},"2815":{"id":"/hermes-270","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-public-name-and-its-doors","content":"Treat its approvals the way you treat a root shell. That is the same standing as\npublic Coder."},"2816":{"id":"/hermes-271","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-public-name-and-its-doors","content":"HTTP basic auth stays, including on the public URL. Authelia is the gate in front of\nthat name only. LAN `:9119` and a matching Host on `:8080` bypass Authelia, so the\nbasic-auth provider is load-bearing. It is a provider, not a toggle."},"2817":{"id":"/hermes-272","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-public-name-and-its-doors","content":"`HERMES_DASHBOARD_INSECURE` does not remove that requirement. Leave\n`approvals.mode` on `manual`."},"2818":{"id":"/hermes-273","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#secrets-and-ad-hoc-shell","content":"Secrets live in gitignored `.env` and in the `hermes-data` volume. Never commit them,\nand never paste `LITELLM_MASTER_KEY` into a chat to prove a route works."},"2819":{"id":"/hermes-274","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#secrets-and-ad-hoc-shell","content":"Prefer structured commands - the existing Bazel scripts and `docker compose` - over\nad-hoc shell. A script the repo owns is reviewable and test-covered; a one-liner the\nmodel invented is neither. See AGENTS.md."},"2820":{"id":"/hermes-275","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#secrets-and-ad-hoc-shell","content":"No GitHub PAT in Hermes. GitHub auth in this stack is Coder External Auth only, and a\ntoken here would sit on a container that can both write to the checkout and drive the\nhost daemon. See SECURITY.md."},"2821":{"id":"/hermes-276","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-extra-doors","content":"The terminal door adds a way in for someone who already has a shell on this host, and\nopens no new listener, no new port and no new credential. `hermes-shell` authenticates\nnothing of its own: `docker` on that host is the credential, and it was always\nroot-equivalent here."},"2822":{"id":"/hermes-277","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-extra-doors","content":"Its one guard is that the assistant's approvals stay `manual` on both doors."},"2823":{"id":"/hermes-278","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-extra-doors","content":"The API server is the widest door here and ships closed. It carries the same\ntoolset as the dashboard, terminal included, and its only gate is the bearer key,\nso it is off in compose and its host mapping binds loopback until an operator\nnames both."},"2824":{"id":"/hermes-279","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-extra-doors","content":"Treat `HERMES_API_SERVER_KEY` as a root credential: rotate it by editing `.env` and\nrecreating the container, and give a phone a Shortcut that holds it rather than a URL\nthat carries it."},"2825":{"id":"/hermes-280","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-extra-doors","content":"A push channel is an inbound door even when you only use it to listen. Every\npublisher to an ntfy topic is one identity to the gateway, so the push-only\nposture - `NTFY_TOPIC` and `NTFY_PUBLISH_TOPIC` set, `NTFY_ALLOWED_USERS` not -\nis the one this doc recommends, and the topic name is the secret."},"2826":{"id":"/hermes-281","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#the-extra-doors","content":"The deploy workspace is writable by the assistant's file tools only when you say so\nwith `--writable`, and the file tools refuse anything outside the image's\n`HERMES_WRITE_SAFE_ROOT` (the official default is `/opt/data`) with no prompt at all.\nName the narrowest directory that finishes the job."},"2827":{"id":"/hermes-282","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#commands","content":"Open the assistant in your own terminal (subcommands `chat`, `ask`, `shell`, `check`,\n`commands`; `--help` for the flags):"},"2828":{"id":"/hermes-283","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#commands","content":"Read-only audit of what the assistant was created with, and how far it has drifted from\nthis checkout (`report`, `posture`, `web`, `diff`; `--check` narrows to one):"},"2829":{"id":"/hermes-284","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#commands","content":"Stable stack - `hermes` comes up with the rest:"},"2830":{"id":"/hermes-285","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#commands","content":"Bootstrap options, including `--data` and `--force`:"},"2831":{"id":"/hermes-286","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#commands","content":"Dev sandbox, which puts the dashboard on 19119:"},"2832":{"id":"/hermes-287","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#commands","content":"The stack runners take `up`, `down`, `status`, `logs`, `reset`; `status` and `logs` are\nwhere a Hermes that will not bind its port is diagnosed first."},"2833":{"id":"/hermes-288","page_id":"/hermes","tags":["hermes","dashboard","terminal","operate","safety"],"type":"text","url":"/hermes#commands","content":"Status across the whole box, including this card, is in\ndashboard.md; the LAN and public routing rules are in\npublic-access.md, and the service inventory is in\nREADME.md."},"2834":{"id":"/","page_id":"/","type":"page","content":"evo-t1-coder-stack","breadcrumbs":["Docs"],"tags":["overview","start","stack"],"url":"/"},"2835":{"id":"/-0","page_id":"/","tags":["overview","start","stack"],"type":"text","url":"/","content":"One compose stack that turns a GMKtec EVO-T1 into a self-hosted dev-workspace server — Coder, LiteLLM, IPEX-LLM Ollama, Kasm, Homepage and Hermes."},"2836":{"id":"/-1","page_id":"/","type":"heading","tags":["overview","start","stack"],"url":"/#evo-t1-coder-stack","content":"evo-t1-coder-stack"},"2837":{"id":"/-2","page_id":"/","type":"heading","tags":["overview","start","stack"],"url":"/#what-this-repository-brings-up","content":"What this repository brings up"},"2838":{"id":"/-3","page_id":"/","type":"heading","tags":["overview","start","stack"],"url":"/#two-copies-of-the-stack-on-one-box","content":"Two copies of the stack on one box"},"2839":{"id":"/-4","page_id":"/","type":"heading","tags":["overview","start","stack"],"url":"/#start-here","content":"Start here"},"2840":{"id":"/-5","page_id":"/","type":"heading","tags":["overview","start","stack"],"url":"/#what-runs-here","content":"What runs here"},"2841":{"id":"/-6","page_id":"/","type":"heading","tags":["overview","start","stack"],"url":"/#the-service-table","content":"The service table"},"2842":{"id":"/-7","page_id":"/","type":"heading","tags":["overview","start","stack"],"url":"/#what-publishes-nothing","content":"What publishes nothing"},"2843":{"id":"/-8","page_id":"/","type":"heading","tags":["overview","start","stack"],"url":"/#the-sidebar-tabs","content":"The sidebar tabs"},"2844":{"id":"/-9","page_id":"/","tags":["overview","start","stack"],"type":"text","url":"/#evo-t1-coder-stack","content":"**What's on this page**"},"2845":{"id":"/-10","page_id":"/","tags":["overview","start","stack"],"type":"text","url":"/#evo-t1-coder-stack","content":"What runs on the box and which door each service answers on"},"2846":{"id":"/-11","page_id":"/","tags":["overview","start","stack"],"type":"text","url":"/#evo-t1-coder-stack","content":"Where to start depending on what you came to do"},"2847":{"id":"/-12","page_id":"/","tags":["overview","start","stack"],"type":"text","url":"/#evo-t1-coder-stack","content":"How the sidebar tabs divide the subjects"},"2848":{"id":"/-13","page_id":"/","tags":["overview","start","stack"],"type":"text","url":"/#evo-t1-coder-stack","content":"**What this enables**"},"2849":{"id":"/-14","page_id":"/","tags":["overview","start","stack"],"type":"text","url":"/#evo-t1-coder-stack","content":"Getting oriented in one screen before opening a terminal"},"2850":{"id":"/-15","page_id":"/","tags":["overview","start","stack"],"type":"text","url":"/#evo-t1-coder-stack","content":"Reaching the page that owns a subject from one card, instead of reading four that touch it"},"2851":{"id":"/-16","page_id":"/","tags":["overview","start","stack"],"type":"text","url":"/