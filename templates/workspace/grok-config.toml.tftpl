# managed-by: evo-t1-coder-stack
#
# ~/.grok/config.toml for the EVO-T1 Coder workspace.
#
# This file is written by templates/workspace/grok-config.toml.tftpl in the
# evo-t1-coder-stack repo and is refreshed on workspace start ONLY while the
# marker line above is present (or the file is missing). To take permanent
# ownership, delete the first line — the startup script will then leave this
# file alone. To go back to stack-managed, delete the file and start the
# workspace again.
#
# Inference goes through the LiteLLM proxy; the key is never stored here, it
# arrives as the LITELLM_API_KEY environment variable set by coder_agent.env.
#
# Two of the create form's per-workspace knobs reach this file: the default model
# (the "Grok default model" dropdown) fills [models] default below, and anything
# typed into "Grok config extras" is appended verbatim under the comment header at
# the very end of the file. Both are per-workspace, so with the Grok profile set to
# "private" two workspaces can legitimately disagree about either one.

# Grok's native web_search is the DEFAULT search lane, on by default. No
# model transport this box ships serves hosted search (LiteLLM answers
# "tools of type 'web_search' are not supported: this server runs function
# tools only"), so the client-side scrape path is what runs and the agent
# alias digests the result. The gated [mcp_servers.searxng] stdio server
# below is the fallback. To park native search, set this key to true and
# start a new session.
disable_web_search = false

[models]
# `agent` (Spark vLLM) is the alias the agent loop needs: it returns a real
# tool_calls array on this runtime. The Arc (IPEX-LLM Ollama) aliases below
# answer tool calls as plain text with finish_reason "stop", which stops the
# loop after one turn — they stay usable as completion-style fallbacks.
# Each key here names the model that serves that role. The CLI's own default
# for the web_search role is a hosted model, so all three roles below stay on
# the local Spark lane; supports_backend_search = false keeps that search
# client-side (local fetch, then the model summarises the result). Native
# web_search is on by default; the gated [mcp_servers.searxng] server below
# is the fallback lane.
default = "${grok_default_model}"
session_summary = "agent"
image_description = "agent"
web_search = "agent"

# Global streaming-idle deadline for every model that does not pin its own
# value below: the compaction summary, the web_search digest and the image
# description all ride this lane, and on a busy Spark a large compaction
# summary can run far past the CLI's 600 s default. 1200 s matches the
# per-model values below and the proxy's request_timeout, so one 20-minute
# deadline covers the whole client-to-backend chain and long compactions are
# not cut off in the middle.
inference_idle_timeout_secs = 1200

# How this workspace announces itself to the LiteLLM proxy: one key per
# workspace pins every session and subagent call to one healthy Spark box
# (session-affinity, refreshed per request, 1 h idle TTL; an unhealthy or
# expired pin falls back to the least-busy picker). grok sends it verbatim, so
# it must stay static per workspace. Shared profile is one file per USER, so
# the last-booted workspace's key serves all of that user's workspaces (one
# pin for the fleet); private gives each workspace its own. Cline/Roo editor
# traffic carries no header (their settings have no custom-header field) and
# floats; per-model or grok_config_extra extra_headers win per key — keep it.
extra_headers = { "x-litellm-session-id" = "${workspace_affinity_key}" }

# --- DGX Spark (vLLM): tool-calling-capable, used for the agent loop --------
[model."agent"]
model = "agent"
base_url = "${litellm_url}"
name = "Agent (DGX Spark vLLM)"
description = "Primary agent model; emits native tool_calls"
api_backend = "chat_completions"
env_key = "LITELLM_API_KEY"
context_window = 262144
max_completion_tokens = 32768
temperature = 1.0
top_p = 0.95
supports_backend_search = false
supports_reasoning_effort = false
stream_tool_calls = true
max_retries = 1
inference_idle_timeout_secs = 1200

# --- Arc 140T (IPEX-LLM Ollama): completion-style fallbacks -----------------
# Measured against the running stack: these endpoints answer tool requests as
# plain text with finish_reason "stop" and no tool_calls array, so Grok's
# agent loop cannot drive them. Keep them for chat/summarisation and for
# explicit -m selection, not as the default.

[model."coder"]
model = "coder"
base_url = "${litellm_url}"
name = "Qwen2.5-Coder 32B (Arc iGPU)"
description = "Arc fallback; completion-style on this runtime (no tool_calls)"
api_backend = "chat_completions"
env_key = "LITELLM_API_KEY"
context_window = 32768
max_completion_tokens = 4096
temperature = 1.0
top_p = 0.95
supports_backend_search = false
supports_reasoning_effort = false
stream_tool_calls = true
max_retries = 1
inference_idle_timeout_secs = 1200

[model."coder-fast"]
model = "coder-fast"
base_url = "${litellm_url}"
name = "Qwen2.5-Coder 14B (Arc iGPU)"
description = "Arc fallback; completion-style on this runtime (no tool_calls)"
api_backend = "chat_completions"
env_key = "LITELLM_API_KEY"
context_window = 32768
max_completion_tokens = 4096
temperature = 1.0
top_p = 0.95
supports_backend_search = false
supports_reasoning_effort = false
stream_tool_calls = true
max_retries = 1
inference_idle_timeout_secs = 1200

[model."chat"]
model = "chat"
base_url = "${litellm_url}"
name = "Qwen2.5 7B (Arc iGPU)"
description = "Arc chat fallback; returns real tool_calls on this runtime (measured)"
api_backend = "chat_completions"
env_key = "LITELLM_API_KEY"
context_window = 32768
max_completion_tokens = 2048
temperature = 1.0
top_p = 0.95
supports_backend_search = false
supports_reasoning_effort = false
stream_tool_calls = true
max_retries = 1
inference_idle_timeout_secs = 1200

[features]
telemetry = false
# Offline-first box: the tool stays available for the rare reachable docs site.
web_fetch = true

[toolset.web_fetch]
# SSRF fail-closed: loopback only when explicitly enabled, private ranges and
# cloud metadata stay blocked.
allow_local = false

[session]
auto_compact_threshold_percent = 75

# Three Spark boxes behind one model lane, and LiteLLM's "least-busy" routing
# spreads the fan-out across them, so keep the fan-out modest and let
# limit_behavior "queue" hold the overflow instead of failing the spawn.
[subagents]
enabled = true
max_concurrent = 4
max_depth = 1
limit_behavior = "queue"

[subagents.models]
explore = "agent"
plan = "agent"

# MCP servers: the default render declares exactly one, the gated searxng
# server below. This file used to seed five offline stdio servers here
# (filesystem, memory, sequential-thinking, git and time) plus the gated
# github HTTP entry. Every session trace collected
# on this machine called none of their tools, and a declared-but-unused
# server still spends each session's start on its handshake and keeps its
# tool schemas in every context, so the default config names none of them.
# They stay installed in the golden image, so switching one back on is a
# one-block edit here (or in the create form's config-extras field); check a
# stubborn one with `grok mcp doctor <name>`.
#
# Deliberately absent for other reasons, because they need outbound network or
# a credential this workspace does not carry: sentry (OAuth to mcp.sentry.dev),
# postgres (needs a live DSN), fetch (PySocks/egress proxy). Context7 is no
# longer in that list: it is now an optional cached local process, rendered only
# when context7_mcp is on, and it still needs CONTEXT7_API_KEY in the agent
# environment plus outbound network on the first fetch (later identical lookups
# inside the TTL come from the local SQLite cache instead). So the three gated
# entries this file can switch on are: search_mcp defaults to true, so searxng
# renders as the fallback search lane unless a push passes search_mcp=false;
# github_mcp defaults to false; context7_mcp defaults to false.
#
# What is left out is simply not defined here, so there is nothing to disable;
# if you add one later and want it parked rather than deleted, list its name
# in `disabled_mcp_servers = ["..."]` (top-level key, string array).

%{if github_mcp~}
# Rendered only when github_mcp is on; with it off this whole block is absent
# from the file. There is no token to gate it on any more: the credential comes
# from the Coder External Auth provider (id github by default), so a session whose owner
# connected no GitHub account has no GH_TOKEN in its environment and simply fails
# this server's handshake (and so does one whose token expired while the
# workspace slept, until coder_script.gh_token_refresh mints the next one). The
# token itself stays in the environment — this file only ever names it.
[mcp_servers.github]
url = "https://api.githubcopilot.com/mcp/"
enabled = true
headers = { Authorization = "Bearer $${GH_TOKEN}" }

%{endif~}
%{if context7_mcp~}
# Cached Context7 MCP: official @upstash/context7-mcp wrapped by mcp-cache-proxy
# for local SQLite caching of resolve-library-id / query-docs results.
# Rendered only when context7_mcp is on; with it off this whole block is absent.
# Requires CONTEXT7_API_KEY in the agent environment and outbound network on
# first fetch; later identical lookups within the TTL are served from the
# local SQLite cache under ~/.grok/mcp-cache-proxy/. The file only ever names
# the key; the CLI expands $${CONTEXT7_API_KEY} from the environment.
# Binaries are baked into the golden image; launching by absolute path keeps
# the first boot off the npm registry (npx would re-download).
[mcp_servers.context7]
command = "/opt/npm-global/bin/mcp-cache-proxy"
args = ["--config", "/home/coder/.grok/mcp-cache-proxy/config.json"]
enabled = true
startup_timeout_sec = 120
env = { CONTEXT7_API_KEY = "$${CONTEXT7_API_KEY}" }

%{endif~}

%{if search_mcp~}
# Rendered only when search_mcp is on, and that template variable defaults to
# true, so this block ships unless a push passes --var search_mcp=false (or sets
# SEARCH_MCP=false in .env, which push-template.sh relays). It wires the
# self-hosted SearXNG service as a stdio MCP server: this box's fallback
# search lane.
#
# The binary is baked into the golden image (images/dev/Dockerfile installs
# searxng-mcp-server at the version pinned in images/dev/tool-versions.env,
# currently 0.5.1). Launching it by absolute path keeps the first boot offline:
# npx would look for the package in its cache or on the npm registry, and the
# image build clears that cache, so an `npx -y` launch means a fresh registry
# download on every new workspace before search works at all.
[mcp_servers.searxng]
command = "/opt/npm-global/bin/searxng-mcp-server"

# The one key this server reads. Its compiled-in default (http://localhost:8888)
# names nothing on this box, so the URL is always rendered: 8181 is the host
# port both compose stacks publish (docker-compose.yml maps STACK_SEARCH_PORT,
# default 8181, to the container's 8181), and push-template.sh derives this
# value from STACK_SEARCH_PORT, so a dev stack that remapped the port pushes a
# config that dials the port it actually has.
#
# Prove the route with `bazelisk run //scripts:search-check` (it reads the same
# SEARXNG_URL, which main.tf also puts in coder_agent's env) and the server's
# handshake
# with `grok mcp doctor searxng`. Native search is already on; this server is
# the fallback. Park it with search_mcp off, or park native search with
# disable_web_search = true at the top of this file (then start a new session).
env = { SEARXNG_URL = "${search_url}" }

%{endif~}

[mcp]
max_output_bytes = 40000

# Conservative defaults on purpose: no always-approve / yolo here — that is a
# per-user decision (`/settings`, or [ui] permission_mode). These denies only
# keep secrets and destructive rm out of the easy path.
[permission]
deny = [
  "Bash(rm -rf *)",
  "Read(**/.env)",
  "Read(**/.env.*)",
  "Edit(**/.env)",
  "Edit(**/.env.*)",
]
%{if grok_config_extra != ""~}

# --- per-workspace additions (create form: Grok config extras) ---
${grok_config_extra}
%{endif~}
