# managed-by: evo-t1-coder-stack
#
# ~/.grok/config.toml for the EVO-T1 Coder workspace.
#
# This file is written by templates/workspace/grok-config.toml.tftpl in the
# evo-t1-coder-stack repo and is refreshed on workspace start ONLY while the
# marker comment above or the __evoT1Stack key below is present (or the file
# is missing). To take permanent ownership, delete BOTH of them: the
# managed-by marker on the first line and the __evoT1Stack key further down.
# The key is there because the CLI's own settings writer (for example
# `grok mcp add`) deletes every comment line, so the marker comment can vanish
# on its own while the key survives. To go back to stack-managed, delete the
# file and start the workspace again.
#
# Inference goes through the LiteLLM proxy; the key is never stored here, it
# arrives as the LITELLM_API_KEY environment variable set by coder_agent.env.
#
# Three of the create form's per-workspace knobs reach this file: the default
# model (the "Grok default model" dropdown) fills [models] default below, the
# "Grok theme" field fills [ui] theme below, and anything typed into "Grok
# config extras" is appended verbatim under the comment header at the very end
# of the file. All three are per-workspace, so with the Grok profile set to
# "private" two workspaces can legitimately disagree about any of them.

# Ownership marker: the stack owns this file while either this key or the
# managed-by comment above is present. Unlike that comment, this top-level key
# survives the CLI rewriting the file, so ownership cannot be revoked
# silently. Delete it together with the marker comment to hand the file over.
# Never put it inside a template gate.
__evoT1Stack = true

# Grok's native web_search is PARKED, and the gated [mcp_servers.searxng] stdio
# server below is the search lane. Measured 2026-10-25: no model transport this
# box ships can serve the native tool. The Spark lane refuses the request
# before anything is fetched, and LiteLLM answers "tools of type 'web_search'
# are not supported: this server runs function tools only".
# supports_backend_search = false cannot route around it, because the
# client-side path still hands the model alias a web_search-typed tool, which
# is the exact shape the endpoint rejects. "# Research lanes" in
# ~/.grok/AGENTS.md sends the agent to the searxng tools by default. Set this
# key to false and start a new session only once the agent has an endpoint that
# really serves the tool.
disable_web_search = true

# The create form's "Grok theme" for this workspace. Any value but "auto" is a
# fixed theme; "auto" follows the terminal's dark/light appearance, and the CLI
# honours the per-appearance pair only alongside it, so both sides are named
# here (the pair the CLI itself maps to). These are the only [ui] keys the
# template writes; the rest of [ui] is the operator's, and the startup render
# carries it over.
[ui]
theme = "${grok_theme}"
%{if grok_theme == "auto"~}
auto_dark_theme = "groknight"
auto_light_theme = "grokday"

%{else~}

%{endif~}
[models]
# `agent` (Spark vLLM) is the alias the agent loop needs: it returns a real
# tool_calls array on this runtime. The Arc (IPEX-LLM Ollama) aliases below
# answer tool calls as plain text with finish_reason "stop", which stops the
# loop after one turn — they stay usable as completion-style fallbacks.
# Each key here names the model that serves that role. The CLI's own default
# for the web_search role is a hosted model, so all three roles below stay on
# the local Spark lane, and supports_backend_search = false on every lane keeps
# the proxy from ever being asked for a hosted search tool. The web_search role
# stays filled so that re-enabling native search is a one-key flip at the top of
# this file; while disable_web_search = true nothing dials it, and the gated
# [mcp_servers.searxng] server below answers instead.
default = "${grok_default_model}"
session_summary = "agent"
image_description = "agent"
web_search = "agent"

# Thinking level a new session starts on. The Spark lane (Qwen3.8-Flash-Next)
# answers low / medium / xhigh — there is no `high` on this runtime, which is
# why the [model."agent"] block below advertises exactly those three. A request
# can still pick another level; the agent-low / agent-medium / agent-xhigh
# aliases below pin one in LiteLLM instead, for callers that cannot send one.
default_reasoning_effort = "xhigh"

# Global streaming-idle deadline for every model that does not pin its own
# value below. The per-model copies below carry the same 1800 s, so one
# 30-minute client deadline covers the turns this key really governs: the main
# agent loop, the web_search digest and the image description. It deliberately
# sits ABOVE the proxy's request_timeout (1200 s in litellm/config.yaml), which
# stays the tightest bound on the chain: a stream that produces nothing ends at
# the proxy. What this key has to do is stop the client abandoning a
# slow-but-flowing stream the proxy still allows, and clearing 1200 s is what
# buys that. No proxy deadline moved with it.
#
# What it does NOT govern is the compaction summary, whatever this comment used
# to claim. Measured on 1.0.70 against an upstream held open without sending a
# byte: the client waited past 3000 s and the CLI reported
# inferenceIdleTimeouts = 0 in every session whose compaction hung, so neither
# this key nor the per-model copies below reach that call. The compaction
# summary inherits the session lane's max_completion_tokens (measured on the
# wire at max_tokens=32768) and its only live bound is the proxy's
# request_timeout, which is why litellm/config.yaml declares one attempt for a
# stream that died before its first chunk. The compaction wall-clock budget that
# does exist is a separate 300 s default, is set from the environment by
# GROK_COMPACTION_WALL_CLOCK_SECS (rendered by main.tf, not here, since no TOML
# table accepts it), and is evaluated only once the response returns.
inference_idle_timeout_secs = 1800

# How this workspace announces itself to the LiteLLM proxy: one key per
# workspace pins every session and subagent call to one healthy Spark box
# (session-affinity, refreshed per request, 1 h idle TTL; an unhealthy or
# expired pin falls back to the least-busy picker). grok sends it verbatim, so
# it must stay static per workspace. Shared profile is one file per USER, so
# the last-booted workspace's key serves all of that user's workspaces (one
# pin for the fleet); private gives each workspace its own. Cline/Roo editor
# traffic carries no header (their settings have no custom-header field) and
# floats; per-model or grok_config_extra extra_headers win per key — keep it.
extra_headers = { "x-litellm-session-id" = "${workspace_affinity_key}" }

# --- DGX Spark (vLLM): tool-calling-capable, used for the agent loop --------
[model."agent"]
model = "agent"
base_url = "${litellm_url}"
name = "Agent (DGX Spark vLLM)"
description = "Primary agent model; emits native tool_calls"
api_backend = "chat_completions"
env_key = "LITELLM_API_KEY"
context_window = 262144
max_completion_tokens = 32768
temperature = 1.0
top_p = 0.95
supports_backend_search = false
stream_tool_calls = true
max_retries = 1
inference_idle_timeout_secs = 1800

# The three levels this runtime actually answers. `high` is deliberately
# absent: Qwen3.8-Flash-Next does not support it, and advertising it puts a
# level in the picker that the Spark lane fails or silently downgrades.
[[model."agent".reasoning_efforts]]
id = "low"
value = "low"
label = "Low"
description = "Fastest responses. Best for simple tasks."
default = false

[[model."agent".reasoning_efforts]]
id = "medium"
value = "medium"
label = "Medium"
description = "Strong quality with a faster turnaround."
default = false

[[model."agent".reasoning_efforts]]
id = "xhigh"
value = "xhigh"
label = "Extra High"
description = "Maximum reasoning for the hardest tasks."
default = true

# Same Spark lane with the thinking level baked into the LiteLLM alias instead
# of carried per request: for callers that have no reasoning-effort field at
# all (the editor extensions, a curl in a script). Everything else — tool
# calling, timeouts, the session-affinity header inherited from [models] —
# matches [model."agent"] above. supports_reasoning_effort stays false here on
# purpose: the proxy decides the level, so the client has nothing to override.
[model."agent-low"]
model = "agent-low"
base_url = "${litellm_url}"
name = "Agent (DGX Spark vLLM, thinking low)"
description = "Spark agent lane; thinking baked to low in LiteLLM"
api_backend = "chat_completions"
env_key = "LITELLM_API_KEY"
context_window = 262144
max_completion_tokens = 32768
temperature = 1.0
top_p = 0.95
supports_backend_search = false
supports_reasoning_effort = false
stream_tool_calls = true
max_retries = 1
inference_idle_timeout_secs = 1800

[model."agent-medium"]
model = "agent-medium"
base_url = "${litellm_url}"
name = "Agent (DGX Spark vLLM, thinking medium)"
description = "Spark agent lane; thinking baked to medium in LiteLLM"
api_backend = "chat_completions"
env_key = "LITELLM_API_KEY"
context_window = 262144
max_completion_tokens = 32768
temperature = 1.0
top_p = 0.95
supports_backend_search = false
supports_reasoning_effort = false
stream_tool_calls = true
max_retries = 1
inference_idle_timeout_secs = 1800

[model."agent-xhigh"]
model = "agent-xhigh"
base_url = "${litellm_url}"
name = "Agent (DGX Spark vLLM, thinking extra high)"
description = "Spark agent lane; thinking baked to xhigh in LiteLLM"
api_backend = "chat_completions"
env_key = "LITELLM_API_KEY"
context_window = 262144
max_completion_tokens = 32768
temperature = 1.0
top_p = 0.95
supports_backend_search = false
supports_reasoning_effort = false
stream_tool_calls = true
max_retries = 1
inference_idle_timeout_secs = 1800

# The fan-out lane: the same three Spark boxes, the same baked xhigh, the same tool
# calling as [model."agent"], and the one group the LiteLLM session pin does not
# cover -- litellm/config.yaml gives it an empty flag list in
# router_settings.model_group_affinity_config, so least-busy places each request on
# whichever reachable box has the fewest in flight. This workspace's parent loop and
# all its subagents share one x-litellm-session-id, which on a pinned lane puts the
# whole fan-out on one box and that box's PARALLEL streams; here they spread over
# every box. The price is stickiness, so a single long thread belongs on `agent` and
# this lane is for independent parallel work. Never lift the pin with
# extra_headers -- a blank x-litellm-session-id is not an opt-out at the pinned tag,
# it would give every swarm request the same pin. Prose: docs/litellm-routing.md.
[model."agent-swarm"]
model = "agent-swarm"
base_url = "${litellm_url}"
name = "Agent swarm (all DGX Sparks)"
description = "Spark agent lane; every request placed on the least-busy Spark"
api_backend = "chat_completions"
env_key = "LITELLM_API_KEY"
context_window = 262144
max_completion_tokens = 32768
temperature = 1.0
top_p = 0.95
supports_backend_search = false
supports_reasoning_effort = false
stream_tool_calls = true
max_retries = 1
inference_idle_timeout_secs = 1800

# The read/search lane: the same three Spark boxes, thinking baked to low, and the second
# group the LiteLLM session pin does not cover - a one-shot mapper shares no warm prefix for
# the pin to protect, so with its affinity list emptied in litellm/config.yaml least-busy
# places each probe. Same rule as [model."agent-swarm"]: never lift the pin from here with
# extra_headers.
[model."agent-explore"]
model = "agent-explore"
base_url = "${litellm_url}"
name = "Agent explore (all DGX Sparks, thinking low)"
description = "Spark read/search lane; thinking baked to low, placed on the least-busy Spark"
api_backend = "chat_completions"
env_key = "LITELLM_API_KEY"
context_window = 262144
max_completion_tokens = 32768
temperature = 1.0
top_p = 0.95
supports_backend_search = false
supports_reasoning_effort = false
stream_tool_calls = true
max_retries = 1
inference_idle_timeout_secs = 1800

# The skeptical lane: the same three boxes, thinking baked to xhigh, pin lifted for the same
# one-shot reason as agent-explore. A reviewer has to think harder than the child it checks,
# so this alias sets how deep the mandatory review phase goes; reasoning_effort in the proxy
# config is the seam that retunes it.
[model."agent-review"]
model = "agent-review"
base_url = "${litellm_url}"
name = "Agent review (all DGX Sparks, thinking extra high)"
description = "Spark skeptic lane; thinking baked to xhigh, placed on the least-busy Spark"
api_backend = "chat_completions"
env_key = "LITELLM_API_KEY"
context_window = 262144
max_completion_tokens = 32768
temperature = 1.0
top_p = 0.95
supports_backend_search = false
supports_reasoning_effort = false
stream_tool_calls = true
max_retries = 1
inference_idle_timeout_secs = 1800

# The fast-compaction pair: [model."agent-xhigh"] and [model."agent-swarm"] again, same
# pin and same spread, for the one call the CLI cannot route itself. Grok Build has no
# compaction-model key, so litellm/config.yaml moves the conversation-summary call of
# these two aliases onto the Arc's fast Ollama group and leaves every other call on the
# Spark lane. Nothing here names the summary model.
[model."agent-xhigh-fast"]
model = "agent-xhigh-fast"
base_url = "${litellm_url}"
name = "Agent (DGX Spark vLLM, thinking extra high, fast compaction)"
description = "Spark agent lane; thinking baked to xhigh, summary call served by the fast Arc lane"
api_backend = "chat_completions"
env_key = "LITELLM_API_KEY"
context_window = 262144
max_completion_tokens = 32768
temperature = 1.0
top_p = 0.95
supports_backend_search = false
supports_reasoning_effort = false
stream_tool_calls = true
max_retries = 1
inference_idle_timeout_secs = 1800

[model."agent-swarm-fast"]
model = "agent-swarm-fast"
base_url = "${litellm_url}"
name = "Agent swarm (all DGX Sparks, fast compaction)"
description = "Spark agent lane; every request on the least-busy Spark, summary call on the fast Arc lane"
api_backend = "chat_completions"
env_key = "LITELLM_API_KEY"
context_window = 262144
max_completion_tokens = 32768
temperature = 1.0
top_p = 0.95
supports_backend_search = false
supports_reasoning_effort = false
stream_tool_calls = true
max_retries = 1
inference_idle_timeout_secs = 1800

# --- Arc 140T (IPEX-LLM Ollama): completion-style fallbacks -----------------
# Measured against the running stack: these endpoints answer tool requests as
# plain text with finish_reason "stop" and no tool_calls array, so Grok's
# agent loop cannot drive them. Keep them for chat/summarisation and for
# explicit -m selection, not as the default.

[model."coder"]
model = "coder"
base_url = "${litellm_url}"
name = "Qwen2.5-Coder 32B (Arc iGPU)"
description = "Arc fallback; completion-style on this runtime (no tool_calls)"
api_backend = "chat_completions"
env_key = "LITELLM_API_KEY"
context_window = 32768
max_completion_tokens = 4096
temperature = 1.0
top_p = 0.95
supports_backend_search = false
supports_reasoning_effort = false
stream_tool_calls = true
max_retries = 1
inference_idle_timeout_secs = 1800

[model."coder-fast"]
model = "coder-fast"
base_url = "${litellm_url}"
name = "Qwen2.5-Coder 14B (Arc iGPU)"
description = "Arc fallback; completion-style on this runtime (no tool_calls)"
api_backend = "chat_completions"
env_key = "LITELLM_API_KEY"
context_window = 32768
max_completion_tokens = 4096
temperature = 1.0
top_p = 0.95
supports_backend_search = false
supports_reasoning_effort = false
stream_tool_calls = true
max_retries = 1
inference_idle_timeout_secs = 1800

[model."chat"]
model = "chat"
base_url = "${litellm_url}"
name = "Qwen2.5 7B (Arc iGPU)"
description = "Arc chat fallback; returns real tool_calls on this runtime (measured)"
api_backend = "chat_completions"
env_key = "LITELLM_API_KEY"
context_window = 32768
max_completion_tokens = 2048
temperature = 1.0
top_p = 0.95
supports_backend_search = false
supports_reasoning_effort = false
stream_tool_calls = true
max_retries = 1
inference_idle_timeout_secs = 1800

[features]
telemetry = false
# Offline-first box: the tool stays available for the rare reachable docs site.
web_fetch = true
# Lets the parent steer a live child instead of killing and respawning it.
active_agent_messages = true

[toolset.web_fetch]
# SSRF fail-closed: loopback only when explicitly enabled, private ranges and
# cloud metadata stay blocked.
allow_local = false

[session]
# Auto-compaction fires at this percentage of the CLI's 262144-token window, so
# at 70 it starts near 183,500 tokens. This is a load lever, not a correctness
# one: the summary is a full generation whose cost grows with the history it
# reads, so firing earlier buys a smaller summary. Measured history and the
# caveat that no size threshold separated the failures from the successes are in
# the compaction section of docs/troubleshooting.md.
auto_compact_threshold_percent = 70

# Which lane a fan-out rides and how wide it goes, both from --var so one workspace
# can target the whole fleet: the writers default to the unpinned `agent-swarm` lane,
# and an explicit `--var grok_subagent_max_concurrent=N` still overrides the width.
# That width is the variable's own shipped 15, the fleet's stream count (3 boxes x
# PARALLEL 5 = 15, scripts/spark-configure.sh), on every lane rather than 15-swarm /
# 4-pinned. The reason is a choice the user gets to make at the spawn: the
# `agent-swarm` block below is ungated, so a session whose default lane is pinned can
# still name the swarm lane on any subagent, and a config sized at one box's PARALLEL
# would cap a swarm that was one argument away. An operator who pins every lane to
# one box and wants the narrower queue sets the number explicitly; a number past 15
# deepens LiteLLM's queue rather than buying capacity, because the fleet has no more
# streams to give. limit_behavior "queue" below holds
# overflow instead of failing the spawn, and sampling_limit is deliberately unset
# because it defaults to max_concurrent, which keeps the two caps from drifting.
# Depth rides the same 15: a depth-2 child holds a stream too, so a parent counts
# `1 + spawns` per task in flight; 1 keeps nesting off.
# The fleet's own ceiling is echoed inside the table rather than folded into the number:
# grok_swarm_width renders that line and is the width only under a deliberate null, so
# an explicit --var still owns max_concurrent and a stale width stays legible in here.
# //scripts:subagent-check and the boot advisory compare the two numbers.
[subagents]
enabled = true
# fleet-width: ${grok_subagent_fleet_width}
max_concurrent = ${grok_subagent_max_concurrent}
max_depth = ${grok_subagent_max_depth}
limit_behavior = "queue"

# Pin every built-in subagent type to the fan-out lane. The three are general-purpose
# (the type a spawn gets when it names none, and the one every writer in a fan-out
# runs as), explore, and plan. Naming only the two read-only types is the mistake this
# block exists to prevent: the writers then inherit the parent's model, which on a
# pinned Spark lane means the whole write fan-out queues behind one box's streams
# while the swarm-named readers spread over three.
#
# The pins then split by what the type does, each from its own --var so any one rolls back
# alone: general-purpose stays on the fan-out lane (it is the writer); explore goes to
# agent-explore, low effort and no pin, the traffic that gains most from spreading; plan
# stays pinned, because one planner is a conversation that steers every wave after it. The
# named keys are the project definitions under .grok/agents/ that coder_script.stack_fleet
# seeds; a key no session selects is inert, and naming them pins the skeptics on
# agent-review, the one seam that sets how hard the review phase thinks.
[subagents.models]
general-purpose = "${grok_subagents_lane}"
explore = "${grok_explore_lane}"
plan = "${grok_plan_lane}"
explorer = "${grok_explore_lane}"
architect = "${grok_plan_lane}"
implementer = "${grok_subagents_lane}"
documenter = "${grok_subagents_lane}"
tester = "${grok_subagents_lane}"
reviewer = "${grok_review_lane}"
security-auditor = "${grok_review_lane}"

# MCP servers: three gated entries ship by default, each behind its own boolean
# that defaults to true. search_mcp renders the searxng stdio server, which is
# THE search lane (native web_search is parked at the top of this file);
# context7_mcp renders the cached context7 stdio server, which answers library
# and API questions; github_mcp renders the hosted GitHub HTTP server. An agent
# that needs the web or a docs page reaches these, and the "# Research lanes"
# section of ~/.grok/AGENTS.md sends it there by default.
#
# Five more offline stdio servers (filesystem, memory, sequential-thinking, git
# and time) stay installed in the golden image and stay undeclared here on
# purpose: every session trace collected on this machine called none of their
# tools, while a declared-but-unused server still spends each session's start on
# its handshake and keeps its tool schemas in every context. Declaring one is a
# one-block edit here (or in the create form's config-extras field); check a
# stubborn one with `grok mcp doctor <name>`.
#
# sentry, postgres and fetch are absent for a different reason: each needs
# outbound network or a credential this workspace does not carry (OAuth to
# mcp.sentry.dev, a live DSN, a PySocks/egress proxy).
#
# Each gate ships unless a push passes --var <name>=false. Park one by setting
# its .env key (SEARCH_MCP, CONTEXT7_MCP, GITHUB_MCP) to false and re-pushing:
# push-template.sh relays it to both template pushes. context7 is the lane with
# the outside dependency: it wants outbound network on the first fetch (its
# CONTEXT7_API_KEY is optional and only buys higher rate limits and access to
# private libraries), and later identical lookups inside the TTL come from its
# local SQLite cache instead.
#
# What is left out is simply not defined here, so there is nothing to disable;
# if you add one later and want it parked rather than deleted, list its name
# in `disabled_mcp_servers = ["..."]` (top-level key, string array).

%{if github_mcp~}
# Rendered only when github_mcp is on, and that template variable defaults to
# true, so this block ships unless a push passes --var github_mcp=false (or sets
# GITHUB_MCP=false in .env, which push-template.sh relays); with it off this
# whole block is absent from the file. There is no token to gate it on any more:
# the credential comes from the Coder External Auth provider (id github by
# default), so a session whose owner connected no GitHub account has no GH_TOKEN
# in its environment and simply fails this server's handshake (and so does one
# whose token expired while the workspace slept, until
# coder_script.gh_token_refresh mints the next one). The token itself stays in
# the environment — this file only ever names it.
[mcp_servers.github]
url = "https://api.githubcopilot.com/mcp/"
enabled = true
headers = { Authorization = "Bearer $${GH_TOKEN}" }

%{endif~}
%{if context7_mcp~}
# Cached Context7 MCP: official @upstash/context7-mcp wrapped by mcp-cache-proxy
# for local SQLite caching of resolve-library-id / query-docs results.
# Rendered only when context7_mcp is on, and that template variable defaults to
# true, so this block ships unless a push passes --var context7_mcp=false (or
# sets CONTEXT7_MCP=false in .env, which push-template.sh relays). The key is
# optional: it only decorates the outbound calls to the Context7 API, so with
# an empty CONTEXT7_API_KEY the block still renders, the server still
# handshakes, and the lane still answers at the public rate limits - private
# libraries are the only thing out of reach. Outbound network is needed on
# first fetch; later identical lookups within the TTL are served from the
# local SQLite cache under ~/.grok/mcp-cache-proxy/. The file only ever names
# the key; the CLI expands $${CONTEXT7_API_KEY} from the environment.
# Binaries are baked into the golden image; launching by absolute path keeps
# the first boot off the npm registry (npx would re-download).
[mcp_servers.context7]
command = "/opt/npm-global/bin/mcp-cache-proxy"
args = ["--config", "/home/coder/.grok/mcp-cache-proxy/config.json"]
enabled = true
startup_timeout_sec = 120
env = { CONTEXT7_API_KEY = "$${CONTEXT7_API_KEY}" }

%{endif~}

%{if search_mcp~}
# Rendered only when search_mcp is on, and that template variable defaults to
# true, so this block ships unless a push passes --var search_mcp=false (or sets
# SEARCH_MCP=false in .env, which push-template.sh relays). It wires the
# self-hosted SearXNG service as a stdio MCP server: this box's search lane, and
# the only one an agent gets by default.
#
# The binary is baked into the golden image (images/dev/Dockerfile installs
# searxng-mcp-server at the version pinned in images/dev/tool-versions.env,
# currently 0.5.1). Launching it by absolute path keeps the first boot offline:
# npx would look for the package in its cache or on the npm registry, and the
# image build clears that cache, so an `npx -y` launch means a fresh registry
# download on every new workspace before search works at all.
[mcp_servers.searxng]
command = "/opt/npm-global/bin/searxng-mcp-server"
enabled = true

# This server takes its whole tuning surface from the environment, and the stack
# sets all of it here rather than leaning on compiled-in defaults: two of these
# keys ship in a state that is wrong for this box, one of them
# (SEARXNG_CACHE_TTL_MS, default 0) leaving the search lane with no cache at all.
# Proof for each number is in the note above it, measured against this lane.
#
# Prove the route with `bazelisk run //scripts:search-check` (it reads the same
# SEARXNG_URL, which main.tf also puts in coder_agent's env) and the handshake
# with `grok mcp doctor searxng`. This is the search lane: native web_search is
# parked at the top of this file, so an agent that needs the web reaches these
# tools. Park this lane too with search_mcp off, and a session is left with no
# search tool at all.

[mcp_servers.searxng.env]
# The address. The compiled-in default (http://localhost:8888) names nothing on
# this box, so the URL is always rendered: 8181 is the host port both compose
# stacks publish (docker-compose.yml maps STACK_SEARCH_PORT, default 8181, to
# the container's 8181), and push-template.sh derives this value from
# STACK_SEARCH_PORT, so a dev stack that remapped the port pushes a config that
# dials the port it actually has.
SEARXNG_URL = "${search_url}"
# This client's budget for one SearXNG request; 10s compiled in. The instance
# answers on the slowest engine it has not parked, bounded by
# outgoing.max_request_timeout (10s) in searxng/settings.yml, so a 10s client
# budget can hang up while the instance is still legitimately working and hand
# the agent a timeout it cannot act on. 20s sits above that chain and equals the
# --timeout default of scripts/search-check.sh, so the probe and the lane give
# an engine the same patience.
SEARXNG_TIMEOUT_MS = "20000"
# Turns on the server's in-process response cache, which ships off (0). With it
# off, every repeat of an identical query - the same lookup issued twice in a
# session, or by two subagents on one question - re-dials the upstream engines,
# and re-dialling a backend that already refused this instance is how a "too
# many requests" suspension is earned. The cache is a bounded LRU of 128 entries
# keyed on method plus normalized URL, so this costs a fixed ceiling of memory
# and cannot grow with the session. Fifteen minutes is short enough for a
# news-shaped answer.
SEARXNG_CACHE_TTL_MS = "900000"
# A ceiling on the max_results argument, not a default: a larger request is
# clamped to it with one warning on stderr. The server's own default of ten
# stays the normal answer, so this only bounds the worst case, keeping one
# search inside the GROK_MAX_MCP_OUTPUT_BYTES = 40000 cap that rides the agent
# environment. Measured on this lane, ten formatted results is about 4.6 KB,
# so twenty-five lands well inside the cap.
SEARXNG_MAX_RESULTS = "25"
# Mirrors search.safe_search in searxng/settings.yml (0 = off) so the lane and
# the instance agree without the agent passing the argument, and one file cannot
# quietly loosen the other.
SEARXNG_DEFAULT_SAFESEARCH = "0"
# Pins the instance default of `all`, which means no geo-bias. Left unset the
# value comes from the image, so an image bump could silently start
# geo-filtering every agent search; a per-call `language` argument still wins.
SEARXNG_DEFAULT_LANGUAGE = "all"

%{endif~}

# No [mcp] table here: the pinned CLI reports the documented
# [mcp] max_output_bytes key as an unrecognized config key and applies
# nothing, so a table at this spot would only warn on every session. The MCP
# tool-result cap rides GROK_MAX_MCP_OUTPUT_BYTES = 40000 in the agent
# environment instead (the coder_agent env in main.tf), the route this CLI
# honours today; the documented default it replaces is 20000 bytes.

# Conservative defaults on purpose: no always-approve / yolo here — that is a
# per-user decision (`/settings`, or [ui] permission_mode). These denies only
# keep secrets and destructive rm out of the easy path. The startup render
# carries the CLI-owned tables ([cli], [marketplace]) over from the file it
# replaces, and the operator's other [ui] keys with it, so an approval mode set
# in [ui] survives a re-render while the theme keys above stay the template's.
#
# The dotenv family is split by what the file holds. The live `.env` and the
# suffixed shapes that carry real values are denied for Read and Edit; the
# secret-free templates a repo ships are named in `allow`, so an agent keeps the
# env key list -- the file that keeps .env honest -- in step with the code
# without a prompt in any permission mode. Neither list is the blanket
# `**/.env.*`: a deny rule cannot be overridden by an allow rule, so the blanket
# form blocked `.env.example` and `.env.sample` along with the live files and
# left the key list to drift. `Edit` is the name that covers the Write tool too.
# Add a suffixed shape to `deny` when your projects put secrets in it; a name in
# neither list stays readable and editable, so prefer the plain `.env` for
# anything secret and keep every populated variant out of git (.gitignore
# ignores the family and un-ignores only the names allowed below).
[permission]
deny = [
  "Bash(rm -rf *)",
  "Read(**/.env)",
  "Edit(**/.env)",
  "Read(**/.env.local)",
  "Edit(**/.env.local)",
  "Read(**/.env.*.local)",
  "Edit(**/.env.*.local)",
  "Read(**/.env.production)",
  "Edit(**/.env.production)",
  "Read(**/.env.prod)",
  "Edit(**/.env.prod)",
  "Read(**/.env.staging)",
  "Edit(**/.env.staging)",
  "Read(**/.env.stage)",
  "Edit(**/.env.stage)",
  "Read(**/.env.development)",
  "Edit(**/.env.development)",
  "Read(**/.env.dev)",
  "Edit(**/.env.dev)",
  "Read(**/.env.test)",
  "Edit(**/.env.test)",
  "Read(**/.env.testing)",
  "Edit(**/.env.testing)",
  "Read(**/.env.ci)",
  "Edit(**/.env.ci)",
  "Read(**/.env.override)",
  "Edit(**/.env.override)",
  # The two ways a commit could reach the branch with no gate having seen it:
  # past the hermetic pre-commit hook, and past .gitignore, which is what keeps a
  # populated dotenv variant out of a commit. A human at a shell keeps both
  # escapes; the agent does not. Matching is on the leading spelling, so this
  # narrows that door rather than sealing it, and "Stage by path" in the seed
  # text is the rest of the defence.
  "Bash(git commit --no-verify *)",
  "Bash(git commit -n *)",
  "Bash(git add -f *)",
  "Bash(git add --force *)",
  # Self-teardown: the Bash tool runs inside the agent's own tmux session, so a sweep
  # of "stray" sessions or processes ends the agent's run with them. An agent stops one
  # process it started with kill_command_or_subagent; the rest is in the docs.
  "Bash(*kill-server*)",
  "Bash(*kill-session*)",
  "Bash(*kill-window*)",
  "Bash(*kill-pane*)",
  "Bash(*restart-server*)",
  "Bash(*pkill*tmux*)",
  "Bash(*killall*tmux*)",
  "Bash(*pkill*code-server*)",
  "Bash(*killall*code-server*)",
  "Bash(*pkill*node*)",
  "Bash(*killall*node*)",
  "Bash(*pkill*grok*)",
  "Bash(*killall*grok*)",
  "Bash(*pkill*bash*)",
  "Bash(*killall*bash*)",
  "Bash(*pkill -u *)",
  "Bash(*pkill -U *)",
  "Bash(*pkill -P *)",
  "Bash(*kill 0*)",
  "Bash(*kill -- -*)",
  "Bash(*kill -1 -1*)",
  "Bash(*kill -9 -1*)",
]
allow = [
  "Read(**/.env.example)",
  "Edit(**/.env.example)",
  "Read(**/.env.sample)",
  "Edit(**/.env.sample)",
  "Read(**/.env.template)",
  "Edit(**/.env.template)",
  "Read(**/.env.dist)",
  "Edit(**/.env.dist)",
  "Read(**/.env.defaults)",
  "Edit(**/.env.defaults)",
  "Read(**/.env.*.example)",
  "Edit(**/.env.*.example)",
  "Read(**/.env.*.sample)",
  "Edit(**/.env.*.sample)",
  # The two read-only research lanes, pre-allowed. A declared MCP server still
  # needs a grant per tool call, and an unattended run (`grok -p`, which is how
  # the delegation skill launches its children) has nobody to ask, so without
  # these the agent gets "headless run cannot ask for approval" and loses the
  # web and the docs lanes outright. Search and fetch dial this stack's own
  # SearXNG and context7 reads the public Context7 docs API, so neither can
  # mutate anything. The github server stays out on purpose: its tools write
  # with the owner's minted token, so those keep prompting. A lane parked by its
  # gate leaves its rule matching nothing, which is harmless.
  "MCPTool(searxng__*)",
  "MCPTool(context7__*)",
  # The verbs the branch-first, commit-per-unit policy needs. A grant is still
  # a grant, and an unattended run (`grok -p`, which is how the delegation skill
  # launches its children) has nobody to ask, so one required here would come
  # back "headless run cannot ask for approval" and the child would finish a
  # whole task with its work uncommitted - the failure the seed text now argues
  # against. Every rule here is local to this checkout and undone by another git
  # command: a branch, the index, a commit. `git push` is absent on purpose, so
  # the one step that leaves the machine keeps asking for a human, and so does
  # anything that can lose work (`git branch -D`, `git restore`,
  # `git reset --hard`).
  "Bash(git switch *)",
  "Bash(git checkout -b *)",
  "Bash(git checkout -B *)",
  "Bash(git add *)",
  "Bash(git commit *)",
]
%{if grok_config_extra != ""~}

# --- per-workspace additions (create form: Grok config extras) ---
${grok_config_extra}
%{endif~}
