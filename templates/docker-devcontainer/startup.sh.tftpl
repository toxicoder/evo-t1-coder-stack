#!/bin/bash
# Coder workspace startup — EVO-T1 stack, devcontainer template.
#
# Idempotent: safe to re-run on every workspace start.
#   1. installs tmux (if missing)
#   2. installs the Grok Build CLI (if missing)
#   3. puts ~/.grok/bin on PATH (login shells + this process)
#   4. writes the two terminal-profile helpers (the "Grok Build" one and the
#      plain tmux reattach wrapper the default profile uses), so a closed tab
#      rejoins its session instead of losing the processes running in it
#   5. seeds the Coder Agents context (skill + instructions under ~/.agents),
#      only if those files are absent
#   6. writes ~/.grok/config.toml (only while this stack owns the file)
#   7. clones the repository named by the create form onto the shared
#      devcontainer bind — this is what coder_devcontainer's workspace_folder
#      points at, so it has to exist before the agent builds the dev container
#   8. warms the offline MCP package caches in the background
#
# ~/.grok is not necessarily this workspace's own directory. With main.tf's
# grok_profile_share on (the default) the container mounts the workspace owner's
# shared per-user Docker volume read-write at /home/coder/.grok, nested inside
# that workspace's own /home/coder volume, so the terminal helpers, config.toml,
# memory-v2/ and the MCP warm caches written below are the same files every
# other workspace this user owns reads and writes, and they survive a rebuild.
# It is the workspace container that gets that mount; a dev container the repo
# builds on the sidecar keeps its own home. What none of this changes is
# ownership of config.toml: the managed-by: evo-t1-coder-stack marker still
# decides it, and the file is still re-rendered on every start while that
# marker line is present.
#
# Every stage 5 onward is best-effort: an offline first boot must still leave a
# working terminal, and a repository that cannot be cloned must still leave a
# workspace someone can fix, so nothing here may abort the script. A missing or
# half-cloned folder is not silent — coder_devcontainer fails on its own with a
# visible error naming the folder it looked in.
#
# Note: this file is rendered by Terraform templatefile(); shell variables are
# written with a doubled dollar sign ($name or $${name}; the braced form is only
# safe when escaped this way) so the rendered script keeps them. The only
# interpolations Terraform has to resolve are the three variables main.tf
# passes: grok_config, repo_url and dc_dir.

set -u

SUDO=""
if [ "$(id -u)" != "0" ] && command -v sudo >/dev/null 2>&1; then
  SUDO="sudo"
fi

# --- tmux -------------------------------------------------------------------
if ! command -v tmux >/dev/null 2>&1; then
  $SUDO apt-get update -y >/dev/null
  $SUDO DEBIAN_FRONTEND=noninteractive apt-get install -y tmux >/dev/null
fi

# --- Grok Build CLI ----------------------------------------------------------
# A PATH probe (`command -v`), not `[ -x ~/.grok/bin/grok ]`: the golden image
# bakes the CLI into /usr/local/bin, so on a golden-image boot this probe
# answers YES and nothing downloads. The download is the fallback for the
# `ubuntu:24.04` image option and for a home volume that never received a CLI,
# and it is bounded + retried on purpose: one unbounded attempt burned a whole
# start on a single stalled connection to x.ai ("curl: (28) SSL connection
# timeout") and booted the workspace without a CLI anyway.
#
# GROK_FRESH_INSTALL records that an install COMPLETED this boot. The
# installer writes its own ~/.grok/config.toml (a `[cli] installer = ...`
# stub), indistinguishable from a user's config; the managed-config guard
# below may only treat that stub as stack-owned on a completed install — a
# download that failed must never wipe a user-owned config in its place.
GROK_FRESH_INSTALL=0
if ! command -v grok >/dev/null 2>&1; then
  grok_installer="$(mktemp 2>/dev/null || true)"
  if [ -n "$grok_installer" ] \
     && curl -fsSL --http1.1 --retry 5 --retry-all-errors --retry-delay 2 --connect-timeout 15 --max-time 180 \
          -o "$grok_installer" https://x.ai/cli/install.sh \
     && bash "$grok_installer" >/dev/null; then
    # `command -v` again, not `[ -x ... ]`: the probe must see the CLI
    # wherever the installer put it, and a failed download must leave the
    # flag at 0.
    command -v grok >/dev/null 2>&1 && GROK_FRESH_INSTALL=1
  fi
  # $${...} (doubled dollar) keeps this a shell expansion, not a Terraform
  # interpolation — see the note at the top of this file.
  rm -f "$${grok_installer:-}"
fi
if ! grep -qs 'grok/bin' "$HOME/.bashrc"; then
  printf '\n# Grok Build CLI\nexport PATH="$HOME/.grok/bin:$PATH"\n' >>"$HOME/.bashrc"
fi
export PATH="$HOME/.grok/bin:$PATH"

# --- terminal-profile helpers -------------------------------------------------
# Both profiles below launch through a per-folder tmux session, so a closed tab
# never kills what was running in it.
#
# VS Code shows the profile under the settings key "Grok Build"; this helper
# resumes (or starts) one tmux session per folder:
#   grok-build-<folder>-<hash>
# then runs `grok --cwd <folder>` inside that session.
mkdir -p "$HOME/.grok/bin"
cat >"$HOME/.grok/bin/grok-build-terminal" <<'GROK_BUILD_HELPER'
#!/bin/bash
export PATH="$HOME/.grok/bin:$PATH"
folder=$(basename "$PWD")
hash=$(printf '%s' "$PWD" | cksum 2>/dev/null | awk '{print substr($1, 1, 6)}')
[ -n "$hash" ] || hash=$(printf '%s' "$PWD" | od -An -tx1 2>/dev/null | tr -d ' \n' | cut -c1-6)
[ -n "$hash" ] || hash="root"
session="grok-build-$${folder}-$${hash}"
if command -v grok >/dev/null 2>&1; then
  exec tmux new-session -A -s "$session" -c "$PWD" -- grok --cwd "$PWD"
fi
# Grok CLI missing (offline first boot): still resume the session as a shell.
exec tmux new-session -A -s "$session" -c "$PWD"
GROK_BUILD_HELPER
chmod +x "$HOME/.grok/bin/grok-build-terminal"

# The default terminal (and the Grok Build profile) join one tmux session per
# folder instead of starting a throwaway one, so a closed tab or reloaded page
# never kills running processes and another terminal (or an SSH client) can
# rejoin the same session. No tmux (offline first boot): plain login shell.
cat >"$HOME/.grok/bin/vscode-terminal-tmux" <<'TMUX_ATTACH_HELPER'
#!/bin/bash
folder=$(basename "$PWD")
hash=$(printf '%s' "$PWD" | cksum 2>/dev/null | awk '{print substr($1, 1, 6)}')
[ -n "$hash" ] || hash=$(printf '%s' "$PWD" | od -An -tx1 2>/dev/null | tr -d ' \n' | cut -c1-6)
[ -n "$hash" ] || hash="root"
session="vscode-$${folder}-$${hash}"
if ! command -v tmux >/dev/null 2>&1; then
  exec /bin/bash -l
fi
exec tmux -u new-session -A -s "$session" -c "$PWD"
TMUX_ATTACH_HELPER
chmod +x "$HOME/.grok/bin/vscode-terminal-tmux"

# --- Coder Agents context (skill + instructions) ------------------------------
# Seeds the two files the `agents` EXPERIMENT (Coder Agents chat) reads inside a
# workspace: the skill folder is offered to the chat agent through the
# CODER_AGENT_EXP_SKILLS_DIRS / CODER_AGENT_EXP_INSTRUCTIONS_* env keys set in
# main.tf. Written only if ABSENT — a hand-edited copy is user-owned and this
# stage re-runs harmlessly (the first line of each file carries the stack's
# managed-by: evo-t1-coder-stack marker for the same reason config.toml's does,
# and in SKILL.md sits after the `---` frontmatter because the agent's skill
# parser needs `---` on line 1 and silently drops a skill whose first line is
# anything else). Best-effort like the stages below it: a read-only or missing
# $HOME/.agents changes nothing observable. The files live on the workspace's
# own /home/coder volume — this stage neither needs nor disturbs the ~/.grok
# profile mount.
if [ ! -f "$HOME/.agents/skills/grok-build-delegation/SKILL.md" ]; then
  mkdir -p "$HOME/.agents/skills/grok-build-delegation" 2>/dev/null
  cat >"$HOME/.agents/skills/grok-build-delegation/SKILL.md" <<'AGENT_SKILL_MD_EOF'
---
name: grok-build-delegation
description: "Delegate big multi-file work to the Grok Build CLI (`grok`, also on PATH as `agent`): run it headless as a tracked background process, then review its diff and run the project tests before reporting done."
---

<!-- managed-by: evo-t1-coder-stack — stack-seeded. Delete this file to take the
     skill over: the workspace boot reseeds it only while the file is absent. -->

# Grok Build delegation

## Small ask — handle it yourself

Single-file or short-readable work (read a file, tweak one file, run one
command): do it yourself with `read_file`, `edit_files` and `execute`. Do not
delegate — delegation costs a review pass and buys nothing on a small ask.

## Big task — delegate through `execute`

Multi-file refactor, framework adoption, test suites, a new app: anything that
needs many tool calls against a real repository. Run the Grok Build CLI
headless instead of driving the edits yourself, via `execute`:

    execute: grok -p "<the task brief, with its acceptance criteria>" --cwd <repo> --permission-mode acceptEdits --max-turns <budget>

Rules:

1. Write the brief first: goal, the repo path, and the acceptance criteria —
   the commands or behaviour that prove the task is done. Delegation without
   criteria has nothing to review the delegated diff against.
2. Start it as a TRACKED BACKGROUND PROCESS and poll its output (re-`execute`
   to re-check the tracked process/log, or reattach to its tmux session) —
   `execute` only waits a short window per tool call (about a minute), so a
   synchronous foreground `grok -p` would die mid-run on any big task.
3. When it exits, REVIEW before anything else: `git diff` in the repo (plus
   `git status` for new files), then RUN the project's own tests or build
   against the criteria you wrote.
4. Only then report done. If grok exited non-zero, hit the timeout, or the
   diff fails the criteria, fall back to doing the work yourself — say so in
   the reply rather than reporting or relaunching unreviewed results.

## Environment facts

- `grok` lives at `/usr/local/bin/grok` and may also be called as `agent`
  (the symlink beside it).
- LiteLLM is already exported into workspace shells: `LITELLM_BASE_URL` plus
  the key in `LITELLM_API_KEY`; the CLI's default model alias `agent` is the
  tool-call-capable one. Never print or embed `$LITELLM_API_KEY` in a command,
  file or reply — reference it by name only.
AGENT_SKILL_MD_EOF
fi

if [ ! -f "$HOME/.agents/INSTRUCTIONS.md" ]; then
  cat >"$HOME/.agents/INSTRUCTIONS.md" <<'AGENT_INSTR_MD_EOF'
<!-- managed-by: evo-t1-coder-stack — stack-seeded. Delete this file to take the
     instructions over: the workspace boot reseeds it only while it is absent. -->

# Deployment-wide agent instructions

- Small asks (single file, short-read, one-off command): handle them directly
  with `read_file` / `edit_files` / `execute`. Do not delegate what you can
  read and edit yourself.
- Big multi-file work (refactors, framework adoption, test suites, new apps):
  route it through the `grok-build-delegation` skill — delegate to the Grok
  Build CLI (`grok`, also callable as `agent`) in the workspace, then review
  the delegated `git diff` and run the project's tests before calling it done.
- Keep secrets out of commands and file contents. Never print `$LITELLM_API_KEY`
  — reference env vars by name, never by value.
AGENT_INSTR_MD_EOF
fi

# --- Editor settings ----------------------------------------------------------
# The stack's editor settings are no longer written here. main.tf hands the same
# JSON to the code-server module's `settings`/`machine_settings` inputs, which
# merge it into ~/.local/share/code-server/{User,Machine}/settings.json on
# startup (per-key merge, so a user-edited file survives). Those are the paths
# code-server actually reads; nothing reads ~/.config/Code here.

# --- Grok Build config --------------------------------------------------------
# Rendered from grok-config.toml.tftpl: the LiteLLM model catalog, the offline
# MCP stack and the subagent sizing. Ownership is decided by the marker comment
# below: while it is present the stack re-renders the file on every start, and
# deleting that one line hands the file over to the user for good. On a shared
# profile volume that file usually already exists — another of the owner's
# workspaces wrote it — so the marker, not first-boot, is what decides.
#
# A fresh CLI install always takes the file back. The installer creates a
# `[cli] installer = ...` stub before this stage runs, so without the first-boot
# flag a brand-new workspace would be left with an unconfigured CLI: the stub has
# no marker, the file exists, and the guard below would treat it as user-owned.
mkdir -p "$HOME/.grok/memory" "$HOME/.grok/logs/mcp" 2>/dev/null

if [ ! -f "$HOME/.grok/config.toml" ] \
   || [ "$GROK_FRESH_INSTALL" = "1" ] \
   || grep -qs 'managed-by: evo-t1-coder-stack' "$HOME/.grok/config.toml"; then
  # Re-rendering also happens on every start while the marker is present, so the
  # installer's (or the user's) [cli] table is carried over instead of wiped —
  # `cli.installer` picks the CLI's update path and is not something the stack owns.
  cli_block="$(mktemp 2>/dev/null || printf '/tmp/grok-cli-block.%s.toml' "$$")"
  if [ -f "$HOME/.grok/config.toml" ]; then
    awk '/^\[cli\][[:space:]]*$/{f=1;print;next} /^\[/{f=0} f' \
      "$HOME/.grok/config.toml" >"$cli_block" 2>/dev/null || : >"$cli_block"
  else
    : >"$cli_block"
  fi
  {
    cat <<'GROK_CONFIG_EOF'
${grok_config}
GROK_CONFIG_EOF
    if [ -s "$cli_block" ]; then
      printf '\n'
      cat "$cli_block"
    fi
  } >"$HOME/.grok/config.toml" || true
  rm -f "$cli_block"
  chmod 600 "$HOME/.grok/config.toml" 2>/dev/null || true
fi

# The agent may run as root against a persistent home volume, which leaves the
# Grok directories root-owned and unreadable for the workspace user; hand them
# back to whoever owns $HOME.
if [ "$(id -u)" = "0" ]; then
  home_owner="$(stat -Lc '%u:%g' "$HOME" 2>/dev/null || true)"
  [ "$home_owner" = "0:0" ] && home_owner=""
  if [ -z "$home_owner" ] && id coder >/dev/null 2>&1; then
    home_owner="$(id -u coder):$(id -g coder)"
  fi
  if [ -n "$home_owner" ]; then
    chown -R "$home_owner" "$HOME/.grok" 2>/dev/null || true
  fi
fi

# --- Repository clone onto the shared devcontainer bind ----------------------
# This stage exists because the dev container's workspace folder is not created
# by anything else: coder_devcontainer.repo points at "$dc_dir/<folder>", the
# agent runs @devcontainers/cli against that folder, and only this script ever
# puts code in it. A missing folder is not swallowed here — it surfaces as the
# devcontainer build's own visible failure (no devcontainer.json found), which is
# the report the user actually sees on the workspace page.
#
# The path is load-bearing, not incidental: the DinD sidecar bind-mounts the same
# host directory at the same container path (see the locals block in main.tf),
# because a bind mount's source is resolved by the daemon that runs the container
# and that daemon is the sidecar. Anything cloned anywhere else is invisible to
# the daemon and the build dies with "bind source path does not exist".
#
# The folder name is re-derived here rather than handed in, because this is the
# side that runs git; main.tf derives it the same way for workspace_folder and
# the two derivations must agree (split on "/", drop empty segments so a trailing
# slash is harmless, take the last, drop a trailing ".git", map every character
# outside [A-Za-z0-9._-] to "-", and fall back to "repo" when that leaves no
# leading alphanumeric — which also keeps "../" out of a root-owned bind).
#
# The URL arrives as a rendered literal, so it is read through a quoted heredoc:
# that way no shell quoting has to survive, and the value is only ever expanded
# as data.
repo_url_raw="$(cat <<'REPO_URL_EOF'
${repo_url}
REPO_URL_EOF
)"
dc_dir='${dc_dir}'

repo_leaf="$(printf '%s' "$repo_url_raw" | tr '/' '\n' | grep -v '^$' | tail -n 1)"
# The "$${leaf%.git}" suffix form would be the shorter way to drop the extension;
# it is spelled with sed here because a braced shell expansion is a templatefile
# interpolation, and the bare form keeps this script's interpolation count at the
# three variables main.tf passes.
repo_folder="$(printf '%s' "$repo_leaf" | sed 's/\.git$//')"
repo_folder="$(printf '%s' "$repo_folder" | sed 's/[^A-Za-z0-9._-]/-/g')"
printf '%s' "$repo_folder" | grep -qE '^[A-Za-z0-9]' || repo_folder="repo"
target="$dc_dir/$repo_folder"

# Whichever user the workspace really belongs to: the owner of $HOME when the
# agent runs as root (same rule as the ~/.grok chown above), otherwise whoever is
# running this script. It decides both the chown target and whose git credentials
# the clone uses.
clone_owner="$(id -un)"
if [ "$(id -u)" = "0" ]; then
  clone_owner="$(stat -Lc '%U' "$HOME" 2>/dev/null || true)"
  [ "$clone_owner" = "root" ] && clone_owner=""
  if [ -z "$clone_owner" ] && id coder >/dev/null 2>&1; then
    clone_owner="coder"
  fi
fi
clone_home=""
[ -n "$clone_owner" ] && clone_home="$(getent passwd "$clone_owner" 2>/dev/null | cut -d: -f6)"

# Docker creates a missing bind source root-owned on the stack host, so the shared
# directory is handed to the workspace user before git runs — a root-owned 755
# parent would otherwise fail the clone outright. Non-recursive here: other
# workspaces' clones live alongside this one and are not ours to chown.
mkdir -p -- "$dc_dir" 2>/dev/null || true
if [ -n "$clone_owner" ]; then
  chown "$clone_owner" "$dc_dir" 2>/dev/null || true
fi

# Clone as the workspace user, never as root, so their credentials (a helper,
# ~/.git-credentials, ssh keys) are the ones git consults. An empty prefix means
# "run git directly", which is correct for a non-root agent and for a root agent
# with no derivable workspace user. HOME is passed explicitly because runuser keeps
# the invoker's environment — a root agent would otherwise hand git /root and miss
# the workspace user's credential files entirely.
clone_runner=""
if [ "$(id -u)" = "0" ] && [ -n "$clone_owner" ]; then
  if command -v runuser >/dev/null 2>&1; then
    clone_runner="runuser -u $clone_owner --"
  elif command -v sudo >/dev/null 2>&1; then
    clone_runner="sudo -u $clone_owner --"
  fi
fi

run_clone() {
  if [ -n "$clone_runner" ] && [ -n "$clone_home" ]; then
    $clone_runner env HOME="$clone_home" git "$@"
  elif [ -n "$clone_runner" ]; then
    $clone_runner git "$@"
  else
    git "$@"
  fi
}

if [ -d "$target/.git" ]; then
  # Re-fetching is the user's call: a pull here could conflict mid-edit or fail
  # on a dirty tree, and either way the workspace would start on code nobody chose.
  echo "$repo_folder: already cloned, skipping"
elif [ -e "$target" ]; then
  echo "WARNING: $target exists but is not a git repository — leaving it alone and" \
    "skipping the clone. Remove it from the stack host if it should not be there." >&2
elif ! command -v git >/dev/null 2>&1; then
  echo "WARNING: git is not installed in the workspace container, so $repo_url_raw" \
    "was not cloned into $target — the dev container build will fail. This template" \
    "expects the golden image (scripts/build-dev-image.sh), which ships git." >&2
else
  # -- before the URL: the value is user input and must never parse as an option.
  if run_clone clone -- "$repo_url_raw" "$target"; then
    echo "cloned $repo_url_raw into $target"
    if [ -n "$clone_owner" ]; then
      chown -R "$clone_owner" "$target" 2>/dev/null || true
    fi
  else
    # Loud and non-fatal on purpose: the devcontainer build reports the same
    # problem a second time, and the workspace still boots for someone to fix it.
    # git removes its own partial clone on failure; nothing here deletes a folder
    # that may hold someone's work.
    echo "==============================================================" >&2
    echo "WARNING: the repository clone failed — the dev container will not build." >&2
    echo "  repository: $repo_url_raw" >&2
    echo "  target:     $target" >&2
    echo "  The two likely causes:" >&2
    echo "    1. a private repository: git runs unauthenticated as the workspace" >&2
    echo "       user, so credentials must already exist inside the workspace" >&2
    echo "       (a credential helper, ~/.git-credentials, or ~/.ssh)" >&2
    echo "    2. an unreachable host: check DNS and egress from the workspace" >&2
    echo "       container, then restart the workspace" >&2
    echo "  Clone it by hand into the path above, or fix the URL, and start again." >&2
    echo "==============================================================" >&2
  fi
fi

# --- MCP package warm-up (best effort) ----------------------------------------
# Cold npx/uvx downloads are what make a first session stall on the MCP startup
# timeout; prefetch the packages config.toml declares, off the boot path, with
# every byte going to a log so no output pipe is left open behind the agent.
if command -v npm >/dev/null 2>&1 || command -v uvx >/dev/null 2>&1; then
  mkdir -p "$HOME/.grok/logs" 2>/dev/null
  (
    if command -v npm >/dev/null 2>&1; then
      for pkg in \
        @modelcontextprotocol/server-filesystem \
        @modelcontextprotocol/server-memory \
        @modelcontextprotocol/server-sequential-thinking
      do
        timeout 300 npm cache add "$pkg" </dev/null || true
      done
    fi
    if command -v uvx >/dev/null 2>&1; then
      for pkg in mcp-server-git mcp-server-time
      do
        timeout 300 uvx "$pkg" --help </dev/null || true
      done
    fi
  ) >>"$HOME/.grok/logs/mcp-warmup.log" 2>&1 &
fi
