#!/bin/sh
# tftpl: coder_script body; the two terminal payloads are interpolated from the map
# main.tf passes, each into a quoted here-doc so no shell text inside one is expanded.
# Why these two ride their own body instead of startup.sh.tftpl: the agent execs every
# body as ONE argument and the startup argument is the one that runs out of room;
# docs/coder-templates.md#the-one-argument-ceiling. Nothing at boot executes either
# script -- the code-server terminal profile in settings.json is the only consumer --
# so landing them a moment after the startup script costs an operator nothing. What that
# freedom does not buy is the directory: the start scripts fan out concurrently, so this
# body cannot count on the startup script having made ~/.grok writable by now, and asks
# for it itself with boot_ensure_dir.
set -u

# The library arrives as a map value, and Terraform does not re-interpolate one, so the
# library's own dollar-brace text lands verbatim: no here-doc and no temp file to carry
# it. A comment here has to spell that token as "dollar-brace" too - Terraform reads a
# real one anywhere in this file, comments included.
${boot_log_lib}

boot_begin "terminal launchers" 2

# launcher_landed <name> - the only consumer of either file is the code-server terminal
# profile in settings.json, which execs "$HOME/.grok/bin/<name>" as the tab's process. A
# launcher that did not land is therefore a tab that answers "The terminal process ...
# terminated with exit code: 127" with nothing saying where the file went. Here can only
# miss on a directory this boot cannot write, and the start log is the only place that
# would show it, so the bytes get checked instead of the here-doc being assumed.
launcher_landed() {
  if [ -s "$HOME/.grok/bin/$1" ] && [ -x "$HOME/.grok/bin/$1" ]; then
    boot_ok "$1 is in place"
  else
    boot_err "$HOME/.grok/bin/$1 did not land: the $1 terminal profile exits 127 on every tab"
  fi
}

boot_stage 1 "the grok terminal launcher"
boot_ensure_dir "$HOME/.grok/bin"
boot_phase "writing $HOME/.grok/bin/grok-build-terminal"
cat >"$HOME/.grok/bin/grok-build-terminal" <<'GROK_BUILD_HELPER'
${grok_build_terminal}
GROK_BUILD_HELPER
chmod +x "$HOME/.grok/bin/grok-build-terminal" 2>/dev/null || true
launcher_landed grok-build-terminal

boot_stage 2 "the tmux attach launcher"
boot_phase "writing $HOME/.grok/bin/vscode-terminal-tmux"
cat >"$HOME/.grok/bin/vscode-terminal-tmux" <<'TMUX_ATTACH_HELPER'
${vscode_terminal_tmux}
TMUX_ATTACH_HELPER
chmod +x "$HOME/.grok/bin/vscode-terminal-tmux" 2>/dev/null || true
launcher_landed vscode-terminal-tmux

boot_summary
