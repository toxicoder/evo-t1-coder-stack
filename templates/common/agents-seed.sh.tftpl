#!/bin/sh
# tftpl: coder_script body; the orchestration-protocol payload is interpolated from the
# map main.tf passes, into a quoted here-doc so no shell text inside it is expanded.
# Why this seed rides a body of its own rather than startup.sh.tftpl: the agent execs
# every body as ONE argument to execve(2), Linux caps one argument at 131072 bytes, and
# this payload is the largest the template inlines. docs/coder-templates.md#the-one-argument-ceiling.
set -u

# The verbs arrive as a map value and Terraform does not re-interpolate one, so the
# library's own dollar-brace text lands verbatim - spelled that way here because
# Terraform reads a real one anywhere in this file, comments included.
${boot_log_lib}

boot_begin "agents seed" 3
boot_stage 1 "the orchestration rulebook"

# Marker-aware, not absent-only: a copy carrying the stack marker
# (managed-by: evo-t1-coder-stack) is stack-owned and gets the current text on every
# start, while a copy whose marker lines a person deleted is theirs and is left alone.
# The same marker refresh-configs checks before it rewrites the file from the seed in
# this repo. One line per start says which of the two it did, because this body's log is
# what an operator reads when the rulebook is missing.
if [ ! -f "$HOME/.grok/AGENTS.md" ] \
   || grep -qs 'managed-by: evo-t1-coder-stack' "$HOME/.grok/AGENTS.md"; then
  mkdir -p "$HOME/.grok" 2>/dev/null
  boot_phase "writing $HOME/.grok/AGENTS.md from the seed"
  cat >"$HOME/.grok/AGENTS.md" <<'GROK_AGENTS_EOF'
${grok_build_agents}
GROK_AGENTS_EOF
  boot_ok "the rulebook is in place at ~/.grok/AGENTS.md"
else
  boot_note "left ~/.grok/AGENTS.md alone: its owner deleted the stack marker"
fi

# The same marker contract, applied to the swap file left beside the other file this
# boot owns. A workspace stop kills an open vim, and ~/.grok is one persistent
# per-owner volume, so the swap outlives the container and the next
# `vim ~/.grok/config.toml` stops on E325 asking about a session whose container is
# gone - and answering it "(E)dit anyway" leaves that swap in place and mints another
# beside it, so the home fills up with .swp/.swo/.swn/.swm and the prompt never goes
# away. A config that still carries the stack marker is one every start replaces from
# grok-config.toml.tftpl, so what a leftover swap holds is doomed either way - and the
# marker test below is what this argues from, because a coder_script runs in no promised
# order with the startup script (templates/workspace/coder.tf:272), so the sweep cannot
# count on having seen that rewrite first.
#
# Two checks decide what counts as an orphan, and neither one proves a writer is dead.
# vim writes the swap once about four seconds after a change and then goes quiet while
# you read, so a live session idling over the file looks exactly like a crashed one: the
# hour below is courtesy toward a session that may still be open in another container,
# not evidence. And each workspace has its own PID namespace, so the /proc scan sees this
# container's descriptors only - a sibling workspace holding the same file open on the
# shared volume is invisible here. So the sweep moves what it judges orphaned rather than
# deleting it: nothing this step cannot prove stays recoverable, and a wrong judgement is
# an `ls ~/.grok/stale-swaps` away from undone. docs/coder-templates.md#stale-editor-swap-files
grok_sweep_config_swaps() {
  # What this pass decided travels out in three variables the caller seeds before it and
  # prints after. The suite sources this function on its own
  # (tests/bats/config-swap-sweep.bats), where the verbs above are not part of the
  # extract, so the report has to print either way.
  if ! command -v boot_note >/dev/null 2>&1; then
    boot_note() { printf '%s\n' "$*"; }
  fi
  # The descriptor scan's root, named as one constant so the suite can point it at an
  # empty tree and prove the fail-closed half. The boot calls this with no arguments.
  grok_proc_dir=/proc
  # Only a config the stack owns: an unmanaged one is the operator's file, swap and all.
  grep -qFs -e 'managed-by: evo-t1-coder-stack' -e '__evoT1Stack = true' \
    "$HOME/.grok/config.toml" 2>/dev/null || return 0
  # Prove the one probe whose silence means "nobody holds this", rather than checking
  # that it exists: a readlink that errors answers the empty string, and an empty answer
  # is exactly what the compare below reads as no holder. That would move a swap out from
  # under a live editor, the one thing this step promises never to do.
  readlink -f / >/dev/null 2>&1 || return 0
  grok_sweep_state=no_descriptors
  # No descriptor tree to consult is the same undecided case and fails the same way: with
  # the glob matching nothing, every swap would look unheld.
  [ -d "$grok_proc_dir" ] || return 0
  grok_sweep_state=scanned
  grok_stale_dir="$HOME/.grok/stale-swaps"
  for grok_swap in "$HOME/.grok"/.config.toml.sw?; do
    [ -f "$grok_swap" ] || continue
    # A symlink is not a swap. Archiving one would move the name, strand the bytes it
    # points at, and then promise recovery of a dangling path. The name goes up to the
    # stage that reports it: this loop stays free of the verbs, which the extract lacks.
    if [ -L "$grok_swap" ]; then
      [ -n "$grok_sweep_symlink" ] || grok_sweep_symlink="$grok_swap"
      continue
    fi
    # A find that is missing or failing lands here on a non-zero status and keeps the file.
    grok_recent="$(find "$grok_swap" -mmin -60 2>/dev/null)" || continue
    [ -n "$grok_recent" ] && continue
    # Exact string, never -lname's glob: one bracket in $HOME, or a $HOME that is itself
    # a symlink, hides a live holder from a pattern match.
    grok_target="$(readlink -f "$grok_swap" 2>/dev/null)" || grok_target="$grok_swap"
    grok_held=0
    for grok_fd in "$grok_proc_dir"/[0-9]*/fd/*; do
      [ -e "$grok_fd" ] || continue
      [ "$(readlink "$grok_fd" 2>/dev/null)" = "$grok_target" ] && { grok_held=1; break; }
    done
    [ "$grok_held" -eq 1 ] && continue
    # basename over a brace expansion: a brace expansion here has to be escaped for
    # Terraform to leave it alone, and the escaped form is not the shell the render
    # produces, so the gate that drives this body as written would be testing something
    # the boot never runs.
    grok_base="$(basename "$grok_swap" 2>/dev/null)" || continue
    [ -n "$grok_base" ] || continue
    mkdir -p "$grok_stale_dir" 2>/dev/null || continue
    # The suffix has to be unique across boots and not just within one: sibling containers
    # share this volume and each starts its own PID sequence, so $$ alone can name two
    # archives alike and the second mv would quietly eat the first.
    grok_n=0
    grok_name="sweep-$grok_base.orphan.$$-$grok_n"
    while [ -e "$grok_stale_dir/$grok_name" ]; do
      grok_n=$((grok_n + 1))
      grok_name="sweep-$grok_base.orphan.$$-$grok_n"
    done
    mv -f "$grok_swap" "$grok_stale_dir/$grok_name" 2>/dev/null || continue
    # mv carries the swap's old mtime with it, so a swap from a workspace stopped for six
    # weeks would be archived and pruned in the same breath - the common case of the very
    # situation this exists for. The archive dates from the day the stack set it down,
    # which is the only clock that makes the month of recovery real.
    touch "$grok_stale_dir/$grok_name" 2>/dev/null || true
    grok_sweep_moved=$((grok_sweep_moved + 1))
    # One argument, not three: every verb in the library reads its first operand alone,
    # so the continuation lines an echo could carry have to be joined here.
    grok_report="Moved the stale editor swap $grok_swap to ~/.grok/stale-swaps/$grok_name: the"
    grok_report="$grok_report session that left it is not one this container can see, and this"
    grok_report="$grok_report boot replaces the file it shadows either way. vim -r ~/.grok/stale-swaps/$grok_name recovers it."
    boot_note "$grok_report"
  done
  # Prune only the names this function gives itself, at one level only: an operator who
  # reads the recovery docs and parks a file in that directory keeps it.
  find "$grok_stale_dir" -maxdepth 1 -type f -name 'sweep-*.orphan.*' -mtime +30 \
    -exec rm -f {} + 2>/dev/null || true
}

boot_stage 2 "the stale editor swap sweep"
# The three the sweep answers in. Under set -u the case below has to read names the body
# itself has bound, so they are seeded here as well as written there.
grok_sweep_state=unmanaged
grok_sweep_moved=0
grok_sweep_symlink=''
boot_phase "reading the marker, then every descriptor link under /proc"
grok_sweep_config_swaps || true

# The sweep is the part of this boot an operator cannot otherwise see: it decides in
# silence which swap is an orphan and which it cannot prove, and every one of those gates
# is a reason the E325 prompt survives a boot. One line names the gate it stopped at.
boot_stage 3 "what the marker check decided"
case "$grok_sweep_state" in
  unmanaged)
    boot_note "~/.grok/config.toml carries no stack marker, so its swap is the operator's"
    ;;
  no_probe)
    boot_warn "the holder probe is unusable: every swap stays where it is"
    ;;
  no_descriptors)
    boot_warn "no descriptor tree to read: every swap stays where it is"
    ;;
  scanned)
    if [ "$grok_sweep_moved" -gt 0 ]; then
      boot_ok "archived $grok_sweep_moved orphaned editor swap(s) into ~/.grok/stale-swaps"
    else
      boot_note "no orphaned editor swap to archive"
    fi
    if [ -n "$grok_sweep_symlink" ]; then
      boot_warn "left the symlink $grok_sweep_symlink: archiving a link strands the bytes it points at"
    fi
    ;;
esac

boot_summary
