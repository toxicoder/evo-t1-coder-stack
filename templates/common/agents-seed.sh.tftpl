#!/bin/sh
# tftpl: coder_script body; the orchestration-protocol payload is interpolated from the
# map main.tf passes, into a quoted here-doc so no shell text inside it is expanded.
# Why this seed rides a body of its own rather than startup.sh.tftpl: the agent execs
# every body as ONE argument to execve(2), Linux caps one argument at 131072 bytes, and
# this payload is the largest the template inlines. docs/coder-templates.md#the-one-argument-ceiling.
set -u

# Marker-aware, not absent-only: a copy carrying the stack marker
# (managed-by: evo-t1-coder-stack) is stack-owned and gets the current text on every
# start, while a copy whose marker lines a person deleted is theirs and is left alone.
# The same marker refresh-configs checks before it rewrites the file from the seed in
# this repo. Silent on a healthy workspace, because this body's log is what an operator
# reads when the rulebook is missing.
if [ ! -f "$HOME/.grok/AGENTS.md" ] \
   || grep -qs 'managed-by: evo-t1-coder-stack' "$HOME/.grok/AGENTS.md"; then
  mkdir -p "$HOME/.grok" 2>/dev/null
  cat >"$HOME/.grok/AGENTS.md" <<'GROK_AGENTS_EOF'
${grok_build_agents}
GROK_AGENTS_EOF
fi

# The same marker contract, applied to the swap file left beside the other file this
# boot owns. A workspace stop kills an open vim, and ~/.grok is one persistent
# per-owner volume, so the swap outlives the container and the next
# `vim ~/.grok/config.toml` stops on E325 asking about a session whose container is
# gone - and answering it "(E)dit anyway" leaves that swap in place and mints another
# beside it, so the home fills up with .swp/.swo/.swn/.swm and the prompt never goes
# away. A config that still carries the stack marker is one every start replaces from
# grok-config.toml.tftpl, so what a leftover swap holds is doomed either way - and the
# marker test below is what this argues from, because a coder_script runs in no promised
# order with the startup script (templates/workspace/coder.tf:272), so the sweep cannot
# count on having seen that rewrite first. Orphans only: a swap
# written in the last hour, or one some process still has open, stays. A sibling
# workspace shares this volume and its editor is invisible from here, which is what
# the age check is for. docs/coder-templates.md#stale-editor-swap-files
grok_sweep_config_swaps() {
  # Only a config the stack owns: an unmanaged one is the operator's file, swap and all.
  grep -qFs -e 'managed-by: evo-t1-coder-stack' -e '__evoT1Stack = true' \
    "$HOME/.grok/config.toml" 2>/dev/null || return 0
  for grok_swap in "$HOME/.grok"/.config.toml.sw?; do
    [ -f "$grok_swap" ] || continue
    [ -n "$(find "$grok_swap" -mmin -60 2>/dev/null)" ] && continue
    [ -n "$(find /proc/[0-9]*/fd -lname "$grok_swap" -print -quit 2>/dev/null)" ] && continue
    rm -f "$grok_swap"
    echo "Removed the stale editor swap $grok_swap: the session that left it died" \
      "with an earlier container; this boot replaces the file it shadows either way."
  done
}
grok_sweep_config_swaps || true
