#!/bin/bash
# tftpl: coder_script body; $${shell} stays a shell var. This body declares no
# $${terraform_var} of its own: every input arrives as an environment variable on the
# coder_script, so main.tf renders it with an empty map and the plan carries no key.
set -u
# No CLI in the image: there is nothing to fetch with, and the vault is optional, so a
# missing binary is not news for the boot log.
command -v infisical >/dev/null 2>&1 || exit 0

# The one seam: the vault is off until the operator supplies all six of these, so a stack
# that never adopted Infisical is inert here. INFISICAL_MACHINE_IDENTITY_ID has no slot in
# any CLI argv (the client id/secret are the Universal Auth credential), so it gates here
# and records which identity the stack means.
if [ -z "$${INFISICAL_DOMAIN:-}" ] || [ -z "$${INFISICAL_PROJECT_ID:-}" ] ||
   [ -z "$${INFISICAL_MACHINE_IDENTITY_ID:-}" ] || [ -z "$${INFISICAL_ENVIRONMENT:-}" ] ||
   [ -z "$${INFISICAL_UNIVERSAL_AUTH_CLIENT_ID:-}" ] ||
   [ -z "$${INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET:-}" ]; then
  echo "infisical: vault not configured for this stack. These six names arrive on the coder_agent environment - INFISICAL_DOMAIN, INFISICAL_PROJECT_ID, INFISICAL_MACHINE_IDENTITY_ID, INFISICAL_ENVIRONMENT, INFISICAL_UNIVERSAL_AUTH_CLIENT_ID and INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET - and the template fills them from INFISICAL_PORT and from the five of the same spelling in the stack host's .env once INFISICAL_ENABLED is truthy: set them there and re-run bazelisk run //scripts:push-template." >&2
  exit 0
fi

# The second gate, and the reason this script is present but idle on a stack that
# adopted the vault but has not yet trusted a boot to it. The fetch is bounded by the
# coder_script timeout, so a boot that reaches the network is a boot that can be slow;
# off is the shipped default and the exit stays 0 either way, because a workspace must
# never fail to start over a secret manager.
if [ "$${INFISICAL_PULL_ON_START:-}" != "true" ]; then
  echo "infisical: pull-on-start is off (INFISICAL_PULL_ON_START), so this boot keeps the credentials it already has. Run bazelisk run //scripts:infisical -- pull on the stack host to load them now, or set the key to true to fetch at every start."
  exit 0
fi

evo_home="$${HOME:-}"
if [ -z "$evo_home" ]; then
  echo "infisical: no HOME in this workspace; there is nowhere private to write secrets." >&2
  exit 0
fi
evo_dir="$evo_home/.infisical"
evo_agent="$evo_dir/agent.env"
mkdir -p "$evo_dir" >/dev/null 2>&1 || true
chmod 700 "$evo_dir" >/dev/null 2>&1 || true

# Secrets reach disk and stay there: the CLI writes the dotenv dump straight into a
# mode-600 file, and the subset copy below is a redirect out of that file, never a shell
# variable and never a pipeline. Both temp files die in the trap whatever happens next.
evo_dump="$(mktemp 2>/dev/null || true)"
evo_out=""
evo_cleanup() {
  [ -z "$evo_dump" ] || rm -f "$evo_dump"
  [ -z "$evo_out" ] || rm -f "$evo_out"
  return 0
}
trap evo_cleanup EXIT
if [ -z "$evo_dump" ]; then
  echo "infisical: mktemp gave nothing; skipping the boot fetch." >&2
  exit 0
fi
chmod 600 "$evo_dump" >/dev/null 2>&1 || true

# INFISICAL_DOMAIN in the environment is what every call dials; without it the CLI would
# reach for US Cloud.
evo_token="$(infisical login --method=universal-auth --client-id="$INFISICAL_UNIVERSAL_AUTH_CLIENT_ID" --client-secret="$INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET" --plain --silent 2>/dev/null || true)"
if [ -z "$evo_token" ]; then
  echo "infisical: Universal Auth login failed for project $INFISICAL_PROJECT_ID; the workspace boots without vault secrets. Check the client id/secret and that $INFISICAL_DOMAIN is reachable from this workspace." >&2
  exit 0
fi

evo_err="$(infisical sm secrets export --env="$INFISICAL_ENVIRONMENT" --projectId="$INFISICAL_PROJECT_ID" --format=dotenv --expand=true --include-imports=true --output-file="$evo_dump" 2>&1 || true)"
if [ ! -s "$evo_dump" ]; then
  # The CLI can echo the bearer token back in an error, and a token must never reach the
  # Coder script log, so scrub it (and the client secret) before printing what it said.
  evo_safe="$${evo_err}"
  evo_safe="$${evo_safe//"$evo_token"/<token>}"
  evo_safe="$${evo_safe//"$INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET"/<secret>}"
  echo "infisical: nothing came back for project $INFISICAL_PROJECT_ID env $INFISICAL_ENVIRONMENT; the workspace boots without the vault." >&2
  echo "infisical said: $${evo_safe}" >&2
  exit 0
fi

# The workspace gets the keys its own machine identity can read, which is the subset the
# vault scopes. The 12-key managed inventory is a host-side list
# (infisical/managed-secrets.txt) and is not repeated here.
#
# The second filter is the load-bearing one: the vault's own credentials
# (INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET above all) are plausible keys in the very
# project being exported, and they must not be handed to a workspace through a file.
# A workspace learns them only from the agent environment, which Coder renders per
# start and never writes to disk. agent.env lands on this workspace's own home volume
# instead (the per-owner mounts are ~/.grok and ~/.shared/vscode, not ~/.infisical), so
# its readers are every process that runs inside this workspace, and they outlive the
# start that wrote them. That is the reason for the filter rather than a share boundary:
# a file a workspace can read is a file anything running in it can read.
evo_out="$(mktemp "$evo_dir/.agent.env.XXXXXX" 2>/dev/null || true)"
if [ -z "$evo_out" ]; then
  echo "infisical: could not stage agent.env; leaving the previous copy alone." >&2
  exit 0
fi
chmod 600 "$evo_out" >/dev/null 2>&1 || true

# Every line is rewritten here rather than copied, and that is a security step rather
# than a stylistic one. The CLI's dotenv writer wraps a value in single quotes and
# leaves an embedded single quote raw, so a secret like p@ss"w'ord is written as
# KEY='p@ss"w'ord ...' -- the quote closes at the apostrophe and whatever follows is
# shell. Sourcing such a file either aborts on an unbalanced quote or runs the tail as
# a command, which would put anyone who can write a secret in the project in a
# code-execution position in every shell of every workspace that reads this file.
# Measured on infisical/infisical:v0.167.10 with CLI v0.45.8, in both the dotenv and the
# dotenv-export shape, and neither is safe to source as written.
#
# So the value is taken apart and put back under quoting that has no escape hatch. The
# CLI's wrapping is exactly one pair of single quotes, so exactly one pair comes off and
# the interior survives byte for byte -- an apostrophe inside a password still works --
# then each apostrophe in it is re-emitted through the '"'"' idiom. Pattern and
# replacement ride variables rather than literals so no layer of quoting has to guess
# what the other layer meant. The export prefix is what lets a reader get an environment
# variable out of the line.
evo_sq="'"
evo_wrap="'\"'\"'"
# Key names are not neutral. agent.env is sourced by every shell this workspace starts,
# so a vault key the shell, the dynamic loader, or a common interpreter treats as code or
# as loader configuration is not a secret but a command line an attacker chose: BASH_ENV
# and ENV are executed by every non-interactive bash, PROMPT_COMMAND by every interactive
# one, PS4 and IFS change how the sourcing shell parses itself, LD_PRELOAD and NODE_OPTIONS
# name code another process loads, PATH and HOME decide which binary and which config the
# next command reads. Whoever can write a secret in the project would own every shell of
# every workspace that boots. This is that boundary, spelled once: the filter in the loop
# reads it and the scrub line after the loop is generated from it.
evo_deny="BASH_ENV ENV PROMPT_COMMAND PS1 PS2 PS4 IFS PATH HOME TMPDIR CDPATH \
  SHELLOPTS BASHOPTS GLOBIGNORE FIGNORE HISTFILE ZDOTDIR TERMCAP TERMINFO TERMINFO_DIRS \
  MAILPATH \
  LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT LD_DEBUG LD_ORIGIN_PATH LD_PROFILE GCONV_PATH \
  LOCPATH NLSPATH HOSTALIASES \
  NODE_OPTIONS PYTHONSTARTUP PYTHONPATH PERL5OPT PERL5LIB RUBYOPT RUBYLIB \
  GIT_SSH GIT_SSH_COMMAND GIT_EXEC_PATH GIT_CONFIG_GLOBAL GIT_CONFIG_SYSTEM \
  GIT_EXTERNAL_DIFF GIT_DIR GIT_WORK_TREE \
  PAGER GIT_PAGER LESS EDITOR VISUAL SUDO_ASKPASS SSH_ASKPASS GREP_OPTIONS"
evo_key=""
evo_val=""
evo_trim=""
evo_tail=""
evo_up=""
evo_esc=""
evo_line=""
evo_open=""
evo_multiline=""
evo_name=""
while IFS= read -r evo_line || [ -n "$evo_line" ]; do
  # The tail of a value whose opening quote never closed on its own line: the CLI wrote
  # it raw, so every line up to the one that closes the quote is part of that one secret.
  # Publishing any of them would invent a key out of secret bytes.
  if [ -n "$evo_open" ]; then
    case "$evo_line" in *"'"*) evo_open="" ;; esac
    continue
  fi
  # A --format=dotenv-export dump spells each line `export KEY=value`. The split below
  # would read the prefix as the beginning of the key and publish nothing at all, so the
  # leading prefix and the whitespace after it come off here. Exactly one whitespace
  # character has to follow the word, which is what keeps a key that merely starts with it
  # (exportED=v) intact. The run after the word is trimmed by expansion and not by a
  # pattern because bash has no ksh repetition operator in a case arm: a pattern written
  # with one (##) compiles, matches nothing, and leaves the prefix on the line.
  evo_trim="$evo_line"
  case "$evo_trim" in
    export[[:space:]]*)
      evo_trim="$${evo_trim#export}"
      evo_trim="$${evo_trim#"$${evo_trim%%[![:space:]]*}"}"
      ;;
  esac
  evo_key="$${evo_trim%%=*}"
  evo_val="$${evo_trim#*=}"
  # A key the shell could not name, or one with no '=' at all, is not a secret worth
  # publishing; a blank line and a comment fall out here as well. The leading-character
  # test is separate because the class above only constrains characters: a vault key like
  # 1BAD=x clears it and would be published as export 1BAD='x', which bash rejects as an
  # identifier and every reader of the file then loses every key after that line.
  case "$evo_key" in
    '' | [0-9]* | *[!A-Za-z0-9_]*) continue ;;
  esac
  [ "$evo_val" != "$evo_trim" ] || continue
  # The vault's own credential set stays out of the file whatever shape it arrives in.
  case "$evo_key" in INFISICAL_*) continue ;; esac
  # Shape alone is not safety: the arm above lets any spellable name through, and BASH_ENV
  # is spellable. Same boundary, read from the one list above. The comparison is by
  # normalised case, because bash honours BASH_ENV, bash_env and Bash_Env alike once the
  # file is sourced. It runs after the shape arm on purpose: only a key that arm cleared
  # is free of pattern characters, which is what makes it safe to match as a pattern here.
  evo_up="$${evo_key^^}"
  case " $evo_deny " in
    *" $evo_up "*) continue ;;
  esac
  # A value that opens a single quote without closing it on the same line is a multi-line
  # secret (a PEM, say). Its continuation would be republished as keys of its own, which
  # silently corrupts the value and publishes secret bytes as names, so the whole entry
  # goes. The note is once per boot and names neither the key nor the value.
  case "$evo_val" in
    "'"*)
      evo_tail="$${evo_val#\'}"
      case "$evo_tail" in
        *"'"*) ;;
        *)
          evo_open="yes"
          if [ -z "$evo_multiline" ]; then
            evo_multiline="yes"
            echo "infisical: skipped a secret whose value spans more than one line; only single-line secrets are published." >&2
          fi
          continue
          ;;
      esac
      ;;
  esac
  case "$evo_val" in
    "'"*"'")
      evo_val="$${evo_val#\'}"
      evo_val="$${evo_val%\'}"
      ;;
  esac
  evo_esc="$${evo_val//"$evo_sq"/$evo_wrap}"
  printf "export %s='%s'\n" "$evo_key" "$evo_esc" >>"$evo_out"
done <"$evo_dump"
# Belt over braces. The filter in the loop is what keeps those names out of the file; this
# second pass is what keeps them out if that filter ever regresses or someone edits the
# staged file by hand. It reads the staged bytes once, against one alternation built from
# the same variable the filter reads so the list has exactly one spelling in the body, and
# it refuses the publish rather than correcting it. The agent.env a previous boot wrote
# then stays as it is, which is the point: a poisoned file is what this arm exists to stop,
# and no boot has ever written one past the filter. The obvious shape for this belt was an
# `unset` line appended to agent.env, and it is the wrong one -- the file is sourced by
# every shell this workspace starts, so `unset PATH HOME IFS` would strip those names from
# the shell that sourced it and from every process it then launches. A refusal costs a
# refresh; that would cost the workspace.
evo_alt=""
for evo_name in $evo_deny; do
  if [ -z "$evo_alt" ]; then
    evo_alt="$evo_name"
  else
    evo_alt="$evo_alt|$evo_name"
  fi
done
if grep -qiE "^[[:space:]]*(export[[:space:]]+)?($evo_alt)[[:space:]]*=" "$evo_out" 2>/dev/null; then
  echo "infisical: refused to publish $evo_dir/agent.env; the staged file names a shell-control variable. Nothing was written and no secret value is shown." >&2
  rm -f "$evo_out" >/dev/null 2>&1 || true
  evo_out=""
  exit 0
fi
chmod 600 "$evo_out" >/dev/null 2>&1 || true
if mv -f "$evo_out" "$evo_agent" >/dev/null 2>&1; then
  chmod 600 "$evo_agent" >/dev/null 2>&1 || true
  # A count, never a value: the log says how many keys landed, not which ones. It counts
  # what the publish loop actually wrote, so it cannot report a key the file lacks.
  evo_count="$(grep -c '^export ' "$evo_agent" 2>/dev/null || true)"
  [ -n "$evo_count" ] || evo_count=0
  echo "infisical: loaded $evo_count secret keys into $evo_dir/agent.env"
else
  echo "infisical: could not publish $evo_dir/agent.env; the workspace boots without the vault." >&2
fi
exit 0
