#!/bin/bash
# tftpl: coder_script body; $${shell} stays a shell var; $${terraform_var} is passed from main.tf.
set -u

# The library arrives as a map value and Terraform does not re-interpolate one, so its
# own dollar-brace text lands verbatim; a comment here spells that token in words too.
${boot_log_lib}

boot_begin "dind bootstrap" 2

boot_stage 1 "the docker CLI"
if ! command -v docker >/dev/null 2>&1; then
  boot_err "the docker CLI is missing - this template needs the golden image (bazelisk run //scripts:build-dev-image), which ships the client"
  boot_summary
  exit 1
fi
boot_ok "the docker CLI is present"

# Explicit -H rather than relying on the inherited DOCKER_HOST, so the log
# line below always names the endpoint that was actually probed.
boot_stage 2 "the sidecar daemon answering"
boot_phase "waiting up to 120s for the daemon at ${dind_host}"
start="$(date +%s)"
deadline=$(( start + 120 ))
next=15
while ! docker -H ${dind_host} version >/dev/null 2>&1; do
  now="$(date +%s)"
  if [ "$now" -ge "$deadline" ]; then
    boot_err "the DinD daemon at ${dind_host} never answered 'docker version' within 120s"
    boot_err "from the stack host, inspect the sidecar and its logs: docker ps -a --filter name=${dind_sidecar}"
    boot_summary
    exit 1
  fi
  # One progress line per 15s of waiting, not one per 2s attempt: the whole agent
  # log stream shares one capped budget.
  waited=$(( now - start ))
  if [ "$waited" -ge "$next" ]; then
    boot_phase "the DinD daemon at ${dind_host} has not answered in $waited seconds"
    next=$(( next + 15 ))
  fi
  sleep 2
done
boot_ok "DinD daemon is answering at ${dind_host}"
boot_summary
