# managed-by: evo-t1-coder-stack
#
# ~/.grok/config.toml for the EVO-T1 Coder workspace.
#
# This file is written by templates/devcontainer/grok-config.toml.tftpl in
# evo-t1-coder-stack repo and is refreshed on workspace start ONLY while the
# marker comment above or the __evoT1Stack key below is present (or the file
# is missing). To take permanent ownership, delete BOTH of them: the
# managed-by marker on the first line and the __evoT1Stack key further down.
# The key is there because the CLI's own settings writer (for example
# `grok mcp add`) deletes every comment line, so the marker comment can vanish
# on its own while the key survives. To go back to stack-managed, delete the
# file and start the workspace again.
#
# Inference goes through the LiteLLM proxy; the key is never stored here, it
# arrives as the LITELLM_API_KEY environment variable set by coder_agent.env.
#
# Two of the create form's per-workspace knobs reach this file: the default model
# (the "Grok default model" dropdown) fills [models] default below, and anything
# typed into "Grok config extras" is appended verbatim under the comment header at
# the very end of the file. Both are per-workspace, so with the Grok profile set to
# "private" two workspaces can legitimately disagree about either one — on a
# "shared" profile this single file serves every workspace its owner owns, and the
# one started last re-renders it for all of them.

# Ownership marker: the stack owns this file while either this key or the
# managed-by comment above is present. Unlike that comment, this top-level key
# survives the CLI rewriting the file, so ownership cannot be revoked
# silently. Delete it together with the marker comment to hand the file over.
# Never put it inside a template gate.
__evoT1Stack = true

# Grok's native web_search is PARKED, and the gated [mcp_servers.searxng] stdio
# server below is the search lane. Measured 2026-10-25: no model transport this
# box ships can serve the native tool. The Spark lane refuses the request
# before anything is fetched, and LiteLLM answers "tools of type 'web_search'
# are not supported: this server runs function tools only".
# supports_backend_search = false cannot route around it, because the
# client-side path still hands the model alias a web_search-typed tool, which
# is the exact shape the endpoint rejects. "# Research lanes" in
# ~/.grok/AGENTS.md sends the agent to the searxng tools by default. Set this
# key to false and start a new session only once the agent has an endpoint that
# really serves the tool.
disable_web_search = true

[models]
# `agent` (Spark vLLM) is the alias the agent loop needs: it returns a real
# tool_calls array on this runtime. The Arc (IPEX-LLM Ollama) aliases below
# answer tool calls as plain text with finish_reason "stop", which stops the
# loop after one turn — they stay usable as completion-style fallbacks.
# Each key here names the model that serves that role. The CLI's own default
# for the web_search role is a hosted model, so all three roles below stay on
# the local Spark lane, and supports_backend_search = false on every lane keeps
# the proxy from ever being asked for a hosted search tool. The web_search role
# stays filled so that re-enabling native search is a one-key flip at the top of
# this file; while disable_web_search = true nothing dials it, and the gated
# [mcp_servers.searxng] server below answers instead.
default = "${grok_default_model}"
session_summary = "agent"
image_description = "agent"
web_search = "agent"

# Thinking level a new session starts on. The Spark lane (Qwen3.8-Flash-Next)
# answers low / medium / xhigh — there is no `high` on this runtime, which is
# why the [model."agent"] block below advertises exactly those three. A request
# can still pick another level; the agent-low / agent-medium / agent-xhigh
# aliases below pin one in LiteLLM instead, for callers that cannot send one.
default_reasoning_effort = "xhigh"

# Global streaming-idle deadline for every model that does not pin its own
# value below: the compaction summary, the web_search digest and the image
# description all ride this lane, and on a busy Spark a large compaction
# summary can run far past the CLI's 600 s default. 1200 s matches the
# per-model values below and the proxy's request_timeout, so one 20-minute
# deadline covers the whole client-to-backend chain and long compactions are
# not cut off in the middle.
inference_idle_timeout_secs = 1200

# How this workspace announces itself to the LiteLLM proxy: one key per
# workspace pins every session and subagent call to one healthy Spark box
# (session-affinity, refreshed per request, 1 h idle TTL; an unhealthy or
# expired pin falls back to the least-busy picker). grok sends it verbatim, so
# it must stay static per workspace. Shared profile is one file per USER, so
# the last-booted workspace's key serves all of that user's workspaces (one
# pin for the fleet); private gives each workspace its own. Cline/Roo editor
# traffic carries no header (their settings have no custom-header field) and
# floats; per-model or grok_config_extra extra_headers win per key — keep it.
extra_headers = { "x-litellm-session-id" = "${workspace_affinity_key}" }

# --- DGX Spark (vLLM): tool-calling-capable, used for the agent loop --------
[model."agent"]
model = "agent"
base_url = "${litellm_url}"
name = "Agent (DGX Spark vLLM)"
description = "Primary agent model; emits native tool_calls"
api_backend = "chat_completions"
env_key = "LITELLM_API_KEY"
context_window = 262144
max_completion_tokens = 32768
temperature = 1.0
top_p = 0.95
supports_backend_search = false
stream_tool_calls = true
max_retries = 1
inference_idle_timeout_secs = 1200

# The three levels this runtime actually answers. `high` is deliberately
# absent: Qwen3.8-Flash-Next does not support it, and advertising it puts a
# level in the picker that the Spark lane fails or silently downgrades.
[[model."agent".reasoning_efforts]]
id = "low"
value = "low"
label = "Low"
description = "Fastest responses. Best for simple tasks."
default = false

[[model."agent".reasoning_efforts]]
id = "medium"
value = "medium"
label = "Medium"
description = "Strong quality with a faster turnaround."
default = false

[[model."agent".reasoning_efforts]]
id = "xhigh"
value = "xhigh"
label = "Extra High"
description = "Maximum reasoning for the hardest tasks."
default = true

# Same Spark lane with the thinking level baked into the LiteLLM alias instead
# of carried per request: for callers that have no reasoning-effort field at
# all (the editor extensions, a curl in a script). Everything else — tool
# calling, timeouts, the session-affinity header inherited from [models] —
# matches [model."agent"] above. supports_reasoning_effort stays false here on
# purpose: the proxy decides the level, so the client has nothing to override.
[model."agent-low"]
model = "agent-low"
base_url = "${litellm_url}"
name = "Agent (DGX Spark vLLM, thinking low)"
description = "Spark agent lane; thinking baked to low in LiteLLM"
api_backend = "chat_completions"
env_key = "LITELLM_API_KEY"
context_window = 262144
max_completion_tokens = 32768
temperature = 1.0
top_p = 0.95
supports_backend_search = false
supports_reasoning_effort = false
stream_tool_calls = true
max_retries = 1
inference_idle_timeout_secs = 1200

[model."agent-medium"]
model = "agent-medium"
base_url = "${litellm_url}"
name = "Agent (DGX Spark vLLM, thinking medium)"
description = "Spark agent lane; thinking baked to medium in LiteLLM"
api_backend = "chat_completions"
env_key = "LITELLM_API_KEY"
context_window = 262144
max_completion_tokens = 32768
temperature = 1.0
top_p = 0.95
supports_backend_search = false
supports_reasoning_effort = false
stream_tool_calls = true
max_retries = 1
inference_idle_timeout_secs = 1200

[model."agent-xhigh"]
model = "agent-xhigh"
base_url = "${litellm_url}"
name = "Agent (DGX Spark vLLM, thinking extra high)"
description = "Spark agent lane; thinking baked to xhigh in LiteLLM"
api_backend = "chat_completions"
env_key = "LITELLM_API_KEY"
context_window = 262144
max_completion_tokens = 32768
temperature = 1.0
top_p = 0.95
supports_backend_search = false
supports_reasoning_effort = false
stream_tool_calls = true
max_retries = 1
inference_idle_timeout_secs = 1200

# --- Arc 140T (IPEX-LLM Ollama): completion-style fallbacks -----------------
# Measured against the running stack: these endpoints answer tool requests as
# plain text with finish_reason "stop" and no tool_calls array, so Grok's
# agent loop cannot drive them. Keep them for chat/summarisation and for
# explicit -m selection, not as the default.

[model."coder"]
model = "coder"
base_url = "${litellm_url}"
name = "Qwen2.5-Coder 32B (Arc iGPU)"
description = "Arc fallback; completion-style on this runtime (no tool_calls)"
api_backend = "chat_completions"
env_key = "LITELLM_API_KEY"
context_window = 32768
max_completion_tokens = 4096
temperature = 1.0
top_p = 0.95
supports_backend_search = false
supports_reasoning_effort = false
stream_tool_calls = true
max_retries = 1
inference_idle_timeout_secs = 1200

[model."coder-fast"]
model = "coder-fast"
base_url = "${litellm_url}"
name = "Qwen2.5-Coder 14B (Arc iGPU)"
description = "Arc fallback; completion-style on this runtime (no tool_calls)"
api_backend = "chat_completions"
env_key = "LITELLM_API_KEY"
context_window = 32768
max_completion_tokens = 4096
temperature = 1.0
top_p = 0.95
supports_backend_search = false
supports_reasoning_effort = false
stream_tool_calls = true
max_retries = 1
inference_idle_timeout_secs = 1200

[model."chat"]
model = "chat"
base_url = "${litellm_url}"
name = "Qwen2.5 7B (Arc iGPU)"
description = "Arc chat fallback; returns real tool_calls on this runtime (measured)"
api_backend = "chat_completions"
env_key = "LITELLM_API_KEY"
context_window = 32768
max_completion_tokens = 2048
temperature = 1.0
top_p = 0.95
supports_backend_search = false
supports_reasoning_effort = false
stream_tool_calls = true
max_retries = 1
inference_idle_timeout_secs = 1200

[features]
telemetry = false
# Offline-first box: the tool stays available for the rare reachable docs site.
web_fetch = true

[toolset.web_fetch]
# SSRF fail-closed: loopback only when explicitly enabled, private ranges and
# cloud metadata stay blocked.
allow_local = false

[session]
auto_compact_threshold_percent = 75

# Three Spark boxes behind one model lane, and LiteLLM's "least-busy" routing
# spreads the fan-out across them, so keep the fan-out modest and let
# limit_behavior "queue" hold the overflow instead of failing the spawn.
[subagents]
enabled = true
max_concurrent = 4
max_depth = 1
limit_behavior = "queue"

[subagents.models]
explore = "agent"
plan = "agent"

# MCP servers: three gated entries ship by default, each behind its own boolean
# that defaults to true. search_mcp renders the searxng stdio server, which is
# THE search lane (native web_search is parked at the top of this file);
# context7_mcp renders the cached context7 stdio server, which answers library
# and API questions; github_mcp renders the hosted GitHub HTTP server. An agent
# that needs the web or a docs page reaches these, and the "# Research lanes"
# section of ~/.grok/AGENTS.md sends it there by default.
#
# Five more offline stdio servers (filesystem, memory, sequential-thinking, git
# and time) stay installed in the golden image and stay undeclared here on
# purpose: every session trace collected on this machine called none of their
# tools, while a declared-but-unused server still spends each session's start on
# its handshake and keeps its tool schemas in every context. Declaring one is a
# one-block edit here (or in the create form's config-extras field); check a
# stubborn one with `grok mcp doctor <name>`.
#
# sentry, postgres and fetch are absent for a different reason: each needs
# outbound network or a credential this workspace does not carry (OAuth to
# mcp.sentry.dev, a live DSN, a PySocks/egress proxy).
#
# Each gate ships unless a push passes --var <name>=false. Park one by setting
# its .env key (SEARCH_MCP, CONTEXT7_MCP, GITHUB_MCP) to false and re-pushing:
# push-template.sh relays it to both template pushes. context7 is the lane with
# the outside dependency: it wants a usable CONTEXT7_API_KEY in the agent
# environment plus outbound network on the first fetch, and later identical
# lookups inside the TTL come from its local SQLite cache instead.
#
# What is left out is simply not defined here, so there is nothing to disable;
# if you add one later and want it parked rather than deleted, list its name
# in `disabled_mcp_servers = ["..."]` (top-level key, string array).

%{if github_mcp~}

# Hosted GitHub API MCP over HTTPS: no local process and no package to prefetch, but
# it needs outbound TLS and a bearer token — the exception the note above makes.
# Rendered only when this template is pushed with github_mcp = true, and that
# template variable defaults to true, so the block ships unless a push passes
# --var github_mcp=false (or sets GITHUB_MCP=false in .env, which
# push-template.sh relays); with it off the gate below emits nothing at all, so
# the rendered file is what it was before this entry existed. There is no token
# to gate it on any more: the credential comes from the Coder External Auth
# provider (id github by default), so a session whose owner connected no GitHub
# account has no GH_TOKEN in its environment and just fails this server's
# handshake.
# The header below escapes its dollar signs (doubled), so the rendered file keeps
# that reference literally and the CLI expands it from the agent environment at
# run time. Written with single dollars it would be a templatefile interpolation,
# resolved (or rejected) at render time — and resolving it would need the token
# itself in the render map, which is exactly what stays out.
[mcp_servers.github]
url = "https://api.githubcopilot.com/mcp/"
enabled = true
headers = { Authorization = "Bearer $${GH_TOKEN}" }

%{endif~}
%{if context7_mcp~}
# Cached Context7 MCP: official @upstash/context7-mcp wrapped by mcp-cache-proxy
# for local SQLite caching of resolve-library-id / query-docs results.
# Rendered only when context7_mcp is on, and that template variable defaults to
# true, so this block ships unless a push passes --var context7_mcp=false (or
# sets CONTEXT7_MCP=false in .env, which push-template.sh relays). The key is
# optional: an empty CONTEXT7_API_KEY still renders the block, and that server
# then fails its handshake once per session. A real key needs outbound network
# on first fetch; later identical lookups within the TTL are served from the
# local SQLite cache under ~/.grok/mcp-cache-proxy/. The file only ever names
# the key; the CLI expands $${CONTEXT7_API_KEY} from the environment.
# Binaries are baked into the golden image; launching by absolute path keeps
# the first boot off the npm registry (npx would re-download).
[mcp_servers.context7]
command = "/opt/npm-global/bin/mcp-cache-proxy"
args = ["--config", "/home/coder/.grok/mcp-cache-proxy/config.json"]
enabled = true
startup_timeout_sec = 120
env = { CONTEXT7_API_KEY = "$${CONTEXT7_API_KEY}" }

%{endif~}

%{if search_mcp~}
# Rendered only when search_mcp is on, and that template variable defaults to
# true, so this block ships unless a push passes --var search_mcp=false (or sets
# SEARCH_MCP=false in .env, which push-template.sh relays). It wires the
# self-hosted SearXNG service as a stdio MCP server: this box's search lane, and
# the only one an agent gets by default.
#
# The binary is baked into the golden image (images/dev/Dockerfile installs
# searxng-mcp-server at the version pinned in images/dev/tool-versions.env,
# currently 0.5.1). Launching it by absolute path keeps the first boot offline:
# npx would look for the package in its cache or on the npm registry, and the
# image build clears that cache, so an `npx -y` launch means a fresh registry
# download on every new workspace before search works at all.
[mcp_servers.searxng]
command = "/opt/npm-global/bin/searxng-mcp-server"
enabled = true

# The one key this server reads. Its compiled-in default (http://localhost:8888)
# names nothing on this box, so the URL is always rendered: 8181 is the host
# port both compose stacks publish (docker-compose.yml maps STACK_SEARCH_PORT,
# default 8181, to the container's 8181), and push-template.sh derives this
# value from STACK_SEARCH_PORT, so a dev stack that remapped the port pushes a
# config that dials the port it actually has.
#
# Prove the route with `bazelisk run //scripts:search-check` (it reads the same
# SEARXNG_URL, which main.tf also puts in coder_agent's env) and the server's
# handshake with `grok mcp doctor searxng`. This is the search lane: native
# web_search is parked at the top of this file, so an agent that needs the web
# reaches these tools. Park this lane too with search_mcp off, and a session is
# left with no search tool at all.
env = { SEARXNG_URL = "${search_url}" }

%{endif~}

[mcp]
max_output_bytes = 40000

# Conservative defaults on purpose: no always-approve / yolo here — that is a
# per-user decision (`/settings`, or [ui] permission_mode). These denies only
# keep secrets and destructive rm out of the easy path. The startup render
# carries the CLI-owned tables ([cli], [ui], [marketplace]) over from the file
# it replaces, so an approval mode set in [ui] survives a re-render.
#
# The live dotenv file is blanket-blocked. Suffixed dotenv files are named one by
# one instead of blanket-blocked, because a deny rule cannot be overridden by an
# allow rule and `**/.env.*` also covers the committed, secret-free templates a
# repo ships (.env.sample, .env.example) -- blocking those stopped agents from
# maintaining the env key list, which is the file that keeps .env honest. Add any
# suffixed shape your projects carry secrets in; a name absent from this list is
# readable and editable, so prefer the plain `.env` for anything secret.
[permission]
deny = [
  "Bash(rm -rf *)",
  "Read(**/.env)",
  "Edit(**/.env)",
  "Read(**/.env.local)",
  "Edit(**/.env.local)",
  "Read(**/.env.*.local)",
  "Edit(**/.env.*.local)",
  "Read(**/.env.production)",
  "Edit(**/.env.production)",
  "Read(**/.env.prod)",
  "Edit(**/.env.prod)",
  "Read(**/.env.staging)",
  "Edit(**/.env.staging)",
  "Read(**/.env.development)",
  "Edit(**/.env.development)",
]

%{if grok_config_extra != ""~}
# --- per-workspace additions (create form: Grok config extras) ---
${grok_config_extra}
%{endif~}
