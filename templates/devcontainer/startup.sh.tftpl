#!/bin/bash
# Coder workspace startup — EVO-T1 stack, devcontainer template.
#
# Idempotent: safe to re-run on every workspace start.
#   1. installs tmux (if missing)
#   1b. seeds ~/.tmux.conf (only while this stack owns the file), so the
#       workspace's tmux terminals scroll and copy like a native terminal
#   2. installs the Grok Build CLI (if missing)
#   3. puts ~/.grok/bin on PATH (login shells + this process)
#   4. writes the two terminal-profile helpers (the "Grok Build" one and the
#      plain tmux reattach wrapper the default profile uses), so a closed tab
#      rejoins its session instead of losing the processes running in it
#   5. seeds the Coder Agents context (AGENTS.md + skill under ~/.coder, with
#      ~/.agents twins for the Grok CLI), only for files that are absent
#   5b. seeds the shared code-server User settings if that file is absent, then
#       links the editor at it (one file per owner, not re-merged each start)
#   6. writes ~/.grok/config.toml (only while this stack owns the file): the
#      model catalog with this workspace's default model alias, Grok's native
#      web_search on by default, the gated searxng MCP entry (on by default as
#      the fallback), and anything the create form put in "Grok config extras"
#   7. seeds the GitHub credential plumbing (git's github.com credential helper),
#      and only when a GitHub token was supplied and both git and gh exist
#   8. clones the repository named by the create form onto the shared
#      devcontainer bind — this is what coder_devcontainer's workspace_folder
#      points at, so it has to exist before the agent builds the dev container —
#      and says so out loud when the clone carries no devcontainer configuration
#      for the CLI to build
#   8b. puts a private notes.md in every clone folder on that bind, restoring it
#       from the shared profile volume and keeping that volume up to date
#
# ~/.grok is not necessarily this workspace's own directory. In "shared" mode
# (main.tf's grok_profile_mode, and the default) the container mounts the
# workspace owner's shared per-user Docker volume read-write at /home/coder/.grok,
# nested inside that workspace's own /home/coder volume, so the terminal helpers,
# config.toml and memory-v2/ written below are the same files
# every other workspace this user owns reads and writes, they survive a rebuild,
# and config.toml stays one last-boot-wins file for all of them: the workspace
# started last re-renders it for everyone, which is the only way this template's
# per-workspace model alias and config extras can be overwritten. "private" mode
# adds no such mount, so ~/.grok is this workspace's own directory on its own
# home volume and dies with the workspace. Either way the mount is on the
# workspace container only — a dev container the repo builds on the sidecar keeps
# its own home. What none of this changes is ownership of config.toml: the
# managed-by: evo-t1-coder-stack marker still decides it, and the file is still
# re-rendered on every start while that marker line is present.
#
# Every stage 5 onward is best-effort: an offline first boot must still leave a
# working terminal, and a repository that cannot be cloned must still leave a
# workspace someone can fix, so nothing here may abort the script. A missing or
# half-cloned folder is not silent — coder_devcontainer fails on its own with a
# visible error naming the folder it looked in, and the clone stage prints its own
# warning first when a clone arrives with no devcontainer configuration in it.
#
# Note: this file is rendered by Terraform templatefile(); shell variables are
# written with a doubled dollar sign ($name or $${name}; the braced form is only
# safe when escaped this way) so the rendered script keeps them. The only
# interpolations Terraform has to resolve here are the fourteen variables main.tf
# passes into this script: grok_build_agents, grok_config, repo_url,
# additional_repos, dc_dir, build_devcontainer, vscode_settings, notes_setup,
# tmux_conf, grok_build_terminal, vscode_terminal_tmux,
# grok_build_delegation_skill, coder_agents and mcp_cache_proxy.
# grok_config arrives already rendered from grok-config.toml.tftpl, whose own
# keys are litellm_url, grok_default_model, workspace_affinity_key,
# grok_config_extra, github_mcp, search_mcp, search_url and context7_mcp - the
# three boolean keys only gate text (github_mcp, search_mcp and context7_mcp
# each decide whether their [mcp_servers.*] block appears; search_url supplies
# the URL the searxng block
# dials),
# the affinity key is a per-workspace routing hint (a workspace UUID, not a
# secret), and the token's own bytes never appear in the result. The
# GH_TOKEN and CONTEXT7_API_KEY references that config template does emit are
# dollar-escaped, so they
# stay literal text inside the quoted heredoc below
# and reach config.toml unchanged, for the CLI to expand from the environment.

set -u

SUDO=""
if [ "$(id -u)" != "0" ] && command -v sudo >/dev/null 2>&1; then
  SUDO="sudo"
fi

# Extra named volumes Docker creates empty (vscode-settings-<owner-id>, and
# grok-profile-<owner-id> in shared mode) are root:root 755. The agent runs as
# coder, so a first-boot write into them is Permission denied unless they
# belong to whoever owns $HOME first. $SUDO is empty when this script is
# already root, and sudo on the golden image (NOPASSWD).
home_owner="$(stat -Lc '%u:%g' "$HOME" 2>/dev/null || true)"
[ "$home_owner" = "0:0" ] && home_owner=""
if [ -z "$home_owner" ] && id coder >/dev/null 2>&1; then
  home_owner="$(id -u coder):$(id -g coder)"
fi
if [ -n "$home_owner" ]; then
  mkdir -p "$HOME/.shared/vscode" "$HOME/.grok" 2>/dev/null || true
  $SUDO chown -R "$home_owner" "$HOME/.shared" "$HOME/.grok" 2>/dev/null || true
fi

# --- tmux -------------------------------------------------------------------
if ! command -v tmux >/dev/null 2>&1; then
  $SUDO apt-get update -y >/dev/null
  $SUDO DEBIAN_FRONTEND=noninteractive apt-get install -y tmux >/dev/null
fi

# --- tmux configuration -----------------------------------------------------
# Seeded before the terminal-profile helpers, so it is in place before any
# `tmux new-session -A` can run: tmux reads this file once at server start and
# every terminal (plus an SSH client that reattaches) shares that one server.
# `mouse on` hands the wheel and the drag to tmux; `set-clipboard on` is what
# carries a tmux copy out to the client's clipboard over OSC 52, which a client
# that blocks OSC 52 (iTerm2 by default) keeps inside tmux's own buffer.
#
# The marker line is the ownership flag, on the same contract as
# ~/.grok/config.toml: while it is present this stage rewrites the file on
# every start, and editing the file away from the marker hands it to the user
# for good.
if [ ! -f "$HOME/.tmux.conf" ] \
   || grep -qs 'managed-by: evo-t1-coder-stack' "$HOME/.tmux.conf"; then
  cat >"$HOME/.tmux.conf" <<'TMUX_CONF_EOF'
${tmux_conf}
TMUX_CONF_EOF
else
  echo "WARNING: $HOME/.tmux.conf carries no evo-t1-coder-stack marker -" \
    "leaving it alone. Remove the marker line to keep your own tmux config." >&2
fi

# --- Grok Build CLI ----------------------------------------------------------
# A PATH probe (`command -v`), not `[ -x ~/.grok/bin/grok ]`: the golden image
# bakes the CLI into /usr/local/bin, so on a golden-image boot this probe
# answers YES and nothing downloads. The download is the fallback for the
# `ubuntu:24.04` image option and for a home volume that never received a CLI,
# and it is bounded + retried on purpose: one unbounded attempt burned a whole
# start on a single stalled connection to x.ai ("curl: (28) SSL connection
# timeout") and booted the workspace without a CLI anyway.
#
# GROK_FRESH_INSTALL records that an install COMPLETED this boot. The
# installer writes its own ~/.grok/config.toml (a `[cli] installer = ...`
# stub), indistinguishable from a user's config; the managed-config guard
# below may only treat that stub as stack-owned on a completed install — a
# download that failed must never wipe a user-owned config in its place.
GROK_FRESH_INSTALL=0
if ! command -v grok >/dev/null 2>&1; then
  grok_installer="$(mktemp 2>/dev/null || true)"
  if [ -n "$grok_installer" ] \
     && curl -fsSL --http1.1 --retry 5 --retry-all-errors --retry-delay 2 --connect-timeout 15 --max-time 180 \
          -o "$grok_installer" https://x.ai/cli/install.sh \
     && bash "$grok_installer" >/dev/null; then
    # `command -v` again, not `[ -x ... ]`: the probe must see the CLI
    # wherever the installer put it, and a failed download must leave the
    # flag at 0.
    command -v grok >/dev/null 2>&1 && GROK_FRESH_INSTALL=1
  fi
  # $${...} (doubled dollar) keeps this a shell expansion, not a Terraform
  # interpolation — see the note at the top of this file.
  rm -f "$${grok_installer:-}"
fi
if ! grep -qs 'grok/bin' "$HOME/.bashrc"; then
  printf '\n# Grok Build CLI\nexport PATH="$HOME/.grok/bin:$PATH"\n' >>"$HOME/.bashrc"
fi
export PATH="$HOME/.grok/bin:$PATH"

# --- terminal-profile helpers -------------------------------------------------
# Both profiles below launch through a per-folder tmux session, so a closed tab
# never kills what was running in it.
#
# VS Code shows the profile under the settings key "Grok Build"; this helper
# resumes (or starts) one tmux session per repository root:
#   grok-build-<folder>-<hash>
# then runs `grok --cwd <that root>` inside it. The root, not $PWD, keys the
# session and decides where the CLI starts, so a tab opened in a subdirectory
# still rejoins the session its repository owns. The identical helper body lives
# in templates/workspace's startup.sh.tftpl — keep the two copies byte-identical.
mkdir -p "$HOME/.grok/bin"
cat >"$HOME/.grok/bin/grok-build-terminal" <<'GROK_BUILD_HELPER'
${grok_build_terminal}
GROK_BUILD_HELPER
chmod +x "$HOME/.grok/bin/grok-build-terminal"

# The default terminal (and the Grok Build profile) join one tmux session per
# folder instead of starting a throwaway one, so a closed tab or reloaded page
# never kills running processes and another terminal (or an SSH client) can
# rejoin the same session. No tmux (offline first boot): plain login shell.
cat >"$HOME/.grok/bin/vscode-terminal-tmux" <<'TMUX_ATTACH_HELPER'
${vscode_terminal_tmux}
TMUX_ATTACH_HELPER
chmod +x "$HOME/.grok/bin/vscode-terminal-tmux"

# --- Coder Agents context (skill + instructions) ------------------------------
# Seeds the two files the Coder Agents chat agent discovers through its
# DEFAULT paths (verified against the v2.36.6 agent binary + its
# agentcontextconfig source): the instruction file AGENTS.md under ~/.coder
# and skills under ~/.coder/skills, plus a working-dir-relative
# .agents/skills. main.tf therefore sets NO CODER_AGENT_EXP_SKILLS_DIRS /
# CODER_AGENT_EXP_INSTRUCTIONS_* keys: those REPLACE the default lists
# rather than appending, and the seeded copies now sit exactly where the
# (unmodified) defaults point. Chat itself is on by default in 2.36.6 — no
# experiment name and no entitlement gates it.
# Working-dir resolution here: with the dev-container toggle OFF the agent's
# working dir is /home/coder, so .agents/skills resolves to
# /home/coder/.agents/skills exactly as in templates/workspace; with the toggle ON
# the dev container's own working dir is the cloned folder under
# /srv/coder-devcontainers/..., and that folder ships no skill tree, so the
# ~/.coder copies remain the live source either way. Each file also gets a
# twin in the ~/.agents tree, because the `execute`-lane delegation this
# stack teaches starts `grok -p` inside the workspace, and that CLI reads
# the ~/.agents convention (the chat agent would only take the ~/.coder
# copies anyway — skill dedupe is first-match-wins, home scope first).
# Written or copied only if ABSENT — a hand-edited copy is user-owned and
# this stage re-runs harmlessly. The managed-by: evo-t1-coder-stack marker
# marks every stack-seeded file (in SKILL.md it sits after the `---`
# frontmatter because the skill parser needs `---` on line 1 and silently
# drops a skill whose first line is anything else; injected instruction
# content gets HTML comments stripped anyway, so there the marker is pure
# provenance). Best-effort like the stages below it: a read-only or missing
# $HOME changes nothing observable. The files live on the workspace's own
# /home/coder home volume — this stage neither needs nor disturbs the ~/.grok
# profile mount.
if [ ! -f "$HOME/.coder/skills/grok-build-delegation/SKILL.md" ]; then
  mkdir -p "$HOME/.coder/skills/grok-build-delegation" 2>/dev/null
  cat >"$HOME/.coder/skills/grok-build-delegation/SKILL.md" <<'AGENT_SKILL_MD_EOF'
${grok_build_delegation_skill}
AGENT_SKILL_MD_EOF
fi

# The ~/.agents twin: copied only while absent, and only from the managed
# ~/.coder copy, so a hand-placed skill there is never overwritten (and the
# chat agent's first-match-wins skill dedupe keeps exactly one live source).
if [ ! -f "$HOME/.agents/skills/grok-build-delegation/SKILL.md" ]; then
  mkdir -p "$HOME/.agents/skills/grok-build-delegation" 2>/dev/null
  cp "$HOME/.coder/skills/grok-build-delegation/SKILL.md" \
    "$HOME/.agents/skills/grok-build-delegation/SKILL.md" 2>/dev/null
fi

if [ ! -f "$HOME/.coder/AGENTS.md" ]; then
  cat >"$HOME/.coder/AGENTS.md" <<'AGENT_INSTR_MD_EOF'
${coder_agents}
AGENT_INSTR_MD_EOF
fi

# The ~/.agents twin, same rule as the skill twin above (copied only while
# absent; the CLI-side spelling of this file keeps its INSTRUCTIONS.md name
# because that is the name the ~/.agents convention was seeded under).
if [ ! -f "$HOME/.agents/INSTRUCTIONS.md" ]; then
  cp "$HOME/.coder/AGENTS.md" "$HOME/.agents/INSTRUCTIONS.md" 2>/dev/null
fi

# --- Grok Build orchestration protocol ----------------------------------------
# Seeds the parent-orchestrator / conflict-gate protocol into ~/.grok/AGENTS.md
# so every Grok Build session in the workspace follows it. The text arrives
# interpolated: main.tf reads GROK_BUILD_AGENTS.md (the stack keeps one copy
# in templates/common/, and the push stages it into this template's pushed
# copy) and hands its text to the heredoc below, which copies it in, renamed.
#
# The marker line in the payload is the ownership flag, on the same contract as
# ~/.grok/config.toml: while it is present this stage rewrites the file on every
# start, so every Grok Build session follows the protocol this template shipped.
# Deleting the marker (or the file's marker line) hands the file to the user for
# good, and a hand-edited, marker-free copy is never touched again.
if [ ! -f "$HOME/.grok/AGENTS.md" ] \
   || grep -qs 'managed-by: evo-t1-coder-stack' "$HOME/.grok/AGENTS.md"; then
  mkdir -p "$HOME/.grok" 2>/dev/null
  cat >"$HOME/.grok/AGENTS.md" <<'GROK_AGENTS_EOF'
${grok_build_agents}
GROK_AGENTS_EOF
fi

# --- Private per-repo notes ---------------------------------------------------
# The library behind each clone's notes.md. Unlike the seed above it is rewritten
# on every start: it is stack-owned code, and the copy on the shared ~/.grok
# volume must be the one this template shipped. main.tf reads
# templates/common/notes-setup.sh and hands the text to the heredoc below; the
# clone stage further down calls notes_materialize with it. The live file is a
# regular file on the clone bind rather than a link into ~/.grok, because the dev
# container built on the sidecar mounts that bind and has its own ~/.grok.
#
# Written beside its target and moved in: two of this owner's workspaces can boot
# at once against the one shared volume, and a sibling must never source a
# half-written library.
mkdir -p "$HOME/.grok" 2>/dev/null || true
notes_lib="$HOME/.grok/notes-setup.sh"
notes_lib_tmp="$(mktemp "$notes_lib.XXXXXX" 2>/dev/null)" || notes_lib_tmp="$notes_lib.$$"
if cat >"$notes_lib_tmp" <<'NOTES_SETUP_EOF'
${notes_setup}
NOTES_SETUP_EOF
then
  # mktemp makes 0600 and mv keeps that mode, so the temp is opened up first:
  # the rename is the first moment $notes_lib exists for anyone to source.
  chmod 0644 "$notes_lib_tmp" 2>/dev/null || true
  mv -f "$notes_lib_tmp" "$notes_lib" 2>/dev/null || true
fi
rm -f "$notes_lib_tmp" 2>/dev/null || true
# shellcheck disable=SC1090
. "$notes_lib" 2>/dev/null || true

# --- Editor settings ----------------------------------------------------------
# One settings.json per owner, on the vscode-settings-<owner-id> volume main.tf
# mounts at ~/.shared/vscode. The first boot that finds the file missing copies
# the rendered seed in; every later boot leaves it alone, so an edit survives
# and every workspace this owner has opens the same file. code-server reads
# ~/.local/share/code-server/User/settings.json, which is a symlink to that
# shared file. Nothing reads ~/.config/Code. The code-server module is not
# given a settings map in plain mode: its merge runs on every start and `mv`s
# over this symlink, which would fork a private copy and discard the sharing.
# A built dev container does not mount this volume (it has its own home on the
# sidecar); main.tf still hands the module the seed in that mode only.
#
# The seed in git has no API key. Cline and Roo read their key from
# settings.json and have no env_key field, so when LITELLM_API_KEY is set it
# is written into the seed once here and nowhere else. Delete
# ~/.shared/vscode/settings.json to reseed on the next start.
mkdir -p "$HOME/.shared/vscode" "$HOME/.local/share/code-server/User"
shared_settings="$HOME/.shared/vscode/settings.json"
user_settings="$HOME/.local/share/code-server/User/settings.json"
if [ ! -f "$shared_settings" ]; then
  if cat >"$shared_settings" <<'VSCODE_SETTINGS_EOF'
${vscode_settings}
VSCODE_SETTINGS_EOF
  then
    if [ -n "$${LITELLM_API_KEY:-}" ]; then
      tmp_settings="$(mktemp)"
      if command -v jq >/dev/null 2>&1 && jq --arg k "$LITELLM_API_KEY" \
        '.["cline.apiKey"]=$k | .["roo.openaiApiKey"]=$k' \
        "$shared_settings" >"$tmp_settings"; then
        mv "$tmp_settings" "$shared_settings"
      elif command -v python3 >/dev/null 2>&1; then
        rm -f "$tmp_settings"
        SETTINGS_PATH="$shared_settings" python3 -c 'import json, os; p = os.environ["SETTINGS_PATH"]; d = json.load(open(p)); k = os.environ["LITELLM_API_KEY"]; d["cline.apiKey"] = k; d["roo.openaiApiKey"] = k; json.dump(d, open(p, "w"), indent=2); open(p, "a").write("\n")'
      else
        rm -f "$tmp_settings"
      fi
    fi
    chmod 600 "$shared_settings" 2>/dev/null || true
  else
    echo "WARNING: could not write $shared_settings — the vscode-settings volume is not writable. Editor settings were not seeded." >&2
  fi
fi
# A regular file here is the old per-workspace copy. Keep it beside the link
# once, then point the editor at the shared file on every start so a workspace
# cannot drift off it. GNU ln -sfn replaces a symlink; it does not follow it.
if [ -e "$user_settings" ] && [ ! -L "$user_settings" ]; then
  mv "$user_settings" "$${user_settings}.pre-shared"
fi
ln -sfn "$shared_settings" "$user_settings"

# --- Grok Build config --------------------------------------------------------
# Rendered from grok-config.toml.tftpl: the LiteLLM model catalog (with this
# workspace's default model alias, from the create form), native web_search on
# by default, the MCP stack - the gated searxng search entry (on by default as
# the fallback, dialing the stack's own SearXNG) beside the gated github entry
# (off by default) - and the subagent sizing,
# with anything the create form put in "Grok config extras" appended at the end. Ownership is decided by the
# marker comment below: while it is present the stack re-renders the file on
# every start, and deleting that one line hands the file over to the user for
# good. On a shared profile volume that file usually already exists — another of
# the owner's workspaces wrote it — so the marker, not first-boot, is what
# decides, and it decides one file for every workspace that user owns: this
# workspace's alias and extras overwrite whatever the last boot wrote, for all of
# them. The heredoc below is quoted, so a `Bearer $${GH_TOKEN}` line the template
# emits travels through as literal text instead of being expanded here: the token
# itself stays in the environment and the file only names the key to read.
#
# A fresh CLI install always takes the file back. The installer creates a
# `[cli] installer = ...` stub before this stage runs, so without the first-boot
# flag a brand-new workspace would be left with an unconfigured CLI: the stub has
# no marker, the file exists, and the guard below would treat it as user-owned.
mkdir -p "$HOME/.grok/memory" "$HOME/.grok/logs/mcp" 2>/dev/null

if [ ! -f "$HOME/.grok/config.toml" ] \
   || [ "$GROK_FRESH_INSTALL" = "1" ] \
   || grep -qs 'managed-by: evo-t1-coder-stack' "$HOME/.grok/config.toml"; then
  # Re-rendering also happens on every start while the marker is present, so the
  # installer's (or the user's) [cli] table is carried over instead of wiped —
  # `cli.installer` picks the CLI's update path and is not something the stack owns.
  cli_block="$(mktemp 2>/dev/null || printf '/tmp/grok-cli-block.%s.toml' "$$")"
  if [ -f "$HOME/.grok/config.toml" ]; then
    awk '/^\[cli\][[:space:]]*$/{f=1;print;next} /^\[/{f=0} f' \
      "$HOME/.grok/config.toml" >"$cli_block" 2>/dev/null || : >"$cli_block"
  else
    : >"$cli_block"
  fi
  {
    cat <<'GROK_CONFIG_EOF'
${grok_config}
GROK_CONFIG_EOF
    if [ -s "$cli_block" ]; then
      printf '\n'
      cat "$cli_block"
    fi
  } >"$HOME/.grok/config.toml" || true
  rm -f "$cli_block"
  chmod 600 "$HOME/.grok/config.toml" 2>/dev/null || true
else
  # Same marker contract as ~/.tmux.conf above: no marker means the file is
  # user-owned and this stage keeps its hands off it - which is also why the
  # loss was silent. Say what it costs, because the render above is the only
  # place this workspace's model catalog and MCP lanes are ever written.
  echo "WARNING: $HOME/.grok/config.toml carries no stack marker - this" \
    "workspace is running a config the stack does not manage, so the default" \
    "MCP lanes and the model catalog never reach it. Delete the file and" \
    "restart, or re-materialize it with" \
    "'bazelisk run //scripts:seed-dev-env -- --force'." >&2
fi

# --- MCP command reachability (advisory) --------------------------------------
# Every [mcp_servers.*] block the render above writes names its binary by the
# absolute path the golden image bakes (/opt/npm-global/bin/...), so the config
# and the image are two artifacts that have to agree - and they do not always.
# A workspace running an image built before that binary was added boots with a
# lane that can never start, and the CLI only says so in its own MCP log. This
# stage reads the RENDERED file, pulls every command = "..." value out of it and
# names the ones that are not executable files, in the same startup log that
# wrote the config. Advisory only: one warning line per missing path, never a
# failed start, so the call below swallows whatever status it returns.
check_mcp_commands() {
  local mcp_cfg mcp_cmd
  mcp_cfg="$HOME/.grok/config.toml"
  [ -f "$mcp_cfg" ] || return 0
  while IFS= read -r mcp_cmd; do
    # sed keeps only a double-quoted value, and a TOML path carries no spaces,
    # so an empty entry here is an odd line, not a missing binary.
    [ -n "$mcp_cmd" ] || continue
    [ -x "$mcp_cmd" ] && continue
    echo "WARNING: $mcp_cfg declares an MCP command that is not executable:" \
      "$mcp_cmd - the running image is older than the templates. Rebuild" \
      "evo-t1-dev (bazelisk run //scripts:build-dev-image), or install it" \
      "here: npm i -g --prefix /opt/npm-global <package> at the version" \
      "pinned in images/dev/tool-versions.env." >&2
  done < <(grep -E '^[[:space:]]*command[[:space:]]*=' "$mcp_cfg" 2>/dev/null \
    | sed -n 's/.*=[[:space:]]*"\([^"]*\)".*/\1/p' | sort -u)
}
check_mcp_commands || true

# --- Context7 cache-proxy config ---------------------------------------------
# Seeded only while absent, so a hand-edited copy survives restarts. Lives
# under ~/.grok so a shared grok-profile volume reuses the SQLite cache across
# that owner's workspaces. The JSON names no secret: empty CONTEXT7_API_KEY
# tells mcp-cache-proxy to inherit process.env.
mkdir -p "$HOME/.grok/mcp-cache-proxy" 2>/dev/null || true
if [ ! -f "$HOME/.grok/mcp-cache-proxy/config.json" ]; then
  cat >"$HOME/.grok/mcp-cache-proxy/config.json" <<'MCP_CACHE_PROXY_EOF'
${mcp_cache_proxy}
MCP_CACHE_PROXY_EOF
  chmod 600 "$HOME/.grok/mcp-cache-proxy/config.json" 2>/dev/null || true
fi

# Second pass: grok's installer and the seed above may have created files as
# root when the agent ran as root; hand them back to whoever owns $HOME.
if [ -n "$home_owner" ]; then
  $SUDO chown -R "$home_owner" "$HOME/.grok" "$HOME/.shared" 2>/dev/null || true
fi

# --- GitHub credential plumbing (best effort) ---------------------------------
# Only runs with a token: GH_TOKEN and GITHUB_TOKEN exist solely when the owner
# has connected the External Auth provider named by CODER_GITHUB_AUTH_ID, so an empty pair —
# the default — leaves this stage, and the workspace, exactly as they were before
# it existed.
#
# With a token, two things read it, and this stage stores nothing: `gh` picks
# the key out of its own environment, and git is told here to ask `gh auth
# git-credential` for credentials for github.com, which answers from that same
# environment. The secret therefore lives in the agent environment for the
# length of the workspace, plus one copy that main.tf's gh_token_refresh script
# pipes into `gh auth login --with-token` — the per-workspace gh auth store,
# 0600, for shells launched outside that environment — and ~/.gitconfig only
# ever names the helper. That file is what the
# append below writes, and only while it names neither the helper nor a
# github.com credential section of its own, so a gitconfig someone manages by
# hand keeps whatever it already says — a second section for the same host would
# otherwise win over the helper they chose.
#
# Nothing here changes what the clone stage below does: it still runs the plain
# `git clone` it always ran, now with whatever credentials the environment
# already offers it (the seeded helper with the env token, or the Coder
# external-auth askpass helper when an account is connected). What the helper
# also opens up is the manual route — `git clone`, `git fetch` or `gh auth
# status` from a terminal in the same environment, and any push after that —
# and the clone-failure hint the clone stage prints names credential trouble
# (none found, or one that does not grant this repo) as the first likely cause.
if command -v git >/dev/null 2>&1 && command -v gh >/dev/null 2>&1 \
   && [ -n "$${GH_TOKEN:-}$${GITHUB_TOKEN:-}" ]; then
  # Two names to look for, not one: git resolves a credential helper by host and
  # takes the LAST value it finds, so a hand-written [credential "https://github.com"]
  # section already in the file would be overridden by the append below. Absent
  # either the helper line or that section, this stage leaves the file alone.
  if ! grep -qs -e 'helper = !gh auth git-credential' \
                -e '\[credential "https://github.com"\]' "$HOME/.gitconfig"; then
    printf '\n[credential "https://github.com"]\n\thelper = !gh auth git-credential\n' \
      >>"$HOME/.gitconfig" 2>/dev/null
  fi
fi

# --- Repository clone onto the shared devcontainer bind ----------------------
# This stage exists because nothing else puts code in that folder: it is what
# coder_devcontainer.repo points at, so the agent would otherwise run
# @devcontainers/cli against an empty path, and with the dev-container toggle off
# it is the folder code-server opens instead. A missing folder is not swallowed
# here — it surfaces as the devcontainer build's own visible failure (no
# devcontainer.json found), which is the report the user actually sees.
#
# The path is load-bearing, not incidental: the DinD sidecar bind-mounts the same
# host directory at the same container path (see the locals block in main.tf),
# because a bind mount's source is resolved by the daemon that runs the container
# and that daemon is the sidecar. Anything cloned anywhere else is invisible to
# the daemon and the build dies with "bind source path does not exist".
#
# The folder name is re-derived here rather than handed in, because this is the
# side that runs git; main.tf derives it the same way for workspace_folder and
# the two derivations must agree (split on "/", drop empty segments so a trailing
# slash is harmless, take the last, drop a trailing ".git", map every character
# outside [A-Za-z0-9._-] to "-", and fall back to "repo" when that leaves no
# leading alphanumeric — which also keeps "../" out of a root-owned bind).
#
# The URL arrives as a rendered literal, so it is read through a quoted heredoc:
# that way no shell quoting has to survive, and the value is only ever expanded
# as data.
repo_url_raw="$(cat <<'REPO_URL_EOF'
${repo_url}
REPO_URL_EOF
)"
dc_dir='${dc_dir}'
# "yes" only when the create form asked for the dev container build. Its only
# reader is the preflight below, which needs it to decide what to warn about.
build_devcontainer='${build_devcontainer}'

repo_leaf="$(printf '%s' "$repo_url_raw" | tr '/' '\n' | grep -v '^$' | tail -n 1)"
# The "$${leaf%.git}" suffix form would be the shorter way to drop the extension;
# it is spelled with sed here because a braced shell expansion is a templatefile
# interpolation, and the bare form would add a seventh interpolation, to a
# name main.tf does not pass.
repo_folder="$(printf '%s' "$repo_leaf" | sed 's/\.git$//')"
repo_folder="$(printf '%s' "$repo_folder" | sed 's/[^A-Za-z0-9._-]/-/g')"
printf '%s' "$repo_folder" | grep -qE '^[A-Za-z0-9]' || repo_folder="repo"
target="$dc_dir/$repo_folder"
# Made before git runs, and before the code-server script's own mkdir: the
# editor starts in parallel with this stage, and an empty tree here is a folder
# VS Code can open while the clone is still writing. Skipped with no repository
# named — then nothing clones here, and an empty leaf would only be a folder an
# additional repository could later trip over. An empty directory is also what
# git clone accepts, so this does not change what gets cloned: the guard below
# still refuses anything that is not empty.
if [ -n "$repo_url_raw" ]; then
  mkdir -p -- "$target" 2>/dev/null || true
fi

# Whichever user the workspace really belongs to: the owner of $HOME when the
# agent runs as root (same rule as the ~/.grok chown above), otherwise whoever is
# running this script. It decides both the chown target and whose git credentials
# the clone uses.
clone_owner="$(id -un)"
if [ "$(id -u)" = "0" ]; then
  clone_owner="$(stat -Lc '%U' "$HOME" 2>/dev/null || true)"
  [ "$clone_owner" = "root" ] && clone_owner=""
  if [ -z "$clone_owner" ] && id coder >/dev/null 2>&1; then
    clone_owner="coder"
  fi
fi
clone_home=""
[ -n "$clone_owner" ] && clone_home="$(getent passwd "$clone_owner" 2>/dev/null | cut -d: -f6)"

# Docker creates a missing bind source root-owned on the stack host, so the shared
# directory is handed to the workspace user before git runs — a root-owned 755
# parent would otherwise fail the clone outright. Non-recursive here: other
# workspaces' clones live alongside this one and are not ours to chown.
mkdir -p -- "$dc_dir" 2>/dev/null || true
if [ -n "$clone_owner" ]; then
  chown "$clone_owner" "$dc_dir" 2>/dev/null || true
  # Same rule for the clone folder created above: a root agent would otherwise
  # leave it root-owned and the clone, which runs as the workspace user, would
  # die writing .git inside it.
  chown "$clone_owner" "$target" 2>/dev/null || true
fi

# Clone as the workspace user, never as root, so their credentials (a helper,
# ~/.git-credentials, ssh keys) are the ones git consults. An empty prefix means
# "run git directly", which is correct for a non-root agent and for a root agent
# with no derivable workspace user. HOME is passed explicitly because runuser keeps
# the invoker's environment — a root agent would otherwise hand git /root and miss
# the workspace user's credential files entirely.
clone_runner=""
if [ "$(id -u)" = "0" ] && [ -n "$clone_owner" ]; then
  if command -v runuser >/dev/null 2>&1; then
    clone_runner="runuser -u $clone_owner --"
  elif command -v sudo >/dev/null 2>&1; then
    clone_runner="sudo -u $clone_owner --"
  fi
fi

run_clone() {
  if [ -n "$clone_runner" ] && [ -n "$clone_home" ]; then
    $clone_runner env HOME="$clone_home" git "$@"
  elif [ -n "$clone_runner" ]; then
    $clone_runner git "$@"
  else
    git "$@"
  fi
}

# The notes stage writes files into the workspace home and runs git config
# --global, so it follows run_clone's identity rule rather than the agent's uid:
# run as root it would rename a root-owned ~/.gitconfig over the workspace user's
# and leave notes.md unreadable on an already-cloned folder.
run_notes() {
  if [ -n "$clone_runner" ] && [ -n "$clone_home" ]; then
    $clone_runner env HOME="$clone_home" NOTES_SETUP_LIB="$notes_lib" bash -c \
      '. "$NOTES_SETUP_LIB" 2>/dev/null || exit 0
       notes_materialize "$1" "$2"' _ "$1" "$2"
  else
    notes_materialize "$1" "$2"
  fi
}

if [ -z "$repo_url_raw" ]; then
  # An empty Git repository field names nothing to clone and nothing to build a
  # dev container from, so the clone chain stays quiet and the dev-container
  # preflight below stays out too — there is no clone to probe, and a warning
  # about a clone nobody asked for would only be noise. The editor and the
  # terminals stay on the home folder: main.tf's editor_folder names /home/coder
  # for exactly this case.
  :
elif [ -d "$target/.git" ]; then
  # Re-fetching is the user's call: a pull here could conflict mid-edit or fail
  # on a dirty tree, and either way the workspace would start on code nobody chose.
  echo "$repo_folder: already cloned, skipping"
  run_notes "$target" "$repo_url_raw" || true
elif [ -e "$target" ] && [ -n "$(ls -A -- "$target" 2>/dev/null)" ]; then
  # Emptiness is tested, not just existence: the mkdir above and the one in
  # coder_script.code_server both leave an empty folder on a first boot, and
  # git clone into an empty folder is exactly what is wanted. A folder with
  # anything in it is still not ours to touch.
  echo "WARNING: $target exists but is not a git repository — leaving it alone and" \
    "skipping the clone. Remove it from the stack host if it should not be there." >&2
elif ! command -v git >/dev/null 2>&1; then
  echo "WARNING: git is not installed in the workspace container, so $repo_url_raw" \
    "was not cloned into $target — the dev container build will fail. This template" \
    "expects the golden image (bazelisk run //scripts:build-dev-image), which ships git." >&2
else
  # -- before the URL: the value is user input and must never parse as an option.
  if run_clone clone -- "$repo_url_raw" "$target"; then
    echo "cloned $repo_url_raw into $target"
    # Before the chown: the notes file and the .git/info/exclude write are ours
    # to make, and the recursive chown below settles their ownership.
    run_notes "$target" "$repo_url_raw" || true
    if [ -n "$clone_owner" ]; then
      chown -R "$clone_owner" "$target" 2>/dev/null || true
    fi
  else
    # Loud and non-fatal on purpose: the devcontainer build reports the same
    # problem a second time, and the workspace still boots for someone to fix it.
    # git removes its own partial clone on failure; nothing here deletes a folder
    # that may hold someone's work.
    echo "==============================================================" >&2
    echo "WARNING: the repository clone failed — the dev container will not build." >&2
    echo "  repository: $repo_url_raw" >&2
    echo "  target:     $target" >&2
    echo "  The two likely causes:" >&2
    echo "    1. a private repository: git runs as the workspace user and" >&2
    echo "       consults any credential it finds (a credential helper," >&2
    echo "       ~/.git-credentials, ~/.ssh, or the external-auth account" >&2
    echo "       connected in Coder — which must also GRANT this repo)." >&2
    echo "    2. an unreachable host: check DNS and egress from the workspace" >&2
    echo "       container, then restart the workspace" >&2
    echo "  Clone it by hand into the path above, or fix the URL, and start again." >&2
    echo "==============================================================" >&2
  fi
fi

# --- Additional repositories (best effort) -----------------------------------
# The list --additional-repos on the new-workspace CLI writes, arriving here as
# one comma- or newline-separated string (textarea on the create form). Every
# entry lands beside the primary clone, inside the same $dc_dir bind, so the
# devcontainer build context and the editor's folder both stay on $target. The
# same three rules apply per entry — folder name re-derived the same way, never
# clobber a non-git folder, one loud warning per failed clone — and an empty
# primary URL means there is no clone tree to be beside, which is why the extras
# ride along with the primary instead of replacing it.
extra_repos_raw="$(cat <<'EXTRA_REPOS_EOF'
${additional_repos}
EXTRA_REPOS_EOF
)"
for extra_url in $(printf '%s\n' "$extra_repos_raw" | tr ',' '\n' | tr '\r' '\n' \
    | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//' | grep -v '^[[:space:]]*$' || true); do
  extra_leaf="$(printf '%s' "$extra_url" | tr '/' '\n' | grep -v '^$' | tail -n 1)"
  extra_folder="$(printf '%s' "$extra_leaf" | sed 's/\.git$//')"
  extra_folder="$(printf '%s' "$extra_folder" | sed 's/[^A-Za-z0-9._-]/-/g')"
  printf '%s' "$extra_folder" | grep -qE '^[A-Za-z0-9]' || extra_folder="repo"
  if [ "$extra_folder" = "$repo_folder" ]; then
    continue
  fi
  extra_target="$dc_dir/$extra_folder"
  if [ -d "$extra_target/.git" ]; then
    echo "$extra_folder: already cloned, skipping"
    run_notes "$extra_target" "$extra_url" || true
  elif [ -e "$extra_target" ]; then
    echo "WARNING: $extra_target exists but is not a git repository — leaving it" \
      "alone and skipping the clone. Remove it from the stack host if it should not be there." >&2
  elif ! command -v git >/dev/null 2>&1; then
    echo "WARNING: git is not installed, so $extra_url was not cloned into $extra_target." \
      "This template expects the golden image (bazelisk run //scripts:build-dev-image), which ships git." >&2
  elif run_clone clone -- "$extra_url" "$extra_target"; then
    echo "cloned $extra_url into $extra_target"
    run_notes "$extra_target" "$extra_url" || true
    if [ -n "$clone_owner" ]; then
      chown -R "$clone_owner" "$extra_target" 2>/dev/null || true
    fi
  else
    echo "WARNING: $extra_url did not clone into $extra_target. The same two causes" \
      "apply as for the primary repository: a credential that does not cover this" \
      "repository, or no route to its host." >&2
  fi
done

# --- Dev-container preflight (best effort) ------------------------------------
# Only worth running after the clone, because it is about what the clone holds.
# The six paths below are the ones @devcontainers/cli looks in. Nothing here
# changes what the build does — with the toggle on, a clone that carries no
# devcontainer configuration fails the build either way, and the editor that hangs
# off the dev container never appears — this is only the early notice, in the same
# log the clone warnings above already use. It also runs on a re-start that cloned
# nothing, because the build re-runs then too.
if [ -d "$target/.git" ]; then
  dc_config=""
  for probe in \
    "$target/devcontainer.json" "$target/devcontainer.yml" \
    "$target/.devcontainer/devcontainer.json" "$target/.devcontainer/devcontainer.yml" \
    "$target/.github/devcontainers/devcontainer.json" "$target/.github/devcontainers/devcontainer.yml"
  do
    if [ -e "$probe" ]; then
      dc_config="$probe"
      break
    fi
  done
  if [ -z "$dc_config" ]; then
    echo "==============================================================" >&2
    if [ "$build_devcontainer" = "yes" ]; then
      echo "WARNING: $repo_folder has no devcontainer configuration found — the dev" \
        "container will NOT build, and with the dev-container toggle on that means no" \
        "editor and no in-container terminal either: this workspace's code-server and" \
        "Grok hang off the dev-container sub-agent, and no dev container means no" \
        "sub-agent to attach them to (recreate this workspace with the dev-container" \
        "toggle set to No if the plain-container shape is what you want)." >&2
    else
      echo "WARNING: $repo_folder has no devcontainer configuration found — expected" \
        "with the dev-container toggle off; the editor opens the clone directly." >&2
    fi
    echo "==============================================================" >&2
  fi
fi
