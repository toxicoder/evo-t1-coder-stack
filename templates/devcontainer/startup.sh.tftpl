#!/bin/bash
# Coder workspace startup - EVO-T1 stack, devcontainer template.
#
# Idempotent: safe to re-run on every workspace start. The stage list, and why each
# stage sits where it does: docs/coder-templates.md#what-the-startup-script-does-in-order
#
# Rendered by Terraform templatefile(): a braced shell expansion must be written
# $${name}, or the render swallows it as an interpolation. Only the variables main.tf
# passes interpolate; docs/coder-templates.md#startup-script-templatefile-rules.

set -u

${boot_log_lib}

# The library arrives as a Terraform map value, which Terraform does not
# re-interpolate, so the library's own dollar-brace text lands here verbatim: no
# here-doc and no temp file. A comment in this body spells that token as
# "dollar-brace" too, because Terraform reads a real one anywhere in the file.
boot_begin "workspace startup" 9

SUDO=""
if [ "$(id -u)" != "0" ] && command -v sudo >/dev/null 2>&1; then
  SUDO="sudo"
fi

home_owner="$(stat -Lc '%u:%g' "$HOME" 2>/dev/null || true)"
[ "$home_owner" = "0:0" ] && home_owner=""
if [ -z "$home_owner" ] && id coder >/dev/null 2>&1; then
  home_owner="$(id -u coder):$(id -g coder)"
fi
if [ -n "$home_owner" ]; then
  mkdir -p "$HOME/.shared/vscode" "$HOME/.grok" 2>/dev/null || true
  $SUDO chown -R "$home_owner" "$HOME/.shared" "$HOME/.grok" 2>/dev/null || true
fi

# --- tmux -------------------------------------------------------------------
boot_stage 1 "tmux and its config"
if ! command -v tmux >/dev/null 2>&1; then
  boot_phase "installing tmux with apt-get"
  $SUDO apt-get update -y >/dev/null
  $SUDO DEBIAN_FRONTEND=noninteractive apt-get install -y tmux >/dev/null
  boot_ok "tmux installed"
fi

# --- tmux configuration -----------------------------------------------------
# docs/coder-templates.md#marker-ownership-of-the-seeded-files
if [ ! -f "$HOME/.tmux.conf" ] \
   || grep -qs 'managed-by: evo-t1-coder-stack' "$HOME/.tmux.conf"; then
  cat >"$HOME/.tmux.conf" <<'TMUX_CONF_EOF'
${tmux_conf}
TMUX_CONF_EOF
else
  echo "WARNING: $HOME/.tmux.conf carries no evo-t1-coder-stack marker -" \
    "leaving it alone. Remove the marker line to keep your own tmux config." >&2
fi

# --- Grok Build CLI ----------------------------------------------------------
# docs/coder-templates.md#the-grok-build-cli-probe-the-download-and-the-installer-stub
boot_stage 2 "the Grok Build CLI"
GROK_FRESH_INSTALL=0
if ! command -v grok >/dev/null 2>&1; then
  boot_phase "downloading and running the grok installer from x.ai (max-time 180s)"
  grok_installer="$(mktemp 2>/dev/null || true)"
  if [ -n "$grok_installer" ] \
     && curl -fsSL --http1.1 --retry 5 --retry-all-errors --retry-delay 2 --connect-timeout 15 --max-time 180 \
          -o "$grok_installer" https://x.ai/cli/install.sh \
     && bash "$grok_installer" >/dev/null; then
    command -v grok >/dev/null 2>&1 && GROK_FRESH_INSTALL=1
  fi
  rm -f "$${grok_installer:-}"
  if [ "$GROK_FRESH_INSTALL" = "1" ]; then
    boot_ok "grok installed"
  else
    boot_warn "grok is still not on PATH - the installer did not take"
  fi
fi
boot_stage 3 "the shell profile"
if ! grep -qs 'grok/bin' "$HOME/.bashrc"; then
  printf '\n# Grok Build CLI\nexport PATH="$HOME/.grok/bin:$PATH"\n' >>"$HOME/.bashrc"
  boot_ok "the grok bin PATH line added to ~/.bashrc"
fi
export PATH="$HOME/.grok/bin:$PATH"

# Vault-fed credentials. The infisical_secrets coder_script writes the project's
# secrets to ~/.infisical/agent.env; sourcing it here puts them in every shell and
# command this workspace runs, and set -a exports each line rather than leaving it
# shell-local. Gated on infisical_hook (main.tf, from var.infisical_enabled), so a
# stack that never adopted the vault gets no line in a file the operator owns. The
# existence test sits inside the appended line because the fetch is a separate
# coder_script with no promised order; the grep stops a later start doubling it.
# Sourcing is safe only because of what the writer does: read the publish step of
# infisical-secrets.sh.tftpl and docs/operate/secrets.md before changing either side.
# The trim markers are load-bearing. A ~} on either tag eats a newline, and with the one on
# the opening tag the whole if lands inside the comment above it, leaving its fi for bash to
# trip over -- which the render gate catches and a rendered-fragment test alone will not.
%{~ if infisical_hook }
if ! grep -qs 'infisical/agent.env' "$HOME/.bashrc"; then
  printf '\n# Infisical vault secrets, fetched at workspace start by the infisical_secrets script\nif [ -f "$HOME/.infisical/agent.env" ]; then set -a; . "$HOME/.infisical/agent.env"; set +a; fi\n' >>"$HOME/.bashrc"
fi
%{ endif }

# --- Coder Agents context (skill + instructions) ------------------------------
# docs/coder-templates.md#the-coder-agents-seeds-and-their-agents-tree-twins
boot_stage 4 "skills, agents, and the notes library"
if [ ! -f "$HOME/.coder/skills/grok-build-delegation/SKILL.md" ]; then
  mkdir -p "$HOME/.coder/skills/grok-build-delegation" 2>/dev/null
  cat >"$HOME/.coder/skills/grok-build-delegation/SKILL.md" <<'AGENT_SKILL_MD_EOF'
${grok_build_delegation_skill}
AGENT_SKILL_MD_EOF
  boot_ok "the delegation skill seeded under ~/.coder/skills"
fi

if [ ! -f "$HOME/.agents/skills/grok-build-delegation/SKILL.md" ]; then
  mkdir -p "$HOME/.agents/skills/grok-build-delegation" 2>/dev/null
  cp "$HOME/.coder/skills/grok-build-delegation/SKILL.md" \
    "$HOME/.agents/skills/grok-build-delegation/SKILL.md" 2>/dev/null
fi

# Retire the pre-rename name: the stack seeded this skill under /learn until it moved,
# and a leftover marker-carrying copy keeps offering that old name. Marker-free stays.
for _d in "$HOME/.coder/skills/learn" "$HOME/.agents/skills/learn"; do
  grep -qF 'managed-by: evo-t1-coder-stack' "$_d/SKILL.md" 2>/dev/null &&
    { rm -f "$_d/SKILL.md"; rmdir "$_d"; } 2>/dev/null
done

if [ ! -f "$HOME/.coder/AGENTS.md" ]; then
  cat >"$HOME/.coder/AGENTS.md" <<'AGENT_INSTR_MD_EOF'
${coder_agents}
AGENT_INSTR_MD_EOF
  boot_ok "the coder AGENTS.md seeded"
fi

# The ~/.agents twin, same rule as above; INSTRUCTIONS.md is the name the ~/.agents
# convention was seeded under.
if [ ! -f "$HOME/.agents/INSTRUCTIONS.md" ]; then
  cp "$HOME/.coder/AGENTS.md" "$HOME/.agents/INSTRUCTIONS.md" 2>/dev/null
fi

# The Grok Build rulebook (~/.grok/AGENTS.md) is seeded by coder_script.agents_seed,
# which carries the GROK_BUILD_AGENTS.md payload in its own execve argument: this body is
# one argument with one kernel ceiling, and that payload is the largest the template
# inlines. docs/coder-templates.md#the-one-argument-ceiling.

# --- Private per-repo notes ---------------------------------------------------
# docs/coder-templates.md#marker-ownership-of-the-seeded-files
mkdir -p "$HOME/.grok" 2>/dev/null || true
notes_lib="$HOME/.grok/notes-setup.sh"
notes_lib_tmp="$(mktemp "$notes_lib.XXXXXX" 2>/dev/null)" || notes_lib_tmp="$notes_lib.$$"
if cat >"$notes_lib_tmp" <<'NOTES_SETUP_EOF'
${notes_setup}
NOTES_SETUP_EOF
then
  chmod 0644 "$notes_lib_tmp" 2>/dev/null || true
  mv -f "$notes_lib_tmp" "$notes_lib" 2>/dev/null || true
  boot_ok "the notes library published at ~/.grok/notes-setup.sh"
fi
rm -f "$notes_lib_tmp" 2>/dev/null || true
# shellcheck disable=SC1090
. "$notes_lib" 2>/dev/null || true

# --- Editor settings ----------------------------------------------------------
# docs/coder-templates.md#editor-settings-seed
boot_stage 5 "editor settings"
mkdir -p "$HOME/.shared/vscode" "$HOME/.local/share/code-server/User"
shared_settings="$HOME/.shared/vscode/settings.json"
user_settings="$HOME/.local/share/code-server/User/settings.json"
if [ ! -f "$shared_settings" ]; then
  if cat >"$shared_settings" <<'VSCODE_SETTINGS_EOF'
${vscode_settings}
VSCODE_SETTINGS_EOF
  then
    if [ -n "$${LITELLM_API_KEY:-}" ]; then
      tmp_settings="$(mktemp)"
      if command -v jq >/dev/null 2>&1 && jq --arg k "$LITELLM_API_KEY" \
        '.["cline.apiKey"]=$k | .["roo.openaiApiKey"]=$k' \
        "$shared_settings" >"$tmp_settings"; then
        mv "$tmp_settings" "$shared_settings"
      elif command -v python3 >/dev/null 2>&1; then
        rm -f "$tmp_settings"
        SETTINGS_PATH="$shared_settings" python3 -c 'import json, os; p = os.environ["SETTINGS_PATH"]; d = json.load(open(p)); k = os.environ["LITELLM_API_KEY"]; d["cline.apiKey"] = k; d["roo.openaiApiKey"] = k; json.dump(d, open(p, "w"), indent=2); open(p, "a").write("\n")'
      else
        rm -f "$tmp_settings"
      fi
    fi
    chmod 600 "$shared_settings" 2>/dev/null || true
    boot_ok "the shared editor settings seeded"
  else
    boot_err "could not write $shared_settings — the vscode-settings volume is not writable. Editor settings were not seeded."
  fi
fi
# A real file, rewritten each start: render, then the shared overlay wins, then the
# theme, so the overlay cannot veto it. Your own symlink here is left alone.
if [ -L "$user_settings" ]; then
  boot_note "$user_settings is your own symlink - the stack leaves it alone."
else
  user_settings_new="$${user_settings}.tmp"
  if cat >"$user_settings_new" <<'VSCODE_USER_SETTINGS_EOF'
${vscode_settings}
VSCODE_USER_SETTINGS_EOF
  then
    if [ -f "$shared_settings" ]; then
      if command -v jq >/dev/null 2>&1 && jq -s \
        '(.[0] * .[1]) + {"workbench.colorTheme": (.[0]["workbench.colorTheme"] // .[1]["workbench.colorTheme"] // empty)}' \
        "$user_settings_new" "$shared_settings" >"$${user_settings_new}.m" 2>/dev/null; then
        mv -f "$${user_settings_new}.m" "$user_settings_new"
      elif command -v python3 >/dev/null 2>&1; then
        SETTINGS_BASE="$user_settings_new" SETTINGS_OVERLAY="$shared_settings" \
          SETTINGS_OUT="$${user_settings_new}.m" python3 -c 'import json,os; deep=lambda a,b:{**a,**{k:(deep(a[k],v) if isinstance(v,dict) and isinstance(a.get(k),dict) else v) for k,v in b.items()}}; b=json.load(open(os.environ["SETTINGS_BASE"])); o=json.load(open(os.environ["SETTINGS_OVERLAY"])); m=deep(b,o); m.update(({"workbench.colorTheme":b["workbench.colorTheme"]} if "workbench.colorTheme" in b else ({"workbench.colorTheme":o["workbench.colorTheme"]} if "workbench.colorTheme" in o else {}))); json.dump(m,open(os.environ["SETTINGS_OUT"],"w"),indent=2); open(os.environ["SETTINGS_OUT"],"a").write("\n")'
        mv -f "$${user_settings_new}.m" "$user_settings_new" 2>/dev/null || true
      fi
      rm -f "$${user_settings_new}.m" 2>/dev/null || true
    fi
    mv -f "$user_settings_new" "$user_settings"
    chmod 600 "$user_settings" 2>/dev/null || true
    boot_ok "the code-server user settings refreshed"
  else
    boot_err "could not write $user_settings_new - the editor settings were not refreshed."
    rm -f "$user_settings_new" 2>/dev/null || true
  fi
fi

# --- Grok Build config --------------------------------------------------------
# docs/coder-templates.md#marker-ownership-of-the-seeded-files
boot_stage 6 "the Grok Build profile"
mkdir -p "$HOME/.grok/memory" "$HOME/.grok/logs/mcp" 2>/dev/null

if [ ! -f "$HOME/.grok/config.toml" ] \
   || [ "$GROK_FRESH_INSTALL" = "1" ] \
   || grep -qFs -e 'managed-by: evo-t1-coder-stack' -e '__evoT1Stack = true' \
     "$HOME/.grok/config.toml"; then
  # [ui] comes across minus the keys the render owns: a second [ui] is bad TOML.
  cli_block="$(mktemp)"
  ui_keys="$(mktemp)"
  if [ -f "$HOME/.grok/config.toml" ]; then
    awk '/^\[(cli|marketplace)\][[:space:]]*$/{f=1;print;next} /^\[/{f=0} f' \
      "$HOME/.grok/config.toml" >"$cli_block" 2>/dev/null || : >"$cli_block"
    awk '/^\[ui\][[:space:]]*$/{f=1;next} /^\[/{f=0} \
      f && $0 !~ /^[[:space:]]*(theme|auto_dark_theme|auto_light_theme|ui_theme|permission_mode)[[:space:]]*=/' \
      "$HOME/.grok/config.toml" >"$ui_keys" 2>/dev/null || : >"$ui_keys"
  else
    : >"$cli_block"
    : >"$ui_keys"
  fi
  {
    awk -v ui="$ui_keys" \
      'BEGIN{while ((getline l < ui) > 0) k[n++] = l; close(ui)} \
       {print; if (/^\[ui\][[:space:]]*$/) {u = 1; for (i = 0; i < n; i++) print k[i]}} \
       END{if (!u && n) {printf "\n[ui]\n"; for (i = 0; i < n; i++) print k[i]}}' <<'GROK_CONFIG_EOF'
${grok_config}
GROK_CONFIG_EOF
    if [ -s "$cli_block" ]; then
      printf '\n'
      cat "$cli_block"
    fi
  } >"$HOME/.grok/config.toml" || true
  rm -f "$cli_block" "$ui_keys"
  chmod 600 "$HOME/.grok/config.toml" 2>/dev/null || true
  boot_ok "config.toml re-materialized with the stack markers"
  # fleet-width advisory: the rendered width against the ceiling the same render
  # wrote above it. The scoping and the tolerances match profile_table in
  # scripts/subagent-check.sh, which is the CLI's copy of this check.
  sub_prog='/^[[:space:]]*\[/{h=$0;sub(/[[:space:]]*#.*$/,"",h);sub(/^[[:space:]]+/,"",h);sub(/[[:space:]]+$/,"",h);sub(/^\[/,"",h);sub(/\]$/,"",h);sub(/^[[:space:]]+/,"",h);sub(/[[:space:]]+$/,"",h);inside=(h==want);next} inside{print}'
  sub_w="$(awk -v want=subagents "$sub_prog" "$HOME/.grok/config.toml" 2>/dev/null | sed -nE 's/^[[:space:]]*"?max_concurrent"?[[:space:]]*=[[:space:]]*\+?([0-9][0-9]*)([[:space:]]*#.*)?[[:space:]]*$/\1/p' | head -1 | sed 's/^0*\([0-9]\)/\1/')"
  sub_f="$(awk -v want=subagents "$sub_prog" "$HOME/.grok/config.toml" 2>/dev/null | awk '/^[[:space:]]*$/{next} /^[[:space:]]*max_concurrent[[:space:]]*=/{print prev;exit} {prev=$0}' | sed -nE 's/^[[:space:]]*#[[:space:]]*fleet-width:[[:space:]]*([0-9][0-9]*)([[:space:]]*#.*)?[[:space:]]*$/\1/p' | head -1 | sed 's/^0*\([0-9]\)/\1/')"
  # The comparison runs in awk on purpose: bash's integer test prints an error and
  # lets the condition fall through on a value too large for it, and a startup log
  # has no business carrying that.
  sub_narrow="$(awk -v w="$sub_w" -v f="$sub_f" 'BEGIN{if (w ~ /^[0-9]+$/ && f ~ /^[0-9]+$/ && w+0 <= 9999 && f+0 <= 9999 && w+0 < f+0) print "y"}')"
  if [ "$sub_narrow" = "y" ]; then
    boot_note "subagents width $sub_w is below the fleet's $sub_f - a value that outlived its template, unless you set it on purpose (docs/troubleshooting.md#the-rendered-width-is-below-fleet-width)"
  fi
else
  # Same marker contract as ~/.tmux.conf above; the loss costs this model catalog.
  echo "WARNING: $HOME/.grok/config.toml carries neither stack marker (no" \
    "managed-by comment, no __evoT1Stack key) - this workspace is" \
    "running a config the stack does not manage, so the default MCP lanes and" \
    "the model catalog never reach it. Delete the file and restart, or" \
    "re-materialize it with 'bazelisk run //scripts:seed-dev-env -- --force'." >&2
fi

# --- MCP command reachability (advisory) --------------------------------------
# docs/coder-templates.md#mcp-command-reachability-advisory
check_mcp_commands() {
  local mcp_cfg mcp_cmd
  mcp_cfg="$HOME/.grok/config.toml"
  [ -f "$mcp_cfg" ] || return 0
  while IFS= read -r mcp_cmd; do
    [ -n "$mcp_cmd" ] || continue
    [ -x "$mcp_cmd" ] && continue
    boot_err "$mcp_cfg declares an MCP command that is not executable: $mcp_cmd - the running image is older than the templates. Rebuild evo-t1-dev (bazelisk run //scripts:build-dev-image), or install it here: npm i -g --prefix /opt/npm-global <package> at the version pinned in images/dev/tool-versions.env."
  done < <(grep -E '^[[:space:]]*command[[:space:]]*=' "$mcp_cfg" 2>/dev/null \
    | sed -n 's/.*=[[:space:]]*"\([^"]*\)".*/\1/p' | sort -u)
}
check_mcp_commands || true

# --- Context7 cache-proxy config ---------------------------------------------
# Seeded only while absent, so a hand-edited copy survives. Under ~/.grok, which is
# this workspace's own. The JSON names no secret.
mkdir -p "$HOME/.grok/mcp-cache-proxy" 2>/dev/null || true
if [ ! -f "$HOME/.grok/mcp-cache-proxy/config.json" ]; then
  cat >"$HOME/.grok/mcp-cache-proxy/config.json" <<'MCP_CACHE_PROXY_EOF'
${mcp_cache_proxy}
MCP_CACHE_PROXY_EOF
  chmod 600 "$HOME/.grok/mcp-cache-proxy/config.json" 2>/dev/null || true
  boot_ok "the context7 cache-proxy config seeded"
fi

boot_stage 7 "ownership, the legacy hoist, and the git credentials"
if [ -n "$home_owner" ]; then
  $SUDO chown -R "$home_owner" "$HOME/.grok" "$HOME/.shared" 2>/dev/null || true
fi

# run_notes below can run under the clone container's HOME, where the read-only
# ~/.grok-legacy mount is not, so hoist with the HOME that actually has it.
notes_hoist_legacy || true

# --- GitHub credential plumbing (best effort) ---------------------------------
# docs/coder-templates.md#github-credentials-for-a-workspace
if command -v git >/dev/null 2>&1 && command -v gh >/dev/null 2>&1; then
  evo_gh_bin="$(command -v gh)"
  evo_gh_helper="!env -u GH_TOKEN -u GITHUB_TOKEN -u GH_ENTERPRISE_TOKEN -u GITHUB_ENTERPRISE_TOKEN $${evo_gh_bin} auth git-credential"
  for evo_host in github.com gist.github.com; do
    git config --file "$HOME/.gitconfig" --replace-all "credential.https://$${evo_host}.helper" '' 2>/dev/null || true
    git config --file "$HOME/.gitconfig" --add "credential.https://$${evo_host}.helper" "$${evo_gh_helper}" 2>/dev/null || true
  done
  if [ -n "$home_owner" ]; then
    $SUDO chown "$home_owner" "$HOME/.gitconfig" 2>/dev/null || true
  fi
  boot_ok "the gh credential helper wired for github.com"
fi

# --- Repository clone onto the shared devcontainer bind ----------------------
# docs/coder-templates.md#why-the-shared-bind-path-is-load-bearing
boot_stage 8 "the repositories and the notes watcher"
repo_url_raw="$(cat <<'REPO_URL_EOF'
${repo_url}
REPO_URL_EOF
)"
dc_dir='${dc_dir}'
# "yes" only when the create form asked for the build; only the preflight reads it.
build_devcontainer='${build_devcontainer}'

repo_leaf="$(printf '%s' "$repo_url_raw" | tr '/' '\n' | grep -v '^$' | tail -n 1)"
# sed, not the shorter "$${leaf%.git}": a braced shell expansion is a templatefile
# interpolation and would name a key main.tf does not pass.
repo_folder="$(printf '%s' "$repo_leaf" | sed 's/\.git$//')"
repo_folder="$(printf '%s' "$repo_folder" | sed 's/[^A-Za-z0-9._-]/-/g')"
printf '%s' "$repo_folder" | grep -qE '^[A-Za-z0-9]' || repo_folder="repo"
target="$dc_dir/$repo_folder"
# Made before git runs, and before the code-server script's own mkdir: the editor
# starts in parallel and opens an empty tree while the clone is still writing, and
# git clone accepts empty, so the guard below still rules.
if [ -n "$repo_url_raw" ]; then
  mkdir -p -- "$target" 2>/dev/null || true
fi

# Whichever user the workspace really belongs to: the owner of $HOME when the agent runs
# as root, otherwise this script's user. Decides the chown target and the git creds.
clone_owner="$(id -un)"
if [ "$(id -u)" = "0" ]; then
  clone_owner="$(stat -Lc '%U' "$HOME" 2>/dev/null || true)"
  [ "$clone_owner" = "root" ] && clone_owner=""
  if [ -z "$clone_owner" ] && id coder >/dev/null 2>&1; then
    clone_owner="coder"
  fi
fi
clone_home=""
[ -n "$clone_owner" ] && clone_home="$(getent passwd "$clone_owner" 2>/dev/null | cut -d: -f6)"

# Non-recursive: other workspaces' clones live alongside this one and are not ours.
mkdir -p -- "$dc_dir" 2>/dev/null || true
if [ -n "$clone_owner" ]; then
  chown "$clone_owner" "$dc_dir" 2>/dev/null || true
  chown "$clone_owner" "$target" 2>/dev/null || true
fi

# Clone as the workspace user, never as root, so their credentials (a helper,
# ~/.git-credentials, ssh keys) are what git consults; HOME is passed because runuser
# keeps the invoker's environment.
clone_runner=""
if [ "$(id -u)" = "0" ] && [ -n "$clone_owner" ]; then
  if command -v runuser >/dev/null 2>&1; then
    clone_runner="runuser -u $clone_owner --"
  elif command -v sudo >/dev/null 2>&1; then
    clone_runner="sudo -u $clone_owner --"
  fi
fi

# The host alone: a create-form URL can carry userinfo, and no boot line may
# print a credential.
repo_host() {
  printf '%s' "$1" | sed -E -e 's#^[A-Za-z0-9+.-]+://##' -e 's#^[^/@]*@##' \
    -e 's#[:/].*##'
}

run_clone() {
  if [ -n "$clone_runner" ] && [ -n "$clone_home" ]; then
    $clone_runner env HOME="$clone_home" git "$@"
  elif [ -n "$clone_runner" ]; then
    $clone_runner git "$@"
  else
    git "$@"
  fi
}

# Follows run_clone's identity rule, not the agent's uid: it runs git config --global.
run_notes() {
  if [ -n "$clone_runner" ] && [ -n "$clone_home" ]; then
    $clone_runner env HOME="$clone_home" NOTES_SETUP_LIB="$notes_lib" bash -c \
      '. "$NOTES_SETUP_LIB" 2>/dev/null || exit 0
       notes_materialize "$1" "$2"' _ "$1" "$2"
  else
    notes_materialize "$1" "$2"
  fi
}

if [ -z "$repo_url_raw" ]; then
  # An empty Git repository field names nothing to clone and nothing to build a dev
  # container from, so the clone chain and the preflight below both stay out.
  :
elif [ -d "$target/.git" ]; then
  # No pull here: re-fetching is the user's call, and one could conflict mid-edit.
  boot_note "$repo_folder: already cloned, skipping"
  run_notes "$target" "$repo_url_raw" || true
elif [ -e "$target" ] && [ -n "$(ls -A -- "$target" 2>/dev/null)" ]; then
# Emptiness is tested, not just existence: this mkdir and the one in
# coder_script.code_server both leave an empty folder on a first boot, and that clones.
  boot_err "$target exists but is not a git repository — leaving it alone and skipping the clone. Remove it from the stack host if it should not be there."
elif ! command -v git >/dev/null 2>&1; then
  boot_err "git is not installed in the workspace container, so $repo_url_raw was not cloned into $target — the dev container build will fail. This template expects the golden image (bazelisk run //scripts:build-dev-image), which ships git."
else
  # -- before the URL: the value is user input and must never parse as an option.
  boot_phase "cloning the $(repo_host "$repo_url_raw") repository into $target"
  if run_clone clone -- "$repo_url_raw" "$target"; then
    boot_ok "cloned $repo_url_raw into $target"
    run_notes "$target" "$repo_url_raw" || true
    if [ -n "$clone_owner" ]; then
      chown -R "$clone_owner" "$target" 2>/dev/null || true
    fi
  else
    # Loud and non-fatal on purpose: the devcontainer build reports the same problem a
    # second time, and the workspace still boots for someone to fix it.
    echo "==============================================================" >&2
    boot_err "the repository clone failed — the dev container will not build."
    echo "  repository: $repo_url_raw" >&2
    echo "  target:     $target" >&2
    echo "  The two likely causes:" >&2
    echo "    1. a private repository: git runs as the workspace user and" >&2
    echo "       consults any credential it finds (a credential helper," >&2
    echo "       ~/.git-credentials, ~/.ssh, or the external-auth account" >&2
    echo "       connected in Coder — which must also GRANT this repo)." >&2
    echo "    2. an unreachable host: check DNS and egress from the workspace" >&2
    echo "       container, then restart the workspace" >&2
    echo "  Clone it by hand into the path above, or fix the URL, and start again." >&2
    echo "==============================================================" >&2
  fi
fi

# --- Additional repositories (best effort) -----------------------------------
# docs/coder-templates.md#cloning-more-than-one-repository
extra_repos_raw="$(cat <<'EXTRA_REPOS_EOF'
${additional_repos}
EXTRA_REPOS_EOF
)"
for extra_url in $(printf '%s\n' "$extra_repos_raw" | tr ',' '\n' | tr '\r' '\n' \
    | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//' | grep -v '^[[:space:]]*$' || true); do
  extra_leaf="$(printf '%s' "$extra_url" | tr '/' '\n' | grep -v '^$' | tail -n 1)"
  extra_folder="$(printf '%s' "$extra_leaf" | sed 's/\.git$//')"
  extra_folder="$(printf '%s' "$extra_folder" | sed 's/[^A-Za-z0-9._-]/-/g')"
  printf '%s' "$extra_folder" | grep -qE '^[A-Za-z0-9]' || extra_folder="repo"
  if [ "$extra_folder" = "$repo_folder" ]; then
    continue
  fi
  extra_target="$dc_dir/$extra_folder"
  if [ -d "$extra_target/.git" ]; then
    boot_note "$extra_folder: already cloned, skipping"
    run_notes "$extra_target" "$extra_url" || true
  elif [ -e "$extra_target" ]; then
    boot_err "$extra_target exists but is not a git repository — leaving it alone and skipping the clone. Remove it from the stack host if it should not be there."
  elif ! command -v git >/dev/null 2>&1; then
    boot_err "git is not installed, so $extra_url was not cloned into $extra_target. This template expects the golden image (bazelisk run //scripts:build-dev-image), which ships git."
  elif run_clone clone -- "$extra_url" "$extra_target"; then
    boot_phase "cloning the $(repo_host "$extra_url") repository into $extra_target"
    boot_ok "cloned $extra_url into $extra_target"
    run_notes "$extra_target" "$extra_url" || true
    if [ -n "$clone_owner" ]; then
      chown -R "$clone_owner" "$extra_target" 2>/dev/null || true
    fi
  else
    boot_err "$extra_url did not clone into $extra_target. The same two causes apply as for the primary repository: a credential that does not cover this repository, or no route to its host."
  fi
done

# Notes have to survive a recreate that lands between edits, not just one after a start:
# run_notes synced once, so later work lived only in this container, and the watcher
# closes that gap on run_notes' identity rule.
run_notes_watch() {
  if [ -n "$clone_runner" ] && [ -n "$clone_home" ]; then
    $clone_runner env HOME="$clone_home" NOTES_SETUP_LIB="$notes_lib" bash -c \
      '. "$NOTES_SETUP_LIB" 2>/dev/null || exit 0
       notes_sync_start "" "$2"' _ "" "$dc_dir"
  else
    notes_sync_start "" "$dc_dir"
  fi
}
run_notes_watch || true

# --- Dev-container preflight (best effort) ------------------------------------
# docs/coder-templates.md#dev-container-preflight
if [ -d "$target/.git" ]; then
  dc_config=""
  for probe in \
    "$target/devcontainer.json" "$target/devcontainer.yml" \
    "$target/.devcontainer/devcontainer.json" "$target/.devcontainer/devcontainer.yml" \
    "$target/.github/devcontainers/devcontainer.json" "$target/.github/devcontainers/devcontainer.yml"
  do
    if [ -e "$probe" ]; then
      dc_config="$probe"
      break
    fi
  done
  if [ -z "$dc_config" ]; then
    echo "==============================================================" >&2
    if [ "$build_devcontainer" = "yes" ]; then
      boot_err "$repo_folder has no devcontainer configuration found — the dev container will NOT build, and with the dev-container toggle on that means no editor and no in-container terminal either: this workspace's code-server and Grok hang off the dev-container sub-agent, and no dev container means no sub-agent to attach them to (recreate this workspace with the dev-container toggle set to No if the plain-container shape is what you want)."
    else
      boot_note "$repo_folder has no devcontainer configuration found — expected with the dev-container toggle off; the editor opens the clone directly."
    fi
    echo "==============================================================" >&2
  fi
fi

# --- Session archive (out-of-band backup) --------------------------------------
# A long-term copy of this workspace's session tree, written to one host-wide volume
# every workspace on this daemon shares. The Grok CLI never reads it and nothing here
# feeds it back: ~/.grok/sessions stays the only session state the CLI sees, and the
# hooks deny list refuses any agent command that names the archive path.
# docs/grok-build-and-agents.md#the-out-of-band-session-archive
boot_stage 9 "session archive"
ARCHIVE="/var/lib/grok-session-archive"
# The leaf is this workspace's own directory inside a volume every workspace shares, and
# the sanctioned reader accepts only a leaf of [A-Za-z0-9._-]. Fold anything else rather
# than trust it: a slash would write outside workspaces/, and an empty leaf would collect
# every workspace on this box into one mirror.
ARCHIVE_LEAF="$(hostname 2>/dev/null | tr -c 'A-Za-z0-9._-' '-' | sed 's/[-_.]*$//')"
[ -n "$ARCHIVE_LEAF" ] || ARCHIVE_LEAF="unknown"
DEST="$${ARCHIVE}/workspaces/$${ARCHIVE_LEAF}"
# A named volume Docker has never seen arrives root:root while the agent runs as coder,
# so take the mount point back the way the ~/.grok and ~/.shared volumes above do.
# Without this the mkdir below fails quietly and the mirror never starts.
if [ -n "$home_owner" ]; then
  $SUDO chown "$home_owner" "$ARCHIVE" 2>/dev/null || true
fi
mkdir -p "$DEST" 2>/dev/null || true
if [ ! -w "$ARCHIVE" ] || [ ! -w "$DEST" ]; then
  # Both are checked. The leaf, because a writable mount point with an unwritable leaf
  # would print ok: about a mirror that writes nothing. The volume root, because the
  # per-workspace lock below is created in it, and flock failing there kills a loop
  # this stage would already have reported as started.
  boot_warn "session archive skipped (archive or leaf not writable under $ARCHIVE)"
elif ! command -v flock >/dev/null 2>&1; then
  boot_warn "session archive skipped (no flock to keep one mirror per workspace)"
else
  # Background mirror. No --delete: keep historical files even if a live session is
  # pruned. The sessions directory is re-tested inside the loop because the CLI creates
  # it on its first run, which can land well after this boot. flock -n is what keeps the
  # stage idempotent: Coder re-runs this body on every start, and a second loop over the
  # same leaf would only double the write rate. setsid keeps the mirror alive when the
  # start script exits, with nohup and the redirected fds covering an image that has no
  # setsid - the same shape the notes watcher uses in notes-setup.sh.
  mirror_wrapper=""
  if command -v setsid >/dev/null 2>&1; then
    mirror_wrapper="setsid"
  fi
  (
    # shellcheck disable=SC2086  # an empty wrapper has to vanish, not be one argument
    $mirror_wrapper nohup flock -n "$${ARCHIVE}/.mirror-$${ARCHIVE_LEAF}.lock" sh -c '
      while :; do
        if [ -d "$1" ]; then
          rsync -a --exclude="*.tmp" --exclude="*.lock" "$1/" "$2/" 2>/dev/null || true
        fi
        sleep 180
      done
    ' _ "$HOME/.grok/sessions" "$DEST" </dev/null >/dev/null 2>&1 &
  )
  boot_ok "session archive sync started -> $DEST"
fi

boot_summary
