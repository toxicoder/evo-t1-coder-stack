# Secrets / local state — never commit
.env
# Per-repo scratch notes the workspace startup materializes at this clone's root
# (anchored: a notes.md under docs/ or anywhere else stays visible)
/notes.md
# Optional per-host Coder external-auth overrides (GitHub OAuth client secret
# lives here when the broker is enabled); compose mounts it into the coder
# container only if it exists.
coder.env
*.tfstate
*.tfstate.*
.terraform/
crash.log

# SSH / private key material
id_rsa
id_rsa.*
*.pem
.ssh/

# Browser/session scratch
browsed_files*

# Self-signed dashboard cert issued by scripts/bootstrap.sh
proxy/certs/

# Per-host Spark overrides (sparks/<host>.env), per-host run logs and the recipe repo
# cloned into sparks/<host>/. Generated by scripts/spark-configure.sh and
# scripts/spark-verify.sh; the clone is per host and stays outside this repo.
sparks/

# OS noise
.DS_Store
Thumbs.db

# Bazel
/bazel-*
MODULE.bazel.lock.old

# Docs site: package-lock.json is tracked, everything else here is generated.
# out/ is the static export the deploy job publishes; .source/ is written by the
# defineDocs macro; next-env.d.ts is rewritten by `next build`, which is why the
# Pages publisher checks gh-pages out in its own worktree.
docs-site/out/
docs-site/.next/
docs-site/.source/
docs-site/node_modules/
docs-site/next-env.d.ts
docs-site/tsconfig.tsbuildinfo
docs-site/scripts/__pycache__/
