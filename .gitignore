# Secrets / local state — never commit
.env
*.tfstate
*.tfstate.*
.terraform/
crash.log

# SSH / private key material
id_rsa
id_rsa.*
*.pem
.ssh/

# Browser/session scratch
browsed_files*

# Self-signed dashboard cert issued by scripts/bootstrap.sh
proxy/certs/

# Per-host Spark overrides (sparks/<host>.env), per-host run logs and the recipe repo
# cloned into sparks/<host>/. Generated by scripts/spark-configure.sh and
# scripts/spark-verify.sh; the clone is per host and stays outside this repo.
sparks/

# OS noise
.DS_Store
Thumbs.db
