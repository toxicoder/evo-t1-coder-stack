024":8,"3025":8,"3026":8,"3027":8,"3028":8,"3029":8,"3030":8,"3031":8,"3032":8,"3033":8,"3034":8,"3035":8,"3036":8,"3037":8,"3038":8,"3039":8,"3040":8,"3041":8,"3042":8,"3043":8,"3044":7,"3045":7,"3046":7,"3047":7,"3048":7,"3049":7,"3050":7,"3051":7,"3052":7}}},"docs":{"docs":{"1":{"id":"/branching","page_id":"/branching","type":"page","content":"Branching","breadcrumbs":["Docs"],"tags":["git","branching","ci"],"url":"/branching"},"2":{"id":"/branching-0","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching","content":"Trunk-based branch rules: main is the only long-lived branch, work branches are short-lived, and a pull request is the only way back in."},"3":{"id":"/branching-1","page_id":"/branching","type":"heading","tags":["git","branching","ci"],"url":"/branching#branching","content":"Branching"},"4":{"id":"/branching-2","page_id":"/branching","type":"heading","tags":["git","branching","ci"],"url":"/branching#main","content":"main"},"5":{"id":"/branching-3","page_id":"/branching","type":"heading","tags":["git","branching","ci"],"url":"/branching#work-branches","content":"Work branches"},"6":{"id":"/branching-4","page_id":"/branching","type":"heading","tags":["git","branching","ci"],"url":"/branching#commits-and-when-they-happen","content":"Commits, and when they happen"},"7":{"id":"/branching-5","page_id":"/branching","type":"heading","tags":["git","branching","ci"],"url":"/branching#issues-and-how-they-close","content":"Issues, and how they close"},"8":{"id":"/branching-6","page_id":"/branching","type":"heading","tags":["git","branching","ci"],"url":"/branching#ci-and-protection","content":"CI and protection"},"9":{"id":"/branching-7","page_id":"/branching","type":"heading","tags":["git","branching","ci"],"url":"/branching#scope","content":"Scope"},"10":{"id":"/branching-8","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#branching","content":"**What's on this page**"},"11":{"id":"/branching-9","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#branching","content":"What `main` is allowed to be, and what may not be committed to it"},"12":{"id":"/branching-10","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#branching","content":"How to cut, name and delete a short-lived work branch, and when the branch and its commits happen"},"13":{"id":"/branching-11","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#branching","content":"Where a hotfix branches from and where it lands first"},"14":{"id":"/branching-12","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#branching","content":"How an issue is read, referenced by the branch, and closed by the merge that fixes it"},"15":{"id":"/branching-13","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#branching","content":"What CI runs, what branch protection should require, and where secrets go"},"16":{"id":"/branching-14","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#branching","content":"**What this enables**"},"17":{"id":"/branching-15","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#branching","content":"Naming a branch and a commit so CI and `git log` read the way the rest of the repo does"},"18":{"id":"/branching-16","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#branching","content":"Recovering a half-finished change with one revert, because each landed step was committed as it landed"},"19":{"id":"/branching-17","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#branching","content":"Knowing which green check actually gates a merge into `main`"},"20":{"id":"/branching-18","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#branching","content":"Trunk-based, GitHub-Flow shaped: one long-lived branch, short-lived work branches, and a pull\nrequest as the only way back into `main`."},"21":{"id":"/branching-19","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#main","content":"`main` is the only long-lived branch. It stays green and deployable: `main` is what a\nmachine is built from, so a merge to `main` is by definition deployable to the stack host."},"22":{"id":"/branching-20","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#main","content":"Nothing is committed straight to `main`. Integration into `main` is by pull request, and a\nPR is only mergeable once CI is green:\n`bazelisk test //:test-fast`, `bazelisk test //:lint --test_tag_filters=manual` and the\nfull gate `bazelisk test //:test-all`, all\nexecuted inside the golden image (`images/dev/Dockerfile`) that CI builds with buildx and\ndocker-runs — the toolchain comes from that image, not from anything installed onto the\nrunner. Locally, run them the same way: inside the contributor container\n(contribute/devcontainer.md) or with\n`bazelisk run //scripts:test-in-image --`. `bash scripts/setup-host.sh` is the bootstrap\nfor the stack host, where the suites have to run on the host itself.\nTwo things run those checks for you so the gate is not a thing to remember:\n`bazelisk run //scripts:pre-commit` on demand, and, once\n`bazelisk run //scripts:install-hooks` has pointed `core.hooksPath` at `.githooks`,\n`.githooks/pre-commit` on every commit and `.githooks/pre-push` before anything is\npushed. `bazelisk run //:validate` runs the fast pair plus\n`docker compose config -q` and the `.env.sample`/`.env.example` comparison; the\npre-PR gate is `//:test-all`, which `//:validate` and the pre-push hook both reach."},"23":{"id":"/branching-21","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#work-branches","content":"Cut `feat/…`, `fix/…`, `refactor/…` (and `docs/…`, `test/…`, `chore/…`, `ci/…`) from the\ncurrent tip of `main`, one branch per change, and delete it the moment it merges. A branch\nthat outlives its change is a branch nobody rebases any more.\n`bazelisk run //scripts:branch-hygiene` is the check for that sentence and for the two\nbelow: it lists every branch the trunk already contains, every unmerged branch past the\nbranch lifetime, and every branch that carries an environment in its name, each printed\nwith its tip SHA because that is the record a deletion has to leave behind. It reports\nand never deletes - `--plan` prints the commands, and deleting stays the operator's call.\nPass `--fetch` before acting on what it names, so the remote rows are the remote's\ncurrent answer rather than the last one this checkout happened to see. That flag is\nthe run's only write: it is `git remote update --prune`, which refreshes and prunes\nthis checkout's own remote-tracking refs and deletes nothing on the remote."},"24":{"id":"/branching-22","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#work-branches","content":"`fix/…` means a defect that is already on `main`. **A hotfix branches from `main` and lands\non `main` first** — every environment deploys *from* `main` (or from a tag cut on `main`),\nso there is no `staging` or `production` branch to patch and then remember to merge back."},"25":{"id":"/branching-23","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#work-branches","content":"Name the branch after the change, not the author, and keep the commit subject imperative\nwith one of `feat:`, `fix:`, `docs:`, `test:`, `chore:`, `ci:`, `refactor:`."},"26":{"id":"/branching-24","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#work-branches","content":"Below the subject leave one empty line, then the bullet points, and leave an empty line\nbetween every two bullets, so each bullet is its own paragraph. The same rule is in\n`templates/common/GROK_BUILD_AGENTS.md`, which is the text every workspace seeds into\n`~/.grok/AGENTS.md`, so a commit written by an agent and one written by hand read the\nsame way in `git log`."},"27":{"id":"/branching-25","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#commits-and-when-they-happen","content":"The branch and the commits are in place while the work happens, and the push waits. This is the\norder the agent seed teaches and the order a human contributor gets the most out of:"},"28":{"id":"/branching-26","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#commits-and-when-they-happen","content":"**Branch first, then edit.** The work branch is cut as the first action of the change, off the\ntip of `main`. `main` is not a place to work: an agent edits it only when the operator asked for\nthat in words. Cut late and the branch is cheap to add anyway - `git switch -c` carries the\nworking tree with it - which is the fix, where `stash`, `reset --hard`, or `checkout -- .` to\nclean the tree is how an unfinished change is destroyed."},"29":{"id":"/branching-27","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#commits-and-when-they-happen","content":"**Commit each unit as it lands.** A unit is what a reviewer reads as one step: a script with its\nBats file, a template with its twin, a flag with the docs that name it. Commit when that unit's\nown check is green, then start the next one. `git log --oneline main..HEAD` then shows the shape\nof the change, and a wrong turn is one `git revert` away instead of a lost afternoon."},"30":{"id":"/branching-28","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#commits-and-when-they-happen","content":"**Stage by path.** `git add <path> <path>`, and read the index back with\n`git diff --cached --name-only`. `git add -A`, `git add .`, and `git commit -a` are how a scratch\nfile, a build artifact, or someone else's edit walks into a commit - and the secret hygiene rule\nabove depends on the agent being able to say what is in each one."},"31":{"id":"/branching-29","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#commits-and-when-they-happen","content":"**A local commit is free, a push is not.** Nothing leaves the machine until you push, so err\ntoward committing, including a `WIP:` checkpoint before a step that might break something green.\nHistory is local until then, so amend the message, fold the checkpoint into the commit it belongs\nto, and reorder there; that door closes at the push, after which a shared commit is never\nrewritten."},"32":{"id":"/branching-30","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#commits-and-when-they-happen","content":"**Push once, when the pull request opens**, and pre-flight it: the log above reads as one commit\nper unit with imperative prefixed subjects, `git diff --stat main...HEAD` matches what was meant,\nand no `.env`, token, key, or workspace-local state is in any commit."},"33":{"id":"/branching-31","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#commits-and-when-they-happen","content":"Small commits cost nothing at the gate: `.githooks/pre-commit` runs the hermetic half on every\ncommit and `.githooks/pre-push` runs the full set before anything leaves the machine, so a stream of\nfocused commits is held to the same bar as one large one. See `main` for installing them."},"34":{"id":"/branching-32","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#issues-and-how-they-close","content":"Every change answers something, and the tracker is where the answer gets recorded. This is the\nsame etiquette `templates/common/GROK_BUILD_AGENTS.md` teaches every workspace, so a bug an agent\nfixes and a bug a human fixes leave the tracker in the same state."},"35":{"id":"/branching-33","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#issues-and-how-they-close","content":"**Read the report before you plan.** `gh issue view <n> --comments` is the requirements and the\nreproduction in one place, and it is the wording the change is measured against. An agent reads\nit through `env -u GH_TOKEN -u GITHUB_TOKEN gh ...` for the reason in\ntroubleshooting.md."},"36":{"id":"/branching-34","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#issues-and-how-they-close","content":"**Search before you file.** `gh issue list --state open --search '<keywords> in:title,body'`,\nthen the same with `--state closed`. A duplicate becomes a link to the original, something\n`main` already fixed becomes a comment naming the commit, and only a genuinely new report\nbecomes `gh issue create` - with the reproduction and the verbatim output in its body."},"37":{"id":"/branching-35","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#issues-and-how-they-close","content":"**Announce a long fix.** For anything past an obvious edit, a short comment saying what is about\nto change lets a maintainer redirect the work early and keeps two people off the same file."},"38":{"id":"/branching-36","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#issues-and-how-they-close","content":"**Name the issue in the branch, close it in one place.** A bug fix branches as `fix/<n>-<slug>`,\nand the closing keyword goes in the pull request body only. GitHub auto-links `#<n>` in a commit\nsubject too, so repeating `Fixes #<n>` down the branch multiplies one link and hides which\ncommit answers the report."},"39":{"id":"/branching-37","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#issues-and-how-they-close","content":"**Let the merge close it.** `Closes #<n>` / `Fixes #<n>` claim the pull request fully satisfies\nthe report, and GitHub closes the issue when it lands on the default branch - a merge a human\nperforms. `Refs #<n>` is the keyword for a pull request that is one step of the work, or lands\nbefore the fix. Nobody closes an issue by hand to announce that a pull request exists."},"40":{"id":"/branching-38","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#issues-and-how-they-close","content":"**A bug fix ships with its proof.** The test that fails before the change and passes after it,\nwith the reproduction's failing output quoted in the pull request. \"Cannot reproduce\" is a\nfinding to post on the issue, and the issue stays open."},"41":{"id":"/branching-39","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#issues-and-how-they-close","content":"**Triage belongs to a person.** Closing, reopening, reassigning, labelling and milestoning are\nthe maintainer's calls, and an agent makes them only when the operator asked for that in words."},"42":{"id":"/branching-40","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#ci-and-protection","content":"The `ci` workflow (`.github/workflows/ci.yml`) runs for `push` to `main` and for a\n`pull_request` whose **base** is `main` or one of the sanctioned work-branch prefixes\n(`feat/**`, `fix/**`, `refactor/**`, `docs/**`, `test/**`, `chore/**`, `ci/**`).\n`pull_request.branches` filters on the base rather than the head, so naming only\n`main` left a stacked pull request - a dependent branch that names its parent as its\nbase, the shape the agent guidance in `templates/common/GROK_BUILD_AGENTS.md` tells\nyou to open - with no gate at all: it collected\njust the docs deploy its branch push earned from `deploy-docs`. Gate a stack the same\nway as any other pull request. The other shipped workflow, `deploy-docs`, also runs\non a `push` to any branch (`branches: [\"**\"]`) whose diff touches its `paths:` list -\n`docs/**`, `docs-site/**`, the two `scripts/ci/` helpers it publishes through\n(`publish-pages-tree.sh`, `docs-alias.sh`), and its own workflow file - and by\n`workflow_dispatch`."},"43":{"id":"/branching-41","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#ci-and-protection","content":"Branch protection on `main` should require a pull request before pushing, and the two\nBazel checks before merging — `//:test-fast` and `//:lint`, run inside the golden image\nthe workflow builds, so a green check means the suite passed on the Linux toolchain the\nstack actually ships rather than on whatever the runner image carried that day."},"44":{"id":"/branching-42","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#ci-and-protection","content":"Environments are where future protection rules and secrets go, per environment:\n`development`, `staging`, `production`. `production` stays restricted to `main` — or to\ntags — with required reviewers. See the header comment in `.github/workflows/ci.yml`.\nThose three words are environments and never branch names, and\n`bazelisk run //scripts:branch-hygiene` is what keeps that honest: a branch or a\nremote-tracking ref named `dev`, `staging`, `prod`, `uat` or the like - bare, or as the\nfirst segment of a path - is an error and exits 1. It is an operator CLI rather than a\nCI step on purpose: the branches that break the rule live on the remote, where a job\nchecked out at `main` cannot see them."},"45":{"id":"/branching-43","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#scope","content":"A `fix/…` branch that also has to rename a template directory, retarget a `.bats` suite, and\nupdate `docs/` is one change: the rename is not green until the last reference follows.\nWhen a rename cannot be proven complete, the reference stays (a rename is only \"done\" when\nthe old name is gone outside historical docs) and the CI file says so in a comment."},"46":{"id":"/coder-templates","page_id":"/coder-templates","type":"page","content":"Coder workspace templates","breadcrumbs":["Docs"],"tags":["coder","templates","workspaces","terraform"],"url":"/coder-templates"},"47":{"id":"/coder-templates-0","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates","content":"Deep reference for `templates/workspace/` and `templates/devcontainer/`: what they build, how they get pushed, and what every variable means."},"48":{"id":"/coder-templates-1","page_id":"/coder-templates","type":"heading","tags":["coder","templates","workspaces","terraform"],"url":"/coder-templates#coder-workspace-templates","content":"Coder workspace templates"},"49":{"id":"/coder-templates-2","page_id":"/coder-templates","type":"heading","tags":["coder","templates","workspaces","terraform"],"url":"/coder-templates#what-the-two-templates-make","content":"What the two templates make"},"50":{"id":"/coder-templates-3","page_id":"/coder-templates","type":"heading","tags":["coder","templates","workspaces","terraform"],"url":"/coder-templates#the-templatescommon-payloads","content":"The `templates/common/` payloads"},"51":{"id":"/coder-templates-4","page_id":"/coder-templates","type":"heading","tags":["coder","templates","workspaces","terraform"],"url":"/coder-templates#presets","content":"Presets"},"52":{"id":"/coder-templates-5","page_id":"/coder-templates","type":"heading","tags":["coder","templates","workspaces","terraform"],"url":"/coder-templates#how-push-template-works","content":"How `push-template` works"},"53":{"id":"/coder-templates-6","page_id":"/coder-templates","type":"heading","tags":["coder","templates","workspaces","terraform"],"url":"/coder-templates#what-it-does-and-does-not-do","content":"What it does and does not do"},"54":{"id":"/coder-templates-7","page_id":"/coder-templates","type":"heading","tags":["coder","temp