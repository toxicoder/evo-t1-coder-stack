"""Package purpose: ShellCheck, shfmt, and buildifier. Host tools, tagged manual."""

load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:private"])

sh_test(
    name = "shell",
    srcs = ["run_shellcheck.sh"],
    data = [
        "check_tool.sh",
        "//:fix.sh",
        "//scripts:doc_sources",
        "//scripts:validate.sh",
    ],
    tags = [
        "lint",
        "local",
        "manual",
        "no-sandbox",
        "shellcheck",
    ],
)

sh_test(
    name = "shfmt",
    srcs = ["run_shfmt.sh"],
    data = [
        "check_tool.sh",
        "//:fix.sh",
        "//scripts:doc_sources",
        "//scripts:validate.sh",
    ],
    tags = [
        "lint",
        "local",
        "manual",
        "no-sandbox",
        "shfmt",
    ],
)

sh_test(
    name = "buildifier",
    srcs = ["buildifier_check.sh"],
    data = ["check_tool.sh"],
    tags = [
        "buildifier",
        "lint",
        "local",
        "manual",
        "no-sandbox",
    ],
)

test_suite(
    name = "all",
    tags = ["lint"],
    tests = [
        ":buildifier",
        ":shell",
        ":shfmt",
    ],
    visibility = ["//visibility:public"],
)
