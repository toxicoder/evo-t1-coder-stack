"""Package purpose: ShellCheck, shfmt, mypy, and buildifier. Host tools, tagged manual."""

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tools:exec_shell.bzl", "exec_shell")

package(default_visibility = ["//visibility:private"])

# This package's own target declarations, for the dependency gate in //tests.
filegroup(
    name = "build_file",
    srcs = ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

# The lint runners themselves, as a group a suite can declare. //tests:bats_mypy_lint_test
# reads run_mypy.sh by path to pin its target list against the data edge below, and a
# runner is not payload any other package owns. check_tool.sh rides along because every
# runner sources it, and a suite that reads one runner reads the probe with it.
filegroup(
    name = "runners",
    srcs = [
        "buildifier_check.sh",
        "check_tool.sh",
        "run_mypy.sh",
        "run_shellcheck.sh",
        "run_shfmt.sh",
    ],
    visibility = ["//visibility:public"],
)

# Every first-party shell file the two shell linters walk: one list, shared by :shell and
# :shfmt, whose contents equal the scan set rather than a subset of it.
#
# It mirrors, entry for entry, the scan_dirs line in each runner —
#   run_shellcheck.sh:16  scan_dirs=(scripts lints tests .github templates/common docs)
#   run_shfmt.sh:15       scan_dirs=(scripts lints tests .github templates/common docs)
# — plus the fix.sh each appends after the find (run_shellcheck.sh:22, run_shfmt.sh:21),
# minus tests/bats/tool_stubs/, which both find calls exclude. Edit one side and edit the
# other: a runner that gains a scan_dir without this list keeps linting files a sandboxed
# run never shipped into the tree.
#
# The under-declaration stayed invisible because bazel_checkout_root in check_tool.sh
# falls back to resolving the runfiles symlinks back into the real checkout, so the find
# always saw the whole repo. This data is the honest declaration: a sandboxed run needs
# exactly this set and nothing more.
_LINT_SHELL_SOURCES = [
    # lints/: the runners and the host-tool probe they all source.
    "buildifier_check.sh",
    "check_tool.sh",
    "run_mypy.sh",
    "run_shellcheck.sh",
    "run_shfmt.sh",
    "//:ci_lint_installer",  # .github/: install-lint-tools.sh is the only shell there
    "//:fix.sh",
    "//docs:manage-docs.sh",  # docs/: the only shell there
    "//scripts:doc_sources",  # scripts/: every CLI and every sourced lib
    "//templates/common:payload",  # templates/common/: notes-setup.sh, the terminal scripts
    # tests/: the shell its runners and coverage drivers are made of. tests/bats/ holds
    # .bats, fixtures and tool_stubs, which the find either excludes or does not match.
    "//tests:shell_sources",
]

exec_shell(
    name = "shell_exec",
    src = "run_shellcheck.sh",
    data = ["check_tool.sh"],
)

sh_test(
    name = "shell",
    srcs = [":shell_exec"],
    data = _LINT_SHELL_SOURCES,
    tags = [
        "lint",
        "local",
        "manual",
        "no-sandbox",
        "shellcheck",
    ],
)

exec_shell(
    name = "shfmt_exec",
    src = "run_shfmt.sh",
    data = ["check_tool.sh"],
)

sh_test(
    name = "shfmt",
    srcs = [":shfmt_exec"],
    data = _LINT_SHELL_SOURCES,
    tags = [
        "lint",
        "local",
        "manual",
        "no-sandbox",
        "shfmt",
    ],
)

# run_mypy.sh is the Python half of this package and the only runner here whose input is
# not shell. Its scan list is the `targets` array in the runner, and this data edge is the
# honest declaration of exactly that list: the three Python groups plus //:mypy_config,
# which the runner names with `--config-file mypy.ini`. //tests:py_coverage carries the
# same Python through a different set of groups, and the runner's header comment says
# which side to edit when a new package starts shipping .py files.
exec_shell(
    name = "mypy_exec",
    src = "run_mypy.sh",
    data = ["check_tool.sh"],
)

sh_test(
    name = "mypy",
    size = "medium",
    srcs = [":mypy_exec"],
    data = [
        "//:mypy_config",
        "//docs-site:python_sources",
        "//scripts:py_programs",
        "//tests:python_sources",
    ],
    tags = [
        "lint",
        "local",
        "manual",
        "mypy",
        "no-sandbox",
    ],
)

# buildifier_check.sh walks every BUILD, BUILD.bazel, MODULE.bazel and *.bzl in the repo,
# which is exactly what //:bazel_files enumerates, so that group and not the shell list is
# the input here.
exec_shell(
    name = "buildifier_exec",
    src = "buildifier_check.sh",
    data = ["check_tool.sh"],
)

sh_test(
    name = "buildifier",
    srcs = [":buildifier_exec"],
    data = [
        "check_tool.sh",
        "//:bazel_files",
    ],
    tags = [
        "buildifier",
        "lint",
        "local",
        "manual",
        "no-sandbox",
    ],
)

test_suite(
    name = "all",
    tags = ["lint"],
    tests = [
        ":buildifier",
        ":mypy",
        ":shell",
        ":shfmt",
    ],
    visibility = ["//visibility:public"],
)
