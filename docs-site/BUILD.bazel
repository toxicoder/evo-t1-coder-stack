"""Package purpose: Fumadocs (Next.js App Router) documentation site — npm runners, typecheck and the unit gates.

The site renders the markdown/MDX content in the sibling `docs/` package, so the content
data dependencies below come from `//docs:content`. Keeping content out of this package
means the pages stay at the paths the README and the published aliases link to.

The gates here are npm-backed and therefore `manual`: they need a real `node_modules`,
which `//:test-fast` does not install. CI runs them in the `docs` job of
`.github/workflows/ci.yml`; `//:validate` and `//:test-fast` stay hermetic.

Usage:
  bazelisk run //docs-site:install       # npm ci from the pinned lockfile
  bazelisk run //docs-site:dev           # dev server (hot reload)
  bazelisk run //docs-site:build         # static export into docs-site/out/
  bazelisk run //docs-site:build-latest  # export with the /latest basePath
  bazelisk run //docs-site:typecheck     # next typegen + tsc --noEmit
  bazelisk test //docs-site:unit         # Vitest suite (widgets, transforms, page contract)
  bazelisk test //docs-site:unit_coverage # the same suites with the v8 coverage gate
  bazelisk test //docs-site:nav_test     # the nav generator's own tests
  bazelisk run //docs-site:build && bazelisk test //docs-site:verify  # verify reads docs-site/out/
  bazelisk run //docs-site:npm -- <args> # escape hatch
"""

load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:private"])

# This package's own target declarations, for the dependency gate in //tests.
filegroup(
    name = "build_file",
    srcs = ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

_NPM_DATA = [
    ":sources",
    "//docs:content",
]

# Named groups under :sources so a consumer asks for what it runs instead of the whole
# tree. Every group is public: //docs and //tests pull these directly, and the runners
# only ever receive their files through a data edge, so nothing here needs exports_files.
#
# Whether the data edge carries any weight depends on how the runner starts. Both
# runners prefer BUILD_WORKSPACE_DIRECTORY and cd into the real docs-site/, so any
# `bazel run`/`bazel test` invoked from inside the checkout ignores the data files
# entirely; they are the fallback for a foreign cwd (SCRIPT_DIR), where runfiles is all
# the runner has. Per target:
#   install      only `npm ci` runs, which reads package.json + package-lock.json, so
#                :npm_manifest + :runners is the whole fallback.
#   nav_test     `unittest discover` runs the suite out of runfiles, so :python_sources
#                and :runners are load-bearing there. The generator's REPO_ROOT comes
#                from Path(__file__).resolve(), which follows the runfiles symlink back
#                into the checkout, so the docs/ pages it validates and the nav.json it
#                reads come from the checkout, not from :docs:content — that edge is
#                declared for honesty about what the generator touches, not because the
#                sandbox copy is ever opened.
#   unit_coverage run_in_real_checkout() refuses to measure symlinked sources (v8 reads
#                0%), so it demands the checkout and its data is never consulted; it
#                keeps the full tree only so the target stays runnable the same way the
#                other npm gates are.
#   the rest     Next's build, Vitest, tsc and verify_site.mjs read pages, components,
#                lib/, the configs and the sibling docs/ content, so :sources is honest.

filegroup(
    name = "npm_manifest",
    srcs = [
        "package.json",
        "package-lock.json",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "app",
    srcs = glob(
        ["app/**"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "components",
    srcs = glob(
        ["components/**"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "lib",
    srcs = glob(
        ["lib/**"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "site_scripts",
    srcs = glob(
        ["scripts/**"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "unit_tests",
    srcs = glob(
        ["tests/**"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "configs",
    srcs = [
        "next.config.ts",
        "postcss.config.mjs",
        "source.config.ts",
        "tsconfig.json",
        "vitest.config.ts",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "static",
    srcs = ["pages-root-index.html"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "runners",
    srcs = [
        "run_npm.sh",
        "run_python_test.sh",
    ],
    visibility = ["//visibility:public"],
)

# What //tests:py_coverage runs in this tree: tests/coverage/py_cov.sh discovers
# docs-site:test_gen_nav.py, which imports scripts/gen_nav.py. Nothing else here is a
# Python test entry point.
filegroup(
    name = "python_sources",
    srcs = glob(
        ["test_*.py"],
        allow_empty = True,
    ) + ["scripts/gen_nav.py"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "sources",
    srcs = [
        ":app",
        ":components",
        ":configs",
        ":lib",
        ":npm_manifest",
        ":python_sources",
        ":runners",
        ":site_scripts",
        ":static",
        ":unit_tests",
    ],
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "install",
    srcs = ["run_npm.sh"],
    data = [
        ":npm_manifest",
        ":runners",
    ],
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "dev",
    srcs = ["run_npm.sh"],
    data = _NPM_DATA,
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "build",
    srcs = ["run_npm.sh"],
    data = _NPM_DATA,
    visibility = ["//visibility:public"],
)

# Each published alias is its own export: DOCS_ALIAS sets Next's basePath so the asset
# URLs carry /<repo>/<alias>/ instead of asking the GitHub Pages root for them.
sh_binary(
    name = "build-latest",
    srcs = ["run_npm.sh"],
    data = _NPM_DATA,
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "serve",
    srcs = ["run_npm.sh"],
    data = _NPM_DATA,
    visibility = ["//visibility:public"],
)

# npm-backed checks: tagged manual so //:test-fast and //:lint stay hermetic (a sandboxed
# test action has no node_modules and must not reach the network for one).
sh_test(
    name = "typecheck",
    size = "medium",
    timeout = "moderate",
    srcs = ["run_npm.sh"],
    data = _NPM_DATA,
    tags = [
        "manual",
        "no-sandbox",
    ],
    visibility = ["//visibility:public"],
)

sh_test(
    name = "unit",
    size = "medium",
    timeout = "moderate",
    srcs = ["run_npm.sh"],
    data = _NPM_DATA,
    tags = [
        "manual",
        "no-sandbox",
    ],
    visibility = ["//visibility:public"],
)

sh_test(
    name = "verify",
    size = "medium",
    timeout = "moderate",
    srcs = ["run_npm.sh"],
    data = _NPM_DATA,
    tags = [
        "manual",
        "no-sandbox",
    ],
    visibility = ["//visibility:public"],
)

# Measured coverage of the site's application code: every function in lib/,
# components/, app/api/ and scripts/ must be reached by a suite, at the thresholds
# in vitest.config.ts. Kept out of `unit` so the hermetic-suite ingress stays a
# pass/fail on behaviour and this stays the coverage question.
sh_test(
    name = "unit_coverage",
    size = "medium",
    timeout = "long",
    srcs = ["run_npm.sh"],
    data = _NPM_DATA,
    tags = [
        "manual",
        "no-sandbox",
    ],
    visibility = ["//visibility:public"],
)

# The nav generator writes the tree the sidebar imports; its tests cover the drift check
# and the on-disk page validation that //docs-site:nav_test gates.
sh_test(
    name = "nav_test",
    size = "small",
    srcs = ["run_python_test.sh"],
    data = [
        ":python_sources",
        ":runners",
        "//docs:content",
    ],
    tags = ["no-sandbox"],
    visibility = ["//visibility:public"],
)

# Generic escape hatch: bazelisk run //docs-site:npm -- ci --force
sh_binary(
    name = "npm",
    srcs = ["run_npm.sh"],
    data = _NPM_DATA,
    visibility = ["//visibility:public"],
)
