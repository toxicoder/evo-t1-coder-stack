{
  "name": "evo-t1-docs-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:latest": "DOCS_ALIAS=latest next build",
    "typecheck": "next typegen && tsc --noEmit",
    "nav:generate": "python3 scripts/gen_nav.py",
    "nav:check": "python3 scripts/gen_nav.py --check",
    "unit": "vitest run",
    "unit:coverage": "vitest run --coverage",
    "verify": "tsx scripts/verify_site.mjs",
    "serve": "node scripts/serve_static.mjs"
  },
  "dependencies": {
    "fumadocs-core": "^16.15.11",
    "fumadocs-mdx": "^15.4.1",
    "fumadocs-ui": "^16.15.11",
    "mermaid": "^12.0.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
