"""Package purpose: Root Bazel targets. Bazelisk is the primary ingress.

  bazelisk test //:test-fast
  bazelisk test //:lint --test_tag_filters=manual
  bazelisk run //:validate
  bazelisk run //:fix
  bazelisk run //scripts:<stem> -- <args>

docs/contribute/building-with-bazel.md and docs/contribute/test-with-bazel.md
explain the harness; docs/branching.md the branch rules that CI guards.
"""

load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//tools:exec_shell.bzl", "exec_shell")

package(default_visibility = ["//visibility:private"])

exports_files([
    "fix.sh",
    "CONTRIBUTING.md",
    "README.md",
    "Makefile",
    "LICENSE",
    "docker-compose.yml",
])

# Payload the operational scripts read by path after they resolve a repo root:
# the compose file, both template payload trees, the golden-image pins, the
# LiteLLM routing file, the two .env samples, and the license that ships beside
# them. scripts/**.sh reaches runfiles through //scripts:doc_sources, not here.
filegroup(
    name = "stack_data",
    srcs = [
        ".env.example",
        ".env.sample",
        "LICENSE",
        "docker-compose.yml",
    ] + glob(
        [
            "images/dev/**",
            "litellm/**",
            "templates/**",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "ci_workflows",
    srcs = [
        ".github/actions/setup-bazel/action.yml",
        ".github/scripts/install-lint-tools.sh",
        ".github/workflows/ci.yml",
    ],
    visibility = ["//visibility:public"],
)

alias(
    name = "bats",
    actual = "//tests:bats",
    visibility = ["//visibility:public"],
)

test_suite(
    name = "test-fast",
    tests = [
        "//tests:bats",
        "//tests:doc_coverage",
        "//tests:shell_inventory",
    ],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "test",
    tests = [":test-fast"],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "lint",
    tags = ["lint"],
    tests = ["//lints:all"],
    visibility = ["//visibility:public"],
)

exec_shell(
    name = "fix_exec",
    src = "fix.sh",
)

sh_binary(
    name = "fix",
    srcs = [":fix_exec"],
    visibility = ["//visibility:public"],
)

alias(
    name = "validate",
    actual = "//scripts:validate",
    visibility = ["//visibility:public"],
)
