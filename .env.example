# EVO-T1 Coder stack environment template.
# Copy to .env (bootstrap.sh does this) and edit. Never commit .env.
# Each key: what it is, then `Set:` how to choose the value.
# Sections are the `# ---` banners. Long form for GitHub external auth,
# Grok profile mode, public hosts, and the Spark `agent` group:
# docs/config-updates.md

# --- Coder ----------------------------------------------------------------

# Coder UI host port. Kasm already binds 3000.
# Set: unused TCP port on the stack host. Default 3001.
CODER_HTTP_PORT=3001

# Second Coder listener for workspace agents on host.docker.internal.
# Set: unused TCP port. Default 3002. See coder_agent_url in templates/workspace.
CODER_AGENT_TUNNEL_PORT=3002

# URL workspaces use to call back to Coder. Must be https and LAN-routable,
# not localhost. Set: bootstrap.sh fills your LAN IP when it can.
# Self-signed cert: expect a first-visit browser warning.
CODER_ACCESS_URL=https://YOUR_LAN_IP:3001

# Postgres password for Coder's database. The db wrapper re-applies it on
# every start, so rotating here then `prod-stack up` (or `dev-stack up`) is enough.
# Set: any strong secret. bootstrap.sh replaces change-me-* on first run.
CODER_PG_PASSWORD=change-me-postgres

# Prometheus metrics for the Coder control plane, bound to 127.0.0.1 only.
# Set: unused TCP port. Scrape http://127.0.0.1:<port>/metrics on the stack host.
CODER_METRICS_PORT=2112

# Browser session lifetime. The product 24h default is too short on a
# single-user box.
# Set: a Go duration. Default 720h (30 days).
CODER_SESSION_DURATION=720h

# CLI/API-key lifetime. Same Go duration units as CODER_SESSION_DURATION.
# Set: a Go duration. Default 720h so keys do not expire weekly.
CODER_DEFAULT_TOKEN_LIFETIME=720h

# OAuth refresh lifetime. Must be STRICTLY greater than CODER_SESSION_DURATION
# or the server refuses to boot. Maps to CODER_DEFAULT_OAUTH_REFRESH_LIFETIME.
# Set: a Go duration. Default 8760h (1 year).
CODER_OAUTH_REFRESH_LIFETIME=8760h

# Coder marks the deployment unhealthy after 5 slow median-query probes.
# Set: a duration. Default 60ms (the product 15ms trips when a model is loaded).
CODER_HEALTH_CHECK_THRESHOLD_DATABASE=60ms

# Quiet hours clamp autostop deadlines, so the timezone is load-bearing.
# Set: a quoted CRON_TZ=<Area/City> cron expression. Default UTC 03:00.
CODER_QUIET_HOURS="CRON_TZ=UTC 0 3 * * *"

# Built-in DERP STUN. Keep disable: Google STUN buys nothing on a LAN,
# and agents already connect directly over WireGuard.
# Set: disable (recommended).
CODER_DERP_STUN=disable

# Coder experiment opt-ins, comma-separated.
# Set: names from `coder server --help`. Empty = none. `agents` is not a name in 2.36.6.
CODER_EXPERIMENTS=

# --- Grok profile ---------------------------------------------------------

# Default for the create-form Grok profile dropdown (read once per push-template).
# Set: shared (one volume per user, last start wins) or private (dies with the workspace).
# Rebuild to switch. docs/config-updates.md#grok-profile-mode
GROK_PROFILE_MODE=shared

# --- GitHub / MCP ---------------------------------------------------------

# GitHub credentials are Coder External Auth only. Do not add
# CODER_EXTERNAL_AUTH_0_* here: a defined-but-empty key crash-loops coder.
# Custom OAuth app, callback URL, and the Coder GitHub App install:
# docs/config-updates.md#github-external-auth-and-coderenv

# GitHub MCP HTTP server in every workspace's ~/.grok/config.toml (default on).
# Set: empty or true to keep; false and re-push to drop [mcp_servers.github].
# Uses Coder External Auth ($GH_TOKEN), never a PAT. docs/coder-templates.md
GITHUB_MCP=

# Cached Context7 MCP server (default on). Needs outbound network.
# Set: empty or true to keep; false and re-push to drop [mcp_servers.context7].
# docs/coder-templates.md
CONTEXT7_MCP=

# Context7 API key from https://context7.com/dashboard. Forwarded as a
# sensitive template variable; config.toml names it and never stores the value.
# Set: the dashboard key, or empty for the public rate limit. Never commit a real key.
CONTEXT7_API_KEY=

# SearXNG MCP fallback (default on). Native web_search stays unless config.toml
# sets disable_web_search = true. docs/grok-build-and-agents.md
# Set: empty or true to keep; false and re-push to drop [mcp_servers.searxng].
SEARCH_MCP=

# Host port compose publishes for SearXNG. Workspaces dial
# http://host.docker.internal:<this>, so a remap needs a template re-push.
# Set: unused TCP port. Default 8181 matches docker-compose.yml.
STACK_SEARCH_PORT=8181

# --- LiteLLM + Spark ------------------------------------------------------

# Model gateway host port. Sole model transport for the stack.
# Set: unused TCP port. Default 4000.
LITELLM_PORT=4000

# Master key every client authenticates to LiteLLM with.
# Set: any strong secret. bootstrap.sh replaces change-me-* on first run.
LITELLM_MASTER_KEY=change-me-litellm

# Spark box 1 Ollama endpoint, behind the spark-1 alias.
# Set: real Ollama URL, or leave the placeholder (the alias fails when used).
SPARK1_OLLAMA_URL=http://spark-1.lan:11434

# Spark box 2 Ollama endpoint, behind the spark-2 alias.
# Set: real Ollama URL, or leave the placeholder (the alias fails when used).
SPARK2_OLLAMA_URL=http://spark-2.lan:11434

# Spark box 1 OpenAI-compatible /v1 endpoint. One of three in the `agent` group.
# Set: real TensorFold/vLLM URL. Empty on all three leaves `agent` unusable
# (LiteLLM falls back to `coder`). docs/config-updates.md#spark-agent-model-group
SPARK1_OPENAI_URL=http://spark-1.lan:8888/v1

# Spark box 2 of the `agent` group (OpenAI-compatible /v1).
# Set: real TensorFold/vLLM URL, or leave the placeholder.
SPARK2_OPENAI_URL=http://spark-2.lan:8888/v1

# Spark box 3 of the `agent` group (OpenAI-compatible /v1).
# Set: real TensorFold/vLLM URL, or leave the placeholder.
SPARK3_OPENAI_URL=http://spark-3.lan:8888/v1

# Bearer token for SPARK1_OPENAI_URL. Empty is not valid (LiteLLM fails at
# client construction). `local-spark` is not a secret.
# Set: any non-empty string on a keyless box, or the real key if started with --api-key.
SPARK_1_API_KEY=local-spark

# Bearer token for SPARK2_OPENAI_URL. Same rules as SPARK_1_API_KEY.
# Set: any non-empty string on a keyless box, or the real --api-key value.
SPARK_2_API_KEY=local-spark

# Bearer token for SPARK3_OPENAI_URL. Same rules as SPARK_1_API_KEY.
# Set: any non-empty string on a keyless box, or the real --api-key value.
SPARK_3_API_KEY=local-spark

# Optional per-box health URLs for the dashboard Spark cards (one widget
# per box). Compose already defaults each to http://spark-<n>.lan:8888/health.
# Uncomment and set to the real hostname when the placeholder does not resolve.
# SPARK1_HEALTH_URL=http://spark-1.lan:8888/health
# SPARK2_HEALTH_URL=http://spark-2.lan:8888/health
# SPARK3_HEALTH_URL=http://spark-3.lan:8888/health

# /v1/models URL for the dashboard "Agent backend" card (tool-capable route
# vs the text-only Arc fallback). All three boxes serve the same model id.
# Set: any reachable SPARKn_OPENAI_URL plus /models.
AGENT_MODEL_URL=http://spark-2.lan:8888/v1/models

# --- Workspace golden image -----------------------------------------------

# Workspace container image. Built by `bazelisk run //scripts:build-dev-image`
# and referenced by name, so it never pulls. bootstrap.sh builds it when missing.
# Set: evo-t1-dev:latest (default) or a Coder base image if you skip the build.
DEV_IMAGE=evo-t1-dev:latest

# Default Git URL on the create form (both templates). This stack's repo so
# VS Code Web opens ~/workspace/evo-t1-coder-stack. Empty keeps each template default.
# Set: a git URL, or empty. Per-workspace: the form, or new-workspace -- <git-url>.
REPO_URL=https://github.com/toxicoder/evo-t1-coder-stack.git

# Additional repositories have no key here. One repo per workspace is the
# default; extras are opted in per workspace on the create form's
# "Git repositories (additional)" field or `--additional-repos "url1,url2"`
# on new-workspace. They never become the folder the editor opens on.

# Docker-in-docker is the create form's "Docker-in-docker" Yes/No
# (preset "AI workspace + DinD"), fixed at create time. Needs
# docker:29.8.1-dind in the host image store; bootstrap.sh pulls it.

# SKIP_DEV_IMAGE_BUILD=1, SKIP_TEMPLATE_PUSH=1 and SKIP_SPARKS=1 change
# what bootstrap.sh does. They are read from the process environment only,
# never from this file. Export them in the shell that runs
# `bazelisk run //scripts:bootstrap`.

# --- Ollama (IPEX-LLM on the Arc 140T) ------------------------------------

# Models `bazelisk run //scripts:pull-models` fetches (first run is large).
# Set: space-separated Ollama model tags the Arc 140T can hold.
OLLAMA_MODELS="qwen2.5-coder:32b qwen2.5-coder:14b qwen2.5:7b"

# --- Kasm -----------------------------------------------------------------

# Kasm first-boot install wizard host port.
# Set: unused TCP port. Default 3000 (this is why Coder is on 3001).
KASM_WIZARD_PORT=3000

# Kasm UI host port after the wizard finishes.
# Set: unused TCP port. Default 4443.
KASM_UI_PORT=4443

# --- Homepage dashboard ---------------------------------------------------

# Dashboard HTTP host port. The nginx sidecar owns this; 80 redirects to TLS.
# Set: unused TCP port. Default 80.
HOMEPAGE_HTTP_PORT=80

# Dashboard TLS port, terminated with the self-signed cert in proxy/certs/
# (gitignored; bootstrap.sh writes it).
# Set: unused TCP port. Default 443.
HOMEPAGE_HTTPS_PORT=443

# Router sidecar's plain-HTTP port for public subdomains. Traefik points
# its routers here (proxy/router.conf routes by Host).
# Set: unused TCP port. Default 8080.
STACK_PROXY_HTTP_PORT=8080

# Hostname the browser uses to reach the dashboard on the LAN.
# Set: leave empty; bootstrap.sh fills it from CODER_ACCESS_URL. localhost if both empty.
STACK_LAN_HOST=

# --- Public naming parts -------------------------------------------------

# Every public name is composed as <service>-<environment>-<suffix>.<base>,
# always ONE label under the zone: a wildcard certificate covers a single
# label, so the dotted two-label form has no cert at the public edge. Set
# these once instead of five long names below.
# Set: the DNS zone your edge terminates TLS for. Default overeazy.io.
STACK_DOMAIN_BASE=overeazy.io

# Box label one label under the zone, shared by every service name.
# Set: this machine's label. Default gmktecbeast.
STACK_SUBDOMAIN_SUFFIX=gmktecbeast

# Environment label inserted after the service name, so a dev stack answers
# coder-dev-gmktecbeast.overeazy.io and never collides with the stable names.
# Set: leave empty for the stable stack. dev-stack.sh applies `dev` for the
# evo-t1-dev project only; a value here or in the shell always wins.
STACK_ENV_LABEL=

# Service label that prefixes the Coder name.
# Set: leave the default unless your edge already routes another prefix.
STACK_CODER_NAME=coder

# Service label that prefixes the Kasm name.
# Set: leave the default unless your edge already routes another prefix.
STACK_KASM_NAME=kasm

# Service label that prefixes the LiteLLM name.
# Set: leave the default unless your edge already routes another prefix.
STACK_LITELLM_NAME=litellm

# Service label that prefixes the Hermes name.
# Set: leave the default unless your edge already routes another prefix.
STACK_HERMES_NAME=hermes

# Service label for the dashboard. Empty puts it on the zone apex
# (gmktecbeast.overeazy.io), the shape the wildcard certificate covers.
# Set: leave empty for the apex, or give it a label to move the dashboard.
STACK_DASHBOARD_NAME=

# Which router config compose mounts out of proxy/.
# Set: leave empty; bootstrap.sh fills it after it renders
# proxy/router.conf.template into proxy/router.gen.conf. Empty mounts the
# checked-in proxy/router.conf.
STACK_ROUTER_CONF=

# Records that the names above are the source of truth, so a later bootstrap
# run re-composes instead of trusting the resolved list in STACK_PUBLIC_HOSTS.
# Set: leave empty; bootstrap.sh writes `auto` when STACK_PUBLIC_HOSTS=auto.
STACK_PUBLIC_HOSTS_MODE=

# Public DNS names, off by default. Empty keeps everything LAN-only.
# Set: `auto` to compose the five names from the parts above, or
# comma-separated DNS names (no scheme/port/path), one hyphenated label per
# service, to pin them by hand (then leave STACK_PUBLIC_HOSTS_MODE empty).
# docs/config-updates.md#public-hosts-and-the-dashboard
#   STACK_PUBLIC_HOSTS=auto
#   STACK_PUBLIC_HOSTS=gmktecbeast.overeazy.io,coder-gmktecbeast.overeazy.io,kasm-gmktecbeast.overeazy.io,litellm-gmktecbeast.overeazy.io,hermes-gmktecbeast.overeazy.io
STACK_PUBLIC_HOSTS=

# Public origin for the dashboard. bootstrap.sh writes this from STACK_PUBLIC_HOSTS, which `auto` composes from
# the naming parts above.
# Set: leave empty for LAN-only (compose uses STACK_LAN_HOST plus the ports above).
STACK_DASHBOARD_URL=

# Public origin for the Coder tile. bootstrap.sh writes this from STACK_PUBLIC_HOSTS, which `auto` composes from
# the naming parts above.
# Set: leave empty for LAN-only.
STACK_CODER_URL=

# Public origin for the Kasm tile. bootstrap.sh writes this from STACK_PUBLIC_HOSTS, which `auto` composes from
# the naming parts above.
# Set: leave empty for LAN-only.
STACK_KASM_URL=

# Public origin for the LiteLLM tile. bootstrap.sh writes this from STACK_PUBLIC_HOSTS, which `auto` composes from
# the naming parts above.
# Set: leave empty for LAN-only.
STACK_LITELLM_URL=

# Login-gate secret for Homepage v2. The dashboard lists every service, so
# anyone who can reach :443 needs this. bootstrap.sh fills it on first run.
# Set: any strong secret. bootstrap.sh replaces change-me-* .
HOMEPAGE_AUTH_SECRET=change-me-homepage-secret

# Password typed at the Homepage login gate.
# Set: any strong password. bootstrap.sh replaces change-me-* and prints it once.
HOMEPAGE_AUTH_PASSWORD=change-me-homepage

# --- Coder Docker access --------------------------------------------------

# GID of the host docker group. The coder and hermes containers need this
# group to use the mounted /var/run/docker.sock.
# Set: `getent group docker` on the stack host. bootstrap.sh fills it. Recheck after reinstalling Docker.
DOCKER_GID=980

# --- Hermes host assistant ------------------------------------------------

# Official Web Dashboard port (Chat tab embeds the TUI with approval prompts).
# Public name is opt-in via STACK_PUBLIC_HOSTS (bootstrap writes STACK_HERMES_URL).
# Set: unused TCP port. Default 9119. Dev stack shifts this to 19119 in dev-stack.env.
HERMES_DASHBOARD_PORT=9119

# HTTP basic-auth username for the Hermes dashboard.
# Set: any username. Default admin.
HERMES_DASHBOARD_USER=admin

# HTTP basic-auth password for the Hermes dashboard. Not the Homepage password;
# dashboard-password.sh does not rotate this.
# Set: any strong secret. bootstrap.sh replaces change-me-* on first run.
HERMES_DASHBOARD_PASSWORD=change-me-hermes

# Signs the Hermes dashboard session cookie.
# Set: any strong secret. bootstrap.sh replaces change-me-* on first run.
HERMES_DASHBOARD_SECRET=change-me-hermes-secret

# Host path of this checkout, bind-mounted at the same path inside hermes so
# `docker compose` through the socket resolves bind sources on the daemon.
# Set: absolute path of the checkout, or empty (compose falls back to .:/opt/stack, what CI needs).
STACK_HOST_PATH=

# uid hermes-init chowns /opt/data to, so the gateway can reopen the seed
# after s6 drops privileges.
# Set: a numeric uid. bootstrap.sh fills this from `id -u`.
HERMES_UID=1000

# gid matching HERMES_UID.
# Set: a numeric gid. bootstrap.sh fills this from `id -g`.
HERMES_GID=1000

# Browser URL for the Homepage Host card. bootstrap.sh writes STACK_HERMES_URL
# from a hermes-* name in STACK_PUBLIC_HOSTS, which `auto` composes from the naming
# parts above. LAN :9119 remains either way.
# Set: leave empty for LAN (compose builds the card from STACK_LAN_HOST + HERMES_DASHBOARD_PORT).
STACK_HERMES_URL=
