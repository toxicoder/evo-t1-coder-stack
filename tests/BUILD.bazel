    # the scripts/lib/ helpers it sources ride in with //scripts:doc_sources from
    # _BATS_COMMON, and the one payload the CLI touches (the compose file, for its
    # repo-root walk) is a common entry too. The templates ride in for the last
    # section, which cuts stage 6's width advisory out of both startup twins and
    # runs it, so the boot path that warns about a narrowed width is covered by the
    # shipped text rather than by a copy of it. That note names a docs anchor, so
    # the page it points at rides in too and the assertion reads the real target.
    "subagent-check.bats": [
        "//:templates_payload",
        "//docs:content",
    ],
    "storage-clean.bats": [
        # The six reseed rows scripts/lib/config_seed.sh lists for the reflection
        # runbooks and trunk-refactor: the seeder this suite drives opens those six
        # payloads from templates/common, which this group carries.
        "//:stack_data",
        "//:templates_payload",
    ],
    "test-in-image.bats": [
        "//images/dev:dockerfile",
    ],
    # The suite runs the shipped awk program (carried by _BATS_COMMON through
    # //scripts:doc_sources) over both template twins, so it owes the group that
    # ships those four .tf files.
    "tf-types.bats": [
        "//:templates_payload",
    ],
    # The subject is the twins themselves: the checker reads both main.tf files and every
    # body they name, the render tier renders each shell body through terraform, and one
    # test diffs the startup key list in the templates doc against the real map.
    "tftpl-interpolation.bats": [
        "//:templates_payload",
        "//docs:content",
    ],
    "tmux-fidelity.bats": [
        "//:templates_payload",
    ],
    "tool-pins.bats": [
        "//images/dev:tool_versions",
    ],
    # The trunk-refactor set is this suite's whole subject: the canonical body, the
    # repo-tier link and the rules that load it, the flags sample that no other gate
    # parses, the docs twin plus the nav file that makes it reachable, and the rulebook
    # that cites all of them.
    # The reflection runbook is this suite's whole subject: the canonical body with its
    # references page and its bundled sweeper, the repo-tier symlink that makes the body a
    # discoverable skill, the fixture session tree the sweeper ranks, and the docs page that
    # names the skill in the roster. No other suite reads the repo-tier skills/ tree, so
    # nothing else bills for //:skill_sources.
    "reflect-and-evolve-skill.bats": [
        "//:skill_sources",
        "//:stack_data",
        "//docs:content",
        ":fixtures",
    ],
    # The repo reflection runbook is this suite's whole subject: the canonical body and its
    # references page, the repo-tier symlink that makes the body a discoverable skill, the
    # sibling body it must stay distinct from and the one sweeper both share, and the docs page
    # that names both skills in the same roster subsection. It bills no fixture: the sweeper
    # case builds its session tree at runtime, because a store written to be provably unopened
    # is not something to commit.
    "reflect-and-evolve-repo-skill.bats": [
        "//:agent_rules",
        "//:skill_sources",
        "//docs:content",
    ],
    "trunk-refactor-skill.bats": [
        "//:agent_rules",
        "//:flags_example",
        "//:skill_sources",
        # The canonical body moved to templates/common/trunk-refactor.SKILL.md,
        # which this suite opens and pins the .grok/ link against.
        "//:templates_payload",
        "//docs-site:sources",
        "//docs:content",
    ],
    "update-configs.bats": [
        "//:env_example",
        "//:env_sample",
        # The six reseed rows scripts/lib/config_seed.sh lists for the reflection
        # runbooks and trunk-refactor: the seeder this suite drives opens those six
        # payloads from templates/common, which this group carries.
        "//:stack_data",
        "//:templates_payload",
    ],
    "update-stack.bats": [
        "//infisical:payload",
    ],
    "validate.bats": [
        "//:env_example",
        "//:env_sample",
        "//:templates_payload",
        "//hermes:seed",
        "//homepage:config",
        "//litellm:config",
        "//observability:payload",
        "//searxng:settings",
    ],
    "vscode-settings.bats": [
        "//:templates_payload",
    ],
    "workspace-notes.bats": [
        "//:templates_payload",
    ],
    "workspace.bats": [
        "//:devcontainer",
    ],
}

# Pairings the source scan cannot derive in either direction, each with its reason.
_SUITE_PAYLOAD_ALLOW = {
    # make_fixture builds a throwaway checkout to aim configure.sh at, and the
    # hooks-install branch runs scripts/install-hooks.sh inside it, so the CLI and
    # the lib it sources have to be in runfiles. Neither path appears in the suite
    # as a token: the suite names the container files, and the CLI is reached
    # through the configure script it copies in. //lints:runners is reached the
    # same way: the suite builds "lints/<runner>" from a directory list, so the
    # two runner names never appear as a path, and the flags comparison that
    # needs them would silently skip without the declaration.
    "contributor-devcontainer.bats": [
        "//scripts:shell_sources",
        "//lints:runners",
    ],
    # It reads neither tree: the canned plan it hands the checker assigns its eight
    # example tasks files under docs/ and tests/bats/, which is what a real plan
    # would name, and the checker only parses those strings. The suite builds its
    # own scratch plan tree and never opens a page or a sibling suite.
    "ez-micro-plan.bats": [
        "//docs:content",
        "//tests:all_bats",
    ],
    # It dials nothing: `searxng:8181` appears only as a value written into a
    # scratch container-environment fixture, which the web-lane check reads back
    # out of a stubbed `docker inspect`. The suite never opens searxng/settings.yml.
    "hermes-doctor.bats": [
        "//searxng:settings",
    ],
    # It reads no inventory: the token comes from the stub CLI's own filename, which the
    # suite writes to a scratch bin dir and puts first on PATH so the boot body's
    # `command -v infisical` resolves to it. `/bin/infisical` is what the scan sees as
    # the payload directory. The suite drives the coder_script against that stub and
    # never opens infisical/managed-secrets.txt.
    "infisical_boot_body.bats": [
        "//infisical:payload",
    ],
    # Its BUILD.bazel is a pointer inside a skip string, not a read: the dotenv-twin cases
    # name the map an operator has to extend with two labels when the twins are missing
    # from this target's runfiles. The suite opens the two dotenv files themselves, which
    # _SUITE_PAYLOAD declares, and never opens tests/BUILD.bazel.
    "infisical.bats": [
        "//:bazel_files",
    ],
    # It opens nothing under infisical/. The token comes from the grep patterns and the
    # header prose naming what the appended .bashrc line sources -- ~/.infisical/agent.env,
    # a path inside the workspace home that the boot body writes at run time. What this
    # suite actually reads is the startup body and both main.tf twins, all three declared.
    "startup-vault-hook.bats": [
        "//infisical:payload",
    ],
    # Each case writes its own ${dir}/Dockerfile and points dockerfile_args.awk at that
    # scratch file; the repo's images/dev/Dockerfile is never opened here.
    "awk.bats": [
        "//images/dev:dockerfile",
    ],
    # Its BUILD.bazel is a fixture, not a read: each case writes ${dir}/pkg/BUILD.bazel
    # inside its own scratch clone and asks the indexer which language it guessed. The
    # suite opens no repo payload at all -- it drives the helper in templates/common/
    # against trees it builds itself.
    "ez-code-index.bats": [
        "//:bazel_files",
    ],
    # Two names the scan charges but this suite never opens. The .bats path is a file
    # the .bats-derivation case writes inside its own throwaway project to watch the
    # hook turn tests/bats/<stem>.bats into //tests:bats_<stem>_test; no suite of this
    # checkout is read. The runner is read for one thing: the formatter test holds the
    # hook's shfmt flags against lints/run_shfmt.sh rather than against a copy written
    # here, so the two cannot drift apart silently -- and a lint runner is not a group
    # the token table knows, which is why it is declared here and not in the payload.
    "stack-hooks.bats": [
        "//tests:all_bats",
        "//lints:runners",
    ],
    # It reads back the .gitignore publish-pages-tree.sh commits onto gh-pages, out of
    # the scratch origin it builds, not out of this checkout. The README.md it stages is
    # the one the same case just wrote into that clone with printf.
    "publish-pages-tree.bats": [
        "//:gitignore",
        "//:entry_docs",
    ],
    # It opens nothing under templates/. The token is one row of the verbatim-span list it
    # greps out of the new skill's body: the body has to carry the seed-path instruction that
    # names `templates/common/`, and the suite proves that sentence survived by matching the
    # literal, never by reading a template.
    "reflect-and-evolve-repo-skill.bats": [
        "//:templates_payload",
    ],
    # It parses docker-compose.yml for its bind-mount sources and asserts each one exists
    # beside it, so the files it checks come out of compose, not out of a literal.
    "stack-data.bats": [
        "//:stack_data",
    ],
    # It drives update-stack.sh, which case-globs the payload paths out of `git diff`
    # output and reads whichever the diff names. The README.md and docs/* it names are
    # the stubbed diff itself (STUB_DIFF_OUT, changed_paths_match), the changed-path
    # strings the CLI parses, never files this suite opens.
    "update-stack.bats": [
        "//:stack_data",
        "//:entry_docs",
        "//docs:content",
    ],
    # run_npm.sh prefers BUILD_WORKSPACE_DIRECTORY, so under a test this edge is the
    # foreign-cwd fallback rather than the path the runner opens.
    "run-npm.bats": [
        "//docs-site:sources",
    ],
    # The dotted env twin appears only as the rename target the CLI mv's to inside the
    # tree it just rendered, never as this repo's own .env.example. The .gitignore it
    # appends lane blocks to, and the README.md and docs/adr/ paths it asserts got
    # renamed, are that rendered tree's files as well, not this checkout's.
    "new-repo.bats": [
        "//:env_example",
        "//:gitignore",
        "//:entry_docs",
        "//docs:content",
        # tests/python/test_cli.py is the lane file the scaffold lands inside the
        # repository it just rendered, which is not this checkout's unittest tree.
        "//tests:python_sources",
    ],
    # The README.md is the tail of a github.com tree URL the case hands the CLI as the
    # path below a repository it must refuse to probe. github.com serves no ref
    # advertisement there, so nothing local of that name is opened.
    "github-auth.bats": [
        "//:entry_docs",
    ],
    # Every README.md is one line of STUB_GIT_TREE_OUT: the canned `git ls-tree` the
    # stub answers with about the foreign workspace repo, which lib/workspace.sh
    # matches against, never this checkout's own root document.
    "workspace.bats": [
        "//:entry_docs",
    ],
    # The suite builds its own tracked set and its own owned-label set, hands both to
    # stubs of git and bazelisk, and reads nothing out of this checkout. So each side of
    # the pairing needs a reason the scan cannot derive.
    #
    # The four groups: README.md is one row of the canned `git ls-files` the stub answers
    # with, BUILD.bazel is the row that proves a per-package BUILD is control plane, and
    # docs/ and proxy/ are prefixes in fabricated paths (docs/notes.md,
    # proxy/certificates/stack.crt) that test the ignore-prefix and control-plane rules
    # without any such file existing. None is opened.
    #
    # The four sources: the suite execs the runner, which sources repo_root.sh and runs
    # the checker by path composed from ${REPO_ROOT}, and reads the ledger through the
    # runner's EVO_T1_UNOWNED_LEDGER default. The scan matches a literal repo-relative
    # path, so a composed one reads as no dependency at all while the runfiles still owe
    # every one of them.
    "owned_files.bats": [
        "owned_files.sh",
        "owned_files_check.py",
        "repo_root.sh",
        "//:bazel_unowned_ledger",
        "//:bazel_files",
        "//:entry_docs",
        "//docs:content",
        "//proxy:confs",
    ],
}

exec_shell(
    name = "bats_runner_exec",
    src = "bats_runner.sh",
)

bats_file_tests(
    # glob-policy: the glob saves target boilerplate, not the review: bats_file_tests fails analysis unless the suite has a _SUITE_PAYLOAD key that //tests:bats_bazel_deps_test re-derives
    srcs = glob(["bats/*.bats"]),
    common_data = _BATS_COMMON,
    payload = _SUITE_PAYLOAD,
    payload_allow = _SUITE_PAYLOAD_ALLOW,
    runner = ":bats_runner_exec",
)

exec_shell(
    name = "shell_inventory_exec",
    src = "shell_inventory.sh",
    data = ["repo_root.sh"],
)

# shell_inventory.sh greps scripts/**/*.sh for function definitions and tests/bats/*.bats,
# tests/bats/*.bash and tests/*.sh for the names that reference them: those three groups and
# nothing else.
sh_test(
    name = "shell_inventory",
    size = "small",
    srcs = [":shell_inventory_exec"],
    data = [
        ":all_bats",
        ":shell_sources",
        "//scripts:shell_sources",
    ],
    tags = [
        "local",
        "no-sandbox",
    ],
    visibility = ["//visibility:public"],
)

# Measured shell coverage is non-hermetic by construction: it drives the whole Bats suite
# with bash xtrace on, so it is manual (//:test-fast stays fast) and runs local. It is the
# one target that has to carry every payload group, because it runs every suite. The suite
# payloads come from _SUITE_PAYLOAD itself rather than a second hand-written list: a suite
# that is green standalone and red here is almost always this data list missing a group.
# Each label is folded to its repo-relative spelling first, because ":all_bats" and
# "//tests:all_bats" are one label in two spellings and Bazel rejects the pair as a
# duplicate in a single data attribute.
_COVERAGE_EXTRA = [
    ":all_bats",
    ":fixtures",
    "bazel_deps.py",
    "//:bazel_files",
    "//:stack_data",
    "//docs-site:sources",
    "//docs:manage-docs.sh",
]

_COVERAGE_UNION = sorted({
    (":" + label[len("//tests:"):] if label.startswith("//tests:") else label): True
    for group in [
        _BATS_COMMON,
        _COVERAGE_EXTRA,
    ] + _SUITE_PAYLOAD.values()
    for label in group
}.keys())

exec_shell(
    name = "shell_cov_exec",
    src = "coverage/shell_cov.sh",
    data = [
        "coverage/aggregate.py",
        "coverage/instrument.py",
    ],
)

sh_test(
    name = "shell_coverage",
    size = "medium",
    timeout = "long",
    srcs = [":shell_cov_exec"],
    data = _COVERAGE_UNION + [
        "coverage/aggregate.py",
        "coverage/instrument.py",
        "coverage/shell_cov.sh",
    ],
    tags = [
        "local",
        "manual",
        "no-sandbox",
    ],
    visibility = ["//visibility:public"],
)

exec_shell(
    name = "py_cov_exec",
    src = "coverage/py_cov.sh",
    data = [
        "coverage/py_report.py",
    ],
)

# py_cov.sh discovers tests/python/test_*.py, scripts/lib/*.py and the docs-site nav
# generator, and probes for docker-compose.yml as the repo-root marker. tests/bazel_deps.py
# rides along because test_bazel_deps.py imports it by path; it stays out of py_report's
# --expect list, which measures the shipped modules under scripts/lib and docs-site/scripts.
# //litellm:compaction_router.py rides along for the same reason -- test_compaction_router.py
# opens it by path -- and it stays out of --expect for the same reason too: it is stack
# payload the proxy imports, not one of the two module trees this floor measures. A suite
# that resolves its own __file__ reaches the checkout through the runfiles symlinks, so a
# missing edge would pass rather than fail loudly: this list is the declaration, not the
# mechanism that reads the file.
sh_test(
    name = "py_coverage",
    size = "medium",
    srcs = [":py_cov_exec"],
    data = [
        "bazel_deps.py",
        "coverage/py_cov.sh",
        "coverage/py_report.py",
        "//:compose_file",
        "//docs-site:python_sources",
        # The group, not the single module: //tests:py_report.py builds its denominator by
        # listing the *.py that actually arrive in runfiles, and nothing cross-reads this
        # edge against the payload group. A per-file label here would let a second module
        # join //litellm:config and be measured by nothing -- proven by mutation: a
        # litellm/*.py added to that group left this gate printing ok at 7/7.
        "//litellm:config",
        "//scripts:py_programs",
        # glob-policy: coverage/py_cov.sh discovers tests/python/test_*.py at runtime, so a new unittest module must arrive in runfiles or the suite silently measures less
    ] + glob(
        ["python/**"],
        allow_empty = True,
        exclude = ["python/**/__pycache__/**"],
    ),
    tags = [
        "local",
        "manual",
        "no-sandbox",
    ],
    visibility = ["//visibility:public"],
)

exec_shell(
    name = "doc_coverage_exec",
    src = "doc_coverage.sh",
    data = ["repo_root.sh"],
)

# doc_coverage.sh walks scripts/**/*.sh looking for the `# ##` header and `# @function`
# blocks: the scripts shell tree and nothing else.
sh_test(
    name = "doc_coverage",
    size = "small",
    srcs = [":doc_coverage_exec"],
    data = [
        "//scripts:shell_sources",
    ],
    tags = [
        "local",
        "no-sandbox",
    ],
    visibility = ["//visibility:public"],
)

# The tracked-file ownership audit: every `git ls-files` path is either a target's
# source or data, Bazel's own control plane, or named in unowned-files.txt with a
# reason. It is an sh_binary rather than an sh_test on purpose. The owned set comes
# from `bazelisk query`, and a test action holds the Bazel server that query needs,
# while `bazel run` hands it one -- the same nested query //scripts:bazel-map runs.
# .githooks/pre-push and the CI lane invoke this target, so drift fails a build;
# //tests:bats_owned_files_test pins the bucketing itself hermetically against a
# stubbed Bazelisk, which is what //:test-fast runs.
exec_shell(
    name = "owned_files_exec",
    src = "owned_files.sh",
    data = [
        "owned_files_check.py",
        "repo_root.sh",
    ],
)

sh_binary(
    name = "owned_files_audit",
    srcs = [":owned_files_exec"],
    data = [
        "//:bazel_unowned_ledger",
    ],
    visibility = ["//visibility:public"],
)
