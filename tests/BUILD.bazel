# Pairings the source scan cannot derive in either direction, each with its reason.
_SUITE_PAYLOAD_ALLOW = {
    # Each case writes its own ${dir}/Dockerfile and points dockerfile_args.awk at that
    # scratch file; the repo's images/dev/Dockerfile is never opened here.
    "awk.bats": [
        "//images/dev:dockerfile",
    ],
    # It parses docker-compose.yml for its bind-mount sources and asserts each one exists
    # beside it, so the files it checks come out of compose, not out of a literal.
    "stack-data.bats": [
        "//:stack_data",
    ],
    # It drives update-stack.sh, which case-globs the payload paths out of `git diff`
    # output and reads whichever the diff names.
    "update-stack.bats": [
        "//:stack_data",
    ],
    # run_npm.sh prefers BUILD_WORKSPACE_DIRECTORY, so under a test this edge is the
    # foreign-cwd fallback rather than the path the runner opens.
    "run-npm.bats": [
        "//docs-site:sources",
    ],
    # The dotted env twin appears only as the rename target the CLI mv's to inside the
    # tree it just rendered, never as this repo's own .env.example.
    "new-repo.bats": [
        "//:env_example",
    ],
}

exec_shell(
    name = "bats_runner_exec",
    src = "bats_runner.sh",
)

bats_file_tests(
    srcs = glob(["bats/*.bats"]),
    common_data = _BATS_COMMON,
    payload = _SUITE_PAYLOAD,
    payload_allow = _SUITE_PAYLOAD_ALLOW,
    runner = ":bats_runner_exec",
)

exec_shell(
    name = "shell_inventory_exec",
    src = "shell_inventory.sh",
    data = ["repo_root.sh"],
)

# shell_inventory.sh greps scripts/**/*.sh for function definitions and tests/bats/*.bats,
# tests/bats/*.bash and tests/*.sh for the names that reference them: those three groups and
# nothing else.
sh_test(
    name = "shell_inventory",
    size = "small",
    srcs = [":shell_inventory_exec"],
    data = [
        ":all_bats",
        ":shell_sources",
        "//scripts:shell_sources",
    ],
    tags = [
        "local",
        "no-sandbox",
    ],
    visibility = ["//visibility:public"],
)

# Measured shell coverage is non-hermetic by construction: it drives the whole Bats suite
# with bash xtrace on, so it is manual (//:test-fast stays fast) and runs local. It is the
# one target that has to carry every payload group, because it runs every suite. The suite
# payloads come from _SUITE_PAYLOAD itself rather than a second hand-written list: a suite
# that is green standalone and red here is almost always this data list missing a group.
# Each label is folded to its repo-relative spelling first, because ":all_bats" and
# "//tests:all_bats" are one label in two spellings and Bazel rejects the pair as a
# duplicate in a single data attribute.
_COVERAGE_EXTRA = [
    ":all_bats",
    ":fixtures",
    "bazel_deps.py",
    "//:bazel_files",
    "//:stack_data",
    "//docs-site:sources",
    "//docs:manage-docs.sh",
]

_COVERAGE_UNION = sorted({
    (":" + label[len("//tests:"):] if label.startswith("//tests:") else label): True
    for group in [
        _BATS_COMMON,
        _COVERAGE_EXTRA,
    ] + _SUITE_PAYLOAD.values()
    for label in group
}.keys())

exec_shell(
    name = "shell_cov_exec",
    src = "coverage/shell_cov.sh",
    data = [
        "coverage/aggregate.py",
        "coverage/instrument.py",
    ],
)

sh_test(
    name = "shell_coverage",
    size = "medium",
    timeout = "long",
    srcs = [":shell_cov_exec"],
    data = _COVERAGE_UNION + [
        "coverage/aggregate.py",
        "coverage/instrument.py",
        "coverage/shell_cov.sh",
    ],
    tags = [
        "local",
        "manual",
        "no-sandbox",
    ],
    visibility = ["//visibility:public"],
)

exec_shell(
    name = "py_cov_exec",
    src = "coverage/py_cov.sh",
    data = [
        "coverage/py_report.py",
    ],
)

# py_cov.sh discovers tests/python/test_*.py, scripts/lib/*.py and the docs-site nav
# generator, and probes for docker-compose.yml as the repo-root marker. tests/bazel_deps.py
# rides along because test_bazel_deps.py imports it by path; it stays out of py_report's
# --expect list, which measures the shipped modules under scripts/lib and docs-site/scripts.
sh_test(
    name = "py_coverage",
    size = "medium",
    srcs = [":py_cov_exec"],
    data = [
        "bazel_deps.py",
        "coverage/py_cov.sh",
        "coverage/py_report.py",
        "//:compose_file",
        "//docs-site:python_sources",
        "//scripts:py_programs",
    ] + glob(
        ["python/**"],
        allow_empty = True,
        exclude = ["python/**/__pycache__/**"],
    ),
    tags = [
        "local",
        "manual",
        "no-sandbox",
    ],
    visibility = ["//visibility:public"],
)

exec_shell(
    name = "doc_coverage_exec",
    src = "doc_coverage.sh",
    data = ["repo_root.sh"],
)

# doc_coverage.sh walks scripts/**/*.sh looking for the `# ##` header and `# @function`
# blocks: the scripts shell tree and nothing else.
sh_test(
    name = "doc_coverage",
    size = "small",
    srcs = [":doc_coverage_exec"],
    data = [
        "//scripts:shell_sources",
    ],
    tags = [
        "local",
        "no-sandbox",
    ],
    visibility = ["//visibility:public"],
)
