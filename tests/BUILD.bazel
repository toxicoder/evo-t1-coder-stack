"""Package purpose: Hermetic Bats, shell-function inventory, and docstring coverage."""

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tools:exec_shell.bzl", "exec_shell")
load(":bats.bzl", "bats_file_tests")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "bats_tool",
    srcs = ["@bats_core//:bin/bats"],
    data = [
        "@bats_core//:libexec/bats-core/bats",
        "@bats_core//:libexec/bats-core/bats-exec-file",
        "@bats_core//:libexec/bats-core/bats-exec-suite",
        "@bats_core//:libexec/bats-core/bats-exec-test",
        "@bats_core//:libexec/bats-core/bats-format-cat",
        "@bats_core//:libexec/bats-core/bats-format-junit",
        "@bats_core//:libexec/bats-core/bats-format-pretty",
        "@bats_core//:libexec/bats-core/bats-format-tap",
        "@bats_core//:libexec/bats-core/bats-format-tap13",
        "@bats_core//:libexec/bats-core/bats-gather-tests",
        "@bats_core//:libexec/bats-core/bats-preprocess",
    ],
)

# docker-compose.yml is both the marker the runner and bats_canonical_repo_root probe
# for and the file several suites read by path; the template/image/litellm payload
# beside it is read the same way, so it all travels with the suite.
_BATS_COMMON = [
    "bats/test_helper.bash",
    "bats_runner.sh",
    "extract_fn.py",
    ":bats_tool",
    "//scripts:doc_sources",
    "//docs:manage-docs.sh",
    "//:stack_data",
    "//:ci_workflows",
] + glob(
    [
        "bats/tool_stubs/**",
        "bats/fixtures/**",
        "test_helpers.sh",
    ],
    allow_empty = True,
)

exec_shell(
    name = "bats_runner_exec",
    src = "bats_runner.sh",
)

bats_file_tests(
    srcs = glob(["bats/*.bats"]),
    common_data = _BATS_COMMON,
    # run-npm.bats reads docs-site/run_npm.sh, which sits outside the shared
    # set; named here so the suite runs under its own target instead of skipping.
    extra_data = {
        "run-npm.bats": ["//docs-site:sources"],
    },
    runner = ":bats_runner_exec",
)

exec_shell(
    name = "shell_inventory_exec",
    src = "shell_inventory.sh",
    data = ["repo_root.sh"],
)

sh_test(
    name = "shell_inventory",
    size = "small",
    srcs = [":shell_inventory_exec"],
    data = [
        "repo_root.sh",
        "//scripts:doc_sources",
    ] + glob(["bats/**"]),
    tags = [
        "local",
        "no-sandbox",
    ],
    visibility = ["//visibility:public"],
)

# Measured coverage. Non-hermetic by construction: it drives the whole Bats suite
# with bash xtrace on, so it is manual (//:test-fast stays fast) and runs local.
exec_shell(
    name = "shell_cov_exec",
    src = "coverage/shell_cov.sh",
    data = [
        "coverage/aggregate.py",
        "coverage/instrument.py",
    ],
)

sh_test(
    name = "shell_coverage",
    size = "medium",
    timeout = "long",
    srcs = [":shell_cov_exec"],
    data = _BATS_COMMON + glob(["bats/*.bats"]) + [
        "coverage/aggregate.py",
        "coverage/instrument.py",
        "coverage/shell_cov.sh",
        "//docs-site:sources",
    ],
    tags = [
        "local",
        "manual",
        "no-sandbox",
    ],
    visibility = ["//visibility:public"],
)

exec_shell(
    name = "py_cov_exec",
    src = "coverage/py_cov.sh",
    data = [
        "coverage/py_report.py",
    ],
)

sh_test(
    name = "py_coverage",
    size = "medium",
    srcs = [":py_cov_exec"],
    # stack_data carries the docker-compose.yml marker py_cov_repo_root probes
    # for; the suites themselves have to travel with the target or discover finds
    # an empty directory and reports full coverage of nothing.
    data = [
        "coverage/py_cov.sh",
        "coverage/py_report.py",
        "//:stack_data",
        "//docs-site:sources",
        "//scripts:doc_sources",
    ] + glob(
        ["python/**"],
        allow_empty = True,
        exclude = ["python/**/__pycache__/**"],
    ),
    tags = [
        "local",
        "manual",
        "no-sandbox",
    ],
    visibility = ["//visibility:public"],
)

exec_shell(
    name = "doc_coverage_exec",
    src = "doc_coverage.sh",
    data = ["repo_root.sh"],
)

sh_test(
    name = "doc_coverage",
    size = "small",
    srcs = [":doc_coverage_exec"],
    data = [
        "repo_root.sh",
        "//scripts:doc_sources",
    ],
    tags = [
        "local",
        "no-sandbox",
    ],
    visibility = ["//visibility:public"],
)

exports_files(
    [
        "bats_runner.sh",
        "doc_coverage.sh",
        "repo_root.sh",
        "shell_inventory.sh",
    ],
    visibility = ["//visibility:public"],
)
