"""Package purpose: Hermetic Bats, shell-function inventory, docstring coverage, and the
Bazel dependency gate.

Every suite gets the same irreducible set (bats-core, the runner, the two helpers, the
tool stubs, and the compose file that `bats_canonical_repo_root` probes for as the repo-root
marker) and nothing else. Everything a suite reads beyond that is named per suite in
`_SUITE_PAYLOAD`, which `//tests:bats_bazel_deps_test` re-derives from the suite sources, so
the map cannot drift from what the suites actually open.
"""

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tools:exec_shell.bzl", "exec_shell")
load(":bats.bzl", "bats_file_tests")

package(default_visibility = ["//visibility:private"])

# This package's own target declarations and the Bats macro, for the dependency gate in
# this package to read under hermetic runfiles.
filegroup(
    name = "build_file",
    srcs = ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bats_bzl",
    srcs = ["bats.bzl"],
    visibility = ["//visibility:public"],
)

# The first-party shell this package owns. //lints walks it because its runners scan the
# tests/ entry of scan_dirs, so this group and that scan list are kept equal.
filegroup(
    name = "shell_sources",
    srcs = glob(
        [
            "coverage/*.sh",
            "*.sh",
        ],
        allow_empty = True,
    ),
    visibility = [
        "//lints:__pkg__",
        "//visibility:public",
    ],
)

# Every suite file, for the tools that walk the whole suite tree: //tests:shell_inventory
# greps them for function names and //tests:shell_coverage drives them all.
filegroup(
    name = "all_bats",
    srcs = glob(
        [
            "bats/*.bash",
            "bats/*.bats",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

# Scratch trees two suites build from a canned psql token.
filegroup(
    name = "fixtures",
    srcs = glob(
        ["bats/fixtures/**"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bats_tool",
    srcs = ["@bats_core//:bin/bats"],
    data = [
        "@bats_core//:libexec/bats-core/bats",
        "@bats_core//:libexec/bats-core/bats-exec-file",
        "@bats_core//:libexec/bats-core/bats-exec-suite",
        "@bats_core//:libexec/bats-core/bats-exec-test",
        "@bats_core//:libexec/bats-core/bats-format-cat",
        "@bats_core//:libexec/bats-core/bats-format-junit",
        "@bats_core//:libexec/bats-core/bats-format-pretty",
        "@bats_core//:libexec/bats-core/bats-format-tap",
        "@bats_core//:libexec/bats-core/bats-format-tap13",
        "@bats_core//:libexec/bats-core/bats-gather-tests",
        "@bats_core//:libexec/bats-core/bats-preprocess",
    ],
)

# The set every one of the 49 suites needs, verified by running them all: the runner and
# bats-core, the two helpers every suite loads, the tool stubs stub_bin fails on, the
# extract_fn.py that load_shell_function runs, and docker-compose.yml - which is the marker
# bats_canonical_repo_root walks up to, so a suite without it skips entirely. The scripts
# tree joins it because 40 of 49 suites run a CLI, source a lib, or copy the tree by path;
# naming it 40 times would say less than naming it here.
_BATS_COMMON = [
    "bats/test_helper.bash",
    "bats_runner.sh",
    "extract_fn.py",
    "test_helpers.sh",
    ":bats_tool",
    "//:compose_file",
    "//scripts:doc_sources",
] + glob(
    ["bats/tool_stubs/**"],
    allow_empty = True,
)

# ---------------------------------------------------------------------------
# Per-suite payload map. Read by //tests:bats_bazel_deps_test, which re-derives it from the
# suite sources (and from the entry script a suite execs, since that script's own reads are
# the suite's reads). Literal strings and lists only - the gate parses these with
# ast.literal_eval.
#
# An empty list means the suite reads nothing beyond the common set. //:stack_data appears
# only where the suite is the completeness gate itself or drives a CLI that discovers
# payload at runtime.
# ---------------------------------------------------------------------------

