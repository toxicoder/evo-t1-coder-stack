"""Package purpose: Hermetic Bats, shell-function inventory, docstring coverage, and the
Bazel dependency gate.

Every suite gets the same irreducible set (bats-core, the runner, the two helpers, the
tool stubs, and the compose file that `bats_canonical_repo_root` probes for as the repo-root
marker) and nothing else. Everything a suite reads beyond that is named per suite in
`_SUITE_PAYLOAD`, which `//tests:bats_bazel_deps_test` re-derives from the suite sources, so
the map cannot drift from what the suites actually open.
"""

load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//tools:exec_shell.bzl", "exec_shell")
load(":bats.bzl", "bats_file_tests")

package(default_visibility = ["//visibility:private"])

# This package's own target declarations and the Bats macro, for the dependency gate in
# this package to read under hermetic runfiles.
filegroup(
    name = "build_file",
    srcs = ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bats_bzl",
    srcs = ["bats.bzl"],
    visibility = ["//visibility:public"],
)

# The first-party shell this package owns. //lints walks it because its runners scan the
# tests/ entry of scan_dirs, so this group and that scan list are kept equal.
filegroup(
    name = "shell_sources",
    # glob-policy: this list equals the tests/ entry of each runner's scan_dirs, so the directory is the contract and a new tests/*.sh must enter //lints:shell and //lints:shfmt on its own
    srcs = glob(
        [
            "coverage/*.sh",
            "*.sh",
        ],
        allow_empty = True,
    ),
    visibility = [
        "//lints:__pkg__",
        "//visibility:public",
    ],
)

# The coverage harness itself. A suite that pins how the harness hands it a tree reads
# these by path, so they have to be in its runfiles beside the suites they drive.
#
# Explicit rather than a glob: this is five named files that change only when the
# harness changes, and a sixth file dropped into coverage/ that nobody wired into a
# driver should be a decision, not something the gate silently ships to every
# consumer. //tests:shell_coverage and //tests:py_coverage name the same files in
# their own data edges, so a new one has to be declared twice on purpose.
filegroup(
    name = "coverage_tools",
    srcs = [
        "coverage/aggregate.py",
        "coverage/instrument.py",
        "coverage/py_cov.sh",
        "coverage/py_report.py",
        "coverage/shell_cov.sh",
    ],
    visibility = ["//visibility:public"],
)

# The first-party Python this package owns: the Bazel data-map checker, the function
# extractor, the tracked-file ownership checker, the three coverage drivers, and the
# unittest suites. It is the tests/ half of what //lints:mypy type-checks, and equals the
# Python entries of :py_coverage's data edge minus the groups this package does not own
# (//scripts:py_programs and //docs-site:python_sources, which that target pulls directly).
# Keep the two in step: a new .py here joins this list, and a new .py under scripts/lib or
# docs-site/scripts joins the list in lints/run_mypy.sh instead.
filegroup(
    name = "python_sources",
    srcs = [
        "bazel_deps.py",
        "extract_fn.py",
        "owned_files_check.py",
        # glob-policy: coverage/ and python/ are the harness's and the unittest suite's own directories, and a new test module must reach //lints:mypy and //tests:py_coverage without a BUILD edit
    ] + glob(
        [
            "coverage/*.py",
            "python/*.py",
        ],
        allow_empty = True,
    ),
    visibility = [
        "//lints:__pkg__",
        "//visibility:public",
    ],
)

# Every suite file, for the tools that walk the whole suite tree: //tests:shell_inventory
# greps them for function names and //tests:shell_coverage drives them all.
filegroup(
    name = "all_bats",
    # glob-policy: this is the inventory denominator //tests:shell_inventory greps, so a new .bats has to join it silently rather than stop being measured
    srcs = glob(
        [
            "bats/*.bash",
            "bats/*.bats",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

# Scratch trees two suites build from a canned psql token.
filegroup(
    name = "fixtures",
    # glob-policy: a fixture tree is canned input a suite opens by path, and the per-suite _SUITE_PAYLOAD entry already makes each suite declare what it reads
    srcs = glob(
        ["bats/fixtures/**"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "bats_tool",
    srcs = ["@bats_core//:bin/bats"],
    data = [
        "@bats_core//:libexec/bats-core/bats",
        "@bats_core//:libexec/bats-core/bats-exec-file",
        "@bats_core//:libexec/bats-core/bats-exec-suite",
        "@bats_core//:libexec/bats-core/bats-exec-test",
        "@bats_core//:libexec/bats-core/bats-format-cat",
        "@bats_core//:libexec/bats-core/bats-format-junit",
        "@bats_core//:libexec/bats-core/bats-format-pretty",
        "@bats_core//:libexec/bats-core/bats-format-tap",
        "@bats_core//:libexec/bats-core/bats-format-tap13",
        "@bats_core//:libexec/bats-core/bats-gather-tests",
        "@bats_core//:libexec/bats-core/bats-preprocess",
    ],
)

# The set every one of the 49 suites needs, verified by running them all: the runner and
# bats-core, the two helpers every suite loads, the tool stubs stub_bin fails on, the
# extract_fn.py that load_shell_function runs, and docker-compose.yml - which is the marker
# bats_canonical_repo_root walks up to, so a suite without it skips entirely. The scripts
# tree joins it because 40 of 49 suites run a CLI, source a lib, or copy the tree by path;
# naming it 40 times would say less than naming it here.
_BATS_COMMON = [
    "bats/test_helper.bash",
    "bats_runner.sh",
    "extract_fn.py",
    "test_helpers.sh",
    ":bats_tool",
    "//:compose_file",
    "//scripts:doc_sources",
    # glob-policy: every bats_file_tests target gets this as common_data and stub_bin fails on a missing stub, so a new stub must reach every suite's runfiles
] + glob(
    ["bats/tool_stubs/**"],
    allow_empty = True,
)

