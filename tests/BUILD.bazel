# Pairings the source scan cannot derive in either direction, each with its reason.
_SUITE_PAYLOAD_ALLOW = {
    # It dials nothing: `searxng:8181` appears only as a value written into a
    # scratch container-environment fixture, which the web-lane check reads back
    # out of a stubbed `docker inspect`. The suite never opens searxng/settings.yml.
    "hermes-doctor.bats": [
        "//searxng:settings",
    ],
    # Each case writes its own ${dir}/Dockerfile and points dockerfile_args.awk at that
    # scratch file; the repo's images/dev/Dockerfile is never opened here.
    "awk.bats": [
        "//images/dev:dockerfile",
    ],
    # It reads back the .gitignore publish-pages-tree.sh commits onto gh-pages, out of
    # the scratch origin it builds, not out of this checkout. The README.md it stages is
    # the one the same case just wrote into that clone with printf.
    "publish-pages-tree.bats": [
        "//:gitignore",
        "//:entry_docs",
    ],
    # It parses docker-compose.yml for its bind-mount sources and asserts each one exists
    # beside it, so the files it checks come out of compose, not out of a literal.
    "stack-data.bats": [
        "//:stack_data",
    ],
    # It drives update-stack.sh, which case-globs the payload paths out of `git diff`
    # output and reads whichever the diff names. The README.md and docs/* it names are
    # the stubbed diff itself (STUB_DIFF_OUT, changed_paths_match), the changed-path
    # strings the CLI parses, never files this suite opens.
    "update-stack.bats": [
        "//:stack_data",
        "//:entry_docs",
        "//docs:content",
    ],
    # run_npm.sh prefers BUILD_WORKSPACE_DIRECTORY, so under a test this edge is the
    # foreign-cwd fallback rather than the path the runner opens.
    "run-npm.bats": [
        "//docs-site:sources",
    ],
    # The dotted env twin appears only as the rename target the CLI mv's to inside the
    # tree it just rendered, never as this repo's own .env.example. The .gitignore it
    # appends lane blocks to, and the README.md and docs/adr/ paths it asserts got
    # renamed, are that rendered tree's files as well, not this checkout's.
    "new-repo.bats": [
        "//:env_example",
        "//:gitignore",
        "//:entry_docs",
        "//docs:content",
        # tests/python/test_cli.py is the lane file the scaffold lands inside the
        # repository it just rendered, which is not this checkout's unittest tree.
        "//tests:python_sources",
    ],
    # The README.md is the tail of a github.com tree URL the case hands the CLI as the
    # path below a repository it must refuse to probe. github.com serves no ref
    # advertisement there, so nothing local of that name is opened.
    "github-auth.bats": [
        "//:entry_docs",
    ],
    # Every README.md is one line of STUB_GIT_TREE_OUT: the canned `git ls-tree` the
    # stub answers with about the foreign workspace repo, which lib/workspace.sh
    # matches against, never this checkout's own root document.
    "workspace.bats": [
        "//:entry_docs",
    ],
    # The suite builds its own tracked set and its own owned-label set, hands both to
    # stubs of git and bazelisk, and reads nothing out of this checkout. So each side of
    # the pairing needs a reason the scan cannot derive.
    #
    # The four groups: README.md is one row of the canned `git ls-files` the stub answers
    # with, BUILD.bazel is the row that proves a per-package BUILD is control plane, and
    # docs/ and proxy/ are prefixes in fabricated paths (docs/notes.md,
    # proxy/certificates/stack.crt) that test the ignore-prefix and control-plane rules
    # without any such file existing. None is opened.
    #
    # The four sources: the suite execs the runner, which sources repo_root.sh and runs
    # the checker by path composed from ${REPO_ROOT}, and reads the ledger through the
    # runner's EVO_T1_UNOWNED_LEDGER default. The scan matches a literal repo-relative
    # path, so a composed one reads as no dependency at all while the runfiles still owe
    # every one of them.
    "owned_files.bats": [
        "owned_files.sh",
        "owned_files_check.py",
        "repo_root.sh",
        "//:bazel_unowned_ledger",
        "//:bazel_files",
        "//:entry_docs",
        "//docs:content",
        "//proxy:confs",
    ],
}

exec_shell(
    name = "bats_runner_exec",
    src = "bats_runner.sh",
)

bats_file_tests(
    # glob-policy: the glob saves target boilerplate, not the review: bats_file_tests fails analysis unless the suite has a _SUITE_PAYLOAD key that //tests:bats_bazel_deps_test re-derives
    srcs = glob(["bats/*.bats"]),
    common_data = _BATS_COMMON,
    payload = _SUITE_PAYLOAD,
    payload_allow = _SUITE_PAYLOAD_ALLOW,
    runner = ":bats_runner_exec",
)

exec_shell(
    name = "shell_inventory_exec",
    src = "shell_inventory.sh",
    data = ["repo_root.sh"],
)

# shell_inventory.sh greps scripts/**/*.sh for function definitions and tests/bats/*.bats,
# tests/bats/*.bash and tests/*.sh for the names that reference them: those three groups and
# nothing else.
sh_test(
    name = "shell_inventory",
    size = "small",
    srcs = [":shell_inventory_exec"],
    data = [
        ":all_bats",
        ":shell_sources",
        "//scripts:shell_sources",
    ],
    tags = [
        "local",
        "no-sandbox",
    ],
    visibility = ["//visibility:public"],
)

# Measured shell coverage is non-hermetic by construction: it drives the whole Bats suite
# with bash xtrace on, so it is manual (//:test-fast stays fast) and runs local. It is the
# one target that has to carry every payload group, because it runs every suite. The suite
# payloads come from _SUITE_PAYLOAD itself rather than a second hand-written list: a suite
# that is green standalone and red here is almost always this data list missing a group.
# Each label is folded to its repo-relative spelling first, because ":all_bats" and
# "//tests:all_bats" are one label in two spellings and Bazel rejects the pair as a
# duplicate in a single data attribute.
_COVERAGE_EXTRA = [
    ":all_bats",
    ":fixtures",
    "bazel_deps.py",
    "//:bazel_files",
    "//:stack_data",
    "//docs-site:sources",
    "//docs:manage-docs.sh",
]

_COVERAGE_UNION = sorted({
    (":" + label[len("//tests:"):] if label.startswith("//tests:") else label): True
    for group in [
        _BATS_COMMON,
        _COVERAGE_EXTRA,
    ] + _SUITE_PAYLOAD.values()
    for label in group
}.keys())

exec_shell(
    name = "shell_cov_exec",
    src = "coverage/shell_cov.sh",
    data = [
        "coverage/aggregate.py",
        "coverage/instrument.py",
    ],
)

sh_test(
    name = "shell_coverage",
    size = "medium",
    timeout = "long",
    srcs = [":shell_cov_exec"],
    data = _COVERAGE_UNION + [
        "coverage/aggregate.py",
        "coverage/instrument.py",
        "coverage/shell_cov.sh",
    ],
    tags = [
        "local",
        "manual",
        "no-sandbox",
    ],
    visibility = ["//visibility:public"],
)

exec_shell(
    name = "py_cov_exec",
    src = "coverage/py_cov.sh",
    data = [
        "coverage/py_report.py",
    ],
)

# py_cov.sh discovers tests/python/test_*.py, scripts/lib/*.py and the docs-site nav
# generator, and probes for docker-compose.yml as the repo-root marker. tests/bazel_deps.py
# rides along because test_bazel_deps.py imports it by path; it stays out of py_report's
# --expect list, which measures the shipped modules under scripts/lib and docs-site/scripts.
sh_test(
    name = "py_coverage",
    size = "medium",
    srcs = [":py_cov_exec"],
    data = [
        "bazel_deps.py",
        "coverage/py_cov.sh",
        "coverage/py_report.py",
        "//:compose_file",
        "//docs-site:python_sources",
        "//scripts:py_programs",
        # glob-policy: coverage/py_cov.sh discovers tests/python/test_*.py at runtime, so a new unittest module must arrive in runfiles or the suite silently measures less
    ] + glob(
        ["python/**"],
        allow_empty = True,
        exclude = ["python/**/__pycache__/**"],
    ),
    tags = [
        "local",
        "manual",
        "no-sandbox",
    ],
    visibility = ["//visibility:public"],
)

exec_shell(
    name = "doc_coverage_exec",
    src = "doc_coverage.sh",
    data = ["repo_root.sh"],
)

# doc_coverage.sh walks scripts/**/*.sh looking for the `# ##` header and `# @function`
# blocks: the scripts shell tree and nothing else.
sh_test(
    name = "doc_coverage",
    size = "small",
    srcs = [":doc_coverage_exec"],
    data = [
        "//scripts:shell_sources",
    ],
    tags = [
        "local",
        "no-sandbox",
    ],
    visibility = ["//visibility:public"],
)

# The tracked-file ownership audit: every `git ls-files` path is either a target's
# source or data, Bazel's own control plane, or named in unowned-files.txt with a
# reason. It is an sh_binary rather than an sh_test on purpose. The owned set comes
# from `bazelisk query`, and a test action holds the Bazel server that query needs,
# while `bazel run` hands it one -- the same nested query //scripts:bazel-map runs.
# .githooks/pre-push and the CI lane invoke this target, so drift fails a build;
# //tests:bats_owned_files_test pins the bucketing itself hermetically against a
# stubbed Bazelisk, which is what //:test-fast runs.
exec_shell(
    name = "owned_files_exec",
    src = "owned_files.sh",
    data = [
        "owned_files_check.py",
        "repo_root.sh",
    ],
)

sh_binary(
    name = "owned_files_audit",
    srcs = [":owned_files_exec"],
    data = [
        "//:bazel_unowned_ledger",
    ],
    visibility = ["//visibility:public"],
)
