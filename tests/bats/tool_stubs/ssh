#!/usr/bin/env bash
# shellcheck shell=bash
#
# ## ssh — deterministic ssh client stub (test fixture; never ships)
#
# Purpose: stand in for `ssh -n ... <target> <cmd>` so the Spark probe
# transport tests hermetically without a network. Prints STUB_SSH_OUT (a
# file's content or a literal body), exits STUB_SSH_RC (0); a non-zero rc
# also prints "ssh: stub failure" on stderr so the callers' first-line
# fallback gets exercised. With STUB_SSH_EXEC=1 the quoted remote command
# ("printf '%s' '<b64>' | base64 -d | sh") is DECODED and run locally by sh
# instead — enough to drive probe_transport end to end against stubbed
# in-guest tools. Records one argv line to $STUB_LOG/ssh.log when set.
#
# Usage (in a .bats file): use_stubs ssh; STUB_SSH_EXEC=1 run ./scripts/...
# Safety: stub only — never opens a socket; decoded payloads are test fixtures
# run under the same PATH shadow, never trusted input.
set -u

if [ -n "${STUB_LOG:-}" ]; then printf '%s\n' "ssh $*" >> "${STUB_LOG}/ssh.log"; fi

if [ "${STUB_SSH_EXEC:-0}" = "1" ]; then
  last="${*: -1}"
  case "${last}" in
    *"printf '%s' "*"| base64 -d | sh"*)
      b64="$(printf '%s' "${last}" | sed -E "s|.*printf '%s' '([^']*)'.*|\1|")"
      if [ -n "${b64}" ]; then
        printf '%s' "${b64}" | base64 -d 2>/dev/null | sh
        exit 0
      fi
      ;;
  esac
fi

if [ -n "${STUB_SSH_OUT:-}" ]; then
  if [ -f "${STUB_SSH_OUT}" ]; then cat "${STUB_SSH_OUT}"; else printf '%s\n' "${STUB_SSH_OUT}"; fi
fi
if [ "${STUB_SSH_RC:-0}" != "0" ]; then
  printf 'ssh: stub failure\n' >&2
fi
exit "${STUB_SSH_RC:-0}"
