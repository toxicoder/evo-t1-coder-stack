#!/usr/bin/env bash
# shellcheck shell=bash
#
# ## curl — deterministic curl stub (test fixture; never ships)
#
# Purpose: answer probes and API calls with a canned body so probe_http and
# the in-container `docker compose exec ... curl` paths test hermetically.
# The DEFAULT answer is an empty body + exit 22 (curl -f's HTTP-fail code):
# "nothing answered" is a legal result the callers must treat as unmeasured,
# and this default keeps the unit tier from inventing passes.
#   -o <file>           write the body to <file> (it is not echoed to stdout)
#   --data-binary @-    drain stdin so piped bodies never block the caller
# STUB_CURL_OUT is a file holding the body, or the literal body itself.
# STUB_CURL_OUT_MAP is a file of "<url-substring>\t<body>" lines that answers
# per call instead of one body for every call (see the map block below).
# STUB_CURL_RC (default 0 when OUT or STATUS is set, else 22) overrides the
# exit code. STUB_CURL_STATUS is the canned HTTP status for probes that read
# the -w '%{http_code}' write-out: with -o it prints the status on stdout
# after storing the body, without -o it appends the status after the body.
# A script that reads the whole -o body from stdout gets the unchanged
# default answer until it opts into STUB_CURL_STATUS or STUB_CURL_OUT.
# Records one argv line to $STUB_LOG/curl.log when STUB_LOG is set.
#
# Usage (in a .bats file): use_stubs curl; STUB_CURL_OUT='{"ok":true}' \
#   run ./scripts/...
# Safety: stub only — never opens a socket.
set -u

if [ -n "${STUB_LOG:-}" ]; then printf '%s\n' "curl $*" >>"${STUB_LOG}/curl.log"; fi

outfile=""
prev=""
for a in "$@"; do
  if [ "${prev}" = "--data-binary" ] && [ "${a}" = "@-" ]; then
    cat >/dev/null 2>&1 || true
  fi
  if [ "${prev}" = "-o" ]; then
    outfile="${a}"
  fi
  prev="${a}"
done

body=""
rc="${STUB_CURL_RC:-}"
status="${STUB_CURL_STATUS:-}"
# STUB_CURL_OUT_MAP answers one call per line, "<url-substring>\t<body>", where
# <body> is a literal or a file. The first line whose substring appears anywhere
# in the argv wins; with the variable unset the answer stays the single
# STUB_CURL_OUT, byte for byte. It exists because a script that reads three
# different endpoints cannot be driven end to end when every GET gets the same
# canned body (scripts/coder-agents.sh reads the provider list, the model
# configs, and the per-lane model override).
if [ -n "${STUB_CURL_OUT_MAP:-}" ] && [ -f "${STUB_CURL_OUT_MAP}" ]; then
  joined_args="$*"
  while IFS=$'\t' read -r map_needle map_body; do
    [ -n "${map_needle}" ] || continue
    case "${joined_args}" in
      *"${map_needle}"*)
        if [ -f "${map_body}" ]; then
          map_body="$(cat "${map_body}")"
        fi
        STUB_CURL_OUT="${map_body}"
        break
        ;;
    esac
  done <"${STUB_CURL_OUT_MAP}"
fi
if [ -n "${STUB_CURL_OUT:-}" ]; then
  if [ -f "${STUB_CURL_OUT}" ]; then body="$(cat "${STUB_CURL_OUT}")"; else body="${STUB_CURL_OUT}"; fi
  rc="${rc:-0}"
fi
# A canned status counts as "an HTTP answer arrived", so it also defaults
# the exit code to 0, like a real transport success. Callers that never set
# STUB_CURL_STATUS keep the old empty-body + exit-22 default, byte for byte.
if [ -n "${status}" ]; then
  rc="${rc:-0}"
fi
rc="${rc:-22}"

if [ -n "${outfile}" ]; then
  printf '%s' "${body}" >"${outfile}"
  if [ -n "${status}" ]; then printf '%s\n' "${status}"; fi
  exit "${rc}"
fi
if [ -n "${status}" ]; then
  printf '%s\n%s\n' "${body}" "${status}"
  exit "${rc}"
fi
printf '%s' "${body}"
exit "${rc}"
