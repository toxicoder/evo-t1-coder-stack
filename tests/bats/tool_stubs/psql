#!/usr/bin/env bash
# shellcheck shell=bash
#
# ## psql — deterministic psql stub (test fixture; never ships)
#
# Purpose: stand in for the psql run INSIDE the db service (reached through
# the docker stub's exec passthrough) so SQL paths test without a database.
# Prints STUB_PSQL_OUT (a file's content or a literal body), exits
# STUB_PSQL_RC (0); a non-zero rc also prints "psql: error: stub failure"
# on stderr, matching the real client's habit of answering bad input with an
# error rather than silence.
#
# Usage (in a .bats file): use_stubs docker psql; STUB_PSQL_RC=1 run ...
#   STUB_PSQL_DELAY=2 makes the answer arrive two seconds late.
# Safety: stub only.
set -u

if [ -n "${STUB_LOG:-}" ]; then printf '%s\n' "psql $*" >> "${STUB_LOG}/psql.log"; fi

# Real psql reads the ALTER USER statement from stdin. Drain it here so a
# producer running under `set -o pipefail` (the db entrypoint) does not get
# SIGPIPE when this stub exits before the write; that race failed the
# entrypoint test on Linux CI and not on macOS.
if [ -n "${STUB_LOG:-}" ]; then
  cat >>"${STUB_LOG}/psql.stdin"
else
  cat >/dev/null
fi

if [ -n "${STUB_PSQL_OUT:-}" ]; then
  if [ -f "${STUB_PSQL_OUT}" ]; then cat "${STUB_PSQL_OUT}"; else printf '%s\n' "${STUB_PSQL_OUT}"; fi
fi
# STUB_PSQL_DELAY holds the caller for that many seconds before answering, so a
# test can pin what a slow query does to a wall-clock budget (a real db that
# answers late is the only other way to reach that shape).
if [ -n "${STUB_PSQL_DELAY:-}" ]; then sleep "${STUB_PSQL_DELAY}"; fi
if [ "${STUB_PSQL_RC:-0}" != "0" ]; then
  printf 'psql: error: stub failure\n' >&2
fi
exit "${STUB_PSQL_RC:-0}"
