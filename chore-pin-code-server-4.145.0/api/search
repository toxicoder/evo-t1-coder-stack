603":12,"1604":12,"1605":13,"1606":13,"1607":13,"1608":13,"1609":13,"1610":13,"1611":13,"1612":19,"1613":19,"1614":19,"1615":19,"1616":19,"1617":19,"1618":19,"1619":19,"1620":19,"1621":19,"1622":19,"1623":19,"1624":19,"1625":19,"1626":19,"1627":15,"1628":15,"1629":17,"1630":17,"1631":15,"1632":15,"1633":14,"1634":14,"1635":14,"1636":14,"1637":13,"1638":13,"1639":13,"1640":16,"1641":16,"1642":16,"1643":16,"1644":16,"1645":16,"1646":16,"1647":13,"1648":13,"1649":13,"1650":14,"1651":14,"1652":14,"1653":9,"1654":9,"1655":12,"1656":12,"1657":12,"1658":12,"1659":12,"1660":8,"1661":8,"1662":8,"1663":12,"1664":12,"1665":23,"1666":23,"1667":14,"1668":14,"1669":12,"1670":12,"1671":12,"1672":12,"1673":12,"1674":12,"1675":12,"1676":19,"1677":19,"1678":19,"1679":19,"1680":23,"1681":23,"1682":23,"1683":23,"1684":23,"1685":13,"1686":13,"1687":13,"1688":13,"1689":13,"1690":13,"1691":13,"1692":13,"1693":13,"1694":13,"1695":10,"1696":10,"1697":10,"1698":10,"1699":10,"1700":10,"1701":17,"1702":17,"1703":17,"1704":17,"1705":17,"1706":17,"1707":17,"1708":17,"1709":17,"1710":17,"1711":17,"1712":17,"1713":17,"1714":17,"1715":17,"1716":17,"1717":17,"1718":17,"1719":17,"1720":17,"1721":17,"1722":17,"1723":17,"1724":17,"1725":17,"1726":12,"1727":12,"1728":12,"1729":12,"1730":12,"1731":12,"1732":12,"1733":12,"1734":12,"1735":12,"1736":12,"1737":12,"1738":12,"1739":12,"1740":12,"1741":12,"1742":17,"1743":17,"1744":17,"1745":17,"1746":17,"1747":17,"1748":17,"1749":17,"1750":18,"1751":18,"1752":18,"1753":18,"1754":18,"1755":18,"1756":7,"1757":7,"1758":9,"1759":9}}},"docs":{"docs":{"1":{"id":"/branching","page_id":"/branching","type":"page","content":"Branching","breadcrumbs":["Docs"],"tags":["git","branching","ci"],"url":"/branching"},"2":{"id":"/branching-0","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching","content":"Trunk-based branch rules: main is the only long-lived branch, work branches are short-lived, and a pull request is the only way back in."},"3":{"id":"/branching-1","page_id":"/branching","type":"heading","tags":["git","branching","ci"],"url":"/branching#main","content":"main"},"4":{"id":"/branching-2","page_id":"/branching","type":"heading","tags":["git","branching","ci"],"url":"/branching#work-branches","content":"Work branches"},"5":{"id":"/branching-3","page_id":"/branching","type":"heading","tags":["git","branching","ci"],"url":"/branching#ci-and-protection","content":"CI and protection"},"6":{"id":"/branching-4","page_id":"/branching","type":"heading","tags":["git","branching","ci"],"url":"/branching#scope","content":"Scope"},"7":{"id":"/branching-5","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching","content":"What `main` is allowed to be, and what may not be committed to it"},"8":{"id":"/branching-6","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching","content":"How to cut, name and delete a short-lived work branch"},"9":{"id":"/branching-7","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching","content":"Where a hotfix branches from and where it lands first"},"10":{"id":"/branching-8","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching","content":"What CI runs, what branch protection should require, and where secrets go"},"11":{"id":"/branching-9","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching","content":"Naming a branch and a commit so CI and `git log` read the way the rest of the repo does"},"12":{"id":"/branching-10","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching","content":"Knowing which green check actually gates a merge into `main`"},"13":{"id":"/branching-11","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching","content":"Trunk-based, GitHub-Flow shaped: one long-lived branch, short-lived work branches, and a pull\nrequest as the only way back into `main`."},"14":{"id":"/branching-12","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#main","content":"`main` is the only long-lived branch. It stays green and deployable: `main` is what a\nmachine is built from, so a merge to `main` is by definition deployable to the stack host."},"15":{"id":"/branching-13","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#main","content":"Nothing is committed straight to `main`. Integration into `main` is by pull request, and a\nPR is only mergeable once CI is green:\n`bazelisk test //:test-fast`, `bazelisk test //:lint --test_tag_filters=manual` and the\nfull gate `bazelisk test //:test-all`, all\nexecuted inside the golden image (`images/dev/Dockerfile`) that CI builds with buildx and\ndocker-runs — the toolchain comes from that image, not from anything installed onto the\nrunner. Locally, run them the same way: inside the contributor container\n(contribute/devcontainer.md) or with\n`bazelisk run //scripts:test-in-image --`. `bash scripts/setup-host.sh` is the bootstrap\nfor the stack host, where the suites have to run on the host itself.\nTwo things run those checks for you so the gate is not a thing to remember:\n`bazelisk run //scripts:pre-commit` on demand, and, once\n`bazelisk run //scripts:install-hooks` has pointed `core.hooksPath` at `.githooks`,\n`.githooks/pre-commit` on every commit and `.githooks/pre-push` before anything is\npushed. `bazelisk run //:validate` runs the fast pair plus\n`docker compose config -q` and the `.env.sample`/`.env.example` comparison; the\npre-PR gate is `//:test-all`, which `//:validate` and the pre-push hook both reach."},"16":{"id":"/branching-14","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#work-branches","content":"Cut `feat/…`, `fix/…`, `refactor/…` (and `docs/…`, `test/…`, `chore/…`, `ci/…`) from the\ncurrent tip of `main`, one branch per change, and delete it the moment it merges. A branch\nthat outlives its change is a branch nobody rebases any more."},"17":{"id":"/branching-15","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#work-branches","content":"`fix/…` means a defect that is already on `main`. **A hotfix branches from `main` and lands\non `main` first** — every environment deploys *from* `main` (or from a tag cut on `main`),\nso there is no `staging` or `production` branch to patch and then remember to merge back."},"18":{"id":"/branching-16","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#work-branches","content":"Name the branch after the change, not the author, and keep the commit subject imperative\nwith one of `feat:`, `fix:`, `docs:`, `test:`, `chore:`, `ci:`, `refactor:`."},"19":{"id":"/branching-17","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#work-branches","content":"Below the subject leave one empty line, then the bullet points, and leave an empty line\nbetween every two bullets, so each bullet is its own paragraph. The same rule is in\n`templates/common/GROK_BUILD_AGENTS.md`, which is the text every workspace seeds into\n`~/.grok/AGENTS.md`, so a commit written by an agent and one written by hand read the\nsame way in `git log`."},"20":{"id":"/branching-18","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#ci-and-protection","content":"The `ci` workflow (`.github/workflows/ci.yml`) runs for `push` to `main` and for\n`pull_request` targeting `main`. The other shipped workflow, `deploy-docs`, also runs\non a `push` to any branch (`branches: [\"**\"]`) whose diff touches its `paths:` list -\n`docs/**`, `docs-site/**`, the two `scripts/ci/` helpers it publishes through\n(`publish-pages-tree.sh`, `docs-alias.sh`), and its own workflow file - and by\n`workflow_dispatch`."},"21":{"id":"/branching-19","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#ci-and-protection","content":"Branch protection on `main` should require a pull request before pushing, and the two\nBazel checks before merging — `//:test-fast` and `//:lint`, run inside the golden image\nthe workflow builds, so a green check means the suite passed on the Linux toolchain the\nstack actually ships rather than on whatever the runner image carried that day."},"22":{"id":"/branching-20","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#ci-and-protection","content":"Environments are where future protection rules and secrets go, per environment:\n`development`, `staging`, `production`. `production` stays restricted to `main` — or to\ntags — with required reviewers. See the header comment in `.github/workflows/ci.yml`."},"23":{"id":"/branching-21","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#scope","content":"A `fix/…` branch that also has to rename a template directory, retarget a `.bats` suite, and\nupdate `docs/` is one change: the rename is not green until the last reference follows.\nWhen a rename cannot be proven complete, the reference stays (a rename is only \"done\" when\nthe old name is gone outside historical docs) and the CI file says so in a comment."},"24":{"id":"/coder-templates","page_id":"/coder-templates","type":"page","content":"Coder workspace templates","breadcrumbs":["Docs"],"tags":["coder","templates","workspaces","terraform"],"url":"/coder-templates"},"25":{"id":"/coder-templates-0","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates","content":"Deep reference for `templates/workspace/` and `templates/devcontainer/`: what they build, how they get pushed, and what every variable means."},"26":{"id":"/coder-templates-1","page_id":"/coder-templates","type":"heading","tags":["coder","templates","workspaces","terraform"],"url":"/coder-templates#what-the-two-templates-make","content":"What the two templates make"},"27":{"id":"/coder-templates-2","page_id":"/coder-templates","type":"heading","tags":["coder","templates","workspaces","terraform"],"url":"/coder-templates#the-templatescommon-payloads","content":"The `templates/common/` payloads"},"28":{"id":"/coder-templates-3","page_id":"/coder-templates","type":"heading","tags":["coder","templates","workspaces","terraform"],"url":"/coder-templates#presets","content":"Presets"},"29":{"id":"/coder-templates-4","page_id":"/coder-templates","type":"heading","tags":["coder","templates","workspaces","terraform"],"url":"/coder-templates#how-push-template-works","content":"How `push-template` works"},"30":{"id":"/coder-templates-5","page_id":"/coder-templates","type":"heading","tags":["coder","templates","workspaces","terraform"],"url":"/coder-templates#what-it-does-and-does-not-do","content":"What it does and does not do"},"31":{"id":"/coder-templates-6","page_id":"/coder-templates","type":"heading","tags":["coder","templates","workspaces","terraform"],"url":"/coder-templates#the-one-argument-ceiling","content":"The one-argument ceiling"},"32":{"id":"/coder-templates-7","page_id":"/coder-templates","type":"heading","tags":["coder","templates","workspaces","terraform"],"url":"/coder-templates#argument-handling","content":"Argument handling"},"33":{"id":"/coder-templates-8","page_id":"/coder-templates","type":"heading","tags":["coder","templates","workspaces","terraform"],"url":"/coder-templates#where-it-runs-and-why","content":"Where it runs, and why"},"34":{"id":"/coder-templates-9","page_id":"/coder-templates","type":"heading","tags":["coder","templates","workspaces","terraform"],"url":"/coder-templates#credentials","content":"Credentials"},"35":{"id":"/coder-templates-10","page_id":"/coder-templates","type":"heading","tags":["coder","templates","workspaces","terraform"],"url":"/coder-templates#env-keys-it-reads","content":"`.env` keys it reads"},"36":{"id":"/coder-templates-11