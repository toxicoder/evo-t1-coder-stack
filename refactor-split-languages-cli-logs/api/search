1258":17,"1259":12,"1260":12,"1261":12,"1262":12,"1263":12,"1264":17,"1265":17,"1266":17,"1267":17,"1268":17,"1269":17,"1270":18,"1271":18,"1272":18,"1273":18,"1274":18,"1275":18,"1276":7,"1277":7,"1278":9,"1279":9}}},"docs":{"docs":{"1":{"id":"/branching","page_id":"/branching","type":"page","content":"Branching","breadcrumbs":["Docs"],"tags":["git","branching","ci"],"url":"/branching"},"2":{"id":"/branching-0","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching","content":"Trunk-based branch rules: main is the only long-lived branch, work branches are short-lived, and a pull request is the only way back in."},"3":{"id":"/branching-1","page_id":"/branching","type":"heading","tags":["git","branching","ci"],"url":"/branching#main","content":"main"},"4":{"id":"/branching-2","page_id":"/branching","type":"heading","tags":["git","branching","ci"],"url":"/branching#work-branches","content":"Work branches"},"5":{"id":"/branching-3","page_id":"/branching","type":"heading","tags":["git","branching","ci"],"url":"/branching#ci-and-protection","content":"CI and protection"},"6":{"id":"/branching-4","page_id":"/branching","type":"heading","tags":["git","branching","ci"],"url":"/branching#scope","content":"Scope"},"7":{"id":"/branching-5","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching","content":"What `main` is allowed to be, and what may not be committed to it"},"8":{"id":"/branching-6","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching","content":"How to cut, name and delete a short-lived work branch"},"9":{"id":"/branching-7","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching","content":"Where a hotfix branches from and where it lands first"},"10":{"id":"/branching-8","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching","content":"What CI runs, what branch protection should require, and where secrets go"},"11":{"id":"/branching-9","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching","content":"Naming a branch and a commit so CI and `git log` read the way the rest of the repo does"},"12":{"id":"/branching-10","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching","content":"Knowing which green check actually gates a merge into `main`"},"13":{"id":"/branching-11","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching","content":"Trunk-based, GitHub-Flow shaped: one long-lived branch, short-lived work branches, and a pull\nrequest as the only way back into `main`."},"14":{"id":"/branching-12","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#main","content":"`main` is the only long-lived branch. It stays green and deployable: `main` is what a\nmachine is built from, so a merge to `main` is by definition deployable to the stack host."},"15":{"id":"/branching-13","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#main","content":"Nothing is committed straight to `main`. Integration into `main` is by pull request, and a\nPR is only mergeable once CI is green:\n`bazelisk test //:test-fast` and `bazelisk test //:lint --test_tag_filters=manual`, both\nexecuted inside the golden image (`images/dev/Dockerfile`) that CI builds with buildx and\ndocker-runs — the toolchain comes from that image, not from anything installed onto the\nrunner. Locally, run them the same way: inside the contributor container\n(contribute/devcontainer.md) or with\n`bazelisk run //scripts:test-in-image --`. `bash scripts/setup-host.sh` is the bootstrap\nfor the stack host, where the suites have to run on the host itself;\n`bazelisk run //:validate` runs both of the checks plus\n`docker compose config -q` and the `.env.sample`/`.env.example` comparison — that is the\npre-PR gate."},"16":{"id":"/branching-14","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#work-branches","content":"Cut `feat/…`, `fix/…`, `refactor/…` (and `docs/…`, `test/…`, `chore/…`, `ci/…`) from the\ncurrent tip of `main`, one branch per change, and delete it the moment it merges. A branch\nthat outlives its change is a branch nobody rebases any more."},"17":{"id":"/branching-15","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#work-branches","content":"`fix/…` means a defect that is already on `main`. **A hotfix branches from `main` and lands\non `main` first** — every environment deploys *from* `main` (or from a tag cut on `main`),\nso there is no `staging` or `production` branch to patch and then remember to merge back."},"18":{"id":"/branching-16","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#work-branches","content":"Name the branch after the change, not the author, and keep the commit subject imperative\nwith one of `feat:`, `fix:`, `docs:`, `test:`, `chore:`, `ci:`, `refactor:`."},"19":{"id":"/branching-17","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#work-branches","content":"Below the subject leave one empty line, then the bullet points, and leave an empty line\nbetween every two bullets, so each bullet is its own paragraph. The same rule is in\n`templates/common/GROK_BUILD_AGENTS.md`, which is the text every workspace seeds into\n`~/.grok/AGENTS.md`, so a commit written by an agent and one written by hand read the\nsame way in `git log`."},"20":{"id":"/branching-18","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#ci-and-protection","content":"CI runs only for `push` to `main` and for `pull_request` targeting `main`."},"21":{"id":"/branching-19","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#ci-and-protection","content":"Branch protection on `main` should require a pull request before pushing, and the two\nBazel checks before merging — `//:test-fast` and `//:lint`, run inside the golden image\nthe workflow builds, so a green check means the suite passed on the Linux toolchain the\nstack actually ships rather than on whatever the runner image carried that day."},"22":{"id":"/branching-20","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#ci-and-protection","content":"Environments are where future protection rules and secrets go, per environment:\n`development`, `staging`, `production`. `production` stays restricted to `main` — or to\ntags — with required reviewers. See the header comment in `.github/workflows/ci.yml`."},"23":{"id":"/branching-21","page_id":"/branching","tags":["git","branching","ci"],"type":"text","url":"/branching#scope","content":"A `fix/…` branch that also has to rename a template directory, retarget a `.bats` suite, and\nupdate `docs/` is one change: the rename is not green until the last reference follows.\nWhen a rename cannot be proven complete, the reference stays (a rename is only \"done\" when\nthe old name is gone outside historical docs) and the CI file says so in a comment."},"24":{"id":"/coder-templates","page_id":"/coder-templates","type":"page","content":"Coder workspace templates","breadcrumbs":["Docs"],"tags":["coder","templates","workspaces","terraform"],"url":"/coder-templates"},"25":{"id":"/coder-templates-0","page_id":"/coder-templates","tags":["coder","templates","workspaces","terraform"],"type":"text","url":"/coder-templates","content":"Deep reference for `templates/workspace/` and `templates/devcontainer/`: what they build, how they get pushed, and what every variable means."},"26":{"id":"/coder-templates-1","page_id":"/coder-templates","type":"heading","tags":["coder","templates","workspaces","terraform"],"url":"/coder-templates#what-the-two-templates-make","content":"What the two templates make"},"27":{"id":"/coder-templates-2","page_id":"/coder-templates","type":"heading","tags":["coder","templates","workspaces","terraform"],"url":"/coder-templates#the-templatescommon-payloads","content":"The `templates/common/` payloads"},"28":{"id":"/coder-templates-3","page_id":"/coder-templates","type":"heading","tags":["coder","templates","workspaces","terraform"],"url":"/coder-templates#presets","content":"Presets"},"29":{"id":"/coder-templates-4","page_id":"/coder-templates","type":"heading","tags":["coder","templates","workspaces","terraform"],"url":"/coder-templates#how-push-template-works","content":"How `push-template` works"},"30":{"id":"/coder-templates-5","page_id":"/coder-templates","type":"heading","tags":["coder","templates","workspaces","terraform"],"url":"/coder-templates#what-it-does-and-does-not-do","content":"What it does and does not do"},"31":{"id":"/coder-templates-6","page_id":"/coder-templates","type":"heading","tags":["coder","templates","workspaces","terraform"],"url":"/coder-templates#argument-handling","content":"Argument handling"},"32":{"id":"/coder-templates-7","page_id":"/coder-templates","type":"heading","tags":["coder","templates","workspaces","terraform"],"url":"/coder-templates#where-it-runs-and-why","content":"Where it runs, and why"},"33":{"id":"/coder-templates-8","page_id":"/coder-templates","type":"heading","tags":["coder","templates","workspaces","terraform"],"url":"/coder-templates#credentials","content":"Credentials"},"34":{"id":"/coder-templates-9","page_id":"/coder-templates","type":"heading","tags":["coder","templates","workspaces","terraform"],"url":"/coder-templates#env-keys-it-reads","content":"`.env` keys it reads"},"35":{"id":"/coder-templates-10","page_id":"/coder-templates","type":"heading","tags":["coder","templates","workspaces","terraform"],"url":"/coder-templates#knobs-and-skips","content":"Knobs and skips"},"36":{"id":"/coder-templates-11","page_id":"/coder-templates","type":"heading","tags":["coder","templates","workspaces","terraform"],"url":"/coder-templates#the-same-pu