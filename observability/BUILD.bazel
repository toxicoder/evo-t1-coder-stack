"""Package purpose: the observability bundle's payload (metrics, logs, traces).

One directory holds every config the bundle's services mount, and the tree is
separated per component because that is how compose mounts it: one bind per service,
each read by exactly one container. `prometheus/` is mounted as a directory so an
operator can drop rule files beside prometheus.yml without a compose edit; the rest
are single files, and each grafana/ subdirectory mirrors one provisioning mount so
shadowing the image's own /etc/grafana/provisioning siblings stays impossible.

Three production scripts read this tree: //scripts:validate parses the YAML,
//scripts:observability-check reads the Alloy config to report what the shipper
tails, and //scripts:spark-monitor ferries dcgm/custom-counters.csv to each Spark
and mounts it into that box's exporter. Each declares what it reads in
scripts/BUILD.bazel.
"""

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "prometheus_config",
    # glob-policy: compose mounts ./observability/prometheus as a directory at
    # /etc/prometheus, so the directory itself is the mount contract and anything
    # added to it ships without a BUILD edit.
    srcs = glob(
        ["prometheus/**"],
        allow_empty = True,
    ),
)

filegroup(
    name = "loki_config",
    srcs = ["loki/loki.yml"],
)

filegroup(
    name = "tempo_config",
    srcs = ["tempo/tempo.yml"],
)

filegroup(
    name = "mimir_config",
    srcs = ["mimir/mimir.yml"],
)

filegroup(
    name = "grafana_provisioning",
    # Listed, not globbed: these files name the datasource UIDs the dashboards
    # query by and the contact point alerts route through, so a new provisioning
    # file is a change someone has to read, not a file that ships because it
    # landed in a directory.
    srcs = [
        "grafana/provisioning/alerting/stack.yaml",
        "grafana/provisioning/dashboards/stack.yaml",
        "grafana/provisioning/datasources/stack.yaml",
    ],
)

filegroup(
    name = "grafana_unified_storage",
    # The quota-overrides file GF_UNIFIED_STORAGE_OVERRIDES_PATH points at, mounted
    # as a single read-only file by the grafana service. Its existence is the
    # point: without it /apis/quotas.grafana.app answers 501 on every dashboard
    # page. Listed rather than globbed, the way the provisioning tree is, because
    # the path is named twice more (the compose mount and the GF_ variable) and
    # those three have to agree.
    srcs = ["grafana/unified-storage/overrides.yml"],
)

filegroup(
    name = "blackbox_config",
    # The prober's whole module set. Listed rather than globbed: a module is a
    # network behaviour this box asks the LAN to perform, so each one is reviewed.
    srcs = ["blackbox/blackbox.yml"],
)

filegroup(
    name = "alertmanager_config",
    srcs = [
        "alertmanager/alertmanager.yml",
        # The container's own entrypoint: it turns ALERTMANAGER_WEBHOOK_URL into
        # the file alertmanager.yml's `url_file:` reads, because Alertmanager
        # cannot expand an environment variable itself.
        "alertmanager/boot-webhook-url.sh",
    ],
)

filegroup(
    name = "dcgm_counters",
    # The counter list //scripts:spark-monitor ferries to each Spark and mounts
    # into the DCGM exporter. It is a payload of that CLI as much as of this tree,
    # so scripts/BUILD.bazel names it in _SCRIPT_PAYLOAD too.
    srcs = ["dcgm/custom-counters.csv"],
)

filegroup(
    name = "grafana_dashboards",
    # glob-policy: ./observability/grafana/dashboards is mounted at
    # /var/lib/grafana/dashboards and the provider file loads whatever is in it, so
    # a new dashboard JSON is a file add with no BUILD edit.
    srcs = glob(
        ["grafana/dashboards/*.json"],
        allow_empty = True,
    ),
)

filegroup(
    name = "alloy_config",
    srcs = ["alloy/config.alloy"],
)

filegroup(
    name = "spark_targets",
    # Only the README is tracked: sparks.json is generated on the stack host and is
    # gitignored because it names the boxes. The directory still has to ship, because
    # compose bind-mounts it and //tests:bats_stack_data_test checks that every bind
    # source exists beside the compose file.
    srcs = ["spark-targets/README.md"],
)

# Every file the bundle's containers mount, for the gates that address the tree as
# one directory (//:stack_data, the compose-config suites).
filegroup(
    name = "payload",
    srcs = [
        ":alertmanager_config",
        ":alloy_config",
        ":blackbox_config",
        ":dcgm_counters",
        ":grafana_dashboards",
        ":grafana_provisioning",
        ":grafana_unified_storage",
        ":loki_config",
        ":mimir_config",
        ":prometheus_config",
        ":spark_targets",
        ":tempo_config",
    ],
)
