{
  "uid": "evo-spark-host",
  "title": "One DGX Spark",
  "tags": ["evo-t1", "spark"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "annotations": { "list": [] },
  "description": "The deep dive for a single Spark: host detail and GPU detail on one page. Reach it from a card on DGX Sparks overview, which presets $host to the box you clicked, or pick the box here. Box-side panels filter on instance and GPU-side panels on hostname, because those are the labels each exporter actually carries.",
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Spark",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(spark:box_up, hostname)",
        "query": "label_values(spark:box_up, hostname)",
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": [],
        "hide": 0
      }
    ]
  },
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "Back to DGX Sparks overview",
      "type": "dashboards",
      "url": "/d/evo-sparks-overview/dgx-sparks-overview"
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Box up",
      "description": "spark:box_up, which is 1 only while this box's own node_exporter scrape succeeds; it filters on hostname because the recording rule normalises the box-side instance label to hostname. Read it together with the probe stat beside it: the pair disagreeing is an exporter problem, both at 0 is the box.",
      "id": 1,
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "spark:box_up{hostname=\"$host\"}",
          "legendFormat": "node_exporter scrape",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": { "text": "up", "color": "green" },
                "0": { "text": "down", "color": "red" }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "noValue": "no data",
      "thresholds": {
        "mode": "absolute",
        "steps": [
          { "color": "red", "value": null },
          { "color": "green", "value": 1 }
        ]
      }
    },
    {
      "type": "stat",
      "title": "Worst probe result",
      "description": "spark:probe_up, the worst blackbox result across both modules for this host (observability/prometheus/rules/spark.rules.yml), filtered on the normalised hostname. It goes to 0 before the box does, so a 0 beside a green Box up means a serving port stopped answering while the OS stayed alive.",
      "id": 2,
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "spark:probe_up{hostname=\"$host\"}",
          "legendFormat": "blackbox probes",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": { "text": "probes pass", "color": "green" },
                "0": { "text": "probe failing", "color": "red" }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "noValue": "no data",
      "thresholds": {
        "mode": "absolute",
        "steps": [
          { "color": "red", "value": null },
          { "color": "green", "value": 1 }
        ]
      }
    },
    {
      "type": "stat",
      "title": "GPUs reporting in the last 6h",
      "description": "Count of spark:gpu_reported_recently:gpu rows for this box. The rule keeps a card counted for 6h after it goes silent on purpose, so a number here that is higher than the GPU lines below is a card that fell off the bus rather than a card that is idle.",
      "id": 3,
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "count(spark:gpu_reported_recently:gpu{hostname=\"$host\"}) or vector(0)",
          "legendFormat": "gpus seen",
          "instant": true
        }
      ],
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "noValue": "no data",
      "thresholds": {
        "mode": "absolute",
        "steps": [
          { "color": "red", "value": null },
          { "color": "green", "value": 1 }
        ]
      }
    },
    {
      "type": "row",
      "title": "Host",
      "description": "node_exporter for this box only. A Spark's box-side series carry box and instance but no hostname label (observability/prometheus/rules/spark.rules.yml:14), and box is the positional token from the generated target file, so every panel in this row filters on instance and names the host token from $host.",
      "collapsed": false,
      "id": 4,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 4 },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "CPU utilisation by mode",
      "description": "Busy core-seconds per mode divided by this box's core count, so the lines read as a share of the machine. A steady user line is inference work on the CPU; a rising iowait line is the disk row below, not the compute.",
      "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "custom": { "fillOpacity": 12, "lineWidth": 1, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (mode) (rate(node_cpu_seconds_total{instance=~\"$host(:[0-9]+)?\", mode!=\"idle\"}[5m])) / count(node_cpu_seconds_total{instance=~\"$host(:[0-9]+)?\", mode=\"idle\"})",
          "legendFormat": "{{mode}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Load average, runnable and blocked",
      "description": "The three load averages plus the instantaneous process counts, all filtered on instance. Load climbing while the GPU panels stay flat means something on the box is waiting, and the blocked line says whether it is waiting on the filesystem.",
      "id": 6,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "custom": { "fillOpacity": 8, "lineWidth": 1 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_load1{instance=~\"$host(:[0-9]+)?\"}",
          "legendFormat": "load1"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_load5{instance=~\"$host(:[0-9]+)?\"}",
          "legendFormat": "load5"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_load15{instance=~\"$host(:[0-9]+)?\"}",
          "legendFormat": "load15"
        },
        {
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_procs_running{instance=~\"$host(:[0-9]+)?\"}",
          "legendFormat": "procs running"
        },
        {
          "refId": "E",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_procs_blocked{instance=~\"$host(:[0-9]+)?\"}",
          "legendFormat": "procs blocked"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory",
      "description": "Total and used, where used is MemTotal minus MemAvailable, so page cache is not counted against the box. A used line that only ever climbs is the usual prelude to the swap panel filling and a stalled inference container.",
      "id": 7,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0, "custom": { "fillOpacity": 12, "lineWidth": 1 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_memory_MemTotal_bytes{instance=~\"$host(:[0-9]+)?\"} - node_memory_MemAvailable_bytes{instance=~\"$host(:[0-9]+)?\"}",
          "legendFormat": "used"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_memory_MemTotal_bytes{instance=~\"$host(:[0-9]+)?\"}",
          "legendFormat": "total"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Swap",
      "description": "Swap in use against the swap total, filtered on instance. Any sustained line above zero on a box serving a model means the host is paging model state, which the GPU side will show as a card that looks starved.",
      "id": 8,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0, "custom": { "fillOpacity": 12, "lineWidth": 1 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_memory_SwapTotal_bytes{instance=~\"$host(:[0-9]+)?\"} - node_memory_SwapFree_bytes{instance=~\"$host(:[0-9]+)?\"}",
          "legendFormat": "used"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_memory_SwapTotal_bytes{instance=~\"$host(:[0-9]+)?\"}",
          "legendFormat": "total"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Disk IOPS per device",
      "description": "Completed reads and writes per second per device. A burst that starts when a model loads is normal; one that continues while GPU util is flat is a cache or log path on the wrong disk.",
      "id": 9,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0, "custom": { "fillOpacity": 12, "lineWidth": 1 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (device) (rate(node_disk_reads_completed_total{instance=~\"$host(:[0-9]+)?\"}[5m]))",
          "legendFormat": "{{device}} read"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (device) (rate(node_disk_writes_completed_total{instance=~\"$host(:[0-9]+)?\"}[5m]))",
          "legendFormat": "{{device}} write"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Disk utilisation",
      "description": "Fraction of wall time each device had at least one request in flight. A device pinned at 1.0 is saturated, and every line above it in this row is waiting on it.",
      "id": 10,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "fillOpacity": 12, "lineWidth": 1 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(node_disk_io_time_seconds_total{instance=~\"$host(:[0-9]+)?\"}[5m])",
          "legendFormat": "{{device}}"
        }
      ]
    },
    {
      "type": "table",
      "title": "Filesystems and inodes",
      "description": "One row per mount: the share of space used and the share of inodes used, tmpfs, overlay and squashfs mounts excluded. A full filesystem and a full inode table look identical to the workload, so both fractions are shown; either one at 1.0 stops the model from loading.",
      "id": 11,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_filesystem_avail_bytes{instance=~\"$host(:[0-9]+)?\", fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{instance=~\"$host(:[0-9]+)?\", fstype!~\"tmpfs|overlay|squashfs\"}",
          "legendFormat": "{{mountpoint}} space used",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "1 - node_filesystem_files_free{instance=~\"$host(:[0-9]+)?\", fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_files{instance=~\"$host(:[0-9]+)?\", fstype!~\"tmpfs|overlay|squashfs\"}",
          "legendFormat": "{{mountpoint}} inodes used",
          "instant": true,
          "format": "table"
        }
      ],
      "options": { "showHeader": true },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "max": 1,
          "min": 0,
          "custom": { "align": "auto" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.8 },
              { "color": "red", "value": 0.95 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Network throughput",
      "description": "Bytes per second in and out per physical interface, loopback, veth, bridge and docker interfaces excluded. A box that is not pulling its share of traffic shows up here as a flat line while the fleet is busy.",
      "id": 12,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps", "min": 0, "custom": { "fillOpacity": 12, "lineWidth": 1 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (device) (rate(node_network_receive_bytes_total{instance=~\"$host(:[0-9]+)?\", device!~\"lo|veth.*|br.*|docker.*|virbr.*\"}[5m]))",
          "legendFormat": "{{device}} rx"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (device) (rate(node_network_transmit_bytes_total{instance=~\"$host(:[0-9]+)?\", device!~\"lo|veth.*|br.*|docker.*|virbr.*\"}[5m]))",
          "legendFormat": "{{device}} tx"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Network drops",
      "description": "Dropped receive and transmit packets per second per interface. Any sustained non-zero line is the NIC or the queue depth giving up, which reads at the serving layer as slow requests rather than as errors.",
      "id": 13,
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 29 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "pps", "min": 0, "custom": { "fillOpacity": 12, "lineWidth": 1 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (device) (rate(node_network_receive_drop_total{instance=~\"$host(:[0-9]+)?\", device!~\"lo|veth.*|br.*|docker.*|virbr.*\"}[5m]))",
          "legendFormat": "{{device}} rx drops"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (device) (rate(node_network_transmit_drop_total{instance=~\"$host(:[0-9]+)?\", device!~\"lo|veth.*|br.*|docker.*|virbr.*\"}[5m]))",
          "legendFormat": "{{device}} tx drops"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Pressure stall (not filtered to this box)",
      "description": "PSI some and full stall per subsystem. The node_exporter PSI series carry no labels at all, so no selector can reach this box's own PSI from here: this panel reads the host the exporter sits on and is context, not this Spark's number. A rising line is time spent waiting for CPU, memory or IO, not time spent using them.",
      "id": 14,
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 29 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "custom": { "fillOpacity": 12, "lineWidth": 1 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(node_pressure_cpu_waiting_seconds_total[5m])",
          "legendFormat": "cpu some"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(node_memory_waiting_seconds_total[5m])",
          "legendFormat": "memory some"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(node_io_waiting_seconds_total[5m])",
          "legendFormat": "io some"
        },
        {
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(node_memory_stalled_seconds_total[5m])",
          "legendFormat": "memory full"
        },
        {
          "refId": "E",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(node_io_stalled_seconds_total[5m])",
          "legendFormat": "io full"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Conntrack table",
      "description": "Entries in use against the kernel limit. A table that rides its limit drops new flows silently, which looks like a serving port that sometimes refuses to answer.",
      "id": 15,
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "custom": { "fillOpacity": 12, "lineWidth": 1 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_nf_conntrack_entries{instance=~\"$host(:[0-9]+)?\"}",
          "legendFormat": "entries"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_nf_conntrack_entries_limit{instance=~\"$host(:[0-9]+)?\"}",
          "legendFormat": "limit"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "File descriptors",
      "description": "Allocated descriptors against the system maximum. A line that only climbs is a process leaking sockets or files, and it fails at the maximum with the worst possible timing.",
      "id": 16,
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "custom": { "fillOpacity": 12, "lineWidth": 1 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_filefd_allocated{instance=~\"$host(:[0-9]+)?\"}",
          "legendFormat": "allocated"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_filefd_maximum{instance=~\"$host(:[0-9]+)?\"}",
          "legendFormat": "maximum"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Uptime",
      "description": "time() minus node_boot_time_seconds for this box. A short uptime beside ECC or remap numbers that predate it means the card has already been rebooted once since they were logged.",
      "id": 17,
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "dtdurations" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "time() - node_boot_time_seconds{instance=~\"$host(:[0-9]+)?\"}",
          "legendFormat": "since boot",
          "instant": true
        }
      ],
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "noValue": "no data"
    },
    {
      "type": "row",
      "title": "GPU",
      "description": "The DCGM side of this box. DCGM series and every spark: GPU recording rule carry hostname, so every panel in this row filters on hostname=\"$host\" and is one line per gpu. Temperatures are read against the 95 C slowdown point these cards hold (observability/prometheus/rules/spark.rules.yml:30).",
      "collapsed": false,
      "id": 18,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 43 },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "GPU utilisation",
      "description": "spark:gpu_util_pct:gpu, one line per card, filtered on hostname. This is kernel-active time, not work done: a card at 100 with a low SM clock below is busy being throttled rather than busy computing.",
      "id": 19,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 44 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "fillOpacity": 12, "lineWidth": 1 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "spark:gpu_util_pct:gpu{hostname=\"$host\"}",
          "legendFormat": "{{gpu}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory copy utilisation",
      "description": "spark:gpu_mem_copy_util_pct:gpu per card, filtered on hostname. This is the framebuffer bandwidth meter: high here with low GPU util is a workload that is memory bound rather than compute bound.",
      "id": 20,
