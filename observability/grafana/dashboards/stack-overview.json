        }
      ]
    },
    {
      "type": "link",
      "title": "Models",
      "description": "What is loaded where, and what the request load on it looks like.",
      "id": 25,
      "gridPos": { "h": 4, "w": 3, "x": 12, "y": 38 },
      "targets": [],
      "links": [
        {
          "title": "Models",
          "url": "/d/evo-inference-models/models",
          "targetBlank": false,
          "tooltip": "Models, tokens, and latency per alias"
        }
      ]
    },
    {
      "type": "link",
      "title": "Backends",
      "description": "The serving backends behind those models, and the ports this page's probers answer for.",
      "id": 26,
      "gridPos": { "h": 4, "w": 3, "x": 15, "y": 38 },
      "targets": [],
      "links": [
        {
          "title": "Inference backends",
          "url": "/d/evo-inference-backends/inference-backends",
          "targetBlank": false,
          "tooltip": "Serving backends and their health"
        }
      ]
    },
    {
      "type": "link",
      "title": "Alerts",
      "description": "What is firing now, how long it has been firing, and whether Alertmanager is still delivering.",
      "id": 27,
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 38 },
