{
  "uid": "evo-stack-overview",
  "title": "Stack overview",
  "tags": ["evo-t1", "stack"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "type": "stat",
      "title": "Scrape targets up",
      "description": "How many of the bundle's scrape jobs answered their last poll. It counts targets, not services, so the number you expect is however many jobs observability/prometheus/prometheus.yml configures today.",
      "id": 1,
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "count(up == 1)",
          "instant": true
        }
      ],
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "thresholds": {
        "mode": "absolute",
        "steps": [
          { "color": "red", "value": null },
          { "color": "yellow", "value": 6 },
          { "color": "green", "value": 8 }
        ]
      }
    },
    {
      "type": "stat",
      "title": "Scrape targets down",
      "description": "Configured jobs whose scrape failed. Anything above zero is a service that exists but is not answering, so read it against the job lines below rather than treating it as one outage.",
      "id": 2,
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "count(up == 0) or vector(0)",
          "instant": true
        }
      ],
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "thresholds": {
        "mode": "absolute",
        "steps": [
          { "color": "green", "value": null },
          { "color": "red", "value": 1 }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Prometheus TSDB on disk",
      "description": "The local 15d window. A line that climbs past the retention cap means the size flag stopped being honoured; Mimir's own block count is on the Mimir row below. The write-ahead log is deliberately not charted here - Prometheus exports no WAL size gauge, so a panel would sit at no data forever.",
      "id": 3,
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "prometheus_tsdb_storage_blocks_bytes",
          "legendFormat": "tsdb blocks"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Target availability",
      "description": "One line per scrape job. A job that is absent here was never configured; a job pinned at 0 is configured and not answering, which is the difference between a docs gap and an outage.",
      "id": 4,
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "custom": { "fillOpacity": 12, "lineWidth": 1 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "up",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Log lines per second, by container",
      "description": "Counted by Loki as it receives them, so this is the shipper's view rather than the container's. A container that goes quiet looks identical to one that stopped logging, which is why the log panels live in stack-logs.",
      "id": 5,
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (container) (rate(loki_distributor_lines_received_total{container!=\"\"}[5m])) or sum by (name) (rate(loki_distributor_lines_received_total{name!=\"\"}[5m]))",
          "legendFormat": "{{container}}{{name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Remote write to Mimir",
      "description": "Samples per second leaving Prometheus, the ones that failed, and the ones being retried. The retry line is the one that matters: Prometheus keeps 15d locally, so a stalled write costs query latency in Mimir, not the data itself.",
      "id": 6,
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(prometheus_remote_storage_samples_pending[5m]))",
          "legendFormat": "pending"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(prometheus_remote_storage_samples_failed_total[5m]))",
          "legendFormat": "failed"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(prometheus_remote_storage_samples_retried_total[5m]))",
          "legendFormat": "retried"
        }
      ]
    },
    {
      "type": "stat",
      "title": "node_exporter reporting",
      "description": "One means the exporter behind every host number is not answering its scrape at all, which is why the host pages read as no data rather than as a red outage. Zero means the binary itself is up and publishing.",
      "id": 7,
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "noValue": "unknown" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(absent(node_exporter_build_info{job=\"node_exporter\"}) or vector(0))",
          "instant": true
        }
      ],
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "thresholds": {
        "mode": "absolute",
        "steps": [
          { "color": "green", "value": null },
          { "color": "red", "value": 1 }
        ]
      }
    },
    {
      "type": "stat",
      "title": "cAdvisor reporting",
      "description": "One means cAdvisor stopped publishing, so every per-container number on the Containers page is missing rather than idle. It watches the exporter's own version series so a container that died and an exporter that never started stay two different readings.",
      "id": 8,
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "noValue": "unknown" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(absent(cadvisor_version_info{job=\"cadvisor\"}) or vector(0))",
          "instant": true
        }
      ],
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "thresholds": {
        "mode": "absolute",
        "steps": [
          { "color": "green", "value": null },
          { "color": "red", "value": 1 }
        ]
      }
    },
    {
      "type": "stat",
      "title": "Spark probe job silent",
      "description": "Zero is the healthy reading and it covers a stack with no Spark enrolled, which is what ships: no groups published, nothing to probe, nothing to alarm on. One means the generated target file does publish node_exporter groups, so Sparks are enrolled, while the job that probes their health port has no series at all. Read that as the prober or the generated file being wrong rather than the boxes being offline, and compare against what //scripts:spark-monitor -- --targets would write.",
      "id": 9,
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "noValue": "unknown" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(absent(up{job=\"blackbox-spark\"}) and on() (count(up{job=\"spark-node\"}) > 0)) or vector(0)",
          "instant": true
        }
      ],
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "thresholds": {
        "mode": "absolute",
        "steps": [
          { "color": "green", "value": null },
          { "color": "red", "value": 1 }
        ]
      }
    },
    {
      "type": "stat",
      "title": "Model probe job silent",
      "description": "Zero is the healthy reading and it covers a stack with no Spark enrolled. One means boxes are enrolled by the generated target file while the job that probes the model-serving ports has no series at all, so an inference outage would read as no data on the backends page. Same cause as the tile beside it: the prober or the generated file.",
      "id": 10,
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "noValue": "unknown" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(absent(up{job=\"blackbox-spark-models\"}) and on() (count(up{job=\"spark-node\"}) > 0)) or vector(0)",
          "instant": true
        }
      ],
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "thresholds": {
        "mode": "absolute",
        "steps": [
          { "color": "green", "value": null },
          { "color": "red", "value": 1 }
        ]
      }
    },
    {
      "type": "stat",
      "title": "Host load per core",
      "description": "Runnable tasks divided by the core count, from the repo's own host:cpu_load1_per_core:ratio rule. Above 1 the box has more work ready than cores to run it, whatever the CPU utilisation percentage says.",
      "id": 11,
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ratio", "min": 0, "noValue": "no data" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(host:cpu_load1_per_core:ratio)",
          "instant": true
        }
      ],
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "thresholds": {
        "mode": "absolute",
        "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 1 },
          { "color": "red", "value": 2 }
        ]
      }
    },
    {
      "type": "stat",
      "title": "Containers reporting",
      "description": "Distinct named cAdvisor containers seen on the last scrape, so a container that stopped reporting leaves this count rather than sitting in it as a zero.",
      "id": 12,
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "min": 0, "noValue": "0" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "count(count by (name) (container_last_seen))",
          "instant": true
        }
      ],
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
    },
    {
      "type": "stat",
      "title": "Alerts firing",
      "description": "Alert series from this bundle's own rule files that are firing right now, counted per rule and per Spark rather than per rule file, so three Sparks tripping one rule read as three.",
      "id": 13,
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "min": 0, "noValue": "0" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
          "instant": true
        }
      ],
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "thresholds": {
        "mode": "absolute",
        "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 1 },
          { "color": "red", "value": 3 }
        ]
      }
    },
    {
      "type": "stat",
      "title": "Scrape staleness",
      "description": "Seconds since the least recently written up series. A failed scrape still writes up=0, so this climbing past the scrape interval means the scrape loop itself stalled, which is a Prometheus problem rather than one target being down.",
      "id": 14,
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0, "noValue": "no data" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(time() - timestamp(up))",
          "instant": true
        }
      ],
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "thresholds": {
        "mode": "absolute",
        "steps": [
          { "color": "green", "value": null },
          { "color": "yellow", "value": 60 },
          { "color": "red", "value": 300 }
        ]
      }
    },
    {
      "type": "stat",
      "title": "Coder reporting",
      "description": "One means the Coder control plane stopped answering its scrape, which also takes the agent tunnel every workspace agent reaches LiteLLM through. Zero is the healthy reading for every tile in this row.",
      "id": 15,
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "noValue": "unknown" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(absent(up{job=\"coder\"}) or vector(0))",
          "instant": true
        }
      ],
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "thresholds": {
        "mode": "absolute",
        "steps": [
          { "color": "green", "value": null },
          { "color": "red", "value": 1 }
        ]
      }
    },
    {
      "type": "stat",
      "title": "LiteLLM reporting",
      "description": "One means the sole model transport has no series at all, so every agent lane in the bundle is unreachable rather than merely slow. The LiteLLM proxy page is where to go next, and it reads empty when this tile is red.",
      "id": 16,
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "noValue": "unknown" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(absent(up{job=\"litellm\"}) or vector(0))",
          "instant": true
        }
      ],
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "thresholds": {
        "mode": "absolute",
        "steps": [
          { "color": "green", "value": null },
          { "color": "red", "value": 1 }
        ]
      }
    },
    {
      "type": "stat",
      "title": "Alertmanager reporting",
      "description": "One means nothing is being delivered even though rules can still fire, so the Alerts page looks calm while notifications go nowhere. Silences live in Alertmanager's own UI, not in Grafana.",
      "id": 17,
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "noValue": "unknown" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(absent(up{job=\"alertmanager\"}) or vector(0))",
          "instant": true
        }
      ],
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "thresholds": {
        "mode": "absolute",
        "steps": [
          { "color": "green", "value": null },
          { "color": "red", "value": 1 }
        ]
      }
    },
    {
      "type": "stat",
      "title": "Grafana reporting",
      "description": "One means this page's own process stopped answering its metrics route while still serving the UI, which is the confusing case: the dashboard renders and the bundle looks dark. Trust the other tiles in this row over this one.",
      "id": 18,
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "noValue": "unknown" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(absent(up{job=\"grafana\"}) or vector(0))",
          "instant": true
        }
      ],
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "thresholds": {
        "mode": "absolute",
        "steps": [
          { "color": "green", "value": null },
          { "color": "red", "value": 1 }
        ]
      }
    },
    {
      "type": "stat",
      "title": "Alloy reporting",
      "description": "One means the collector that forwards container logs to Loki has stopped, so the log rate panel above keeps its shape for one rate window and then goes flat. A quiet stack and a dead shipper look the same from Loki alone.",
      "id": 19,
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "noValue": "unknown" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(absent(up{job=\"alloy\"}) or vector(0))",
          "instant": true
        }
      ],
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "thresholds": {
        "mode": "absolute",
        "steps": [
          { "color": "green", "value": null },
          { "color": "red", "value": 1 }
        ]
      }
    },
    {
      "type": "stat",
      "title": "Tempo reporting",
      "description": "One means the trace store is not answering, so the traces page stops filling in its service map while every metric on this page stays green. Read it as missing detail, not as a stopped workload.",
      "id": 20,
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "noValue": "unknown" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(absent(up{job=\"tempo\"}) or vector(0))",
          "instant": true
        }
      ],
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "thresholds": {
        "mode": "absolute",
        "steps": [
          { "color": "green", "value": null },
          { "color": "red", "value": 1 }
        ]
      }
    },
    {
      "type": "link",
      "title": "Host tasks",
      "description": "CPU, memory, filesystem, and disk pressure on the box the bundle itself runs on.",
      "id": 21,
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 38 },
      "targets": [],
      "links": [
        { "title": "Stack host task manager",
          "url": "/d/evo-host-taskmanager/stack-host-task-manager",
          "targetBlank": false,
          "tooltip": "Load, memory, filesystem, and disk on the stack host"
        }
      ]
    },
    {
      "type": "link",
      "title": "Containers",
      "description": "Per-container CPU, memory, throttle, and OOM for the compose services.",
