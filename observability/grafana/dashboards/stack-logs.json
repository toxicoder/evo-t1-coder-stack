{
  "uid": "evo-stack-logs",
  "title": "Container logs",
  "tags": ["evo-t1", "logs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "container",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": { "label": "container", "refId": "LokiVariableQueryEditor-VariableQuery", "type": 1 },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "annotations": { "list": [] },
  "panels": [
    {
      "type": "timeseries",
      "title": "Log volume",
      "description": "Lines per second Loki accepted. The shape is the useful part: a service that starts shouting is usually the one about to be interesting below.",
      "id": 1,
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (container) (count_over_time({container=~\"$container\"} [$__auto]))",
          "legendFormat": "{{container}}"
        }
      ]
    },
    {
      "type": "logs",
      "title": "stdout and stderr",
      "description": "Everything the stack's containers wrote, one stream per container. The docker driver's own JSON wrapper is unpacked by Alloy, so what is on this line is what the process printed.",
      "id": 2,
      "gridPos": { "h": 22, "w": 24, "x": 0, "y": 7 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{container=~\"$container\"}",
          "queryType": "range",
          "maxLines": 500
        }
      ]
    },
    {
      "type": "logs",
      "title": "Errors only",
      "description": "Case-insensitive `error` / `fatal` / `panic` in the line. A filter on the text, not on a level label: nothing in this stack writes structured logs, so the word is the only signal there is.",
      "id": 3,
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 29 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{container=~\"$container\"} |~ \"(?i)(error|fatal|panic)\"",
          "queryType": "range",
          "maxLines": 500
        }
      ]
    }
  ]
}
