{
  "uid": "evo-sparks-overview",
  "title": "DGX Sparks overview",
  "description": "The entry point to a DGX Spark: one row of cards per enrolled box, and the Open this Spark card at the end of each row opens the deep-dive page with that box already selected. A page with no cards is the normal state of a fresh stack, before the Spark target file has been generated.",
  "tags": ["evo-t1", "spark"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Spark",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(spark:box_up, hostname)",
        "query": { "query": "label_values(spark:box_up, hostname)", "refId": "SparkHostVariable" },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "options": [],
        "regex": "",
        "sort": 1,
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "links": [
    {
      "type": "link",
      "title": "DGX Spark fleet",
      "url": "/d/evo-sparks-fleet/dgx-spark-fleet",
      "asDashboard": true,
      "targetBlank": true,
      "icon": "external link",
      "tags": ["evo-t1"]
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Spark $host",
      "description": "One value per Spark, 1 when its node_exporter scrape answers, filtered on the hostname label the spark:box_up rule rewrote from instance; a box sitting at 0 with the probe also failing is the box, not one exporter.",
      "id": 1,
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 0 },
      "repeat": { "queryName": "var-host" },
      "repeatDirection": "h",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "spark:box_up{hostname=\"$host\"}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": { "text": "up", "color": "green" },
                "0": { "text": "down", "color": "red" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "noValue": "no data"
    },
    {
      "type": "stat",
      "title": "GPU util",
      "description": "Mean of this box's per-GPU utilisation, filtered on hostname; a line that sits near 100 across the fleet is the fleet saturated, while one box alone at 100 means the router is loading it harder than its neighbours.",
      "id": 2,
      "gridPos": { "h": 4, "w": 3, "x": 3, "y": 0 },
      "repeat": { "queryName": "var-host" },
      "repeatDirection": "h",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "avg(spark:gpu_util_pct:gpu{hostname=\"$host\"})",
          "instant": true
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "decimals": 0 }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "noValue": "no data"
    },
    {
      "type": "stat",
      "title": "Framebuffer fill",
      "description": "The fullest card on this box as used/(used+free), filtered on hostname; a rising number past 0.95 means the next model asked to load will fail to fit rather than slow down.",
      "id": 3,
      "gridPos": { "h": 4, "w": 3, "x": 6, "y": 0 },
      "repeat": { "queryName": "var-host" },
      "repeatDirection": "h",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(spark:gpu_fb_fill_ratio:gpu{hostname=\"$host\"})",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.8 },
              { "color": "red", "value": 0.95 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "noValue": "no data"
    },
    {
      "type": "stat",
      "title": "Temp headroom",
      "description": "Degrees of margin left on the hottest core on this box against the 95 C slowdown point, filtered on hostname; a number falling toward 0 is the room's airflow or a saturating workload, and below 8 C the card starts holding clocks.",
      "id": 4,
      "gridPos": { "h": 4, "w": 3, "x": 9, "y": 0 },
      "repeat": { "queryName": "var-host" },
      "repeatDirection": "h",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "min(spark:gpu_temp_headroom_c:gpu{hostname=\"$host\"})",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 8 },
              { "color": "green", "value": 20 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "noValue": "no data"
    },
    {
      "type": "stat",
      "title": "Power",
      "description": "Watts drawn by all GPUs on this box summed, filtered on hostname; the box rising well above its neighbours at similar utilisation is the one throttling or sharing a socket with too much else.",
      "id": 5,
      "gridPos": { "h": 4, "w": 3, "x": 12, "y": 0 },
      "repeat": { "queryName": "var-host" },
      "repeatDirection": "h",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "spark:gpu_power_watts:box{hostname=\"$host\"}",
          "instant": true
        }
      ],
      "fieldConfig": { "defaults": { "unit": "watt", "min": 0, "decimals": 0 }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "noValue": "no data"
    },
    {
      "type": "stat",
      "title": "CPU",
      "description": "Busy CPU on this box from its own node_exporter, filtered on instance rather than hostname because the generated Spark file_sd carries box and instance only and never hostname, so the join is on the host token in instance; rising while GPU utilisation is flat means the tokeniser or the sampler, not the model.",
      "id": 6,
      "gridPos": { "h": 4, "w": 3, "x": 15, "y": 0 },
      "repeat": { "queryName": "var-host" },
      "repeatDirection": "h",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{instance=~\"$host:.*\",mode=\"idle\"}[5m])))",
          "instant": true
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "decimals": 0 }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "noValue": "no data"
    },
    {
      "type": "stat",
      "title": "Memory",
      "description": "Host memory this box is holding, from its own node_exporter filtered on instance rather than hostname for the same file_sd reason as the CPU card; a number that only climbs is a serving process leaking before it is OOM-killed and the box looks down for no visible reason.",
      "id": 7,
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 0 },
      "repeat": { "queryName": "var-host" },
      "repeatDirection": "h",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{instance=~\"$host:.*\"} / node_memory_MemTotal_bytes{instance=~\"$host:.*\"})",
          "instant": true
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "decimals": 0 }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "noValue": "no data"
    },
    {
      "type": "link",
      "title": "Open this Spark",
      "description": "The way into the per-box deep dive: var-host is preset from this card's repeat value, so One DGX Spark opens on the box the operator clicked instead of on a variable they have to set.",
      "id": 8,
      "gridPos": { "h": 4, "w": 3, "x": 21, "y": 0 },
      "repeat": { "queryName": "var-host" },
      "repeatDirection": "h",
      "targets": [],
      "url": "/d/evo-spark-host/one-dgx-spark?var-host=${var:queryparam}",
      "options": { "colorMode": "background", "textAlignment": "center", "openInNewTab": false }
    },
    {
      "type": "stat",
      "title": "Requests per second",
      "description": "Proxy-wide request rate summed across deployments, not per box: litellm:requests_per_second:5m is recorded sum by (model_id) and carries no host label, so this page cannot attribute a share of it to one Spark and does not pretend to. A rising number with every GPU card flat means the router is queueing, not serving.",
      "id": 9,
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(litellm:requests_per_second:5m)",
          "instant": true
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0, "decimals": 1 }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "noValue": "no data"
    },
    {
      "type": "timeseries",
      "title": "Serving request rate, by deployment",
      "description": "One line per LiteLLM deployment rather than per box, because the recorded rule's only label is model_id and no host attribution exists at this exporter set. A deployment that goes flat while the proxy-wide number holds is one backend the router has stopped sending work to.",
      "id": 10,
      "gridPos": { "h": 8, "w": 21, "x": 3, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0, "custom": { "fillOpacity": 10, "lineWidth": 1 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "litellm:requests_per_second:5m",
          "legendFormat": "{{model_id}}"
        }
      ]
    },
    {
      "type": "table",
      "title": "Every Spark, one row per box",
      "description": "The whole enrolled fleet at a glance, sorted so the busiest GPU is on top; a box that sits alone at the bottom of GPU util while the fleet is busy is the one not pulling its weight. The GPU columns read the recorded spark:* rules by hostname; the two host columns read node_exporter series directly and match on instance, which carries the box token whatever the target file stamped, so one row cannot lose its host half.",
      "id": 11,
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "spark:box_up{hostname=~\"$host\"}",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "spark:gpu_util_pct:box{hostname=~\"$host\"}",
          "instant": true
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "spark:gpu_fb_fill_ratio:box{hostname=~\"$host\"}",
          "instant": true
        },
        {
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "spark:gpu_temp_headroom_c:box{hostname=~\"$host\"}",
          "instant": true
        },
        {
          "refId": "E",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "spark:gpu_power_watts:box{hostname=~\"$host\"}",
          "instant": true
        },
        {
          "refId": "F",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * (1 - avg by (hostname) (label_replace(rate(node_cpu_seconds_total{instance=~\"$host:.*\",mode=\"idle\"}[5m]), \"hostname\", \"$1\", \"instance\", \"^(?:[a-zA-Z]+://)?([^:/?#]+).*\")))",
          "instant": true
        },
        {
          "refId": "G",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * (1 - max by (hostname) (label_replace(node_memory_MemAvailable_bytes{instance=~\"$host:.*\"}, \"hostname\", \"$1\", \"instance\", \"^(?:[a-zA-Z]+://)?([^:/?#]+).*\")) / max by (hostname) (label_replace(node_memory_MemTotal_bytes{instance=~\"$host:.*\"}, \"hostname\", \"$1\", \"instance\", \"^(?:[a-zA-Z]+://)?([^:/?#]+).*\")))",
          "instant": true
        }
      ],
      "transformations": [
        { "id": "joinByField", "options": { "byField": "hostname", "mode": "outer" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": {
              "hostname": "Spark",
              "Value #A": "Up",
              "Value #B": "GPU util %",
              "Value #C": "VRAM fill",
              "Value #D": "Temp headroom C",
              "Value #E": "Power W",
              "Value #F": "CPU %",
              "Value #G": "Mem %"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": { "decimals": 1, "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Spark" },
            "properties": [{ "id": "custom.width", "value": 220 }]
          },
          {
            "matcher": { "id": "byName", "options": "Up" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": { "text": "up", "color": "green" },
                      "0": { "text": "down", "color": "red" }
                    }
                  }
                ]
              },
              { "id": "decimals", "value": 0 }
            ]
          },
          { "matcher": { "id": "byName", "options": "GPU util %" }, "properties": [{ "id": "unit", "value": "percent" }] },
          { "matcher": { "id": "byName", "options": "VRAM fill" }, "properties": [{ "id": "unit", "value": "percentunit" }] },
          { "matcher": { "id": "byName", "options": "Temp headroom C" }, "properties": [{ "id": "unit", "value": "celsius" }] },
          { "matcher": { "id": "byName", "options": "Power W" }, "properties": [{ "id": "unit", "value": "watt" }] },
          { "matcher": { "id": "byName", "options": "CPU %" }, "properties": [{ "id": "unit", "value": "percent" }] },
          { "matcher": { "id": "byName", "options": "Mem %" }, "properties": [{ "id": "unit", "value": "percent" }] }
        ]
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "GPU util %", "desc": true }] }
    }
  ]
}
