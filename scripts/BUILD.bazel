"""Package purpose: Operational shell and the validate orchestrator.

Every script under this package is a Bazel target: one generated runfiles launcher
(//tools:exec_shell.bzl) plus one sh_binary wrapper per scripts/*.sh, so
`bazelisk run //scripts:<stem> -- <args>` works from a foreign cwd and from a checkout
whose scripts are mode 100644. Entry scripts cd to a repo root they resolve themselves and
then read repo files by path, so each target declares two things and nothing else:

  - the exact `scripts/lib` files it sources, executes, or ships to a remote host
    (`_SCRIPT_LIBS`), and
  - the payload groups whose files it reads (`_SCRIPT_PAYLOAD`, plus
    `_SCRIPT_PAYLOAD_ALLOW` for the pairings a source scan cannot derive).

Both maps are the machine-readable dependency record for this package: //tests reads them
and re-derives them from the sources, so a script that starts reading a new payload fails
the gate until its target says so. The payload groups live in the root BUILD.bazel and the
payload packages (//litellm:config, //homepage:payload, //proxy:confs, ...); see
`//:stack_data` for the aggregate a target declares only when it addresses the repo whole.
"""

load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//tools:exec_shell.bzl", "exec_shell")

package(default_visibility = ["//visibility:private"])

# This package's own target declarations, for the dependency gate in //tests.
filegroup(
    name = "build_file",
    srcs = ["BUILD.bazel"],
    visibility = ["//visibility:public"],
)

# ---------------------------------------------------------------------------
# Source groups. :doc_sources is the union the lint and coverage drivers declare
# so that any sourced lib, awk program, or Python helper resolves inside runfiles;
# the three groups beside it let a consumer ask for shell only.
# ---------------------------------------------------------------------------

filegroup(
    name = "shell_sources",
    srcs = glob(
        ["**/*.sh"],
        allow_empty = True,
    ),
    visibility = [
        "//lints:__pkg__",
        "//tests:__pkg__",
        "//visibility:public",
    ],
)

filegroup(
    name = "py_programs",
    srcs = glob(
        ["**/*.py"],
        allow_empty = True,
    ),
    visibility = [
        "//lints:__pkg__",
        "//tests:__pkg__",
        "//visibility:public",
    ],
)

filegroup(
    name = "awk_programs",
    srcs = glob(
        ["**/*.awk"],
        allow_empty = True,
    ),
    visibility = [
        "//lints:__pkg__",
        "//tests:__pkg__",
        "//visibility:public",
    ],
)

filegroup(
    name = "doc_sources",
    srcs = [
        ":awk_programs",
        ":py_programs",
        ":shell_sources",
    ],
    visibility = [
        "//lints:__pkg__",
        "//tests:__pkg__",
        "//visibility:public",
    ],
)

# The POSIX probes scripts/lib/config_seed.sh cats and ships into a workspace container.
filegroup(
    name = "seed_probes",
    srcs = [
        "lib/probes/seed-find-mtime.sh",
        "lib/probes/seed-owner.sh",
        "lib/probes/seed-rm-mtime.sh",
        "lib/probes/seed-write.sh",
    ],
    visibility = ["//visibility:public"],
)

# validate.sh is the only file in this package another package addresses by label.
exports_files(["validate.sh"])

# ---------------------------------------------------------------------------
# Per-script dependency maps. Both are read by //tests:bats_bazel_deps_test, which
# re-derives them from the sources, so keep them literal: strings and lists only, no
# concatenation, no comprehensions.
#
# _SCRIPT_LIBS is the transitive source closure: an entry script's own `source`,
# `awk -f`, `python3` and probe `cat` lines plus whatever its libs source. A missing
# entry here is a hard startup failure under `bazel run`, not a silent miss.
#
# _SCRIPT_PAYLOAD names the payload groups whose files the script (or a lib it
# sources) reads by path. //:compose_file appears on every script that resolves a
# repo root: it is the marker resolve_checkout in scripts/lib/common.sh probes for,
# not just the compose project file.
#
# _SCRIPT_PAYLOAD_ALLOW carries a pairing the source scan cannot derive in either
# direction - help text, a `case` glob over `git diff` output, a runtime discovery.
# Every entry states which.
# ---------------------------------------------------------------------------

