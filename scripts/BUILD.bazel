_SCRIPT_PAYLOAD_ALLOW = {
    # HELP text only; lib/workspace.sh matches these paths against a remote
    # `git ls-tree`, never against the checkout.
    "new-workspace": [
        "//:devcontainer",
    ],
    # `searxng` here is a regex over ~/.grok/config.toml, not the payload tree.
    "mcp-check": [
        "//searxng:settings",
    ],
    # These paths appear only inside `case` globs over `git diff --name-only`
    # output, so the script never opens them.
    "update-stack": [
        "//hermes:seed",
        "//homepage:payload",
        "//litellm:config",
        "//proxy:confs",
        "//searxng:settings",
    ],
    # setup-host reads no compose file: it roots itself at SELF_DIR/.. and never
    # calls resolve_checkout.
    "setup-host": [
        "//:compose_file",
        # lib/tool_pins.sh builds the path `${root}/images/dev/tool-versions.env`
        # and hands that string back; setup-host hashes the file through it, so no
        # line in either source names the payload.
        "//images/dev:context",
    ],
}

# One target pair per entry script, generated from the directory so a new scripts/*.sh is a
# Bazel target without a second edit here. scripts/lib/*.sh stays sourced-only: it reaches
# runfiles through the per-script maps and :doc_sources instead of gaining a runnable target.
#
# A scripts/*.sh with no key in _SCRIPT_LIBS or _SCRIPT_PAYLOAD fails analysis rather than
# quietly inheriting the world, which is what keeps the two maps complete.
_ENTRY_SCRIPTS = glob(
    ["*.sh"],
    allow_empty = True,
)

[
    exec_shell(
        name = src.replace(".sh", "") + "_exec",
        src = src,
        data = _SCRIPT_LIBS[src.replace(".sh", "")] +
               _SCRIPT_PAYLOAD[src.replace(".sh", "")] +
               _SCRIPT_PAYLOAD_ALLOW.get(
                   src.replace(".sh", ""),
                   [],
               ),
    )
    for src in _ENTRY_SCRIPTS
]

[
    sh_binary(
        name = src.replace(".sh", ""),
        srcs = [":" + src.replace(".sh", "") + "_exec"],
        data = _SCRIPT_LIBS[src.replace(".sh", "")] +
               _SCRIPT_PAYLOAD[src.replace(".sh", "")] +
               _SCRIPT_PAYLOAD_ALLOW.get(
                   src.replace(".sh", ""),
                   [],
               ),
        visibility = ["//visibility:public"],
    )
    for src in _ENTRY_SCRIPTS
]
