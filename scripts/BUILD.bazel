"""Package purpose: Operational shell and the validate orchestrator.

Every script under this package is a Bazel target: one generated runfiles
launcher (//tools:exec_shell.bzl) plus one sh_binary wrapper per scripts/*.sh,
so `bazelisk run //scripts:<stem> -- <args>` works from a foreign cwd and from
a checkout whose scripts are mode 100644. Entry scripts cd to a repo root they
resolve themselves and then read repo files by path, so the compose file, both
template payload trees, the golden-image pins, litellm/config.yaml and the two
.env samples ride along in runfiles (//:stack_data), and every scripts/**.sh
rides along too (:doc_sources) — a sourced lib must resolve inside the sandbox
just like the entry script that sources it.
"""

load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//tools:exec_shell.bzl", "exec_shell")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "doc_sources",
    srcs = glob(["**/*.sh"]),
    visibility = [
        "//lints:__pkg__",
        "//tests:__pkg__",
        "//visibility:public",
    ],
)

exports_files(
    glob(["**/*.sh"]),
    visibility = [
        "//lints:__pkg__",
        "//tests:__pkg__",
    ],
)

# Repo files a wrapped script may read by path, beside the shell it sources.
_SCRIPT_DATA = [
    ":doc_sources",
    "//:stack_data",
]

# One target pair per entry script, generated from the directory so a new
# scripts/*.sh is a Bazel target without a second edit here. scripts/lib/*.sh
# stays sourced-only: it reaches runfiles through :doc_sources instead of
# gaining a runnable target of its own.
_ENTRY_SCRIPTS = glob(
    ["*.sh"],
    allow_empty = True,
)

[
    exec_shell(
        name = src.replace(".sh", "") + "_exec",
        src = src,
        data = _SCRIPT_DATA,
    )
    for src in _ENTRY_SCRIPTS
]

[
    sh_binary(
        name = src.replace(".sh", ""),
        srcs = [":" + src.replace(".sh", "") + "_exec"],
        data = _SCRIPT_DATA,
        visibility = ["//visibility:public"],
    )
    for src in _ENTRY_SCRIPTS
]
