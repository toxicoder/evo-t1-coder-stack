# EVO-T1 Coder stack — canonical environment template.
# Copy to .env (bootstrap.sh does this) and edit. Never commit .env.
# Sections are the `# ---` banners below. The long form of four notes here —
# GitHub external auth, Grok profile mode, public hosts, and the Spark `agent`
# model group — is in docs/config-updates.md.

# --- Coder ----------------------------------------------------------------

# Host port for the Coder UI. Kasm owns 3000, so Coder uses 3001.
CODER_HTTP_PORT=3001

# Second path to Coder's plain listener, for workspace agents dialing
# host.docker.internal (see coder_agent_url in templates/workspace).
CODER_AGENT_TUNNEL_PORT=3002

# Workspaces call back through this URL, so it must be LAN-routable —
# bootstrap.sh fills in your LAN IP when it can. Must be https (the frontend
# needs a secure context); self-signed cert, so expect a first-visit warning.
CODER_ACCESS_URL=https://YOUR_LAN_IP:3001

# Postgres (Coder's database). The db wrapper re-applies this on every start,
# so rotating it here and running `prod-stack up` (or `dev-stack up`) is
# enough: the persisted volume keeps the old password until that re-apply.
CODER_PG_PASSWORD=change-me-postgres

# Prometheus metrics for the Coder control plane, published on 127.0.0.1 only.
# Point a scraper at http://127.0.0.1:<port>/metrics on the stack host.
CODER_METRICS_PORT=2112

# Browser session lifetime. The 24h product default reads as a bug on a
# single-user box. Accepts Go durations (720h = 30 days).
CODER_SESSION_DURATION=720h

# CLI/API-key lifetime, same units; the 7d default is the weekly sign-out.
CODER_DEFAULT_TOKEN_LIFETIME=720h

# The server refuses to boot unless this is STRICTLY greater than
# CODER_SESSION_DURATION. Maps to CODER_DEFAULT_OAUTH_REFRESH_LIFETIME.
CODER_OAUTH_REFRESH_LIFETIME=8760h

# Coder marks the deployment unhealthy after 5 slow median-query probes; the
# 15ms default is easy to trip when Postgres contends with a loaded model.
CODER_HEALTH_CHECK_THRESHOLD_DATABASE=60ms

# Quiet hours clamp autostop deadlines, so the timezone matters: leaving this
# at UTC force-stops workspaces at the wrong wall-clock hour. Use a
# CRON_TZ=<Area/City> cron expression. Quoted because scripts source .env.
CODER_QUIET_HOURS="CRON_TZ=UTC 0 3 * * *"

# Keep `disable`: the built-in DERP STUN servers default to Google endpoints,
# which buy nothing on a LAN, and agents connect directly over WireGuard.
CODER_DERP_STUN=disable

# Experiment opt-ins, comma-separated; empty = none (safe, the default).
# `agents` is not an experiment name in 2.36.6 — real names are listed by
# `coder server --help`.
CODER_EXPERIMENTS=

# --- Grok profile ---------------------------------------------------------

# Default for the create form's `Grok profile` dropdown, read once per push.
# `shared` nests one grok-profile volume per user; `private` dies with the
# workspace. Rebuild to switch: docs/config-updates.md#grok-profile-mode
GROK_PROFILE_MODE=shared

# --- GitHub / MCP ---------------------------------------------------------

# GitHub credentials are Coder External Auth only; do not add
# CODER_EXTERNAL_AUTH_0_* here (a defined-but-empty key crash-loops coder).
# Custom OAuth app, callback URL and the Coder GitHub App install: see
# docs/config-updates.md#github-external-auth-and-coderenv

# Add the github MCP HTTP server (https://api.githubcopilot.com/mcp/) to every
# workspace's rendered ~/.grok/config.toml. It uses the same external-auth
# token, so leave off unless you want Grok to drive GitHub tools.
GITHUB_MCP=

# Add the cached Context7 MCP server to every workspace's rendered
# ~/.grok/config.toml. Leave off unless you want Grok to fetch library docs.
CONTEXT7_MCP=

# Context7 API key (https://context7.com/dashboard), forwarded as a sensitive
# template variable; config.toml names it and never carries the value. Never
# commit a real key.
CONTEXT7_API_KEY=

# --- LiteLLM + Spark ------------------------------------------------------

# Model gateway port — the sole model transport for the stack.
LITELLM_PORT=4000

# Master key every client authenticates with; bootstrap.sh rotates it.
LITELLM_MASTER_KEY=change-me-litellm

# Optional NVIDIA Spark boxes — Ollama endpoints behind the spark-* aliases.
# Placeholder hostnames on purpose; replace with real Ollama URLs or leave
# them as-is (those aliases simply fail when used).
SPARK1_OLLAMA_URL=http://spark-1.lan:11434

# Second Spark box, same shape.
SPARK2_OLLAMA_URL=http://spark-2.lan:11434

# OpenAI-compatible /v1 endpoints for the ONE `agent` model group: three
# deployments, one per Spark box. All three empty leaves `agent` unusable and
# LiteLLM falls back to `coder`: docs/config-updates.md#spark-agent-model-group
SPARK1_OPENAI_URL=http://spark-1.lan:8888/v1

# Second box of the `agent` group.
SPARK2_OPENAI_URL=http://spark-2.lan:8888/v1

# Third box of the `agent` group.
SPARK3_OPENAI_URL=http://spark-3.lan:8888/v1

# Bearer tokens for the endpoints above: any non-empty string on a keyless box,
# the REAL key when the server runs with --api-key. Empty is not a working
# value; `local-spark` is not a secret.
SPARK_1_API_KEY=local-spark

# Token for the second box, same rules.
SPARK_2_API_KEY=local-spark

# Token for the third box, same rules.
SPARK_3_API_KEY=local-spark

# Per-box health probes for the dashboard's Spark cards (one widget per box).
# Compose already defaults each to http://spark-<n>.lan:8888/health, so these
# are overrides for real hostnames, not requirements.
# SPARK1_HEALTH_URL=http://spark-1.lan:8888/health
# SPARK2_HEALTH_URL=http://spark-2.lan:8888/health
# SPARK3_HEALTH_URL=http://spark-3.lan:8888/health

# Full /v1/models URL for the dashboard's "Agent backend" card — the live
# signal for a tool-capable agent route vs the text-only Arc fallback.
AGENT_MODEL_URL=http://spark-2.lan:8888/v1/models

# --- Workspace golden image -----------------------------------------------

# Built by `bazelisk run //scripts:build-dev-image` and referenced by name, so
# it never pulls. Build it before creating a workspace, or point this at a Coder
# base image; bootstrap.sh builds it when missing.
DEV_IMAGE=evo-t1-dev:latest

# Optional default for the create form's Git repository field (both templates);
# empty keeps each template's own default. Per-workspace URLs go in the form, or
# use `bazelisk run //scripts:new-workspace -- <git-url>`.
REPO_URL=

# Additional repositories have no key here: one repository per workspace is the
# default shape, and the extras are opted into per workspace by the create form's
# "Git repositories (additional)" field or `--additional-repos "url1,url2"` on
# new-workspace.sh. They never become the folder the editor opens on.

# Docker-in-docker is not set here either: it is the "Docker-in-docker" Yes/No
# question on the create form (preset "AI workspace + DinD"), fixed at create
# time, and needs docker:29.8.1-dind in the host image store — bootstrap.sh
# pulls it, because Terraform never does.

# SKIP_DEV_IMAGE_BUILD=1, SKIP_TEMPLATE_PUSH=1 and SKIP_SPARKS=1 change what
# bootstrap.sh does. It reads them from the process environment only, never from
# this file, so export them in the shell that runs `bazelisk run
# //scripts:bootstrap`.

# --- Ollama (IPEX-LLM on the Arc 140T) ------------------------------------

# Models pulled by scripts/pull-models.sh (first run is a big download).
OLLAMA_MODELS="qwen2.5-coder:32b qwen2.5-coder:14b qwen2.5:7b"

# --- Kasm -----------------------------------------------------------------

# First-boot install wizard.
KASM_WIZARD_PORT=3000

# Kasm UI once the wizard is done.
KASM_UI_PORT=4443

# --- Homepage dashboard ---------------------------------------------------

# The dashboard container publishes nothing; an nginx sidecar owns the default
# web ports, so 80 redirects to the TLS port below and proxies to the dashboard
# over the compose network.
HOMEPAGE_HTTP_PORT=80

# TLS port, terminated with the self-signed cert bootstrap.sh writes into
# proxy/certs/ (gitignored).
HOMEPAGE_HTTPS_PORT=443

# The router sidecar's plain-HTTP port for the public subdomains; the main
# Traefik points its routers at this (proxy/router.conf routes by Host).
STACK_PROXY_HTTP_PORT=8080

# Host the browser uses to reach the dashboard; bootstrap.sh derives it from
# CODER_ACCESS_URL. Empty falls back to localhost.
STACK_LAN_HOST=

# Public access, off by default: empty keeps everything LAN-only. Otherwise
# comma-separated DNS names (no scheme/port/path), each prefix hyphen-joined
# for the one-label cert: docs/config-updates.md#public-hosts-and-the-dashboard
#   STACK_PUBLIC_HOSTS=gmktecbeast.overeazy.io,coder-gmktecbeast.overeazy.io,kasm-gmktecbeast.overeazy.io,litellm-gmktecbeast.overeazy.io,hermes-gmktecbeast.overeazy.io
STACK_PUBLIC_HOSTS=

# Per-service origins bootstrap.sh writes from STACK_PUBLIC_HOSTS; empty means
# LAN-only and compose falls back to STACK_LAN_HOST with the ports above. Point
# Traefik at these, not at the LAN ports.
STACK_DASHBOARD_URL=

# Card href for the Coder tile.
STACK_CODER_URL=

# Card href for the Kasm tile.
STACK_KASM_URL=

# Card href for the LiteLLM tile.
STACK_LITELLM_URL=

# Homepage v2 login gate — anyone on the LAN who can reach 443 needs it, since
# the dashboard lists every service in the stack. bootstrap.sh fills both in and
# prints the password once, so note it down.
HOMEPAGE_AUTH_SECRET=change-me-homepage-secret

# The password the operator types at the login gate.
HOMEPAGE_AUTH_PASSWORD=change-me-homepage

# --- Coder Docker access --------------------------------------------------

# GID of the host docker group: the coder and hermes containers need this group
# to reach the mounted /var/run/docker.sock. bootstrap.sh fills it from
# `getent group docker`; check it after reinstalling Docker.
DOCKER_GID=980

# --- Hermes host assistant ------------------------------------------------

# Official Web Dashboard (Chat tab embeds the TUI with approval prompts).
# Public name is opt-in via STACK_PUBLIC_HOSTS; bootstrap writes
# STACK_HERMES_URL. LAN :9119 remains. Dev stack: the dev-stack.env port
# awk shifts 9119 -> 19119.
HERMES_DASHBOARD_PORT=9119

# HTTP basic-auth username for the dashboard.
HERMES_DASHBOARD_USER=admin

# bootstrap.sh replaces both change-me-* values. The password is HTTP basic
# auth for the dashboard. Neither is the Homepage password, and
# dashboard-password.sh does not rotate them.
HERMES_DASHBOARD_PASSWORD=change-me-hermes

# Signs the dashboard session.
HERMES_DASHBOARD_SECRET=change-me-hermes-secret

# Host path of this checkout, bind-mounted at the same path inside the hermes
# container so `docker compose` through the socket resolves bind sources on the
# daemon. Empty = compose falls back to .:/opt/stack (what CI needs).
STACK_HOST_PATH=

# uid hermes-init chowns /opt/data to, so the gateway can reopen the seed after
# s6 drops privileges. bootstrap.sh fills this from `id -u`.
HERMES_UID=1000

# The matching group, from `id -g`.
HERMES_GID=1000

# Browser URL for the Homepage Host card. bootstrap writes STACK_HERMES_URL
# from an opt-in hermes-* name in STACK_PUBLIC_HOSTS; empty means LAN and
# compose builds the card from STACK_LAN_HOST and HERMES_DASHBOARD_PORT.
# LAN :9119 remains.
STACK_HERMES_URL=
